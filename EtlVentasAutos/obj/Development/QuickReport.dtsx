    <DTS:Executable
      DTS:refId="Package\CTL02GetWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{F5BC2453-D10F-44B7-B455-81D0A2639348}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL02GetWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="-- ResultSet: Single row&#xA;-- Output: User::WmCurrentLoadDate&#xA;SELECT ISNULL([LastLoadDate], '1900-01-01') AS CurrentLoadDate&#xA;FROM   [dbo].[CTLWaterMark]&#xA;WHERE  [ProcessID] = ?;&#xA;-- Param 0 (Input): User::CtlProcessID"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="CurrentLoadDate"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL03OpenExecution"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
