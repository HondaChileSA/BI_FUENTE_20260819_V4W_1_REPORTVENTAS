    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{27841657-9506-4FA8-B14B-642DF6958600}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* QuickReport__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U (antes y después) y D (antes) de la entidad, en un solo CTLAuditBatch; el JSON lleva la entidad.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT N'QuickReport' AS Entidad, tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT N'QuickReport' AS Entidad, src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseQuickReport AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadQuickReport AS src ON src.[Archivo] = tgt.[Archivo] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9BC72A39-8BCD-41C9-B5E3-7AC46804B57D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* QuickReport__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría I de la entidad (el JSON lleva la entidad).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'I', NULL,&#xA;       (SELECT N'QuickReport' AS Entidad, src.[Archivo], src.[VersionQuick], src.[MesQuick], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[DealerArea], src.[Unidades], src.[RUTID], src.[SUCURSALID], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadQuickReport AS src&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1C426A6D-4230-4923-9716-84E59C9E2B16}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* QuickReport__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote. FailedRows = pendientes vistos en esta corrida en las 3 Qc; borradas en Notes. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::EtlRowsDeleted · 5) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @FailedRows int =&#xA;      (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcQuickReport WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente');&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = @FailedRows,&#xA;       Notes = CASE WHEN @Del &gt; 0 THEN N'Filas borradas de Base (TypeLoad D, fotografía reemplazada): ' + CONVERT(nvarchar(20), @Del) END&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT @FailedRows AS RowsFailed;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="4" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{822565AA-7F21-4D9A-88B2-F829B89C82F2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* QuickReport__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo (archivos por hash): conserva el corte del KI 103 (CTL10 resta un día) y deja la última fotografía cargada.&#xA;   Parámetros (OLE DB, en orden): 1) User::WmCurrentLoadDate&#xA;*/&#xA;DECLARE @Actual date = ?;&#xA;SELECT DATEADD(DAY, 1, @Actual) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(MesQuick) FROM HMDCBIDW.dbo.V4WBaseQuickReport), 23), N'') AS NewLastID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
