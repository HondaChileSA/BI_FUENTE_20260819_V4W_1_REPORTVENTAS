      DTS:LocaleID="-1"
      DTS:ObjectName="ETL07UpdateDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* QuickReport__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U de la entidad. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;UPDATE tgt SET tgt.[VersionQuick] = src.[VersionQuick], tgt.[MesQuick] = src.[MesQuick], tgt.[FechaCorte] = src.[FechaCorte], tgt.[Hoja] = src.[Hoja], tgt.[DealerArea] = src.[DealerArea], tgt.[Unidades] = src.[Unidades], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseQuickReport AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadQuickReport AS src ON src.[Archivo] = tgt.[Archivo] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsUpdated;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL08InsertDWHDW"
