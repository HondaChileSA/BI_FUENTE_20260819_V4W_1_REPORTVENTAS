        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* QuickReport__ETL05InsertDWHDW_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I de la entidad. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseQuickReport ([Archivo], [VersionQuick], [MesQuick], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [Unidades], [RUTID], [SUCURSALID], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[Archivo], s.[VersionQuick], s.[MesQuick], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[DealerArea], s.[Unidades], s.[RUTID], s.[SUCURSALID], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadQuickReport AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsInsert;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
