          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL02LoadDWHSA — V4W · GestionDealer (ProcessID 36) · Script Task · v1.0
 *
 * Lee los archivos "Gestion Dealer 4W <Mes> DD-MM.xlsx" que dejó ETL00aCheckFile en
 * User::EtlArchivosLista (nuevos o modificados, KI 103) y carga tres Stg en HMDCBISA:
 *   - V4WStgGestionDealer : hojas "Gestion <Dealer>". Cada celda "Retail" abre un bloque; la sala es la
 *                           celda de arriba (vacía = el dealer). Modelo = columna a la izquierda; el
 *                           bloque termina en "Total". Columnas por encabezado (Retail, Plan, FC Retail,
 *                           W/S, FC Whole, Stock*, Test*). Bloques " TTL" con EsTTL = 1.
 *                           FilaOrigen = fila Excel * 1000 + columna Excel del bloque (en una fila puede
 *                           haber varios bloques, uno por sala, lado a lado).
 *   - V4WStgAvanceDiario  : "Avance Diario RETAIL" y "Avance Diario Whole" (tabla de colores).
 *   - V4WStgStockDealer   : hoja "Stock Dealer" (VIN por dealer).
 * Lógica portada de la maqueta (fnLeerGestionDealer / fnLeerMetaGestion / fnLeerStockDealer), validada
 * contra la base del área. Familia / Versión con la lista de familias de V4WBaseModeloAlias (nivel
 * Familia) y V4WBaseModeloGrupo.
 * D-34: filas con todas sus cifras en cero o vacías se omiten (Gestion y Avance).
 * Un archivo que falla no detiene a los demás: queda "Rechazado" con su aviso (lo registra ETL06).
 * Excel por OLE DB ACE 12.0 (HDR=NO, IMEX=1), leyendo rangos acotados (la hoja RETAIL trae un rango
 * usado A1:XDA57).
 *
 * Al terminar reescribe User::EtlArchivosLista agregando a cada línea:
 *   Estado (Cargado / Rechazado), FilasGestion, FilasAvance, FilasStock, Aviso.
 *
 * ReadOnlyVariables : User::CtlExecutionID, $Project::vSQLConnStr, $Project::vSQLConnDw
 * ReadWriteVariables: User::EtlArchivosLista
 *
 * Desarrollador: Franco Véliz (Agente V4W) · 2026-11-08 · C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Globalization;
using System.IO;
using System.Linq;
#endregion

namespace ST_ece9a6b9ab81467a994c3c863fb40de6
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private const string Componente = "ETL02LoadDWHSA";
        private const string Rango = "A1:AZ200";
        private int _row;

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                long execId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                string connStg = Convert.ToString(Dts.Variables["$Project::vSQLConnStr"].Value);
                string lista = Convert.ToString(Dts.Variables["User::EtlArchivosLista"].Value);
                var salida = new List<string>();

                foreach (string linea in lista.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    string[] f = linea.Split('\t');
                    string ruta = f[0], archivo = f[1];
                    DateTime mes = DateTime.ParseExact(f[2], "yyyy-MM-dd", CultureInfo.InvariantCulture);
                    DateTime corte = DateTime.ParseExact(f[3], "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture).Date;
                    string version = Version(archivo);
                    string estado = "Cargado", aviso = "";
                    var t = Nueva();
                    try
                    {
                        using (var cn = new OleDbConnection("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + ruta +
                                                            ";Extended Properties='Excel 12.0 Xml;HDR=NO;IMEX=1';"))
                        {
                            cn.Open();
                            string hoja = Hojas(cn).FirstOrDefault(h => string.Equals(h, "Quick", StringComparison.OrdinalIgnoreCase));
                            if (hoja == null) throw new Exception("HOJA_FALTANTE: no hay hoja 'Quick'");
                            var dt = new DataTable();
                            using (var da = new OleDbDataAdapter("SELECT * FROM [" + hoja + "$" + Rango + "]", cn)) da.Fill(dt);

                            int r0 = -1, c0 = -1;
                            for (int r = 0; r < dt.Rows.Count && r0 < 0; r++)
                                for (int c = 0; c < dt.Columns.Count; c++)
                                    if (string.Equals(Txt(dt, r, c), "to be reported", StringComparison.OrdinalIgnoreCase)) { r0 = r; c0 = c; break; }
                            if (r0 < 0) throw new Exception("No se encontró el bloque 'To be reported' en la hoja Quick");

                            for (int r = r0 + 1; r < dt.Rows.Count && r < r0 + 40; r++)
                            {
                                string dealer = Txt(dt, r, c0);
                                if (dealer.ToLowerInvariant().StartsWith("total")) break;
                                if (dealer == "") continue;
                                double u = Num(dt, r, c0 + 1);
                                if (u == 0) continue;   // D-34
                                t.Rows.Add(execId, ++_row, Cut(archivo, 260), version, mes, corte, Cut(hoja, 100), r + 1,
                                           Cut(dealer, 100), Math.Round((decimal)u, 4));
                            }
                        }
                        Bulk(connStg, t);
                    }
                    catch (Exception exA)
                    {
                        estado = "Rechazado"; aviso = exA.Message;
                        Dts.Events.FireWarning(0, Componente, archivo + ": " + exA.Message, "", 0);
                    }
                    aviso = (aviso ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
                    salida.Add(string.Join("\t", f.Take(6).Concat(new[] { estado, (estado == "Cargado" ? t.Rows.Count : 0).ToString(), "0", "0", aviso })));
                    Dts.Events.FireInformation(0, Componente, string.Format("{0} · {1} · {2:yyyy-MM} · {3} · To be reported {4}{5}",
                        archivo, version, mes, estado, estado == "Cargado" ? t.Rows.Count : 0, aviso == "" ? "" : " · " + aviso), "", 0, ref fireAgain);
                }
                Dts.Variables["User::EtlArchivosLista"].Value = string.Join("\n", salida);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Componente, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // v1.1: la versión se busca por palabra en el nombre ("… - Niguri", "… Junio 2026 PRB"); sin palabra → "Unica"
        // (abril y mayo 2026 tienen un solo Quick).
        private static string Version(string archivo)
        {
            string n = Path.GetFileNameWithoutExtension(archivo).ToLowerInvariant();
            if (n.Contains("niguri")) return "Niguri";
            if (System.Text.RegularExpressions.Regex.IsMatch(n, @"\bprb\b")) return "PRB";
            return "Unica";
        }

        private static string Txt(DataTable dt, int r, int c)
        {
            if (r < 0 || c < 0 || r >= dt.Rows.Count || c >= dt.Columns.Count || dt.Rows[r].IsNull(c)) return "";
            return Convert.ToString(dt.Rows[r][c], CultureInfo.InvariantCulture).Trim();
        }
        private static double Num(DataTable dt, int r, int c)
        {
            string s = Txt(dt, r, c); if (s == "") return 0;
            bool pct = s.EndsWith("%"); if (pct) s = s.TrimEnd('%').Trim();
            double d;
            if (!double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out d) &&
                !double.TryParse(s, NumberStyles.Any, CultureInfo.GetCultureInfo("es-CL"), out d)) return 0;
            return pct ? d / 100.0 : d;
        }
        private static List<string> Hojas(OleDbConnection cn)
        {
            var res = new List<string>();
            foreach (DataRow r in cn.GetOleDbSchemaTable(OleDbSchemaGuid.Tables, null).Rows)
            {
                string n = Convert.ToString(r["TABLE_NAME"]).Trim('\'');
                if (n.EndsWith("$")) res.Add(n.Substring(0, n.Length - 1));
            }
            return res;
        }
        private static string Cut(string s, int n) { return s == null ? null : (s.Length <= n ? s : s.Substring(0, n)); }
        private static DataTable Nueva()
        {
            var t = new DataTable();
            t.Columns.Add("ExecutionID", typeof(long)); t.Columns.Add("RowNumber", typeof(int)); t.Columns.Add("Archivo", typeof(string));
            t.Columns.Add("VersionQuick", typeof(string)); t.Columns.Add("MesQuick", typeof(DateTime)); t.Columns.Add("FechaCorte", typeof(DateTime));
            t.Columns.Add("Hoja", typeof(string)); t.Columns.Add("FilaOrigen", typeof(int)); t.Columns.Add("DealerArea", typeof(string));
            t.Columns.Add("Unidades", typeof(decimal));
            return t;
        }
        private static void Bulk(string connStr, DataTable t)
        {
            if (t.Rows.Count == 0) return;
            using (var cn = new SqlConnection(connStr))
            {
                cn.Open();
                using (var b = new SqlBulkCopy(cn, SqlBulkCopyOptions.CheckConstraints, null))
                {
                    b.DestinationTableName = "dbo.V4WStgQuickReport";
                    foreach (DataColumn c in t.Columns) b.ColumnMappings.Add(c.ColumnName, c.ColumnName);
                    b.WriteToServer(t);
                }
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
