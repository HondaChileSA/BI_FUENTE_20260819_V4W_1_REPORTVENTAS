          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL06RegisterFile � V4W � GestionDealer (ProcessID 36) � Script Task � v1.0
 *
 * Registra en HMDCBIDW.dbo.V4WBaseArchivoCargado cada archivo procesado en la corrida, a partir de
 * User::EtlArchivosLista (la dej� ETL00aCheckFile y la complet� ETL02LoadDWHSA con el resultado):
 *   Ruta, Archivo, FechaCorte, FechaModificacion, TamanoBytes, HashHex, Estado, FilasGestion,
 *   FilasAvance, FilasStock, Aviso   (separados por TAB, un archivo por l�nea).
 * Es Script Task (y no Execute SQL) porque la lista puede superar los 4.000 caracteres que admite un
 * par�metro OLE DB NVARCHAR.
 * FilasQc = filas de ese archivo que quedaron Pendientes en las 3 Qc en esta corrida.
 * Un archivo "Rechazado" queda registrado con su hash: no se reintenta hasta que el �rea lo corrija
 * (cambia el hash). En la rama sin cambios no hay nada que registrar.
 *
 * ReadOnlyVariables : User::EtlArchivosLista, User::CtlExecutionID, $Package::CtlProcessID, $Project::vSQLConnDw
 * ReadWriteVariables: (ninguna)
 *
 * Desarrollador: Franco V�liz (Agente V4W) � 2026-11-08 � C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Data;
using System.Data.SqlClient;
using System.Globalization;
#endregion

namespace ST_6ca334491815411ea66ca52503f634d2
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private const string SqlInsert = @"
INSERT INTO dbo.V4WBaseArchivoCargado
       (ProcessID, Archivo, Ruta, FechaCorte, FechaModificacion, TamanoBytes, HashArchivo,
        ExecutionID, Estado, FilasCargadas, FilasQc, FilasGestion, FilasAvance, FilasStock, Aviso)
VALUES (@ProcessID, @Archivo, @Ruta, @FechaCorte, @FechaMod, @Tamano, CONVERT(binary(32), @HashHex, 2),
        @ExecutionID, @Estado, @FilasCargadas,
        (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcQuickReport WHERE Archivo = @Archivo AND ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente'),
        NULL, NULL, NULL, NULLIF(@Aviso, N''));";

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                string lista = Convert.ToString(Dts.Variables["User::EtlArchivosLista"].Value);
                long execId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                int processId = Convert.ToInt32(Dts.Variables["$Package::CtlProcessID"].Value);
                string connDw = Convert.ToString(Dts.Variables["$Project::vSQLConnDw"].Value);
                int n = 0;

                using (var cn = new SqlConnection(connDw))
                {
                    cn.Open();
                    foreach (string linea in lista.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))
                    {
                        string[] f = linea.Split('\t');
                        if (f.Length < 11) continue;   // línea sin resultado de ETL02 (no debería ocurrir)
                        int g = int.Parse(f[7]), a = int.Parse(f[8]), s = int.Parse(f[9]);
                        using (var cmd = new SqlCommand(SqlInsert, cn))
                        {
                            cmd.Parameters.Add("@ProcessID", SqlDbType.Int).Value = processId;
                            cmd.Parameters.Add("@Archivo", SqlDbType.NVarChar, 260).Value = f[1];
                            cmd.Parameters.Add("@Ruta", SqlDbType.NVarChar, 400).Value = f[0];
                            cmd.Parameters.Add("@FechaCorte", SqlDbType.Date).Value = DateTime.ParseExact(f[2], "yyyy-MM-dd", CultureInfo.InvariantCulture);
                            cmd.Parameters.Add("@FechaMod", SqlDbType.DateTime2).Value = DateTime.ParseExact(f[3], "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
                            cmd.Parameters.Add("@Tamano", SqlDbType.BigInt).Value = long.Parse(f[4], CultureInfo.InvariantCulture);
                            cmd.Parameters.Add("@HashHex", SqlDbType.VarChar, 64).Value = f[5];
                            cmd.Parameters.Add("@ExecutionID", SqlDbType.BigInt).Value = execId;
                            cmd.Parameters.Add("@Estado", SqlDbType.NVarChar, 20).Value = f[6];
                            cmd.Parameters.Add("@FilasCargadas", SqlDbType.Int).Value = g + a + s;
                            cmd.Parameters.Add("@Aviso", SqlDbType.NVarChar, 1000).Value = f[10] ?? "";
                            cmd.ExecuteNonQuery();
                        }
                        n++;
                    }
                }
                Dts.Events.FireInformation(0, "ETL06RegisterFile", n + " archivo(s) registrados en V4WBaseArchivoCargado", "", 0, ref fireAgain);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "ETL06RegisterFile", ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
