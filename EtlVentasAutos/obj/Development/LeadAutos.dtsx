          SQLTask:SqlStatementSource="/* LeadAutos__ETL05InsertDWHDW_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @N int;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseLead ([Id], [FechaCreacion], [AnioMes], [LeadSource], [SubOrigen], [CodigoModelo], [SalaSalesforceId], [Status], [IsConverted], [GrupoOrigen], [Modelo], [Familia], [RUTID], [SUCURSALID], [MotivoSinInformar], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[Id], s.[FechaCreacion], s.[AnioMes], s.[LeadSource], s.[SubOrigen], s.[CodigoModelo], s.[SalaSalesforceId], s.[Status], s.[IsConverted], s.[GrupoOrigen], s.[Modelo], s.[Familia], s.[RUTID], s.[SUCURSALID], s.[MotivoSinInformar], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadLead AS s WHERE s.ExecutionID = ? AND s.TypeLoad = N'I';&#xA;SET @N = @@ROWCOUNT; SELECT @N AS RowsInsert;&#xA;"
