          SQLTask:SqlStatementSource="/* LeadAutos__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @N int;&#xA;UPDATE tgt SET tgt.[FechaCreacion] = src.[FechaCreacion], tgt.[AnioMes] = src.[AnioMes], tgt.[LeadSource] = src.[LeadSource], tgt.[SubOrigen] = src.[SubOrigen], tgt.[CodigoModelo] = src.[CodigoModelo], tgt.[SalaSalesforceId] = src.[SalaSalesforceId], tgt.[Status] = src.[Status], tgt.[IsConverted] = src.[IsConverted], tgt.[GrupoOrigen] = src.[GrupoOrigen], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[MotivoSinInformar] = src.[MotivoSinInformar], tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseLead AS tgt JOIN HMDCBISA.dbo.V4WLoadLead AS src ON src.Id = tgt.Id&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N = @@ROWCOUNT; SELECT @N AS RowsUpdated;&#xA;"
