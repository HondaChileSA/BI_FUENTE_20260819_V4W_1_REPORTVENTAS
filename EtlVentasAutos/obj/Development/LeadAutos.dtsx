    <DTS:Executable
      DTS:refId="Package\ETL01TruncateStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8AA8516D-6A33-44BC-944F-E678A5708980}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL01TruncateStaging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* LeadAutos__ETL01TruncateStaging_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: ETL01TruncateStaging&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Vacía Stg y Load. El lead no tiene Qc (D-79).&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WStgLead;&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WLoadLead;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL02LoadDWHSA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A16960FD-5566-46FE-A9EC-BA9D4E6EF118}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL02LoadDWHSA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* LeadAutos__ETL02LoadDWHSA_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: ETL02LoadDWHSA&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Copia a Stg los leads de Autos creados desde el corte del KI 103 (hora Chile), sin duplicados: cuenta solo el primer lead de Autos de cada RUT en el mes (D-71). El RUT (RUT__c, consulta 36) se usa SOLO dentro de este SELECT y no llega a ninguna tabla, log ni correo (C-1). Sin datos personales (D-ARQ-39). Mismo servidor (.223): Execute SQL, sin data flow. Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::WmCurrentLoadDate&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Desde date = ?;&#xA;&#xA;;WITH L AS (&#xA;    -- CreatedDate viene en UTC (SFO): se convierte a hora de Chile antes de cortar por día y mes (SOL-016 §2.2)&#xA;    SELECT l.Id,&#xA;           CONVERT(datetime2(0), (l.CreatedDate AT TIME ZONE 'UTC') AT TIME ZONE 'Pacific SA Standard Time') AS FechaChile,&#xA;           LEFT(l.LeadSource, 255) AS LeadSource, LEFT(l.Sub_Origen__c, 255) AS SubOrigen,&#xA;           LEFT(l.Codigo_Modelo__c, 255) AS CodigoModelo, l.Sala_Asignada_Cuenta__c AS SalaSalesforceId,&#xA;           LEFT(l.Status, 255) AS Status, l.IsConverted,&#xA;           NULLIF(UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(LEFT(l.RUT__c, 20))), N'.', N''), N'-', N''), N' ', N'')), N'') AS RutClave&#xA;    FROM   HMDCBIDW.dbo.SFOBaseLead AS l&#xA;    WHERE  ISNULL(l.IsDeleted, 0) = 0&#xA;      AND  l.Linea_producto__c = N'Autos'&#xA;      AND  l.CreatedDate &gt;= DATEADD(DAY, -1, CONVERT(datetime, @Desde))      -- margen por la conversión de zona horaria&#xA;), M AS (&#xA;    SELECT L.*, DATEFROMPARTS(YEAR(L.FechaChile), MONTH(L.FechaChile), 1) AS AnioMes&#xA;    FROM   L&#xA;    WHERE  L.FechaChile &gt;= @Desde&#xA;), D AS (&#xA;    SELECT M.*, ROW_NUMBER() OVER (PARTITION BY M.RutClave, M.AnioMes ORDER BY M.FechaChile, M.Id) AS RnRut&#xA;    FROM   M&#xA;)&#xA;INSERT INTO HMDCBISA.dbo.V4WStgLead (ExecutionID, RowNumber, [Id], [FechaCreacion], [AnioMes], [LeadSource], [SubOrigen], [CodigoModelo], [SalaSalesforceId], [Status], [IsConverted])&#xA;SELECT @ExecutionID, CONVERT(int, ROW_NUMBER() OVER (ORDER BY D.FechaChile, D.Id)),&#xA;       D.Id, D.FechaChile, D.AnioMes, D.LeadSource, D.SubOrigen, D.CodigoModelo, D.SalaSalesforceId, D.Status, D.IsConverted&#xA;FROM   D&#xA;WHERE  D.RutClave IS NULL OR D.RnRut = 1;      -- lead sin RUT = no duplicado&#xA;SELECT @@ROWCOUNT AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL04LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B0A5BB36-9111-47F4-B010-332A2F2D7FBA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL04LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* LeadAutos__ETL04LoadDWHDW_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: ETL04LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Resuelve origen, modelo y sala (&quot;Sin informar&quot; si no cruza, D-79) y arma V4WLoad: I / U por hash y D (en Base desde el corte y ya no viene: borrado en Salesforce, pasó a duplicado o cambió de línea). Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::WmCurrentLoadDate&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Desde date = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;IF OBJECT_ID(N'tempdb..#Src') IS NOT NULL DROP TABLE #Src;&#xA;SELECT * INTO #Src FROM HMDCBISA.dbo.V4WStgLead WHERE ExecutionID = @ExecutionID;&#xA;&#xA;-- ── Resolución (ETL04LoadDWHDW) ─────────────────────────────────────────────────────────────&#xA;-- Origen (D-78): Concesionario → Traffic · Renovación → Database · Web Honda: Facebook → Meta,&#xA;--                Honda Campaign → Honda Campaign, otro sub-origen o vacío → Website · otro origen → Sin informar.&#xA;-- Modelo (D-67): Codigo_Modelo__c → V4WBaseModeloGrupo (código de artículo) → Modelo y Familia.&#xA;-- Sala (D-86): Sala_Asignada_Cuenta__c → DICBaseDealerCuentaSalesforce (ACTIVO = 1), primero como cuenta sala&#xA;--              (SUCURSALID → DICBaseDealerBranch → dealer); si no, como cuenta dealer (dealer conocido, sala nula).&#xA;-- Lo que no cruza NO se separa (D-79, D-ARQ-56): queda &quot;Sin informar&quot; con MotivoSinInformar&#xA;-- (ORIGEN_SIN_GRUPO, CODIGO_FUERA_MAESTRO, SALA_SIN_ALIAS; combinables).&#xA;IF OBJECT_ID(N'tempdb..#CtaSala')   IS NOT NULL DROP TABLE #CtaSala;&#xA;IF OBJECT_ID(N'tempdb..#CtaDealer') IS NOT NULL DROP TABLE #CtaDealer;&#xA;IF OBJECT_ID(N'tempdb..#Grupo')     IS NOT NULL DROP TABLE #Grupo;&#xA;IF OBJECT_ID(N'tempdb..#Res')       IS NOT NULL DROP TABLE #Res;&#xA;&#xA;SELECT cs.SALESFORCEID, cs.SUCURSALID, LTRIM(RTRIM(b.RUTID)) AS RUTID&#xA;INTO   #CtaSala&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerCuentaSalesforce AS cs&#xA;JOIN   HMDCBIDW.dbo.DICBaseDealerBranch           AS b ON b.SUCURSALID = cs.SUCURSALID&#xA;WHERE  cs.ACTIVO = 1 AND cs.SUCURSALID IS NOT NULL;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CtaSala ON #CtaSala (SALESFORCEID);&#xA;&#xA;SELECT cs.SALESFORCEID, LTRIM(RTRIM(cs.RUTID)) AS RUTID&#xA;INTO   #CtaDealer&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerCuentaSalesforce AS cs&#xA;WHERE  cs.ACTIVO = 1 AND cs.SUCURSALID IS NULL;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_CtaDealer ON #CtaDealer (SALESFORCEID);&#xA;&#xA;SELECT x.Codigo, x.Modelo, x.Familia&#xA;INTO   #Grupo&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(g.CodigoArticulo))) AS Codigo, g.Modelo, g.Familia,&#xA;             ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(g.CodigoArticulo))) ORDER BY g.ModeloGrupoID) AS Rn&#xA;      FROM HMDCBIDW.dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1) AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Grupo ON #Grupo (Codigo);&#xA;&#xA;SELECT s.Id, s.RowNumber, o.GrupoOrigen, g.Modelo, g.Familia,&#xA;       COALESCE(sa.RUTID, de.RUTID) AS RUTID, sa.SUCURSALID,&#xA;       NULLIF(CONCAT_WS(N' + ',&#xA;              CASE WHEN o.GrupoOrigen = N'Sin informar' THEN N'ORIGEN_SIN_GRUPO' END,&#xA;              CASE WHEN g.Codigo IS NULL THEN N'CODIGO_FUERA_MAESTRO' END,&#xA;              CASE WHEN sa.SUCURSALID IS NULL THEN N'SALA_SIN_ALIAS' END), N'') AS MotivoSinInformar&#xA;INTO   #Res&#xA;FROM   #Src AS s&#xA;CROSS APPLY (SELECT CASE&#xA;                 WHEN s.LeadSource = N'Concesionario'                                    THEN N'Traffic'&#xA;                 WHEN s.LeadSource LIKE N'Renovaci_n'                                    THEN N'Database'&#xA;                 WHEN s.LeadSource = N'Web Honda' AND s.SubOrigen = N'Facebook'          THEN N'Meta'&#xA;                 WHEN s.LeadSource = N'Web Honda' AND s.SubOrigen = N'Honda Campaign'    THEN N'Honda Campaign'&#xA;                 WHEN s.LeadSource = N'Web Honda'                                        THEN N'Website'&#xA;                 ELSE N'Sin informar' END AS GrupoOrigen) AS o&#xA;LEFT JOIN #Grupo     AS g  ON g.Codigo = UPPER(LTRIM(RTRIM(s.CodigoModelo)))&#xA;LEFT JOIN #CtaSala   AS sa ON sa.SALESFORCEID = s.SalaSalesforceId&#xA;LEFT JOIN #CtaDealer AS de ON de.SALESFORCEID = s.SalaSalesforceId;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Res ON #Res (Id);&#xA;-- ── fin resolución ─────────────────────────────────────────────────────────────────────────&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadLead ([Id], [FechaCreacion], [AnioMes], [LeadSource], [SubOrigen], [CodigoModelo], [SalaSalesforceId], [Status], [IsConverted], [GrupoOrigen], [Modelo], [Familia], [RUTID], [SUCURSALID], [MotivoSinInformar], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Id], s.[FechaCreacion], s.[AnioMes], s.[LeadSource], s.[SubOrigen], s.[CodigoModelo], s.[SalaSalesforceId], s.[Status], s.[IsConverted], s.[GrupoOrigen], s.[Modelo], s.[Familia], s.[RUTID], s.[SUCURSALID], s.[MotivoSinInformar], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.Id IS NULL THEN NULL ELSE SYSDATETIME() END, CASE WHEN b.Id IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[GrupoOrigen], r.[Modelo], r.[Familia], r.[RUTID], r.[SUCURSALID], r.[MotivoSinInformar] FROM #Src x JOIN #Res r ON r.Id = x.Id) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(400), s.[Id]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[FechaCreacion]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[AnioMes]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[LeadSource]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SubOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[CodigoModelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SalaSalesforceId]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Status]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[IsConverted]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[GrupoOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Familia]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[MotivoSinInformar]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseLead AS b ON b.Id = s.Id&#xA;WHERE  b.Id IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadLead ([Id], [FechaCreacion], [AnioMes], [LeadSource], [SubOrigen], [CodigoModelo], [SalaSalesforceId], [Status], [IsConverted], [GrupoOrigen], [Modelo], [Familia], [RUTID], [SUCURSALID], [MotivoSinInformar], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT b.[Id], b.[FechaCreacion], b.[AnioMes], b.[LeadSource], b.[SubOrigen], b.[CodigoModelo], b.[SalaSalesforceId], b.[Status], b.[IsConverted], b.[GrupoOrigen], b.[Modelo], b.[Familia], b.[RUTID], b.[SUCURSALID], b.[MotivoSinInformar], b.Hash64, b.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseLead AS b&#xA;WHERE  b.AnioMes &gt;= DATEFROMPARTS(YEAR(@Desde), MONTH(@Desde), 1) AND NOT EXISTS (SELECT 1 FROM #Src s WHERE s.Id = b.Id);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM #Src) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
