    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1818DC8F-8033-439D-8F30-68AAA533F134}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* LeadAutos__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U (antes y después) y D (antes). Sin datos personales: Base no los tiene.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseLead AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadLead AS src ON src.Id = tgt.Id&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C873B6FA-EC3D-424A-9A61-9E5CC5364BC1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* LeadAutos__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría I.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'I', NULL, (SELECT src.[Id], src.[FechaCreacion], src.[AnioMes], src.[LeadSource], src.[SubOrigen], src.[CodigoModelo], src.[SalaSalesforceId], src.[Status], src.[IsConverted], src.[GrupoOrigen], src.[Modelo], src.[Familia], src.[RUTID], src.[SUCURSALID], src.[MotivoSinInformar], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadLead AS src&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F4193F43-BCAB-4F7E-AE3C-09EDA2E4246E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* LeadAutos__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote. FailedRows = 0 (el lead no tiene Qc, D-79); los &quot;Sin informar&quot; de esta ejecución por motivo y las borradas van en Notes. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::EtlRowsDeleted · 5) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @SinInf nvarchar(300) =&#xA;    (SELECT N'Sin informar (I/U): ' + CONVERT(nvarchar(20), COUNT(*))&#xA;          + N' · origen ' + CONVERT(nvarchar(20), SUM(CASE WHEN MotivoSinInformar LIKE N'%ORIGEN_SIN_GRUPO%' THEN 1 ELSE 0 END))&#xA;          + N' · modelo ' + CONVERT(nvarchar(20), SUM(CASE WHEN MotivoSinInformar LIKE N'%CODIGO_FUERA_MAESTRO%' THEN 1 ELSE 0 END))&#xA;          + N' · sala '   + CONVERT(nvarchar(20), SUM(CASE WHEN MotivoSinInformar LIKE N'%SALA_SIN_ALIAS%' THEN 1 ELSE 0 END))&#xA;     FROM HMDCBISA.dbo.V4WLoadLead&#xA;     WHERE ExecutionID = @ExecutionID AND TypeLoad IN (N'I', N'U') AND MotivoSinInformar IS NOT NULL&#xA;     HAVING COUNT(*) &gt; 0);&#xA;UPDATE dbo.CTLAuditBatch SET UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = 0,&#xA;       Notes = NULLIF(CONCAT_WS(N' · ', @SinInf, CASE WHEN @Del &gt; 0 THEN N'Filas borradas de Base (TypeLoad D): ' + CONVERT(nvarchar(20), @Del) END), N'')&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT 0 AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="4" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{2BF9835A-6B1A-4865-9EC4-96B3965DD17A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* LeadAutos__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : LeadAutos (EtlVentasAutos, ProcessID 45) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-65, D-71, D-78, D-79, D-86, C-1, D-ARQ-56&#xA;   Generado: etapas/V1/herramientas/generar_sql_leadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Corte fijo del KI 103: devuelve el mismo LastLoadDate + 1 día (CTL10 resta uno). NewLastID = último lead cargado (fecha de creación).&#xA;   Parámetros (OLE DB, en orden): 1) User::WmCurrentLoadDate&#xA;*/&#xA;DECLARE @Actual date = ?;&#xA;SELECT DATEADD(DAY, 1, @Actual) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(FechaCreacion) FROM HMDCBIDW.dbo.V4WBaseLead), 120), N'') AS NewLastID;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
