        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__ETL05InsertDWHDW_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I de la entidad. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseMetaLead ([Archivo], [MesMeta], [FechaCorte], [Hoja], [FilaOrigen], [Nivel], [SalaArea], [SucursalArea], [FamiliaArea], [ModeloArea], [GrupoOrigen], [Meta], [RUTID], [SUCURSALID], [Modelo], [Familia], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[Archivo], s.[MesMeta], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[Nivel], s.[SalaArea], s.[SucursalArea], s.[FamiliaArea], s.[ModeloArea], s.[GrupoOrigen], s.[Meta], s.[RUTID], s.[SUCURSALID], s.[Modelo], s.[Familia], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadMetaLead AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsInsert;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
