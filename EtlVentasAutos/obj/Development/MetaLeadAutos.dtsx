      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo (archivos por hash): conserva el corte del KI 103 (CTL10 resta un día) y deja el último mes de meta cargado.&#xA;   Parámetros (OLE DB, en orden): 1) User::WmCurrentLoadDate&#xA;*/&#xA;DECLARE @Actual date = ?;&#xA;SELECT DATEADD(DAY, 1, @Actual) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(MesMeta) FROM HMDCBIDW.dbo.V4WBaseMetaLead), 23), N'') AS NewLastID;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
