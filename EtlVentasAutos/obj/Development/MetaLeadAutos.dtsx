    <DTS:Executable
      DTS:refId="Package\ETL08ReevaluateQc"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CE2A41EF-20E5-470D-BD86-F0DAE6C372CC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL08ReevaluateQc"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* QuickReport__ETL08ReevaluateQc_v1.0.sql&#xA;   Paquete : QuickReport (EtlVentasAutos, ProcessID 37) · Tarea: ETL08ReevaluateQc&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v7 · D-16, D-22, D-30, D-33, D-34, D-37, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_quickreport.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Corre en las dos ramas: re-evalúa TODA la Qc pendiente de la entidad contra los maestros actuales (por ejemplo, un alias creado hoy). Lo que ya no falla pasa a Base y queda Resuelto, sin recargar el archivo.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;&#xA;-- ── Maestros (DIC ORIGEN 'Autos' y 'Sales force'; modelos V4W) ──────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#AliasAutos') IS NOT NULL DROP TABLE #AliasAutos;&#xA;IF OBJECT_ID(N'tempdb..#SalaUnica')  IS NOT NULL DROP TABLE #SalaUnica;&#xA;IF OBJECT_ID(N'tempdb..#ModAlias')   IS NOT NULL DROP TABLE #ModAlias;&#xA;IF OBJECT_ID(N'tempdb..#Vin')        IS NOT NULL DROP TABLE #Vin;&#xA;&#xA;-- Alias del área: texto → dealer (por sociedad o directo) y sala si el alias la trae&#xA;SELECT x.Alias, x.RUTID, x.SUCURSALID&#xA;INTO   #AliasAutos&#xA;FROM (&#xA;    SELECT UPPER(LTRIM(RTRIM(al.ALIAS1))) AS Alias,&#xA;           LTRIM(RTRIM(COALESCE(so.RUTID, al.RUTID))) AS RUTID, al.SUCURSALID,&#xA;           ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(al.ALIAS1))) ORDER BY al.ALIASID) AS Rn&#xA;    FROM   HMDCBIDW.dbo.DICBaseDealerAlias AS al&#xA;    LEFT JOIN HMDCBIDW.dbo.DICBaseDealerParentSociety AS so ON so.SOCIEDADID = al.SOCIEDADID AND so.ACTIVO = 1&#xA;    WHERE  al.ORIGEN = N'Autos' AND al.ACTIVO = 1&#xA;) AS x WHERE x.Rn = 1;&#xA;&#xA;-- Dealers de una sola sala de ventas (D-46): una sola sala con alias 'Sales force'&#xA;SELECT LTRIM(RTRIM(b.RUTID)) AS RUTID, MIN(al.SUCURSALID) AS SUCURSALID&#xA;INTO   #SalaUnica&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerAlias  AS al&#xA;JOIN   HMDCBIDW.dbo.DICBaseDealerBranch AS b ON b.SUCURSALID = al.SUCURSALID&#xA;WHERE  al.ORIGEN = N'Sales force' AND al.ACTIVO = 1&#xA;GROUP BY LTRIM(RTRIM(b.RUTID))&#xA;HAVING COUNT(DISTINCT al.SUCURSALID) = 1;&#xA;&#xA;-- Texto de modelo del área → grupo (Modelo o Familia) existente en V4WBaseModeloGrupo&#xA;SELECT UPPER(LTRIM(RTRIM(ma.AliasArea))) AS Alias, ma.NivelGrupo, ma.Grupo,&#xA;       CASE WHEN ma.NivelGrupo = N'Modelo' THEN ma.Grupo END AS Modelo,&#xA;       CASE WHEN ma.NivelGrupo = N'Familia' THEN ma.Grupo&#xA;            ELSE (SELECT TOP (1) g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1 AND g.Modelo = ma.Grupo) END AS Familia,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1&#xA;                         AND ((ma.NivelGrupo = N'Modelo' AND g.Modelo = ma.Grupo) OR (ma.NivelGrupo = N'Familia' AND g.Familia = ma.Grupo)))&#xA;            THEN 1 ELSE 0 END AS EnMaestro&#xA;INTO   #ModAlias&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias AS ma&#xA;WHERE  ma.Activo = 1;&#xA;&#xA;-- VIN de Autos en el maestro de Salesforce&#xA;SELECT x.VIN, x.Codigo&#xA;INTO   #Vin&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;             UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;             ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;      FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;      WHERE v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles') AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Vin ON #Vin (VIN);&#xA;&#xA;-- QuickReport: filas con algún pendiente, una vez por llave (la última vista)&#xA;IF OBJECT_ID(N'tempdb..#SrcQuickReport') IS NOT NULL DROP TABLE #SrcQuickReport;&#xA;SELECT x.* INTO #SrcQuickReport&#xA;FROM (SELECT q.[Archivo], q.[VersionQuick], q.[MesQuick], q.[FechaCorte], q.[Hoja], q.[FilaOrigen], q.[DealerArea], q.[Unidades], q.RowNumber, ROW_NUMBER() OVER (PARTITION BY q.[Archivo], q.[FilaOrigen] ORDER BY q.FechaUltimaVez DESC, q.QcID DESC) AS Rn&#xA;      FROM HMDCBISA.dbo.V4WQcQuickReport q WHERE q.EstadoQc = N'Pendiente') AS x&#xA;WHERE x.Rn = 1;&#xA;-- ── Resolución QuickReport sobre #SrcQuickReport → #ResQuickReport y #FallaQuickReport ──&#xA;-- Dealer del área (bloque &quot;To be reported&quot;) → alias ORIGEN 'Autos' → dealer (por sociedad o directo) y su sala:&#xA;-- la del alias, o la sala única del dealer (D-46). Dealer de varias salas sin alias de sala → Qc (D-16).&#xA;IF OBJECT_ID(N'tempdb..#ResQuickReport')   IS NOT NULL DROP TABLE #ResQuickReport;&#xA;IF OBJECT_ID(N'tempdb..#FallaQuickReport') IS NOT NULL DROP TABLE #FallaQuickReport;&#xA;SELECT s.[Archivo], s.[FilaOrigen], s.RowNumber, a.RUTID, COALESCE(a.SUCURSALID, su.SUCURSALID) AS SUCURSALID,&#xA;       CASE WHEN a.Alias IS NULL THEN 0 ELSE 1 END AS TieneAlias, s.DealerArea&#xA;INTO   #ResQuickReport&#xA;FROM   #SrcQuickReport AS s&#xA;LEFT JOIN #AliasAutos AS a  ON a.Alias = UPPER(LTRIM(RTRIM(s.DealerArea)))&#xA;LEFT JOIN #SalaUnica  AS su ON su.RUTID = a.RUTID;&#xA;&#xA;SELECT r.[Archivo], r.[FilaOrigen], r.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaQuickReport&#xA;FROM   #ResQuickReport AS r&#xA;CROSS APPLY (&#xA;    SELECT N'DEALER_SIN_ALIAS', N'Dealer &quot;' + ISNULL(r.DealerArea, N'(vacío)') + N'&quot; sin alias ORIGEN Autos en DIC'&#xA;    WHERE r.TieneAlias = 0&#xA;    UNION ALL&#xA;    SELECT N'SALA_SIN_ALIAS', N'&quot;' + r.DealerArea + N'&quot; tiene alias de dealer, no de sala, y el dealer tiene varias salas'&#xA;    WHERE r.TieneAlias = 1 AND r.SUCURSALID IS NULL&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;BEGIN TRANSACTION;&#xA;-- Pasan las llaves que ya no tienen ninguna falla&#xA;MERGE HMDCBIDW.dbo.V4WBaseQuickReport AS tgt&#xA;USING (SELECT x2.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), x2.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[VersionQuick]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[MesQuick]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[DealerArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Unidades]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[SUCURSALID]), N''))), 1, 8)) AS HashNuevo&#xA;       FROM #SrcQuickReport x JOIN #ResQuickReport r ON r.[Archivo] = x.[Archivo] AND r.[FilaOrigen] = x.[FilaOrigen]&#xA;       CROSS APPLY (SELECT x.[Archivo], x.[VersionQuick], x.[MesQuick], x.[FechaCorte], x.[Hoja], x.[FilaOrigen], x.[DealerArea], x.[Unidades], r.[RUTID], r.[SUCURSALID]) AS x2 ([Archivo], [VersionQuick], [MesQuick], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [Unidades], [RUTID], [SUCURSALID])&#xA;       WHERE NOT EXISTS (SELECT 1 FROM #FallaQuickReport f WHERE f.[Archivo] = x.[Archivo] AND f.[FilaOrigen] = x.[FilaOrigen])) AS src&#xA;   ON tgt.[Archivo] = src.[Archivo] AND tgt.[FilaOrigen] = src.[FilaOrigen]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[VersionQuick] = src.[VersionQuick], tgt.[MesQuick] = src.[MesQuick], tgt.[FechaCorte] = src.[FechaCorte], tgt.[Hoja] = src.[Hoja], tgt.[DealerArea] = src.[DealerArea], tgt.[Unidades] = src.[Unidades], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.Hash64 = src.HashNuevo,&#xA;                tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([Archivo], [VersionQuick], [MesQuick], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [Unidades], [RUTID], [SUCURSALID], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[Archivo], src.[VersionQuick], src.[MesQuick], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[DealerArea], src.[Unidades], src.[RUTID], src.[SUCURSALID], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q SET q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcQuickReport AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FallaQuickReport f WHERE f.[Archivo] = q.[Archivo] AND f.[FilaOrigen] = q.[FilaOrigen] AND f.MotivoFalla = q.MotivoFalla);&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT 0 AS RowsReevaluadas;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsReevaluadas"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
