      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U de la entidad. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;UPDATE tgt SET tgt.[MesMeta] = src.[MesMeta], tgt.[FechaCorte] = src.[FechaCorte], tgt.[Nivel] = src.[Nivel], tgt.[SalaArea] = src.[SalaArea], tgt.[SucursalArea] = src.[SucursalArea], tgt.[FamiliaArea] = src.[FamiliaArea], tgt.[ModeloArea] = src.[ModeloArea], tgt.[Meta] = src.[Meta], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseMetaLead AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadMetaLead AS src ON src.[Archivo] = tgt.[Archivo] AND src.[Hoja] = tgt.[Hoja] AND src.[FilaOrigen] = tgt.[FilaOrigen] AND src.[GrupoOrigen] = tgt.[GrupoOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsUpdated;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
