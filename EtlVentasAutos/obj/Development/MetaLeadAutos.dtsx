          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL02LoadDWHSA — V4W · MetaLeadAutos (ProcessID 44) · Script Task · v1.0 (base: ETL02 de QuickReport v1.1)
 *
 * Lee los "Meta Lead 4W <Mes> AAAA.xlsx" que dejó ETL00aCheckFile en User::EtlArchivosLista (nuevos o
 * modificados, KI 103) y carga V4WStgMetaLead (HMDCBISA), UNA FILA POR CELDA con meta (modelo × origen):
 *   - Hoja "TTL"                → Nivel 'TTL', sin sala (meta global).
 *   - Cada hoja de dealer       → Nivel 'Sala', un bloque por sala. El bloque empieza en la fila de encabezado
 *                                 "Familia | Modelo | <orígenes> | Total"; el título (columna A) y el SUCURSALID
 *                                 (columna J) están en la fila de arriba. El SUCURSALID manda (D-66); el título es
 *                                 solo referencia. Termina en la fila "Total" (máx. 20 filas).
 *   - "Instrucciones" y "Control" no se leen.
 * Orígenes por encabezado (no por posición): Traffic, Database, Website, Meta y Honda Campaign. La errata del
 * archivo "Honda Campaing" se guarda como "Honda Campaign" (P-8, SOL-016). La columna Total no se lee.
 * D-34: celdas vacías o en 0 no se cargan. Un texto en una celda de meta se omite y se avisa.
 * Validación de archivo (→ Rechazado, no detiene a los demás):
 *   - falta la hoja TTL o su encabezado;
 *   - el mes de TTL!B3 (AAAA-MM) no coincide con el mes del nombre del archivo.
 * Avisos (no rechazan): hoja de dealer con otro mes en B3; celdas con texto; diferencia TTL − suma de salas
 * por origen (puede haber meta no asignada a sala, plan v8 §8.5).
 * MesMeta = mes del nombre (campo FechaCorte de la lista). FechaCorte = fecha de modificación del archivo.
 * Excel por OLE DB ACE 12.0 (HDR=NO, IMEX=1), rango acotado A1:K400 por hoja.
 * Reescribe User::EtlArchivosLista agregando: Estado, FilasMeta, 0, 0, Aviso (mismo formato que 36 y 37).
 *
 * ReadOnlyVariables : User::CtlExecutionID, $Project::vSQLConnStr
 * ReadWriteVariables: User::EtlArchivosLista
 *
 * Desarrollador: Franco Véliz (Agente V4W) · 2026-11-11 · C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text.RegularExpressions;
#endregion

namespace ST_ece9a6b9ab81467a994c3c863fb40de6
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private const string Componente = "ETL02LoadDWHSA";
        private const string Rango = "A1:K400";
        private const int ColSucursal = 9;          // columna J (0-based)
        private const int MaxFilasBloque = 20;
        private static readonly string[] HojasOmitidas = { "Instrucciones", "Control" };
        private int _row;

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                long execId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                string connStg = Convert.ToString(Dts.Variables["$Project::vSQLConnStr"].Value);
                string lista = Convert.ToString(Dts.Variables["User::EtlArchivosLista"].Value);
                var salida = new List<string>();

                foreach (string linea in lista.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    string[] f = linea.Split('\t');
                    string ruta = f[0], archivo = f[1];
                    DateTime mes = DateTime.ParseExact(f[2], "yyyy-MM-dd", CultureInfo.InvariantCulture);
                    DateTime corte = DateTime.ParseExact(f[3], "yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture).Date;
                    string estado = "Cargado";
                    var avisos = new List<string>();
                    var t = Nueva();
                    try
                    {
                        using (var cn = new OleDbConnection("Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + ruta +
                                                            ";Extended Properties='Excel 12.0 Xml;HDR=NO;IMEX=1';"))
                        {
                            cn.Open();
                            List<string> hojas = Hojas(cn);
                            string hojaTtl = hojas.FirstOrDefault(h => string.Equals(h, "TTL", StringComparison.OrdinalIgnoreCase));
                            if (hojaTtl == null) throw new Exception("ESTRUCTURA: no hay hoja 'TTL'");

                            var ttlPorOrigen = new Dictionary<string, decimal>(StringComparer.Ordinal);
                            var salaPorOrigen = new Dictionary<string, decimal>(StringComparer.Ordinal);

                            // 1. TTL: valida el mes y carga la meta global
                            DataTable dtTtl = Leer(cn, hojaTtl);
                            DateTime? mesTtl = MesCelda(dtTtl, 2, 1);   // B3
                            if (mesTtl == null)
                                throw new Exception("MES_INVALIDO: la celda TTL!B3 no trae un mes AAAA-MM");
                            if (mesTtl.Value != mes)
                                throw new Exception(string.Format("MES_DISTINTO: TTL!B3 dice {0:yyyy-MM} y el nombre del archivo {1:yyyy-MM}", mesTtl.Value, mes));
                            int bloquesTtl = LeerBloques(dtTtl, hojaTtl, "TTL", execId, archivo, mes, corte, t, ttlPorOrigen, avisos);
                            if (bloquesTtl == 0) throw new Exception("ESTRUCTURA: la hoja TTL no tiene el encabezado 'Familia | Modelo | orígenes'");

                            // 2. Hojas de dealer: un bloque por sala
                            foreach (string hoja in hojas)
                            {
                                if (string.Equals(hoja, hojaTtl, StringComparison.OrdinalIgnoreCase)) continue;
                                if (HojasOmitidas.Any(h => string.Equals(h, hoja, StringComparison.OrdinalIgnoreCase))) continue;
                                DataTable dt = Leer(cn, hoja);
                                DateTime? mesHoja = MesCelda(dt, 2, 1);
                                if (mesHoja != null && mesHoja.Value != mes)
                                    avisos.Add(string.Format("hoja '{0}' dice {1:yyyy-MM} en B3 (se usa {2:yyyy-MM})", hoja, mesHoja.Value, mes));
                                LeerBloques(dt, hoja, "Sala", execId, archivo, mes, corte, t, salaPorOrigen, avisos);
                            }

                            // 3. Aviso TTL − salas por origen (no es error)
                            var dif = ttlPorOrigen.Keys.Union(salaPorOrigen.Keys)
                                .Select(o => new { o, d = Get(ttlPorOrigen, o) - Get(salaPorOrigen, o) })
                                .Where(x => x.d != 0).Select(x => x.o + " " + x.d.ToString("0.##", CultureInfo.InvariantCulture)).ToList();
                            if (dif.Count > 0) avisos.Add("TTL − salas: " + string.Join(", ", dif));
                        }
                        Bulk(connStg, t);
                    }
                    catch (Exception exA)
                    {
                        estado = "Rechazado"; avisos.Clear(); avisos.Add(exA.Message);
                        Dts.Events.FireWarning(0, Componente, archivo + ": " + exA.Message, "", 0);
                    }
                    string aviso = string.Join(" · ", avisos);
                    if (aviso.Length > 900) aviso = aviso.Substring(0, 900) + "…";
                    aviso = aviso.Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
                    int filas = estado == "Cargado" ? t.Rows.Count : 0;
                    salida.Add(string.Join("\t", f.Take(6).Concat(new[] { estado, filas.ToString(), "0", "0", aviso })));
                    Dts.Events.FireInformation(0, Componente, string.Format("{0} · {1:yyyy-MM} · {2} · metas {3}{4}",
                        archivo, mes, estado, filas, aviso == "" ? "" : " · " + aviso), "", 0, ref fireAgain);
                }
                Dts.Variables["User::EtlArchivosLista"].Value = string.Join("\n", salida);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Componente, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // Recorre la hoja buscando encabezados "Familia | Modelo". Devuelve cuántos bloques encontró.
        private int LeerBloques(DataTable dt, string hoja, string nivel, long execId, string archivo, DateTime mes, DateTime corte,
                                DataTable t, Dictionary<string, decimal> acumulado, List<string> avisos)
        {
            int bloques = 0, textos = 0;
            for (int h = 0; h < dt.Rows.Count; h++)
            {
                if (!Igual(Txt(dt, h, 0), "Familia") || !Igual(Txt(dt, h, 1), "Modelo")) continue;
                bloques++;
                // Columnas de origen por su encabezado
                var cols = new List<KeyValuePair<int, string>>();
                for (int c = 2; c < dt.Columns.Count; c++)
                {
                    string o = Origen(Txt(dt, h, c));
                    if (o != null) cols.Add(new KeyValuePair<int, string>(c, o));
                }
                if (cols.Count == 0) continue;
                string titulo = nivel == "TTL" ? "TOTAL HMDC" : Txt(dt, h - 1, 0);
                int? sucursal = nivel == "TTL" ? (int?)null : Entero(Txt(dt, h - 1, ColSucursal));

                for (int r = h + 1; r < dt.Rows.Count && r <= h + MaxFilasBloque; r++)
                {
                    string familia = Txt(dt, r, 0), modelo = Txt(dt, r, 1);
                    if (Igual(modelo, "Total") || (familia == "" && modelo == "")) break;
                    if (modelo == "") continue;
                    foreach (var oc in cols)
                    {
                        string raw = Txt(dt, r, oc.Key);
                        if (raw == "") continue;
                        decimal v;
                        if (!Dec(raw, out v)) { textos++; continue; }
                        if (v == 0) continue;   // D-34
                        t.Rows.Add(execId, ++_row, Cut(archivo, 260), mes, corte, Cut(hoja, 100), r + 1, nivel,
                                   Cut(titulo, 150), (object)sucursal ?? DBNull.Value, Cut(familia, 100), Cut(modelo, 100),
                                   oc.Value, Math.Round(v, 4));
                        decimal acc; acumulado.TryGetValue(oc.Value, out acc); acumulado[oc.Value] = acc + v;
                    }
                }
            }
            if (textos > 0) avisos.Add(string.Format("hoja '{0}': {1} celda(s) de meta con texto (se omiten)", hoja, textos));
            return bloques;
        }

        // Encabezado del archivo → grupo de origen guardado (D-78). La errata "Honda Campaing" se corrige (P-8).
        private static string Origen(string encabezado)
        {
            string e = Regex.Replace(encabezado.ToLowerInvariant(), @"\s+", " ").Trim();
            switch (e)
            {
                case "traffic": return "Traffic";
                case "database": return "Database";
                case "website": return "Website";
                case "meta": return "Meta";
                case "honda campaing":
                case "honda campaign": return "Honda Campaign";
                default: return null;
            }
        }

        // Mes de una celda: fecha de Excel o texto "AAAA-MM" / "AAAA-M".
        private static DateTime? MesCelda(DataTable dt, int r, int c)
        {
            if (r >= dt.Rows.Count || c >= dt.Columns.Count || dt.Rows[r].IsNull(c)) return null;
            object v = dt.Rows[r][c];
            if (v is DateTime) { var d = (DateTime)v; return new DateTime(d.Year, d.Month, 1); }
            var m = Regex.Match(Convert.ToString(v, CultureInfo.InvariantCulture).Trim(), @"^(20\d{2})[-/](\d{1,2})");
            if (!m.Success) return null;
            int mm = int.Parse(m.Groups[2].Value);
            if (mm < 1 || mm > 12) return null;
            return new DateTime(int.Parse(m.Groups[1].Value), mm, 1);
        }

        private static DataTable Leer(OleDbConnection cn, string hoja)
        {
            var dt = new DataTable();
            using (var da = new OleDbDataAdapter("SELECT * FROM [" + hoja + "$" + Rango + "]", cn)) da.Fill(dt);
            return dt;
        }
        private static decimal Get(Dictionary<string, decimal> d, string k) { decimal v; return d.TryGetValue(k, out v) ? v : 0m; }
        private static bool Igual(string a, string b) { return string.Equals(a, b, StringComparison.OrdinalIgnoreCase); }
        private static string Txt(DataTable dt, int r, int c)
        {
            if (r < 0 || c < 0 || r >= dt.Rows.Count || c >= dt.Columns.Count || dt.Rows[r].IsNull(c)) return "";
            return Convert.ToString(dt.Rows[r][c], CultureInfo.InvariantCulture).Trim();
        }
        private static bool Dec(string s, out decimal d)
        {
            return decimal.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out d) ||
                   decimal.TryParse(s, NumberStyles.Any, CultureInfo.GetCultureInfo("es-CL"), out d);
        }
        private static int? Entero(string s)
        {
            decimal d;
            if (s == "" || !Dec(s, out d) || d != Math.Truncate(d)) return null;
            return (int)d;
        }
        private static List<string> Hojas(OleDbConnection cn)
        {
            var res = new List<string>();
            foreach (DataRow r in cn.GetOleDbSchemaTable(OleDbSchemaGuid.Tables, null).Rows)
            {
                string n = Convert.ToString(r["TABLE_NAME"]).Trim('\'');
                if (n.EndsWith("$")) res.Add(n.Substring(0, n.Length - 1).Replace("''", "'"));
            }
            return res;
        }
        private static string Cut(string s, int n) { return s == null ? null : (s.Length <= n ? s : s.Substring(0, n)); }
        private static DataTable Nueva()
        {
            var t = new DataTable();
            t.Columns.Add("ExecutionID", typeof(long)); t.Columns.Add("RowNumber", typeof(int)); t.Columns.Add("Archivo", typeof(string));
            t.Columns.Add("MesMeta", typeof(DateTime)); t.Columns.Add("FechaCorte", typeof(DateTime)); t.Columns.Add("Hoja", typeof(string));
            t.Columns.Add("FilaOrigen", typeof(int)); t.Columns.Add("Nivel", typeof(string)); t.Columns.Add("SalaArea", typeof(string));
            t.Columns.Add("SucursalArea", typeof(int)); t.Columns.Add("FamiliaArea", typeof(string)); t.Columns.Add("ModeloArea", typeof(string));
            t.Columns.Add("GrupoOrigen", typeof(string)); t.Columns.Add("Meta", typeof(decimal));
            return t;
        }
        private static void Bulk(string connStr, DataTable t)
        {
            if (t.Rows.Count == 0) return;
            using (var cn = new SqlConnection(connStr))
            {
                cn.Open();
                using (var b = new SqlBulkCopy(cn, SqlBulkCopyOptions.CheckConstraints, null))
                {
                    b.DestinationTableName = "dbo.V4WStgMetaLead";
                    foreach (DataColumn c in t.Columns) b.ColumnMappings.Add(c.ColumnName, c.ColumnName);
                    b.WriteToServer(t);
                }
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
