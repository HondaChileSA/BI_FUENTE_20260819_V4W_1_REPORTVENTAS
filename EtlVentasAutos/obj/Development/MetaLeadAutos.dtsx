    <DTS:Executable
      DTS:refId="Package\ETL04LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4DD3D182-E743-4EA6-9310-80B71474F04A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL04LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__ETL04LoadDWHDW_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: ETL04LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma la Load: I / U por hash y D (versión reemplazada: filas en Base de un archivo recargado que ya no vienen o pasaron a Qc). Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;-- ── Maestros (DIC por SUCURSALID; modelos V4W) ─────────────────────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#Sala')     IS NOT NULL DROP TABLE #Sala;&#xA;IF OBJECT_ID(N'tempdb..#ModAlias') IS NOT NULL DROP TABLE #ModAlias;&#xA;&#xA;-- Sala: el archivo trae el SUCURSALID de DIC en la columna J de cada bloque (D-66). Solo salas activas.&#xA;SELECT b.SUCURSALID, LTRIM(RTRIM(b.RUTID)) AS RUTID&#xA;INTO   #Sala&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerBranch AS b&#xA;WHERE  b.ACTIVO = 1;&#xA;&#xA;-- Texto de modelo del archivo → grupo existente en V4WBaseModeloGrupo (mismo alias que la tabla de colores, D-67)&#xA;SELECT UPPER(LTRIM(RTRIM(ma.AliasArea))) AS Alias, ma.NivelGrupo, ma.Grupo,&#xA;       CASE WHEN ma.NivelGrupo = N'Modelo' THEN ma.Grupo END AS Modelo,&#xA;       CASE WHEN ma.NivelGrupo = N'Familia' THEN ma.Grupo&#xA;            ELSE (SELECT TOP (1) g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1 AND g.Modelo = ma.Grupo) END AS Familia,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1&#xA;                         AND ((ma.NivelGrupo = N'Modelo' AND g.Modelo = ma.Grupo) OR (ma.NivelGrupo = N'Familia' AND g.Familia = ma.Grupo)))&#xA;            THEN 1 ELSE 0 END AS EnMaestro&#xA;INTO   #ModAlias&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias AS ma&#xA;WHERE  ma.Activo = 1;&#xA;&#xA;-- Archivos recargados en esta corrida (incluye los que quedaron enteros en Qc)&#xA;IF OBJECT_ID(N'tempdb..#Archivos') IS NOT NULL DROP TABLE #Archivos;&#xA;SELECT Archivo INTO #Archivos FROM HMDCBISA.dbo.V4WStgMetaLead WHERE ExecutionID = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WQcMetaLead WHERE ExecutionIDUltima = @ExecutionID;&#xA;&#xA;IF OBJECT_ID(N'tempdb..#SrcMetaLead') IS NOT NULL DROP TABLE #SrcMetaLead;&#xA;SELECT * INTO #SrcMetaLead FROM HMDCBISA.dbo.V4WStgMetaLead WHERE ExecutionID = @ExecutionID;&#xA;-- ── Resolución MetaLead sobre #SrcMetaLead → #ResMetaLead y #FallaMetaLead ──&#xA;-- Nivel TTL: sin sala. Nivel Sala: SucursalArea (columna J) → DICBaseDealerBranch (activa) → SUCURSALID y su dealer.&#xA;-- Modelo: texto del archivo → V4WBaseModeloAlias → grupo en V4WBaseModeloGrupo. Lo que no cruza → Qc (D-22).&#xA;-- Una misma meta (nivel × sala × modelo × origen) dos veces en el archivo → Qc DUPLICADO (protege el índice único).&#xA;IF OBJECT_ID(N'tempdb..#ResMetaLead')   IS NOT NULL DROP TABLE #ResMetaLead;&#xA;IF OBJECT_ID(N'tempdb..#FallaMetaLead') IS NOT NULL DROP TABLE #FallaMetaLead;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.[GrupoOrigen], s.RowNumber, sa.RUTID, sa.SUCURSALID,&#xA;       m.Modelo, m.Familia,&#xA;       s.Nivel, s.SalaArea, s.SucursalArea, s.ModeloArea,&#xA;       CASE WHEN m.Alias IS NULL THEN 0 ELSE 1 END AS TieneAliasModelo, ISNULL(m.EnMaestro, 0) AS EnMaestro,&#xA;       COUNT(*) OVER (PARTITION BY s.Archivo, s.Nivel, ISNULL(sa.SUCURSALID, 0), m.Modelo, s.GrupoOrigen) AS Veces&#xA;INTO   #ResMetaLead&#xA;FROM   #SrcMetaLead AS s&#xA;LEFT JOIN #Sala     AS sa ON s.Nivel = N'Sala' AND sa.SUCURSALID = s.SucursalArea&#xA;LEFT JOIN #ModAlias AS m  ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)));&#xA;&#xA;SELECT r.[Archivo], r.[Hoja], r.[FilaOrigen], r.[GrupoOrigen], r.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaMetaLead&#xA;FROM   #ResMetaLead AS r&#xA;CROSS APPLY (&#xA;    SELECT N'SUCURSALID_NO_EXISTE',&#xA;           N'Bloque &quot;' + ISNULL(r.SalaArea, N'(sin título)') + N'&quot;: SUCURSALID ' + ISNULL(CONVERT(nvarchar(20), r.SucursalArea), N'(vacío)')&#xA;           + N' no existe o está inactivo en DICBaseDealerBranch'&#xA;    WHERE r.Nivel = N'Sala' AND r.SUCURSALID IS NULL&#xA;    UNION ALL&#xA;    SELECT N'GRUPO_FUERA_MAESTRO',&#xA;           CASE WHEN r.TieneAliasModelo = 0 THEN N'Modelo &quot;' + ISNULL(r.ModeloArea, N'(vacío)') + N'&quot; sin alias en V4WBaseModeloAlias'&#xA;                ELSE N'Modelo &quot;' + r.ModeloArea + N'&quot; apunta a un grupo que no existe en V4WBaseModeloGrupo' END&#xA;    WHERE r.TieneAliasModelo = 0 OR r.EnMaestro = 0&#xA;    UNION ALL&#xA;    SELECT N'DUPLICADO', N'Meta repetida en el archivo: ' + r.Nivel + N' · sala ' + ISNULL(CONVERT(nvarchar(20), r.SUCURSALID), N'TTL')&#xA;           + N' · modelo ' + ISNULL(r.Modelo, N'?') + N' aparece ' + CONVERT(nvarchar(10), r.Veces) + N' veces (bloque copiado)'&#xA;    WHERE r.Veces &gt; 1 AND r.Modelo IS NOT NULL&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;-- MetaLead: I / U por hash (fila + resolución); D = filas en Base de un archivo recargado que ya no vienen&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadMetaLead&#xA;       ([Archivo], [MesMeta], [FechaCorte], [Hoja], [FilaOrigen], [Nivel], [SalaArea], [SucursalArea], [FamiliaArea], [ModeloArea], [GrupoOrigen], [Meta], [RUTID], [SUCURSALID], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Archivo], s.[MesMeta], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[Nivel], s.[SalaArea], s.[SucursalArea], s.[FamiliaArea], s.[ModeloArea], s.[GrupoOrigen], s.[Meta], s.[RUTID], s.[SUCURSALID], s.[Modelo], s.[Familia], h.HashNuevo, ISNULL(bs.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN bs.Archivo IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN bs.Archivo IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[RUTID], r.[SUCURSALID], r.[Modelo], r.[Familia] FROM #SrcMetaLead x JOIN #ResMetaLead r ON r.[Archivo] = x.[Archivo] AND r.[Hoja] = x.[Hoja] AND r.[FilaOrigen] = x.[FilaOrigen] AND r.[GrupoOrigen] = x.[GrupoOrigen]) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[MesMeta]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Nivel]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SalaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SucursalArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FamiliaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[GrupoOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Meta]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Familia]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseMetaLead AS bs ON bs.[Archivo] = s.[Archivo] AND bs.[Hoja] = s.[Hoja] AND bs.[FilaOrigen] = s.[FilaOrigen] AND bs.[GrupoOrigen] = s.[GrupoOrigen]&#xA;WHERE  bs.Archivo IS NULL OR bs.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadMetaLead&#xA;       ([Archivo], [MesMeta], [FechaCorte], [Hoja], [FilaOrigen], [Nivel], [SalaArea], [SucursalArea], [FamiliaArea], [ModeloArea], [GrupoOrigen], [Meta], [RUTID], [SUCURSALID], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT bs.[Archivo], bs.[MesMeta], bs.[FechaCorte], bs.[Hoja], bs.[FilaOrigen], bs.[Nivel], bs.[SalaArea], bs.[SucursalArea], bs.[FamiliaArea], bs.[ModeloArea], bs.[GrupoOrigen], bs.[Meta], bs.[RUTID], bs.[SUCURSALID], bs.[Modelo], bs.[Familia], bs.Hash64, bs.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseMetaLead AS bs&#xA;WHERE  bs.Archivo IN (SELECT Archivo FROM #Archivos)&#xA;  AND  NOT EXISTS (SELECT 1 FROM #SrcMetaLead s WHERE s.[Archivo] = bs.[Archivo] AND s.[Hoja] = bs.[Hoja] AND s.[FilaOrigen] = bs.[FilaOrigen] AND s.[GrupoOrigen] = bs.[GrupoOrigen]);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM #SrcMetaLead) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
