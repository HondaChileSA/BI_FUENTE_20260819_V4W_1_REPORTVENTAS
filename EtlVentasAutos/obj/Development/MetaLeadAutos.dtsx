    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{67AD8BDA-6B41-44FC-A338-91EE553E05A5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U (antes y después) y D (antes) de la entidad, en un solo CTLAuditBatch; el JSON lleva la entidad.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT N'MetaLead' AS Entidad, tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT N'MetaLead' AS Entidad, src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseMetaLead AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadMetaLead AS src ON src.[Archivo] = tgt.[Archivo] AND src.[Hoja] = tgt.[Hoja] AND src.[FilaOrigen] = tgt.[FilaOrigen] AND src.[GrupoOrigen] = tgt.[GrupoOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{67E886B0-4A46-4E72-9CF2-8D4D8B53304D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría I de la entidad (el JSON lleva la entidad).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'I', NULL,&#xA;       (SELECT N'MetaLead' AS Entidad, src.[Archivo], src.[MesMeta], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[Nivel], src.[SalaArea], src.[SucursalArea], src.[FamiliaArea], src.[ModeloArea], src.[GrupoOrigen], src.[Meta], src.[RUTID], src.[SUCURSALID], src.[Modelo], src.[Familia], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadMetaLead AS src&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D2D10BD8-99B4-4BDE-A596-C30CA71C377C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* MetaLeadAutos__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : MetaLeadAutos (EtlVentasAutos, ProcessID 44) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-11 · plan V1 v8.3 · SOL-016 · D-22, D-34, D-67, D-69, D-78, D-80, D-ARQ-40, P-7&#xA;   Generado: etapas/V1/herramientas/generar_sql_metaleadautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote. FailedRows = pendientes vistos en esta corrida en la Qc; borradas en Notes. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::EtlRowsDeleted · 5) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @FailedRows int =&#xA;      (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcMetaLead WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente');&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = @FailedRows,&#xA;       Notes = CASE WHEN @Del &gt; 0 THEN N'Filas borradas de Base (TypeLoad D, versión reemplazada): ' + CONVERT(nvarchar(20), @Del) END&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT @FailedRows AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="4" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
