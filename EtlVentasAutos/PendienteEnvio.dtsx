          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL02LoadDWHSA — V4W · FacturaWholesale (ProcessID 34) · Script Task
 *
 * Lee la vista de facturas del .185 y la copia a HMDCBISA.dbo.V4WStgFacturaWholesale.
 * Conexión al .185 por parámetro de proyecto SENSIBLE con usuario y contraseña SQL
 * ($Project::vSQLConnHMDC), mismo patrón que CTB con CHIe (CTB D-11): no depende de que
 * la cuenta del SQL Agent tenga permisos WT en el .185. El valor se lee con
 * GetSensitiveValue() (con .Value SSIS falla) y nunca se escribe en logs ni correos.
 *
 * Pasos: 1) SELECT al .185 con @Desde = User::WmCurrentLoadDate (corte KI 103)
 *        2) SqlBulkCopy a V4WStgFacturaWholesale (HMDCBISA, $Project::vSQLConnStr, WT)
 *        3) User::CtlRowsRead = filas leídas
 *
 * ReadOnlyVariables : $Project::vSQLConnHMDC, $Project::vSQLConnStr, User::CtlExecutionID, User::WmCurrentLoadDate
 * ReadWriteVariables: User::CtlRowsRead
 *
 * Desarrollador: Franco Véliz (Agente V4W) · v1.0 · 2026-11-06 · C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_2fc95aac9b5f4cf3bf9a987ea710b1ea
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        // ╔══════════════════════════════════════════════════════════════════════╗
        // ║  CONFIG                                                              ║
        // ╚══════════════════════════════════════════════════════════════════════╝
        private static class Config
        {
            public const string ComponentName = "ETL02LoadDWHSA";
            public const string ConnOrigen = "$Project::vSQLConnHMDC";   // SENSIBLE · 10.144.5.185 / HMDCBIDW
            public const string ConnStg = "$Project::vSQLConnStr";      // HMDCBISA (WT)
            public const string TablaStg = "dbo.V4WStgPendienteEnvio";
            public const int TimeoutSeg = 600;

            // Copia vigente de SQL/Tareas/PendienteEnvio__ETL02LoadDWHSA_v1.0.sql
            public const string SqlOrigen = @"
SELECT  CONVERT(int, ROW_NUMBER() OVER (ORDER BY o.Fecha, o.Numero_interno, o.Tipo_Documento, o.Numero_Documento)) AS RowNumber,
        CONVERT(decimal(10,0), o.Numero_interno)                AS NumeroInterno,
        CONVERT(smallint,      o.Tipo_Documento)                AS TipoDocumento,
        CONVERT(int,           o.Numero_Documento)              AS NumeroDocumento,
        CONVERT(nvarchar(25),  LTRIM(RTRIM(o.VIN)))             AS VIN,
        CONVERT(date,          o.Fecha)                         AS FechaFactura
FROM    HMDCBIDW.dbo.View_SEL_PH_REPORTES_VIEWS_UNIDADES_VENTAS_OD AS o
WHERE   o.Linea_producto = 1
  AND   o.VIN IS NOT NULL AND LTRIM(RTRIM(o.VIN)) <> ''
  AND   o.Numero_interno IS NOT NULL AND o.Tipo_Documento IS NOT NULL AND o.Numero_Documento IS NOT NULL;";

            // Columnas que vienen del SELECT (ExecutionID se agrega aquí)
            public static readonly string[] Columnas = new string[]
            {
                "RowNumber", "NumeroInterno", "TipoDocumento", "NumeroDocumento", "VIN", "FechaFactura"
            };
        }

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                long executionId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                string connOrigen = LeerConexionSensible(Config.ConnOrigen);
                string connStg = Convert.ToString(Dts.Variables[Config.ConnStg].Value);

                var dt = new DataTable();
                var t0 = DateTime.Now;
                using (var cn = new SqlConnection(connOrigen))
                using (var cmd = new SqlCommand(Config.SqlOrigen, cn))
                {
                    cmd.CommandTimeout = Config.TimeoutSeg;
                    cn.Open();
                    using (var da = new SqlDataAdapter(cmd)) da.Fill(dt);
                }

                var colExec = new DataColumn("ExecutionID", typeof(long)) { DefaultValue = executionId };
                dt.Columns.Add(colExec);
                foreach (DataRow r in dt.Rows) r["ExecutionID"] = executionId;

                using (var cn = new SqlConnection(connStg))
                {
                    cn.Open();
                    using (var bulk = new SqlBulkCopy(cn, SqlBulkCopyOptions.CheckConstraints, null))
                    {
                        bulk.DestinationTableName = Config.TablaStg;
                        bulk.BulkCopyTimeout = Config.TimeoutSeg;
                        bulk.ColumnMappings.Add("ExecutionID", "ExecutionID");
                        foreach (string c in Config.Columnas) bulk.ColumnMappings.Add(c, c);
                        bulk.WriteToServer(dt);
                    }
                }

                Dts.Events.FireInformation(0, Config.ComponentName,
                    string.Format("Pendientes de envío (Autos) leídos del .185: {0} filas · {1:N0} ms",
                        dt.Rows.Count, (DateTime.Now - t0).TotalMilliseconds), "", 0, ref fireAgain);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                // El mensaje de SqlClient no incluye la contraseña; igual no se escribe la cadena de conexión.
                Dts.Events.FireError(0, Config.ComponentName, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // Lee un Project Parameter SENSIBLE (cadena con usuario y contraseña).
        // SSIS no permite leerlo con .Value: se usa GetSensitiveValue(). Nunca va a logs ni correos.
        private string LeerConexionSensible(string nombreVariable)
        {
            object valor = Dts.Variables[nombreVariable].GetSensitiveValue();
            if (valor == null || string.IsNullOrWhiteSpace(valor.ToString()))
                throw new Exception("El parámetro " + nombreVariable + " no tiene valor asignado.");
            return valor.ToString();
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
