    <DTS:Executable
      DTS:refId="Package\ETL04LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{446C870C-A1F7-4E7E-999F-2401896D8A8C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL04LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* PendienteEnvio__ETL04LoadDWHDW_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: ETL04LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Compara la fotografía de hoy con la historia: I = VIN que aparece por primera vez en bodega; U = sigue en bodega (FechaUltimaVez = hoy; si había sido despachado y reaparece, FechaDespacho vuelve a NULL) o ya no está (FechaDespacho = hoy). Devuelve RowsRead (filas de la fotografía).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Hoy date = CONVERT(date, SYSDATETIME());&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;-- Fotografía de hoy (sin duplicados de la vista)&#xA;IF OBJECT_ID(N'tempdb..#Hoy') IS NOT NULL DROP TABLE #Hoy;&#xA;SELECT x.*&#xA;INTO   #Hoy&#xA;FROM  (SELECT s.*, ROW_NUMBER() OVER (PARTITION BY s.[NumeroInterno], s.[TipoDocumento], s.[NumeroDocumento], s.[VIN] ORDER BY s.RowNumber) AS Rn&#xA;       FROM HMDCBISA.dbo.V4WStgPendienteEnvio AS s WHERE s.ExecutionID = @ExecutionID) AS x&#xA;WHERE  x.Rn = 1;&#xA;&#xA;-- I: primera vez en bodega&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadPendienteEnvio&#xA;       ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [VIN], [FechaFactura], FechaPrimeraVez, FechaUltimaVez, FechaDespacho, HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT h.[NumeroInterno], h.[TipoDocumento], h.[NumeroDocumento], h.[VIN], h.[FechaFactura], @Hoy, @Hoy, NULL, 0, 0, @ExecutionID, @BatchId, h.RowNumber, NULL, N'I'&#xA;FROM   #Hoy AS h&#xA;WHERE  NOT EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBasePendienteEnvio b WHERE b.[NumeroInterno] = h.[NumeroInterno] AND b.[TipoDocumento] = h.[TipoDocumento] AND b.[NumeroDocumento] = h.[NumeroDocumento] AND b.[VIN] = h.[VIN]);&#xA;&#xA;-- U: sigue en bodega (refresca FechaUltimaVez; reabre si había sido despachado)&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadPendienteEnvio&#xA;       ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [VIN], [FechaFactura], FechaPrimeraVez, FechaUltimaVez, FechaDespacho, HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT h.[NumeroInterno], h.[TipoDocumento], h.[NumeroDocumento], h.[VIN], h.[FechaFactura], b.FechaPrimeraVez, @Hoy, NULL, 0, b.Hash64, @ExecutionID, @BatchId, h.RowNumber, SYSDATETIME(), N'U'&#xA;FROM   #Hoy AS h&#xA;JOIN   HMDCBIDW.dbo.V4WBasePendienteEnvio AS b ON b.[NumeroInterno] = h.[NumeroInterno] AND b.[TipoDocumento] = h.[TipoDocumento] AND b.[NumeroDocumento] = h.[NumeroDocumento] AND b.[VIN] = h.[VIN]&#xA;WHERE  b.FechaUltimaVez &lt; @Hoy OR b.FechaDespacho IS NOT NULL;&#xA;&#xA;-- U: ya no está en la vista → despachado hoy&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadPendienteEnvio&#xA;       ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [VIN], [FechaFactura], FechaPrimeraVez, FechaUltimaVez, FechaDespacho, HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT b.[NumeroInterno], b.[TipoDocumento], b.[NumeroDocumento], b.[VIN], b.[FechaFactura], b.FechaPrimeraVez, b.FechaUltimaVez, @Hoy, 0, b.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'U'&#xA;FROM   HMDCBIDW.dbo.V4WBasePendienteEnvio AS b&#xA;WHERE  b.FechaDespacho IS NULL&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Hoy h WHERE h.[NumeroInterno] = b.[NumeroInterno] AND h.[TipoDocumento] = b.[TipoDocumento] AND h.[NumeroDocumento] = b.[NumeroDocumento] AND h.[VIN] = b.[VIN]);&#xA;&#xA;-- Hash de la fila final (documento + VIN + fechas)&#xA;UPDATE l SET l.HashNuevo = CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), l.[NumeroInterno]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[TipoDocumento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[NumeroDocumento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[VIN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[FechaFactura]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[FechaPrimeraVez]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[FechaUltimaVez]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), l.[FechaDespacho]), N''))), 1, 8))&#xA;FROM   HMDCBISA.dbo.V4WLoadPendienteEnvio AS l&#xA;WHERE  l.ExecutionID = @ExecutionID;&#xA;&#xA;SELECT (SELECT COUNT(*) FROM #Hoy) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL05UpdateDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8844241F-B0A1-4EB1-9024-81527F9DDF58}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL05UpdateDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* PendienteEnvio__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U (FechaUltimaVez / FechaDespacho). Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsUpdated int;&#xA;UPDATE tgt&#xA;SET    tgt.FechaFactura = src.FechaFactura, tgt.FechaPrimeraVez = src.FechaPrimeraVez, tgt.FechaUltimaVez = src.FechaUltimaVez,&#xA;       tgt.FechaDespacho = src.FechaDespacho, tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID,&#xA;       tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBasePendienteEnvio AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadPendienteEnvio AS src ON src.[NumeroInterno] = tgt.[NumeroInterno] AND src.[TipoDocumento] = tgt.[TipoDocumento] AND src.[NumeroDocumento] = tgt.[NumeroDocumento] AND src.[VIN] = tgt.[VIN]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U';&#xA;SET @RowsUpdated = @@ROWCOUNT;&#xA;SELECT @RowsUpdated AS RowsUpdated;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
