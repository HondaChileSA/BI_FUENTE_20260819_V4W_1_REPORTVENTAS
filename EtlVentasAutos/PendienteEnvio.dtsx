    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C092BF63-6041-46BB-BD22-397585EBC3E5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* PendienteEnvio__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría de filas que se actualizan (antes y después).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'U',&#xA;       (SELECT tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBasePendienteEnvio AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadPendienteEnvio AS src ON src.[NumeroInterno] = tgt.[NumeroInterno] AND src.[TipoDocumento] = tgt.[TipoDocumento] AND src.[NumeroDocumento] = tgt.[NumeroDocumento] AND src.[VIN] = tgt.[VIN]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1746F5CE-E8B7-41BA-98E2-6022B20A56BD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* PendienteEnvio__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría de filas nuevas.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'I', NULL,&#xA;       (SELECT src.[NumeroInterno], src.[TipoDocumento], src.[NumeroDocumento], src.[VIN], src.[FechaFactura], src.[FechaPrimeraVez], src.[FechaUltimaVez], src.[FechaDespacho], src.ExecutionID, src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadPendienteEnvio AS src&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{537415CF-601D-47B4-A62F-520A71B45721}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* PendienteEnvio__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote de auditoría (sin Qc: FailedRows = 0). Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlRowsUpdated · 2) User::CtlRowsInserted · 3) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @Upd int = ?, @Ins int = ?, @AuditBatchID bigint = ?;&#xA;UPDATE dbo.CTLAuditBatch SET UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = 0 WHERE AuditBatchID = @AuditBatchID;&#xA;SELECT 0 AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{5BB1B1D4-C0A5-4BE9-936B-563C6A08AF9F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* PendienteEnvio__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : PendienteEnvio (EtlVentasAutos, ProcessID 43) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · SOL-011, D-47, D-ARQ-52&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo: fecha de hoy + 1 (CTL10 resta un día) y VIN pendientes ahora.&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;SELECT DATEADD(DAY, 1, CONVERT(date, SYSDATETIME()))                              AS NewLoadDate,&#xA;       CONVERT(nvarchar(50), (SELECT COUNT(*) FROM HMDCBIDW.dbo.V4WBasePendienteEnvio WHERE FechaDespacho IS NULL)) AS NewLastID;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
