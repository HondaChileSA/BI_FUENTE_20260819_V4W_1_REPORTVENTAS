        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="-- ResultSet: None&#xA;UPDATE [dbo].[CTLExecution]&#xA;SET    [EndTime]      = SYSDATETIME(),&#xA;       [Status]       = 'Success',&#xA;       [DurationMs]   = ?,&#xA;       [RowsRead]     = ?,&#xA;       [RowsInserted] = ?,&#xA;       [RowsUpdated]  = ?,&#xA;       [ErrorMessage] = NULL&#xA;WHERE  [ExecutionID] = ?;&#xA;-- Params (Input): CtlDurationMs, CtlRowsRead, CtlRowsInserted, CtlRowsUpdated, CtlExecutionID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
