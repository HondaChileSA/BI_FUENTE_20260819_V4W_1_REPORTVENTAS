    <DTS:Executable
      DTS:refId="Package\ETL01DeleteDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{01EECBAF-5B39-43EA-BF04-E61C29D532B3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL01DeleteDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* ImputacionVin__ETL05DeleteDWHDW_v1.0.sql&#xA;   Paquete : ImputacionVin (EtlVentasAutos, ProcessID 42) · Tarea: ETL05DeleteDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: vacía V4WBaseVinImputacion antes de recalcular todas las fotografías (cálculo determinístico, D-ARQ-52 R-2).&#xA;   Parámetros: ninguno · Resultado: RowsDeleted&#xA;*/&#xA;DECLARE @N int = (SELECT COUNT(*) FROM dbo.V4WBaseVinImputacion);&#xA;TRUNCATE TABLE dbo.V4WBaseVinImputacion;&#xA;SELECT @N AS RowsDeleted;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsDeleted"
            SQLTask:DtsVariableName="User::EtlRowsDeleted" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL02InsertDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B6298615-52EB-497C-91AC-B6122EB946B9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL02InsertDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* ImputacionVin__ETL02InsertDWHDW_v1.6.sql   (v1.6 24-11, ARQ7 E2: salas y dealers del maestro de Autos — alias V4WBaseAliasAutos, nombres V4WBaseSalaAutos, sala única D-95; sin DIC · v1.5 09-11: D-62 sala de Fuente por nombre dentro del dealer; D-63 VIN en el dealer = último documento es factura · v1.4 en _reemplazados/)&#xA;   Paquete : ImputacionVin (EtlVentasAutos, ProcessID 42) · Tarea: ETL02InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · SOL-011, SOL-013, D-39 a D-58, D-ARQ-50, D-ARQ-52&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: recalcula la imputación de VIN a sala de TODAS las fotografías oficiales del KI 103 y la&#xA;             inserta en V4WBaseVinImputacion (antes ETL01DeleteDWHDW vació la tabla). El cálculo es&#xA;             determinístico: mismas fuentes → mismo resultado (asignación estable día a día).&#xA;             Por fotografía oficial (D-48) y dealer:&#xA;               Nivel 1 · VIN ↔ dealer: Stock Dealer del área (V4WBaseStockDealer, con su marca &quot;Retail&quot; y &quot;Test&quot;,&#xA;                         D-55/D-56) contra el sistema (wholesale neto a la fecha, fuera de bodega HMDC,&#xA;                         venta retail a la fecha).&#xA;               Nivel 2 · VIN ↔ sala (D-ARQ-54): (1) vendido con oportunidad → sala de la oportunidad&#xA;                         ('Sistema', desde V4WBaseVentaRetail); si el área informa otra sala → SALA_AREA_DISTINTA_SF&#xA;                         (D-ARQ-55); (2) sala que informa el área en Fuente ('Area', D-57); (3) sala única (D-95: una sola sala activa en el maestro de Autos);&#xA;                         (4) reparto FIFO contra el Stock DISPONIBLE por sala × modelo (D-58).&#xA;             D-52/D-53: la venta retail es SOLO la oportunidad en 'Venta Cerrada' o 'Emisión Nota de Venta'&#xA;             (SFOBaseOpportunity). VIN_VENTA_NO_REGISTRADA_SF = el área lo marca &quot;Retail&quot; y Salesforce no&#xA;             tiene venta (SOL-013). Cuando la Qc de VentaRetail (40) esté al día, esta tarea podrá leer&#xA;             V4WBaseVentaRetail en lugar de SFOBaseOpportunity.&#xA;             Las alertas no sacan a nadie de la sábana: describen el estado del VIN (AlertaDealer, AlertaSala).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;   Resultado: RowsInsert&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;&#xA;-- ── 1. Fotografías oficiales (D-48): una por fecha de corte ─────────────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#Foto') IS NOT NULL DROP TABLE #Foto;&#xA;SELECT x.Archivo, x.FechaCorte&#xA;INTO   #Foto&#xA;FROM (&#xA;    SELECT a.Archivo, a.FechaCorte,&#xA;           ROW_NUMBER() OVER (PARTITION BY a.FechaCorte ORDER BY&#xA;               CASE WHEN a.Archivo LIKE N'%Cierre Final%' THEN 1&#xA;                    WHEN a.Archivo LIKE N'%Cierre%'       THEN 2&#xA;                    ELSE 3 END, a.Archivo) AS Rn&#xA;    FROM  (SELECT DISTINCT Archivo, FechaCorte FROM dbo.V4WBaseStockDealer&#xA;           UNION SELECT DISTINCT Archivo, FechaCorte FROM dbo.V4WBaseGestionDealer) AS a&#xA;    WHERE a.Archivo NOT LIKE N'%Respaldo%' AND a.Archivo NOT LIKE N'%Check%'&#xA;) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;-- ── 2. Maestros ──────────────────────────────────────────────────────────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#Grupo')     IS NOT NULL DROP TABLE #Grupo;&#xA;IF OBJECT_ID(N'tempdb..#VinSF')     IS NOT NULL DROP TABLE #VinSF;&#xA;IF OBJECT_ID(N'tempdb..#SalaUnica') IS NOT NULL DROP TABLE #SalaUnica;&#xA;&#xA;SELECT UPPER(LTRIM(RTRIM(g.CodigoArticulo))) AS Codigo, g.Modelo, g.Familia&#xA;INTO   #Grupo FROM dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1;&#xA;&#xA;-- VIN en Salesforce: solo el código de artículo (el retail sale de la oportunidad, D-52)&#xA;SELECT x.VIN, x.Codigo&#xA;INTO   #VinSF&#xA;FROM (&#xA;    SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;           UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;           ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;    FROM   dbo.SFOBaseVin_Modelos__c AS v&#xA;    WHERE  v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles'&#xA;) AS x WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_VinSF ON #VinSF (VIN);&#xA;&#xA;-- Venta retail = oportunidad en 'Venta Cerrada' o 'Emisión Nota de Venta' (D-52, D-53): primera fecha por VIN&#xA;IF OBJECT_ID(N'tempdb..#Retail') IS NOT NULL DROP TABLE #Retail;&#xA;SELECT UPPER(LTRIM(RTRIM(LEFT(o.Vin_texto__c, 25)))) AS VIN, MIN(CONVERT(date, o.CloseDate)) AS FechaRetail&#xA;INTO   #Retail&#xA;FROM   dbo.SFOBaseOpportunity AS o&#xA;WHERE  o.IsDeleted = 0 AND (o.StageName = N'Venta Cerrada' OR o.StageName LIKE N'Emisi_n Nota de Venta')&#xA;  AND  o.Linea_Producto__c = N'Automoviles'&#xA;  AND  o.Vin_texto__c IS NOT NULL AND LTRIM(RTRIM(o.Vin_texto__c)) &lt;&gt; N''&#xA;GROUP BY UPPER(LTRIM(RTRIM(LEFT(o.Vin_texto__c, 25))));&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Retail ON #Retail (VIN);&#xA;&#xA;-- Dealers con una sola sala activa en el maestro de Autos (D-95, reemplaza a D-46)&#xA;SELECT s.RUTID, MIN(s.SUCURSALID) AS SUCURSALID&#xA;INTO   #SalaUnica&#xA;FROM   dbo.V4WBaseSalaAutos AS s&#xA;WHERE  s.ACTIVO = 1&#xA;GROUP BY s.RUTID&#xA;HAVING COUNT(*) = 1;&#xA;&#xA;-- ── 3. Sistema a cada fecha (D-63): el VIN está en el dealer si su ÚLTIMO documento a la fecha es una factura a ese dealer ───&#xA;IF OBJECT_ID(N'tempdb..#Sis') IS NOT NULL DROP TABLE #Sis;&#xA;SELECT f.Archivo, f.FechaCorte, w.RUTID, w.VIN, w.Fecha AS FechaFactura, w.CodigoArticulo&#xA;INTO   #Sis&#xA;FROM   #Foto AS f&#xA;CROSS APPLY (&#xA;    SELECT x.RUTID, x.VIN, x.Fecha, x.CodigoArticulo, x.TipoDocumento, x.Cantidad&#xA;    FROM (SELECT fw.RUTID, UPPER(LTRIM(RTRIM(fw.VIN))) AS VIN, fw.Fecha, fw.CodigoArticulo, fw.TipoDocumento, fw.Cantidad,&#xA;                 ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(fw.VIN))) ORDER BY fw.Fecha DESC, fw.NumeroInterno DESC, fw.TipoDocumento) AS Rn&#xA;          FROM dbo.V4WBaseFacturaWholesale AS fw&#xA;          WHERE fw.Fecha &lt;= f.FechaCorte AND fw.VIN IS NOT NULL) AS x&#xA;    WHERE x.Rn = 1 AND x.TipoDocumento IN (533, 534) AND x.Cantidad &gt; 0&#xA;) AS w;&#xA;&#xA;-- Bodega HMDC a la fecha (historia del paquete 43; antes de su primera corrida no hay dato: R-3)&#xA;IF OBJECT_ID(N'tempdb..#Bodega') IS NOT NULL DROP TABLE #Bodega;&#xA;SELECT DISTINCT f.Archivo, UPPER(LTRIM(RTRIM(pe.VIN))) AS VIN&#xA;INTO   #Bodega&#xA;FROM   #Foto AS f&#xA;JOIN   dbo.V4WBasePendienteEnvio AS pe&#xA;  ON   pe.FechaPrimeraVez &lt;= f.FechaCorte AND (pe.FechaDespacho IS NULL OR pe.FechaDespacho &gt; f.FechaCorte);&#xA;&#xA;-- ── 4. Universo por fotografía: VIN del área (Stock Dealer resuelto) ∪ VIN del sistema en el dealer ──&#xA;-- Del área: marca de venta (D-55: solo &quot;Retail&quot;), unidad de prueba (D-56) y texto de Fuente (sala, D-57)&#xA;IF OBJECT_ID(N'tempdb..#Area') IS NOT NULL DROP TABLE #Area;&#xA;SELECT sd.Archivo, sd.RUTID, UPPER(LTRIM(RTRIM(sd.VIN))) AS VIN,&#xA;       MAX(CASE WHEN UPPER(LTRIM(RTRIM(sd.Retail))) = N'RETAIL' THEN 1 ELSE 0 END) AS MarcaRetail,&#xA;       MAX(CASE WHEN UPPER(LTRIM(RTRIM(sd.Retail))) IN (N'TEST', N'RETAIL 4 TEST') THEN 1 ELSE 0 END) AS MarcaTest,&#xA;       MAX(UPPER(LTRIM(RTRIM(sd.Fuente)))) AS Fuente&#xA;INTO   #Area&#xA;FROM   dbo.V4WBaseStockDealer AS sd&#xA;JOIN   #Foto AS f ON f.Archivo = sd.Archivo&#xA;WHERE  sd.RUTID IS NOT NULL&#xA;GROUP BY sd.Archivo, sd.RUTID, UPPER(LTRIM(RTRIM(sd.VIN)));&#xA;&#xA;IF OBJECT_ID(N'tempdb..#U') IS NOT NULL DROP TABLE #U;&#xA;SELECT f.Archivo, f.FechaCorte, x.RUTID, x.VIN, MAX(x.EnArea) AS EnArea, MAX(x.EnSistema) AS EnSistema&#xA;INTO   #U&#xA;FROM   #Foto AS f&#xA;CROSS APPLY (&#xA;    SELECT a.RUTID, a.VIN, 1 AS EnArea, 0 AS EnSistema FROM #Area AS a WHERE a.Archivo = f.Archivo&#xA;    UNION ALL&#xA;    SELECT s.RUTID, s.VIN, 0, 1 FROM #Sis AS s WHERE s.Archivo = f.Archivo&#xA;) AS x&#xA;GROUP BY f.Archivo, f.FechaCorte, x.RUTID, x.VIN;&#xA;&#xA;IF OBJECT_ID(N'tempdb..#E') IS NOT NULL DROP TABLE #E;&#xA;SELECT u.Archivo, u.FechaCorte, u.RUTID, u.VIN, u.EnArea, u.EnSistema,&#xA;       s.FechaFactura,&#xA;       COALESCE(s.CodigoArticulo, sf.Codigo) AS CodigoArticulo,&#xA;       CASE WHEN bo.VIN IS NOT NULL THEN 1 ELSE 0 END AS EnBodega,&#xA;       CASE WHEN rt.FechaRetail IS NOT NULL AND rt.FechaRetail &lt;= u.FechaCorte THEN 1 ELSE 0 END AS Vendido,&#xA;       ISNULL(a.MarcaRetail, 0) AS MarcaRetail, ISNULL(a.MarcaTest, 0) AS MarcaTest, a.Fuente,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM #Sis s2 WHERE s2.Archivo = u.Archivo AND s2.VIN = u.VIN AND s2.RUTID = u.RUTID) THEN 1 ELSE 0 END AS FacturadoAlDealer&#xA;INTO   #E&#xA;FROM   #U AS u&#xA;LEFT JOIN #Sis    AS s  ON s.Archivo = u.Archivo AND s.RUTID = u.RUTID AND s.VIN = u.VIN&#xA;LEFT JOIN #Bodega AS bo ON bo.Archivo = u.Archivo AND bo.VIN = u.VIN&#xA;LEFT JOIN #VinSF  AS sf ON sf.VIN = u.VIN&#xA;LEFT JOIN #Retail AS rt ON rt.VIN = u.VIN&#xA;LEFT JOIN #Area   AS a  ON a.Archivo = u.Archivo AND a.RUTID = u.RUTID AND a.VIN = u.VIN;&#xA;&#xA;-- ── 5. Nivel 1 · estado y alerta del VIN frente al dealer (plan v7) ─────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#N1') IS NOT NULL DROP TABLE #N1;&#xA;SELECT e.*, g.Modelo, g.Familia,&#xA;       CASE WHEN e.EnArea = 1 AND e.MarcaTest = 1   THEN N'Demo'&#xA;            WHEN e.EnArea = 1 AND e.MarcaRetail = 1 THEN N'VendidoArea'&#xA;            WHEN e.EnBodega = 1 THEN N'EnBodegaHMDC'&#xA;            WHEN e.Vendido = 1  THEN N'Vendido'&#xA;            WHEN e.EnArea = 1 AND e.FacturadoAlDealer = 0 THEN N'ReportadoSinFactura'&#xA;            ELSE N'EnStockDealer' END AS EstadoVin,&#xA;       CASE WHEN e.EnArea = 1 AND e.MarcaTest = 1 THEN NULL&#xA;            WHEN e.EnArea = 1 AND e.MarcaRetail = 1 AND e.Vendido = 0 THEN N'VIN_VENTA_NO_REGISTRADA_SF'&#xA;            WHEN e.EnArea = 1 AND e.MarcaRetail = 1 THEN NULL&#xA;            WHEN e.EnArea = 1 AND e.EnBodega = 1 THEN N'VIN_EN_BODEGA_REPORTADO'&#xA;            WHEN e.EnArea = 1 AND e.Vendido = 1 THEN N'VIN_VENDIDO_REPORTADO_STOCK'&#xA;            WHEN e.EnArea = 1 AND e.FacturadoAlDealer = 0 THEN N'VIN_REPORTADO_SIN_FACTURA'&#xA;            WHEN e.EnArea = 0 AND e.EnBodega = 0 AND e.Vendido = 0 THEN N'VIN_NO_REPORTADO_AREA'&#xA;       END AS AlertaDealer&#xA;INTO   #N1&#xA;FROM   #E AS e&#xA;LEFT JOIN #Grupo AS g ON g.Codigo = e.CodigoArticulo&#xA;WHERE  NOT (e.EnArea = 0 AND (e.EnBodega = 1 OR e.Vendido = 1));   -- en bodega o vendido y el área no lo reporta: normal, no se lista&#xA;&#xA;-- ── 6. Nivel 2 · sala del VIN ───────────────────────────────────────────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#Sala') IS NOT NULL DROP TABLE #Sala;&#xA;CREATE TABLE #Sala (Archivo nvarchar(260), RUTID nvarchar(12), VIN nvarchar(25), SUCURSALID int NULL,&#xA;                    OrigenSala nvarchar(10) NULL, OrdenFIFO int NULL, AlertaSala nvarchar(50) NULL, DetalleAlerta nvarchar(500) NULL);&#xA;&#xA;-- 6a. Sala que informa el área en Fuente (D-57): alias ORIGEN 'Autos' del maestro de Autos de una sala DEL MISMO DEALER&#xA;IF OBJECT_ID(N'tempdb..#AliasSala') IS NOT NULL DROP TABLE #AliasSala;&#xA;SELECT DISTINCT UPPER(LTRIM(RTRIM(al.ALIAS))) AS Alias, b.RUTID, al.SUCURSALID&#xA;INTO   #AliasSala&#xA;FROM   dbo.V4WBaseAliasAutos AS al&#xA;JOIN   dbo.V4WBaseSalaAutos  AS b ON b.SUCURSALID = al.SUCURSALID AND b.ACTIVO = 1&#xA;WHERE  al.ORIGEN = N'Autos' AND al.ACTIVO = 1 AND al.SUCURSALID IS NOT NULL;&#xA;&#xA;-- Sala que informa el área para cada VIN (una sola sala posible del mismo dealer)&#xA;IF OBJECT_ID(N'tempdb..#SalaArea') IS NOT NULL DROP TABLE #SalaArea;&#xA;SELECT n.Archivo, n.RUTID, n.VIN, MIN(x.SUCURSALID) AS SUCURSALID&#xA;INTO   #SalaArea&#xA;FROM   #N1 AS n&#xA;JOIN   #AliasSala AS x ON x.Alias = n.Fuente AND x.RUTID = n.RUTID&#xA;GROUP BY n.Archivo, n.RUTID, n.VIN&#xA;HAVING COUNT(DISTINCT x.SUCURSALID) = 1;&#xA;&#xA;-- D-62: sin alias, la única sala del mismo dealer cuyo nombre en el maestro de Autos contiene el texto de Fuente (≥ 4 letras)&#xA;INSERT INTO #SalaArea (Archivo, RUTID, VIN, SUCURSALID)&#xA;SELECT n.Archivo, n.RUTID, n.VIN, MIN(b.SUCURSALID)&#xA;FROM   #N1 AS n&#xA;JOIN   dbo.V4WBaseSalaAutos AS b&#xA;  ON   b.RUTID = n.RUTID AND b.ACTIVO = 1 AND LEN(n.Fuente) &gt;= 4&#xA;  AND  UPPER(b.NOMBRE_SALA) LIKE N'%' + n.Fuente + N'%'&#xA;WHERE  NOT EXISTS (SELECT 1 FROM #SalaArea sa WHERE sa.Archivo = n.Archivo AND sa.RUTID = n.RUTID AND sa.VIN = n.VIN)&#xA;GROUP BY n.Archivo, n.RUTID, n.VIN&#xA;HAVING COUNT(DISTINCT b.SUCURSALID) = 1;&#xA;&#xA;-- 6-0. Vendido con oportunidad (D-ARQ-54): manda la sala de la oportunidad (V4WBaseVentaRetail, mismo dealer).&#xA;--      Si el área informó otra sala → SALA_AREA_DISTINTA_SF (D-ARQ-55); si la oportunidad es de otro dealer → SALA_DE_OTRO_DEALER.&#xA;IF OBJECT_ID(N'tempdb..#SalaSF') IS NOT NULL DROP TABLE #SalaSF;&#xA;SELECT x.VIN, x.SUCURSALID, x.RUTID&#xA;INTO   #SalaSF&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(vr.VIN))) AS VIN, vr.SUCURSALID, LTRIM(RTRIM(vr.RUTID)) AS RUTID,&#xA;             ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(vr.VIN))) ORDER BY vr.CloseDate DESC, vr.Id DESC) AS Rn&#xA;      FROM dbo.V4WBaseVentaRetail AS vr WHERE vr.VIN IS NOT NULL AND vr.SUCURSALID IS NOT NULL) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, SUCURSALID, OrigenSala, AlertaSala, DetalleAlerta)&#xA;SELECT n.Archivo, n.RUTID, n.VIN,&#xA;       CASE WHEN sf.RUTID = n.RUTID THEN sf.SUCURSALID END,&#xA;       CASE WHEN sf.RUTID = n.RUTID THEN N'Sistema' END,&#xA;       CASE WHEN sf.RUTID &lt;&gt; n.RUTID THEN N'SALA_DE_OTRO_DEALER'&#xA;            WHEN sa.SUCURSALID IS NOT NULL AND sa.SUCURSALID &lt;&gt; sf.SUCURSALID THEN N'SALA_AREA_DISTINTA_SF' END,&#xA;       CASE WHEN sf.RUTID &lt;&gt; n.RUTID THEN N'La venta en Salesforce es de una sala del dealer ' + sf.RUTID&#xA;            WHEN sa.SUCURSALID IS NOT NULL AND sa.SUCURSALID &lt;&gt; sf.SUCURSALID&#xA;            THEN N'Sala informada por el área: ' + ISNULL(ba.NOMBRE_SALA, CONVERT(nvarchar(20), sa.SUCURSALID))&#xA;                 + N' · sala en Salesforce: ' + ISNULL(bs.NOMBRE_SALA, CONVERT(nvarchar(20), sf.SUCURSALID)) END&#xA;FROM   #N1 AS n&#xA;JOIN   #SalaSF AS sf ON sf.VIN = n.VIN&#xA;LEFT JOIN #SalaArea AS sa ON sa.Archivo = n.Archivo AND sa.RUTID = n.RUTID AND sa.VIN = n.VIN&#xA;LEFT JOIN dbo.V4WBaseSalaAutos AS ba ON ba.SUCURSALID = sa.SUCURSALID&#xA;LEFT JOIN dbo.V4WBaseSalaAutos AS bs ON bs.SUCURSALID = sf.SUCURSALID&#xA;WHERE  n.Vendido = 1 AND n.EstadoVin IN (N'Vendido', N'VendidoArea');&#xA;&#xA;-- 6a. Sala que informa el área (D-57): VIN en stock y VIN vendidos por el área sin venta en Salesforce&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, SUCURSALID, OrigenSala)&#xA;SELECT sa.Archivo, sa.RUTID, sa.VIN, sa.SUCURSALID, N'Area'&#xA;FROM   #SalaArea AS sa&#xA;JOIN   #N1 AS n ON n.Archivo = sa.Archivo AND n.RUTID = sa.RUTID AND n.VIN = sa.VIN&#xA;WHERE  n.EstadoVin IN (N'EnStockDealer', N'VendidoArea')&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Sala s WHERE s.Archivo = sa.Archivo AND s.RUTID = sa.RUTID AND s.VIN = sa.VIN);&#xA;&#xA;-- 6b. Dealer de una sola sala activa en el maestro de Autos (D-95)&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, SUCURSALID, OrigenSala)&#xA;SELECT n.Archivo, n.RUTID, n.VIN, su.SUCURSALID, N'SalaUnica'&#xA;FROM   #N1 AS n&#xA;JOIN   #SalaUnica AS su ON su.RUTID = n.RUTID&#xA;WHERE  n.EstadoVin IN (N'EnStockDealer', N'VendidoArea')&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Sala s WHERE s.Archivo = n.Archivo AND s.RUTID = n.RUTID AND s.VIN = n.VIN);&#xA;&#xA;-- 6c. Reparto FIFO contra el Stock DISPONIBLE por sala × modelo del Gestion (D-58), descontando los VIN&#xA;--     en stock que ya tienen sala del área o sala única&#xA;IF OBJECT_ID(N'tempdb..#Dem') IS NOT NULL DROP TABLE #Dem;&#xA;SELECT g.Archivo, g.RUTID, g.SUCURSALID,&#xA;       CASE WHEN g.Modelo IS NOT NULL THEN N'Modelo' ELSE N'Familia' END AS Nivel,&#xA;       COALESCE(g.Modelo, g.Familia) AS Grupo,&#xA;       CONVERT(int, ROUND(SUM(g.Stock), 0)) AS Cupos&#xA;INTO   #Dem&#xA;FROM   dbo.V4WBaseGestionDealer AS g&#xA;JOIN   #Foto AS f ON f.Archivo = g.Archivo&#xA;WHERE  g.EsTTL = 0 AND g.EsDetalle = 1 AND g.SUCURSALID IS NOT NULL AND g.Stock &gt; 0&#xA;  AND  COALESCE(g.Modelo, g.Familia) IS NOT NULL&#xA;GROUP BY g.Archivo, g.RUTID, g.SUCURSALID, CASE WHEN g.Modelo IS NOT NULL THEN N'Modelo' ELSE N'Familia' END, COALESCE(g.Modelo, g.Familia);&#xA;&#xA;UPDATE d&#xA;SET    d.Cupos = d.Cupos - (SELECT COUNT(*) FROM #Sala s JOIN #N1 n ON n.Archivo = s.Archivo AND n.RUTID = s.RUTID AND n.VIN = s.VIN&#xA;                            WHERE s.Archivo = d.Archivo AND s.RUTID = d.RUTID AND s.SUCURSALID = d.SUCURSALID&#xA;                              AND n.EstadoVin = N'EnStockDealer'&#xA;                              AND ((d.Nivel = N'Modelo' AND n.Modelo = d.Grupo) OR (d.Nivel = N'Familia' AND n.Familia = d.Grupo)))&#xA;FROM   #Dem AS d;&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Cupo') IS NOT NULL DROP TABLE #Cupo;&#xA;;WITH T AS (SELECT TOP (500) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n FROM sys.all_objects)&#xA;SELECT d.Archivo, d.RUTID, d.SUCURSALID, d.Nivel, d.Grupo,&#xA;       ROW_NUMBER() OVER (PARTITION BY d.Archivo, d.RUTID, d.Nivel, d.Grupo ORDER BY d.SUCURSALID, t.n) AS Slot&#xA;INTO   #Cupo&#xA;FROM   #Dem AS d JOIN T AS t ON t.n &lt;= d.Cupos&#xA;WHERE  d.Cupos &gt; 0;&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Libre') IS NOT NULL DROP TABLE #Libre;&#xA;SELECT n.Archivo, n.RUTID, n.VIN, n.Modelo, n.Familia, n.FechaFactura&#xA;INTO   #Libre&#xA;FROM   #N1 AS n&#xA;WHERE  n.EnArea = 1 AND n.EstadoVin = N'EnStockDealer'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Sala s WHERE s.Archivo = n.Archivo AND s.RUTID = n.RUTID AND s.VIN = n.VIN);&#xA;&#xA;;WITH V AS (SELECT l.*, ROW_NUMBER() OVER (PARTITION BY l.Archivo, l.RUTID, l.Modelo ORDER BY l.FechaFactura, l.VIN) AS Ord&#xA;            FROM #Libre l WHERE l.Modelo IS NOT NULL)&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, SUCURSALID, OrigenSala, OrdenFIFO)&#xA;SELECT v.Archivo, v.RUTID, v.VIN, c.SUCURSALID, N'Imputada', v.Ord&#xA;FROM   V AS v&#xA;JOIN   #Cupo AS c ON c.Archivo = v.Archivo AND c.RUTID = v.RUTID AND c.Nivel = N'Modelo' AND c.Grupo = v.Modelo AND c.Slot = v.Ord;&#xA;&#xA;;WITH V AS (SELECT l.*, ROW_NUMBER() OVER (PARTITION BY l.Archivo, l.RUTID, l.Familia ORDER BY l.FechaFactura, l.VIN) AS Ord&#xA;            FROM #Libre l&#xA;            WHERE l.Familia IS NOT NULL&#xA;              AND NOT EXISTS (SELECT 1 FROM #Sala s WHERE s.Archivo = l.Archivo AND s.RUTID = l.RUTID AND s.VIN = l.VIN))&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, SUCURSALID, OrigenSala, OrdenFIFO)&#xA;SELECT v.Archivo, v.RUTID, v.VIN, c.SUCURSALID, N'Imputada', v.Ord&#xA;FROM   V AS v&#xA;JOIN   #Cupo AS c ON c.Archivo = v.Archivo AND c.RUTID = v.RUTID AND c.Nivel = N'Familia' AND c.Grupo = v.Familia AND c.Slot = v.Ord;&#xA;&#xA;INSERT INTO #Sala (Archivo, RUTID, VIN, AlertaSala, DetalleAlerta)&#xA;SELECT l.Archivo, l.RUTID, l.VIN,&#xA;       CASE WHEN NOT EXISTS (SELECT 1 FROM #Dem d WHERE d.Archivo = l.Archivo AND d.RUTID = l.RUTID)&#xA;            THEN N'SALA_SIN_STOCK_INFORMADO' ELSE N'STOCK_SALA_NO_CUADRA' END,&#xA;       CASE WHEN NOT EXISTS (SELECT 1 FROM #Dem d WHERE d.Archivo = l.Archivo AND d.RUTID = l.RUTID)&#xA;            THEN N'El dealer solo informa stock total (TTL) en esta fotografía'&#xA;            ELSE N'No hay cupo en el stock disponible por sala para ' + ISNULL(l.Modelo, ISNULL(l.Familia, N'(modelo sin grupo)')) END&#xA;FROM   #Libre AS l&#xA;WHERE  NOT EXISTS (SELECT 1 FROM #Sala s WHERE s.Archivo = l.Archivo AND s.RUTID = l.RUTID AND s.VIN = l.VIN);&#xA;&#xA;-- ── 7. Resultado ─────────────────────────────────────────────────────────────────────────────&#xA;INSERT INTO dbo.V4WBaseVinImputacion&#xA;       (Archivo, FechaCorte, RUTID, VIN, SUCURSALID, OrigenSala, CodigoArticulo, Modelo, Familia, EstadoVin,&#xA;        FechaFactura, FechaDespacho, OrdenFIFO, AlertaDealer, AlertaSala, DetalleAlerta, ExecutionID)&#xA;SELECT n.Archivo, n.FechaCorte, n.RUTID, n.VIN, s.SUCURSALID, s.OrigenSala, n.CodigoArticulo, n.Modelo, n.Familia, n.EstadoVin,&#xA;       n.FechaFactura,&#xA;       (SELECT MAX(pe.FechaDespacho) FROM dbo.V4WBasePendienteEnvio pe WHERE UPPER(LTRIM(RTRIM(pe.VIN))) = n.VIN),&#xA;       s.OrdenFIFO, n.AlertaDealer, s.AlertaSala, LEFT(s.DetalleAlerta, 500), @ExecutionID&#xA;FROM   #N1 AS n&#xA;LEFT JOIN #Sala AS s ON s.Archivo = n.Archivo AND s.RUTID = n.RUTID AND s.VIN = n.VIN;&#xA;&#xA;SELECT @@ROWCOUNT AS RowsInsert;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
