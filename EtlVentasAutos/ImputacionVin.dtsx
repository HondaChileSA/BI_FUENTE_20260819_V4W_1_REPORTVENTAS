    <DTS:Executable
      DTS:refId="Package\CTL05CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{31474216-813F-4122-BEB4-518D128EB2A7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* ImputacionVin__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : ImputacionVin (ProcessID 42) · Tarea: CTL07CloseBatchId · Conexión: HMDCBIPA&#xA;   Qué hace: cierra el lote. FailedRows = VIN con alguna alerta (no bloquean: describen el estado del VIN).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsInserted · 3) User::EtlRowsDeleted · 4) User::CtlAuditBatchID&#xA;   Resultado: RowsFailed&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @Alertas int = (SELECT COUNT(*) FROM HMDCBIDW.dbo.V4WBaseVinImputacion&#xA;                        WHERE ExecutionID = @ExecutionID AND (AlertaDealer IS NOT NULL OR AlertaSala IS NOT NULL));&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    InsertedRows = @Ins, UpdatedRows = 0, FailedRows = @Alertas,&#xA;       Notes = N'Recalculo completo: ' + CONVERT(nvarchar(20), @Del) + N' filas anteriores reemplazadas; ' + CONVERT(nvarchar(20), @Alertas) + N' VIN con alerta'&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT @Alertas AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{E0D136F0-E794-4B69-A32F-F17EF3833CCD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* ImputacionVin__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : ImputacionVin (ProcessID 42) · Tarea: CTL08GetNewWaterMark · Conexión: HMDCBIDW&#xA;   Qué hace: watermark informativo: hoy + 1 (CTL10 resta un día) y la última fotografía imputada.&#xA;   Parámetros: ninguno&#xA;*/&#xA;SELECT DATEADD(DAY, 1, CONVERT(date, SYSDATETIME())) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(FechaCorte) FROM dbo.V4WBaseVinImputacion), 23), N'') AS NewLastID;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
