              ReadOnlyVariables="System::ErrorCode,System::ErrorDescription,System::SourceName,User::CtlDurationMs,User::CtlExecutionID,User::CtlIpExecution,User::CtlRowsInserted,User::CtlRowsRead,User::CtlRowsUpdated,User::CtlStartTime,System::ExecutionInstanceGUID,System::MachineName,System::PackageName,System::UserName,$Package::CtlProcessID,$Package::vMailCC,$Package::vMailFrom,$Package::vMailTO,$Project::vSMTPHost,$Project::vSQLConnStr,$Project::vSMTPPort,$Project::vSQLConnPa,$Project::vLogoMain,$Project::vLogoWhite"
