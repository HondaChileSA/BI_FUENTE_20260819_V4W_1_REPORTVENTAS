    <DTS:Executable
      DTS:refId="Package\ETL05ValidateMaestro"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{70C043A9-3451-44B9-8746-ADF468528AFA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL05ValidateMaestro"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL05ValidateMaestro_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL05ValidateMaestro&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Valida las 4 hojas en cascada (Dealer → Sala → CuentaSalesforce → Alias: cada hoja contra las filas válidas de la anterior en el mismo archivo), actualiza la Qc persistente de cada entidad (Pendiente/Resuelta), deja los avisos que no bloquean en V4WQcCampo (RUTID_DIC_NO_EXISTE, SUCURSALID_DIC_NO_EXISTE, NOMBRE_SF_DISTINTO) y saca de Stg lo que falla (D-22). Personas (RUT &lt; 50.000.000 o cuenta persona): la Qc guarda solo la fila enmascarada (regla 12). Devuelve RowsQc (fila única).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) $Package::CtlProcessID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?, @ProcessID int = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Cuenta')   IS NOT NULL DROP TABLE #Cuenta;&#xA;IF OBJECT_ID(N'tempdb..#DealerOk') IS NOT NULL DROP TABLE #DealerOk;&#xA;IF OBJECT_ID(N'tempdb..#SalaOk')   IS NOT NULL DROP TABLE #SalaOk;&#xA;IF OBJECT_ID(N'tempdb..#Aviso')    IS NOT NULL DROP TABLE #Aviso;&#xA;IF OBJECT_ID(N'tempdb..#FDealerAutos') IS NOT NULL DROP TABLE #FDealerAutos;&#xA;IF OBJECT_ID(N'tempdb..#FSalaAutos') IS NOT NULL DROP TABLE #FSalaAutos;&#xA;IF OBJECT_ID(N'tempdb..#FCuentaSalesforceAutos') IS NOT NULL DROP TABLE #FCuentaSalesforceAutos;&#xA;IF OBJECT_ID(N'tempdb..#FAliasAutos') IS NOT NULL DROP TABLE #FAliasAutos;&#xA;&#xA;-- Cuentas de Salesforce que aparecen en la hoja (para no leer SFOBaseAccount completa)&#xA;SELECT a.Id, a.Name, CONVERT(int, ISNULL(a.IsDeleted, 0)) AS IsDeleted, CONVERT(int, ISNULL(a.IsPersonAccount, 0)) AS IsPersonAccount&#xA;INTO   #Cuenta&#xA;FROM   HMDCBIDW.dbo.SFOBaseAccount AS a&#xA;WHERE  a.Id IN (SELECT s.SALESFORCEID FROM HMDCBISA.dbo.V4WStgCuentaSalesforceAutos s WHERE s.ExecutionID = @ExecutionID);&#xA;&#xA;CREATE TABLE #Aviso (Objeto nvarchar(80) NOT NULL, TablaStg nvarchar(128) NOT NULL, Clave nvarchar(400) NOT NULL,&#xA;                     Columna nvarchar(128) NOT NULL, Valor nvarchar(max) NULL, Motivo nvarchar(200) NOT NULL);&#xA;&#xA;-- ── 1. Dealer (DealerAutos) ──&#xA;SELECT s.*, f.MotivoFalla, f.DetalleError, CONVERT(int, 0) AS Rn&#xA;INTO   #FDealerAutos&#xA;FROM   HMDCBISA.dbo.V4WStgDealerAutos AS s&#xA;CROSS APPLY (&#xA;    SELECT N'DUPLICADO', N'RUTID ' + s.RUTID + N' repetido en la hoja Dealer'&#xA;    WHERE (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgDealerAutos x WHERE x.ExecutionID = @ExecutionID AND x.RUTID = s.RUTID) &gt; 1&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'RUTID con formato distinto de 00XXXXXXXX-X'&#xA;    WHERE s.RUTID NOT LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]'&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'RUTID_DIC con formato distinto de 00XXXXXXXX-X'&#xA;    WHERE s.RUTID_DIC IS NOT NULL AND s.RUTID_DIC NOT LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]'&#xA;    UNION ALL&#xA;    SELECT N'RUT_PERSONA', N'El maestro solo admite empresas (RUT &gt;= 50.000.000); la fila no se guarda (regla 12)'&#xA;    WHERE s.RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND TRY_CAST(LEFT(s.RUTID, 10) AS bigint) &lt; 50000000&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [RUTID], MotivoFalla ORDER BY RowNumber) AS r FROM #FDealerAutos)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;SELECT s.RUTID INTO #DealerOk&#xA;FROM   HMDCBISA.dbo.V4WStgDealerAutos s&#xA;WHERE  s.ExecutionID = @ExecutionID AND NOT EXISTS (SELECT 1 FROM #FDealerAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;INSERT INTO #Aviso (Objeto, TablaStg, Clave, Columna, Valor, Motivo)&#xA;SELECT N'DealerAutos', N'V4WStgDealerAutos', s.RUTID, N'RUTID_DIC', s.RUTID_DIC, N'RUTID_DIC_NO_EXISTE'&#xA;FROM   HMDCBISA.dbo.V4WStgDealerAutos s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.RUTID_DIC IS NOT NULL&#xA;  AND  s.RUTID IN (SELECT RUTID FROM #DealerOk)&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBIDW.dbo.DICBaseDealerParent p WHERE LTRIM(RTRIM(p.RUTID)) = s.RUTID_DIC);&#xA;&#xA;-- ── 2. Sala (SalaAutos) ──&#xA;SELECT s.*, f.MotivoFalla, f.DetalleError, CONVERT(int, 0) AS Rn&#xA;INTO   #FSalaAutos&#xA;FROM   HMDCBISA.dbo.V4WStgSalaAutos AS s&#xA;CROSS APPLY (&#xA;    SELECT N'DUPLICADO', N'SUCURSALID ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' repetido en la hoja Sala'&#xA;    WHERE (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgSalaAutos x WHERE x.ExecutionID = @ExecutionID AND x.SUCURSALID = s.SUCURSALID) &gt; 1&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'SUCURSALID ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' menor que 1001 (numeración de Autos, D-92)'&#xA;    WHERE s.SUCURSALID &lt; 1001&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'RUTID con formato distinto de 00XXXXXXXX-X'&#xA;    WHERE s.RUTID NOT LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]'&#xA;    UNION ALL&#xA;    SELECT N'RUTID_NO_EXISTE_EN_DEALER', N'RUTID no está (o no es válido) en la hoja Dealer'&#xA;    WHERE s.RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND NOT EXISTS (SELECT 1 FROM #DealerOk d WHERE d.RUTID = s.RUTID)&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [SUCURSALID], MotivoFalla ORDER BY RowNumber) AS r FROM #FSalaAutos)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;SELECT s.SUCURSALID, s.RUTID INTO #SalaOk&#xA;FROM   HMDCBISA.dbo.V4WStgSalaAutos s&#xA;WHERE  s.ExecutionID = @ExecutionID AND NOT EXISTS (SELECT 1 FROM #FSalaAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;INSERT INTO #Aviso (Objeto, TablaStg, Clave, Columna, Valor, Motivo)&#xA;SELECT N'SalaAutos', N'V4WStgSalaAutos', CONVERT(nvarchar(20), s.SUCURSALID), N'SUCURSALID_DIC', CONVERT(nvarchar(20), s.SUCURSALID_DIC), N'SUCURSALID_DIC_NO_EXISTE'&#xA;FROM   HMDCBISA.dbo.V4WStgSalaAutos s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.SUCURSALID_DIC IS NOT NULL&#xA;  AND  s.SUCURSALID IN (SELECT SUCURSALID FROM #SalaOk)&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBIDW.dbo.DICBaseDealerBranch b WHERE b.SUCURSALID = s.SUCURSALID_DIC);&#xA;&#xA;-- ── 3. CuentaSalesforce (CuentaSalesforceAutos) ──&#xA;SELECT s.*, f.MotivoFalla, f.DetalleError, CONVERT(int, 0) AS Rn&#xA;INTO   #FCuentaSalesforceAutos&#xA;FROM   HMDCBISA.dbo.V4WStgCuentaSalesforceAutos AS s&#xA;CROSS APPLY (&#xA;    SELECT N'DUPLICADO', N'SALESFORCEID ' + s.SALESFORCEID + N' repetido en la hoja CuentaSalesforce'&#xA;    WHERE (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgCuentaSalesforceAutos x WHERE x.ExecutionID = @ExecutionID AND x.SALESFORCEID = s.SALESFORCEID) &gt; 1&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'SALESFORCEID debe tener 18 caracteres'&#xA;    WHERE LEN(s.SALESFORCEID) &lt;&gt; 18&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'RUTID con formato distinto de 00XXXXXXXX-X'&#xA;    WHERE s.RUTID NOT LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]'&#xA;    UNION ALL&#xA;    SELECT N'TIPO_FUERA_DOMINIO', N'TIPO_CUENTA ' + s.TIPO_CUENTA + N' no es SALA ni CONCESIONARIO'&#xA;    WHERE s.TIPO_CUENTA NOT IN (N'SALA', N'CONCESIONARIO')&#xA;    UNION ALL&#xA;    SELECT N'SALA_NO_EXISTE', N'Cuenta SALA sin SUCURSALID'&#xA;    WHERE s.TIPO_CUENTA = N'SALA' AND s.SUCURSALID IS NULL&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'Cuenta CONCESIONARIO no lleva SUCURSALID'&#xA;    WHERE s.TIPO_CUENTA = N'CONCESIONARIO' AND s.SUCURSALID IS NOT NULL&#xA;    UNION ALL&#xA;    SELECT N'RUTID_NO_EXISTE_EN_DEALER', N'RUTID no está (o no es válido) en la hoja Dealer'&#xA;    WHERE s.RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND NOT EXISTS (SELECT 1 FROM #DealerOk d WHERE d.RUTID = s.RUTID)&#xA;    UNION ALL&#xA;    SELECT N'SALA_NO_EXISTE', N'SUCURSALID ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' no está (o no es válida) en la hoja Sala'&#xA;    WHERE s.SUCURSALID IS NOT NULL AND NOT EXISTS (SELECT 1 FROM #SalaOk x WHERE x.SUCURSALID = s.SUCURSALID)&#xA;    UNION ALL&#xA;    SELECT N'SALA_DE_OTRO_DEALER', N'La sala ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' es de otro dealer en la hoja Sala'&#xA;    WHERE EXISTS (SELECT 1 FROM #SalaOk x WHERE x.SUCURSALID = s.SUCURSALID AND x.RUTID &lt;&gt; s.RUTID)&#xA;    UNION ALL&#xA;    SELECT N'ID_NO_EXISTE_EN_SALESFORCE', N'El Id no existe en SFOBaseAccount o está borrado'&#xA;    WHERE LEN(s.SALESFORCEID) = 18 AND NOT EXISTS (SELECT 1 FROM #Cuenta a WHERE a.Id = s.SALESFORCEID AND a.IsDeleted = 0)&#xA;    UNION ALL&#xA;    SELECT N'CUENTA_PERSONA', N'La cuenta es de una persona (IsPersonAccount = 1); la fila no se guarda (regla 12)'&#xA;    WHERE EXISTS (SELECT 1 FROM #Cuenta a WHERE a.Id = s.SALESFORCEID AND a.IsPersonAccount = 1)&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [SALESFORCEID], MotivoFalla ORDER BY RowNumber) AS r FROM #FCuentaSalesforceAutos)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;INSERT INTO #Aviso (Objeto, TablaStg, Clave, Columna, Valor, Motivo)&#xA;SELECT N'CuentaSalesforceAutos', N'V4WStgCuentaSalesforceAutos', s.SALESFORCEID, N'NOMBRE_CUENTA_SF',&#xA;       s.NOMBRE_CUENTA_SF + N' | Salesforce: ' + a.Name, N'NOMBRE_SF_DISTINTO'&#xA;FROM   HMDCBISA.dbo.V4WStgCuentaSalesforceAutos s&#xA;JOIN   #Cuenta a ON a.Id = s.SALESFORCEID AND a.IsPersonAccount = 0&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.NOMBRE_CUENTA_SF IS NOT NULL&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FCuentaSalesforceAutos f WHERE f.RowNumber = s.RowNumber)&#xA;  AND  UPPER(LTRIM(RTRIM(s.NOMBRE_CUENTA_SF))) &lt;&gt; UPPER(LTRIM(RTRIM(a.Name)));&#xA;&#xA;-- ── 4. Alias (AliasAutos) ──&#xA;SELECT s.*, f.MotivoFalla, f.DetalleError, CONVERT(int, 0) AS Rn&#xA;INTO   #FAliasAutos&#xA;FROM   HMDCBISA.dbo.V4WStgAliasAutos AS s&#xA;CROSS APPLY (&#xA;    SELECT N'DUPLICADO', N'ALIASID ' + CONVERT(nvarchar(20), s.ALIASID) + N' repetido en la hoja Alias'&#xA;    WHERE (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgAliasAutos x WHERE x.ExecutionID = @ExecutionID AND x.ALIASID = s.ALIASID) &gt; 1&#xA;    UNION ALL&#xA;    SELECT N'DUPLICADO', N'El texto ' + s.ALIAS + N' (' + s.ORIGEN + N') está activo en más de una fila'&#xA;    WHERE s.ACTIVO = 1&#xA;      AND (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgAliasAutos x WHERE x.ExecutionID = @ExecutionID AND x.ACTIVO = 1&#xA;             AND UPPER(x.ALIAS) = UPPER(s.ALIAS) AND UPPER(x.ORIGEN) = UPPER(s.ORIGEN)) &gt; 1&#xA;    UNION ALL&#xA;    SELECT N'FORMATO_INVALIDO', N'RUTID con formato distinto de 00XXXXXXXX-X'&#xA;    WHERE s.RUTID NOT LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]'&#xA;    UNION ALL&#xA;    SELECT N'RUTID_NO_EXISTE_EN_DEALER', N'RUTID no está (o no es válido) en la hoja Dealer'&#xA;    WHERE s.RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND NOT EXISTS (SELECT 1 FROM #DealerOk d WHERE d.RUTID = s.RUTID)&#xA;    UNION ALL&#xA;    SELECT N'SALA_NO_EXISTE', N'SUCURSALID ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' no está (o no es válida) en la hoja Sala'&#xA;    WHERE s.SUCURSALID IS NOT NULL AND NOT EXISTS (SELECT 1 FROM #SalaOk x WHERE x.SUCURSALID = s.SUCURSALID)&#xA;    UNION ALL&#xA;    SELECT N'SALA_DE_OTRO_DEALER', N'La sala ' + CONVERT(nvarchar(20), s.SUCURSALID) + N' es de otro dealer en la hoja Sala'&#xA;    WHERE EXISTS (SELECT 1 FROM #SalaOk x WHERE x.SUCURSALID = s.SUCURSALID AND x.RUTID &lt;&gt; s.RUTID)&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [ALIASID], MotivoFalla ORDER BY RowNumber) AS r FROM #FAliasAutos)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;-- Personas: la Qc no guarda su RUT, su Id ni su nombre (regla 12, D-ARQ-72)&#xA;UPDATE #FDealerAutos SET RUTID = N'xxxxx' + RIGHT(RUTID, 5), RAZON_SOCIAL = N'PERSONA', NOMBRE_COMERCIAL = NULL, RUTID_DIC = NULL, DetalleError = REPLACE(DetalleError, RUTID, N'PERSONA') WHERE RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND TRY_CAST(LEFT(RUTID, 10) AS bigint) &lt; 50000000;&#xA;UPDATE #FSalaAutos SET RUTID = N'xxxxx' + RIGHT(RUTID, 5), NOMBRE_SALA = N'PERSONA', DetalleError = REPLACE(DetalleError, RUTID, N'PERSONA') WHERE RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND TRY_CAST(LEFT(RUTID, 10) AS bigint) &lt; 50000000;&#xA;UPDATE #FCuentaSalesforceAutos SET RUTID = N'xxxxx' + RIGHT(RUTID, 5), NOMBRE_CUENTA_SF = N'PERSONA', NOMBRE_DEALER_SF = NULL, OBSERVACION = NULL, DetalleError = REPLACE(REPLACE(DetalleError, SALESFORCEID, N'PERSONA'), RUTID, N'PERSONA') WHERE RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND TRY_CAST(LEFT(RUTID, 10) AS bigint) &lt; 50000000;&#xA;UPDATE #FAliasAutos SET RUTID = N'xxxxx' + RIGHT(RUTID, 5), ALIAS = N'PERSONA', DetalleError = REPLACE(REPLACE(DetalleError, ALIAS, N'PERSONA'), RUTID, N'PERSONA') WHERE RUTID LIKE '[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9K]' AND TRY_CAST(LEFT(RUTID, 10) AS bigint) &lt; 50000000;&#xA;UPDATE f SET f.SALESFORCEID = N'PERSONA-' + CONVERT(nvarchar(10), f.RowNumber), NOMBRE_CUENTA_SF = N'PERSONA', NOMBRE_DEALER_SF = NULL, OBSERVACION = NULL, f.DetalleError = REPLACE(REPLACE(f.DetalleError, f.SALESFORCEID, N'PERSONA'), f.RUTID, N'PERSONA')&#xA;FROM #FCuentaSalesforceAutos f WHERE f.MotivoFalla = N'CUENTA_PERSONA'&#xA;   OR EXISTS (SELECT 1 FROM #FCuentaSalesforceAutos g WHERE g.RowNumber = f.RowNumber AND g.MotivoFalla = N'CUENTA_PERSONA');&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- Qc DealerAutos: refresca pendientes, agrega nuevas, resuelve lo que ya no falla&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora, q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[RAZON_SOCIAL] = f.[RAZON_SOCIAL], q.[NOMBRE_COMERCIAL] = f.[NOMBRE_COMERCIAL], q.[RUTID_DIC] = f.[RUTID_DIC], q.[ACTIVO] = f.[ACTIVO]&#xA;FROM   HMDCBISA.dbo.V4WQcDealerAutos AS q&#xA;JOIN   #FDealerAutos AS f ON f.[RUTID] = q.[RUTID] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcDealerAutos&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [RUTID], [RAZON_SOCIAL], [NOMBRE_COMERCIAL], [RUTID_DIC], [ACTIVO])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente', @Ahora, @Ahora, f.[RUTID], f.[RAZON_SOCIAL], f.[NOMBRE_COMERCIAL], f.[RUTID_DIC], f.[ACTIVO]&#xA;FROM   #FDealerAutos AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcDealerAutos q WHERE q.[RUTID] = f.[RUTID] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcDealerAutos AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FDealerAutos f WHERE f.[RUTID] = q.[RUTID] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgDealerAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND EXISTS (SELECT 1 FROM #FDealerAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;-- Qc SalaAutos: refresca pendientes, agrega nuevas, resuelve lo que ya no falla&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora, q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[RUTID] = f.[RUTID], q.[NOMBRE_SALA] = f.[NOMBRE_SALA], q.[SUCURSALID_DIC] = f.[SUCURSALID_DIC], q.[ACTIVO] = f.[ACTIVO]&#xA;FROM   HMDCBISA.dbo.V4WQcSalaAutos AS q&#xA;JOIN   #FSalaAutos AS f ON f.[SUCURSALID] = q.[SUCURSALID] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcSalaAutos&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [SUCURSALID], [RUTID], [NOMBRE_SALA], [SUCURSALID_DIC], [ACTIVO])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente', @Ahora, @Ahora, f.[SUCURSALID], f.[RUTID], f.[NOMBRE_SALA], f.[SUCURSALID_DIC], f.[ACTIVO]&#xA;FROM   #FSalaAutos AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcSalaAutos q WHERE q.[SUCURSALID] = f.[SUCURSALID] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcSalaAutos AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FSalaAutos f WHERE f.[SUCURSALID] = q.[SUCURSALID] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgSalaAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND EXISTS (SELECT 1 FROM #FSalaAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;-- Qc CuentaSalesforceAutos: refresca pendientes, agrega nuevas, resuelve lo que ya no falla&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora, q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[TIPO_CUENTA] = f.[TIPO_CUENTA], q.[NOMBRE_CUENTA_SF] = f.[NOMBRE_CUENTA_SF], q.[NOMBRE_DEALER_SF] = f.[NOMBRE_DEALER_SF], q.[RUTID] = f.[RUTID], q.[SUCURSALID] = f.[SUCURSALID], q.[OBSERVACION] = f.[OBSERVACION], q.[ACTIVO] = f.[ACTIVO]&#xA;FROM   HMDCBISA.dbo.V4WQcCuentaSalesforceAutos AS q&#xA;JOIN   #FCuentaSalesforceAutos AS f ON f.[SALESFORCEID] = q.[SALESFORCEID] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcCuentaSalesforceAutos&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [SALESFORCEID], [TIPO_CUENTA], [NOMBRE_CUENTA_SF], [NOMBRE_DEALER_SF], [RUTID], [SUCURSALID], [OBSERVACION], [ACTIVO])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente', @Ahora, @Ahora, f.[SALESFORCEID], f.[TIPO_CUENTA], f.[NOMBRE_CUENTA_SF], f.[NOMBRE_DEALER_SF], f.[RUTID], f.[SUCURSALID], f.[OBSERVACION], f.[ACTIVO]&#xA;FROM   #FCuentaSalesforceAutos AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcCuentaSalesforceAutos q WHERE q.[SALESFORCEID] = f.[SALESFORCEID] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcCuentaSalesforceAutos AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FCuentaSalesforceAutos f WHERE f.[SALESFORCEID] = q.[SALESFORCEID] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgCuentaSalesforceAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND EXISTS (SELECT 1 FROM #FCuentaSalesforceAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;-- Qc AliasAutos: refresca pendientes, agrega nuevas, resuelve lo que ya no falla&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora, q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[ALIAS] = f.[ALIAS], q.[ORIGEN] = f.[ORIGEN], q.[RUTID] = f.[RUTID], q.[SUCURSALID] = f.[SUCURSALID], q.[ACTIVO] = f.[ACTIVO]&#xA;FROM   HMDCBISA.dbo.V4WQcAliasAutos AS q&#xA;JOIN   #FAliasAutos AS f ON f.[ALIASID] = q.[ALIASID] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcAliasAutos&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [ALIASID], [ALIAS], [ORIGEN], [RUTID], [SUCURSALID], [ACTIVO])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente', @Ahora, @Ahora, f.[ALIASID], f.[ALIAS], f.[ORIGEN], f.[RUTID], f.[SUCURSALID], f.[ACTIVO]&#xA;FROM   #FAliasAutos AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcAliasAutos q WHERE q.[ALIASID] = f.[ALIASID] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcAliasAutos AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FAliasAutos f WHERE f.[ALIASID] = q.[ALIASID] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgAliasAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND EXISTS (SELECT 1 FROM #FAliasAutos f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;-- Avisos que no bloquean (V4WQcCampo): vigentes se refrescan, nuevos se agregan, los que ya no aparecen se cierran&#xA;UPDATE q SET q.ExecutionIDUltima = @ExecutionID, q.FechaUltima = @Ahora, q.ValorOriginal = a.Valor&#xA;FROM   HMDCBISA.dbo.V4WQcCampo q&#xA;JOIN   #Aviso a ON a.Clave = q.ClaveRegistro AND a.Columna = q.Columna AND a.Motivo = q.MotivoFalla&#xA;WHERE  q.ProcessID = @ProcessID AND q.Vigente = 1;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcCampo (ProcessID, Objeto, TablaStg, ClaveRegistro, Columna, ValorOriginal, MotivoFalla,&#xA;       ExecutionIDDeteccion, ExecutionIDUltima, FechaDeteccion, FechaUltima, Vigente)&#xA;SELECT @ProcessID, a.Objeto, a.TablaStg, a.Clave, a.Columna, a.Valor, a.Motivo, @ExecutionID, @ExecutionID, @Ahora, @Ahora, 1&#xA;FROM   #Aviso a&#xA;WHERE  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcCampo q WHERE q.ProcessID = @ProcessID AND q.ClaveRegistro = a.Clave&#xA;                   AND q.Columna = a.Columna AND q.MotivoFalla = a.Motivo AND q.Vigente = 1);&#xA;&#xA;UPDATE q SET q.Vigente = 0, q.ExecutionIDCorreccion = @ExecutionID, q.FechaCorreccion = @Ahora&#xA;FROM   HMDCBISA.dbo.V4WQcCampo q&#xA;WHERE  q.ProcessID = @ProcessID AND q.Vigente = 1&#xA;  AND  q.MotivoFalla IN (N'RUTID_DIC_NO_EXISTE', N'SUCURSALID_DIC_NO_EXISTE', N'NOMBRE_SF_DISTINTO')&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Aviso a WHERE a.Clave = q.ClaveRegistro AND a.Columna = q.Columna AND a.Motivo = q.MotivoFalla);&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT (SELECT COUNT(DISTINCT RowNumber) FROM #FDealerAutos) + (SELECT COUNT(DISTINCT RowNumber) FROM #FSalaAutos) + (SELECT COUNT(DISTINCT RowNumber) FROM #FCuentaSalesforceAutos) + (SELECT COUNT(DISTINCT RowNumber) FROM #FAliasAutos) AS RowsQc;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsQc"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
