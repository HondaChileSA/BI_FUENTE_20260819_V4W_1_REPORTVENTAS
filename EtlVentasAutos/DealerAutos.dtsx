          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL06ValidateFile — V4W · DealerAutos (ProcessID 47) · Script Task · v1.0
 *
 * Copia del ETL06ValidateFile de ModeloGrupo (38). Solo cambia el bloque Config: proceso, tablas Stg/Qc y columnas de la tabla de pendientes (con la hoja).
 * Las tablas se leen como una tabla derivada (UNION ALL de las 4 entidades del maestro), así el resto del
 * script no se toca. Variables: las mismas de ModeloGrupo.
 *
 * Desarrollador: Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024 · C# 7.3 / .NET Framework (SSIS 2019)
 * Texto original de la plantilla (DIC / ModeloGrupo):
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Diagnostics;
