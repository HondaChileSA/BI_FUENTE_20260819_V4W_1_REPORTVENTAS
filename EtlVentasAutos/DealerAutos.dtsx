    <DTS:Executable
      DTS:refId="Package\ETL07LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EED01DC0-1F13-43E1-9145-0BEE500B8DB9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL07LoadDWHDW"
