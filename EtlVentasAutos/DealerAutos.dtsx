    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1F96ED97-0049-418F-AA98-784AB6E6353E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* DealerAutos__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U de las 4 entidades (antes y después; el JSON lleva la entidad, SOL-012 §4), antes de ETL08UpdateDWHDW.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'U',&#xA;       (SELECT N'DealerAutos' AS Entidad, tgt.[RUTID], tgt.[RAZON_SOCIAL], tgt.[NOMBRE_COMERCIAL], tgt.[RUTID_DIC], tgt.[ACTIVO], tgt.ExecutionID, tgt.Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT N'DealerAutos' AS Entidad, src.[RUTID], src.[RAZON_SOCIAL], src.[NOMBRE_COMERCIAL], src.[RUTID_DIC], src.[ACTIVO], src.ExecutionID, src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBaseDealerAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadDealerAutos AS src ON src.[RUTID] = tgt.[RUTID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U';&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'U',&#xA;       (SELECT N'SalaAutos' AS Entidad, tgt.[SUCURSALID], tgt.[RUTID], tgt.[NOMBRE_SALA], tgt.[SUCURSALID_DIC], tgt.[ACTIVO], tgt.ExecutionID, tgt.Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT N'SalaAutos' AS Entidad, src.[SUCURSALID], src.[RUTID], src.[NOMBRE_SALA], src.[SUCURSALID_DIC], src.[ACTIVO], src.ExecutionID, src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBaseSalaAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadSalaAutos AS src ON src.[SUCURSALID] = tgt.[SUCURSALID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U';&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'U',&#xA;       (SELECT N'CuentaSalesforceAutos' AS Entidad, tgt.[SALESFORCEID], tgt.[TIPO_CUENTA], tgt.[NOMBRE_CUENTA_SF], tgt.[NOMBRE_DEALER_SF], tgt.[RUTID], tgt.[SUCURSALID], tgt.[OBSERVACION], tgt.[ACTIVO], tgt.ExecutionID, tgt.Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT N'CuentaSalesforceAutos' AS Entidad, src.[SALESFORCEID], src.[TIPO_CUENTA], src.[NOMBRE_CUENTA_SF], src.[NOMBRE_DEALER_SF], src.[RUTID], src.[SUCURSALID], src.[OBSERVACION], src.[ACTIVO], src.ExecutionID, src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadCuentaSalesforceAutos AS src ON src.[SALESFORCEID] = tgt.[SALESFORCEID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U';&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'U',&#xA;       (SELECT N'AliasAutos' AS Entidad, tgt.[ALIASID], tgt.[ALIAS], tgt.[ORIGEN], tgt.[RUTID], tgt.[SUCURSALID], tgt.[ACTIVO], tgt.ExecutionID, tgt.Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT N'AliasAutos' AS Entidad, src.[ALIASID], src.[ALIAS], src.[ORIGEN], src.[RUTID], src.[SUCURSALID], src.[ACTIVO], src.ExecutionID, src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBaseAliasAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadAliasAutos AS src ON src.[ALIASID] = tgt.[ALIASID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
