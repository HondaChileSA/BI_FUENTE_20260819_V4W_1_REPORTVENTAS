          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL04LoadDWHSA — V4W · DealerAutos (ProcessID 47) · Script Task · v1.0
 *
 * Reemplaza al Data Flow "ETL04LoadDWHSA" de ModeloGrupo (38): un Data Flow emite una sola salida y el
 * maestro tiene 4 hojas, así que la carga a Stg es un Script Task con SqlBulkCopy (forma de GestionDealer, 36).
 *
 * Lee MaestroDealerAutos.xlsx (OLE DB ACE 12.0, HDR=YES, IMEX=1) y carga en HMDCBISA, en orden:
 *   hoja Dealer           → dbo.V4WStgDealerAutos
 *   hoja Sala             → dbo.V4WStgSalaAutos
 *   hoja CuentaSalesforce → dbo.V4WStgCuentaSalesforceAutos
 *   hoja Alias            → dbo.V4WStgAliasAutos
 * Reglas (las mismas columnas que COLUMN_DEFS de ETL02ValidateFile):
 *   - Trim de todos los textos. RUTID y TIPO_CUENTA en mayúsculas. El Id de Salesforce se deja tal cual.
 *   - Filas completamente vacías se ignoran.
 *   - Filas con formato inválido (tipo, largo u obligatoria vacía) se omiten y se cuentan en
 *     User::EtlFilasFormatoInvalido (ya quedaron informadas en el correo L3 de ETL02ValidateFile).
 *   - Las reglas de negocio (duplicados, formato de RUT, cascada entre hojas, Salesforce) las hace
 *     ETL05ValidateMaestro en SQL, porque la Qc es persistente.
 *   - RowNumber = fila de Excel (la 1 es el encabezado).
 *
 * ReadOnlyVariables : $Package::EtlFilePath, User::CtlExecutionID, $Project::vSQLConnStr
 * ReadWriteVariables: User::EtlFilasFormatoInvalido
 *
 * Desarrollador: Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024 · C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Globalization;
using System.Linq;
#endregion

namespace ST_c59af4df1f234953af61382a14a2a4c2
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private static class Config
        {
            public const string ComponentName = "ETL04LoadDWHSA";
            public const int TimeoutSeg = 600;

            public static readonly HojaDef[] HOJAS = new HojaDef[]
            {
                new HojaDef("Dealer", "dbo.V4WStgDealerAutos", new[]
                {
                    new Col("RUTID",            "string",  12,  true,  Up: true, aliases: new[] { "RUT ID", "ID_RUT" }),
                    new Col("RAZON_SOCIAL",     "string",  255, true,  aliases: new[] { "RAZON SOCIAL" }),
                    new Col("NOMBRE_COMERCIAL", "string",  255, false, aliases: new[] { "NOMBRE COMERCIAL", "RAZON_SOCIAL_COMERCIAL" }),
                    new Col("RUTID_DIC",        "string",  12,  false, Up: true, aliases: new[] { "RUTID DIC" }),
                    new Col("ACTIVO",           "boolean", 0,   true,  aliases: new[] { "ACTIVE", "VIGENTE" }),
                }),
                new HojaDef("Sala", "dbo.V4WStgSalaAutos", new[]
                {
                    new Col("SUCURSALID",       "number",  0,   true,  aliases: new[] { "SUCURSAL ID", "SALAID" }),
                    new Col("RUTID",            "string",  12,  true,  Up: true, aliases: new[] { "RUT ID" }),
                    new Col("NOMBRE_SALA",      "string",  255, true,  aliases: new[] { "NOMBRE SALA", "SALA" }),
                    new Col("SUCURSALID_DIC",   "number",  0,   false, aliases: new[] { "SUCURSALID DIC" }),
                    new Col("ACTIVO",           "boolean", 0,   true,  aliases: new[] { "ACTIVE", "VIGENTE" }),
                }),
                new HojaDef("CuentaSalesforce", "dbo.V4WStgCuentaSalesforceAutos", new[]
                {
                    new Col("SALESFORCEID",     "string",  18,  true,  aliases: new[] { "SALESFORCE ID", "ID" }),
                    new Col("TIPO_CUENTA",      "string",  15,  true,  Up: true, aliases: new[] { "TIPO CUENTA", "TIPO" }),
                    new Col("NOMBRE_CUENTA_SF", "string",  255, false, aliases: new[] { "NOMBRE CUENTA SF" }),
                    new Col("NOMBRE_DEALER_SF", "string",  255, false, aliases: new[] { "NOMBRE DEALER SF" }),
                    new Col("RUTID",            "string",  12,  true,  Up: true, aliases: new[] { "RUT ID" }),
                    new Col("SUCURSALID",       "number",  0,   false, aliases: new[] { "SUCURSAL ID" }),
                    new Col("OBSERVACION",      "string",  500, false, aliases: new[] { "OBSERVACIONES" }),
                    new Col("ACTIVO",           "boolean", 0,   true,  aliases: new[] { "ACTIVE", "VIGENTE" }),
                }),
                new HojaDef("Alias", "dbo.V4WStgAliasAutos", new[]
                {
                    new Col("ALIASID",          "number",  0,   true,  aliases: new[] { "ALIAS ID" }),
                    new Col("ALIAS",            "string",  255, true,  aliases: new[] { "TEXTO" }),
                    new Col("ORIGEN",           "string",  50,  true),
                    new Col("RUTID",            "string",  12,  true,  Up: true, aliases: new[] { "RUT ID" }),
                    new Col("SUCURSALID",       "number",  0,   false, aliases: new[] { "SUCURSAL ID" }),
                    new Col("ACTIVO",           "boolean", 0,   true,  aliases: new[] { "ACTIVE", "VIGENTE" }),
                }),
            };
        }

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                long execId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                string filePath = Convert.ToString(Dts.Variables["$Package::EtlFilePath"].Value);
                string connStg = Convert.ToString(Dts.Variables["$Project::vSQLConnStr"].Value);

                int invalidasTotal = 0;
                var tablas = new List<KeyValuePair<HojaDef, DataTable>>();

                using (var cn = new OleDbConnection(
                    "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + filePath +
                    ";Extended Properties='Excel 12.0 Xml;HDR=YES;IMEX=1';"))
                {
                    cn.Open();
                    foreach (var hoja in Config.HOJAS)
                    {
                        var raw = new DataTable();
                        using (var da = new OleDbDataAdapter("SELECT * FROM [" + hoja.Nombre + "$]", cn)) da.Fill(raw);

                        int invalidas;
                        DataTable t = Convertir(raw, hoja, execId, out invalidas);
                        invalidasTotal += invalidas;
                        tablas.Add(new KeyValuePair<HojaDef, DataTable>(hoja, t));
                        Dts.Events.FireInformation(0, Config.ComponentName,
                            string.Format("Hoja {0}: {1} filas a Stg · {2} con formato inválido", hoja.Nombre, t.Rows.Count, invalidas),
                            "", 0, ref fireAgain);
                    }
                }

                // Orden de carga Dealer → Sala → CuentaSalesforce → Alias (todas en Stg antes de validar)
                foreach (var kv in tablas) Bulk(connStg, kv.Key.Tabla, kv.Value);

                Dts.Variables["User::EtlFilasFormatoInvalido"].Value = invalidasTotal;
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ComponentName, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // Convierte la hoja leída a la tabla de Stg: solo filas con formato válido.
        private static DataTable Convertir(DataTable raw, HojaDef hoja, long execId, out int invalidas)
        {
            invalidas = 0;
            var idx = new Dictionary<string, int>(StringComparer.Ordinal);
            var faltan = new List<string>();
            foreach (var c in hoja.Columnas)
            {
                int i = FindCol(raw, c);
                idx[c.Nombre] = i;
                if (i < 0) faltan.Add(c.Nombre);
            }
            if (faltan.Count > 0)
                throw new Exception("Hoja " + hoja.Nombre + ": columnas no encontradas: " + string.Join(", ", faltan.ToArray()));

            var t = new DataTable();
            t.Columns.Add("ExecutionID", typeof(long));
            t.Columns.Add("RowNumber", typeof(int));
            foreach (var c in hoja.Columnas)
                t.Columns.Add(c.Nombre, c.Tipo == "number" ? typeof(int) : c.Tipo == "boolean" ? typeof(bool) : typeof(string));

            int rowNumber = 1;   // fila 1 = encabezado
            foreach (DataRow row in raw.Rows)
            {
                rowNumber++;
                if (IsRowAllEmpty(row)) continue;

                var nr = t.NewRow();
                nr["ExecutionID"] = execId;
                nr["RowNumber"] = rowNumber;
                bool ok = true;
                foreach (var c in hoja.Columnas)
                {
                    int i = idx[c.Nombre];
                    string v = row.IsNull(i) ? "" : Convert.ToString(row[i], CultureInfo.InvariantCulture).Trim();
                    if (v == "")
                    {
                        if (c.Obligatoria) { ok = false; break; }
                        nr[c.Nombre] = DBNull.Value;
                        continue;
                    }
                    if (c.Tipo == "string")
                    {
                        if (c.Mayusculas) v = v.ToUpperInvariant();
                        if (c.Largo > 0 && v.Length > c.Largo) { ok = false; break; }
                        nr[c.Nombre] = v;
                    }
                    else if (c.Tipo == "number")
                    {
                        decimal d;
                        if (!decimal.TryParse(v, NumberStyles.Any, CultureInfo.InvariantCulture, out d) || d != decimal.Truncate(d)
                            || d > int.MaxValue || d < int.MinValue) { ok = false; break; }
                        nr[c.Nombre] = (int)d;
                    }
                    else
                    {
                        bool b;
                        if (!TryBool(v, out b)) { ok = false; break; }
                        nr[c.Nombre] = b;
                    }
                }
                if (!ok) { invalidas++; continue; }
                t.Rows.Add(nr);
            }
            return t;
        }

        private static bool TryBool(string v, out bool b)
        {
            v = v.Trim().ToLowerInvariant();
            b = v == "true" || v == "1" || v == "si" || v == "yes" || v == "verdadero";
            return b || v == "false" || v == "0" || v == "no" || v == "falso";
        }

        private static bool IsRowAllEmpty(DataRow row)
        {
            foreach (object v in row.ItemArray)
                if (v != null && v != DBNull.Value && v.ToString().Trim() != "") return false;
            return true;
        }

        private static string Norm(string s)
        {
            if (string.IsNullOrWhiteSpace(s)) return "";
            return s.Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
        }

        // Mismo criterio que L2 de ETL02ValidateFile: nombre o alias, exacto o normalizado.
        private static int FindCol(DataTable dt, Col c)
        {
            var buscados = new List<string> { Norm(c.Nombre) };
            if (c.Alias != null) buscados.AddRange(c.Alias.Select(Norm));
            for (int i = 0; i < dt.Columns.Count; i++)
                if (buscados.Contains(Norm(dt.Columns[i].ColumnName))) return i;
            return -1;
        }

        private static void Bulk(string connStr, string tabla, DataTable t)
        {
            if (t.Rows.Count == 0) return;
            using (var cn = new SqlConnection(connStr))
            {
                cn.Open();
                using (var b = new SqlBulkCopy(cn, SqlBulkCopyOptions.CheckConstraints, null))
                {
                    b.DestinationTableName = tabla;
                    b.BulkCopyTimeout = Config.TimeoutSeg;
                    foreach (DataColumn c in t.Columns) b.ColumnMappings.Add(c.ColumnName, c.ColumnName);
                    b.WriteToServer(t);
                }
            }
        }

        private class HojaDef
        {
            public string Nombre; public string Tabla; public Col[] Columnas;
            public HojaDef(string nombre, string tabla, Col[] columnas) { Nombre = nombre; Tabla = tabla; Columnas = columnas; }
        }

        private class Col
        {
            public string Nombre; public string Tipo; public int Largo; public bool Obligatoria; public bool Mayusculas; public string[] Alias;
            public Col(string nombre, string tipo, int largo, bool obligatoria, bool Up = false, string[] aliases = null)
            { Nombre = nombre; Tipo = tipo; Largo = largo; Obligatoria = obligatoria; Mayusculas = Up; Alias = aliases ?? new string[0]; }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
