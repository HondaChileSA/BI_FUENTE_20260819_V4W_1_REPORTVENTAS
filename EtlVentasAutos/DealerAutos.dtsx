      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL07LoadDWHDW_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL07LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma las 4 Load con TypeLoad I/U por hash (SHA-256 → bigint, todas las columnas de negocio, columnas explícitas). Solo filas nuevas o con hash distinto. Devuelve RowsRead (suma de las 4 Stg).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID  (el BatchId se toma de CTLAuditBatch, abierto por CTL04OpenBatchId)&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadDealerAutos&#xA;       ([RUTID], [RAZON_SOCIAL], [NOMBRE_COMERCIAL], [RUTID_DIC], [ACTIVO], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[RUTID], s.[RAZON_SOCIAL], s.[NOMBRE_COMERCIAL], s.[RUTID_DIC], s.[ACTIVO], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.[RUTID] IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.[RUTID] IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   HMDCBISA.dbo.V4WStgDealerAutos AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(500), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[RAZON_SOCIAL]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[NOMBRE_COMERCIAL]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[RUTID_DIC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ACTIVO]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseDealerAutos AS b ON b.[RUTID] = s.[RUTID]&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (b.[RUTID] IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo);&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadSalaAutos&#xA;       ([SUCURSALID], [RUTID], [NOMBRE_SALA], [SUCURSALID_DIC], [ACTIVO], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[SUCURSALID], s.[RUTID], s.[NOMBRE_SALA], s.[SUCURSALID_DIC], s.[ACTIVO], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.[SUCURSALID] IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.[SUCURSALID] IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   HMDCBISA.dbo.V4WStgSalaAutos AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(500), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[NOMBRE_SALA]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[SUCURSALID_DIC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ACTIVO]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseSalaAutos AS b ON b.[SUCURSALID] = s.[SUCURSALID]&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (b.[SUCURSALID] IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo);&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadCuentaSalesforceAutos&#xA;       ([SALESFORCEID], [TIPO_CUENTA], [NOMBRE_CUENTA_SF], [NOMBRE_DEALER_SF], [RUTID], [SUCURSALID], [OBSERVACION], [ACTIVO], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[SALESFORCEID], s.[TIPO_CUENTA], s.[NOMBRE_CUENTA_SF], s.[NOMBRE_DEALER_SF], s.[RUTID], s.[SUCURSALID], s.[OBSERVACION], s.[ACTIVO], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.[SALESFORCEID] IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.[SALESFORCEID] IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   HMDCBISA.dbo.V4WStgCuentaSalesforceAutos AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(500), s.[SALESFORCEID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[TIPO_CUENTA]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[NOMBRE_CUENTA_SF]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[NOMBRE_DEALER_SF]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[OBSERVACION]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ACTIVO]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS b ON b.[SALESFORCEID] = s.[SALESFORCEID]&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (b.[SALESFORCEID] IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo);&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadAliasAutos&#xA;       ([ALIASID], [ALIAS], [ORIGEN], [RUTID], [SUCURSALID], [ACTIVO], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[ALIASID], s.[ALIAS], s.[ORIGEN], s.[RUTID], s.[SUCURSALID], s.[ACTIVO], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.[ALIASID] IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.[ALIASID] IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   HMDCBISA.dbo.V4WStgAliasAutos AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(500), s.[ALIASID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ALIAS]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ORIGEN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), s.[ACTIVO]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseAliasAutos AS b ON b.[ALIASID] = s.[ALIASID]&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (b.[ALIASID] IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgDealerAutos WHERE ExecutionID = @ExecutionID) + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgSalaAutos WHERE ExecutionID = @ExecutionID) + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgCuentaSalesforceAutos WHERE ExecutionID = @ExecutionID) + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgAliasAutos WHERE ExecutionID = @ExecutionID) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL08UpdateDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{70D629A4-1BA1-403C-A916-F28845BAEA28}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL08UpdateDWHDW"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL08UpdateDWHDW_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL08UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U con hash distinto de las 4 entidades, en orden Dealer → Sala → CuentaSalesforce → Alias. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;UPDATE tgt&#xA;SET    tgt.[RAZON_SOCIAL] = src.[RAZON_SOCIAL], tgt.[NOMBRE_COMERCIAL] = src.[NOMBRE_COMERCIAL], tgt.[RUTID_DIC] = src.[RUTID_DIC], tgt.[ACTIVO] = src.[ACTIVO],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseDealerAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadDealerAutos AS src ON src.[RUTID] = tgt.[RUTID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;UPDATE tgt&#xA;SET    tgt.[RUTID] = src.[RUTID], tgt.[NOMBRE_SALA] = src.[NOMBRE_SALA], tgt.[SUCURSALID_DIC] = src.[SUCURSALID_DIC], tgt.[ACTIVO] = src.[ACTIVO],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseSalaAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadSalaAutos AS src ON src.[SUCURSALID] = tgt.[SUCURSALID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;UPDATE tgt&#xA;SET    tgt.[TIPO_CUENTA] = src.[TIPO_CUENTA], tgt.[NOMBRE_CUENTA_SF] = src.[NOMBRE_CUENTA_SF], tgt.[NOMBRE_DEALER_SF] = src.[NOMBRE_DEALER_SF], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[OBSERVACION] = src.[OBSERVACION], tgt.[ACTIVO] = src.[ACTIVO],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadCuentaSalesforceAutos AS src ON src.[SALESFORCEID] = tgt.[SALESFORCEID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;UPDATE tgt&#xA;SET    tgt.[ALIAS] = src.[ALIAS], tgt.[ORIGEN] = src.[ORIGEN], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[ACTIVO] = src.[ACTIVO],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseAliasAutos AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadAliasAutos AS src ON src.[ALIASID] = tgt.[ALIASID]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;SELECT @N AS RowsUpdated;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL09InsertDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2A0EA155-ECC4-44A6-9C5F-CB776FA4E952}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL09InsertDWHDW"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL09InsertDWHDW_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL09InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I de las 4 entidades, en orden Dealer → Sala → CuentaSalesforce → Alias. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @N int = 0;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseDealerAutos ([RUTID], [RAZON_SOCIAL], [NOMBRE_COMERCIAL], [RUTID_DIC], [ACTIVO], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[RUTID], s.[RAZON_SOCIAL], s.[NOMBRE_COMERCIAL], s.[RUTID_DIC], s.[ACTIVO], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadDealerAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseSalaAutos ([SUCURSALID], [RUTID], [NOMBRE_SALA], [SUCURSALID_DIC], [ACTIVO], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[SUCURSALID], s.[RUTID], s.[NOMBRE_SALA], s.[SUCURSALID_DIC], s.[ACTIVO], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadSalaAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos ([SALESFORCEID], [TIPO_CUENTA], [NOMBRE_CUENTA_SF], [NOMBRE_DEALER_SF], [RUTID], [SUCURSALID], [OBSERVACION], [ACTIVO], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[SALESFORCEID], s.[TIPO_CUENTA], s.[NOMBRE_CUENTA_SF], s.[NOMBRE_DEALER_SF], s.[RUTID], s.[SUCURSALID], s.[OBSERVACION], s.[ACTIVO], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadCuentaSalesforceAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseAliasAutos ([ALIASID], [ALIAS], [ORIGEN], [RUTID], [SUCURSALID], [ACTIVO], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[ALIASID], s.[ALIAS], s.[ORIGEN], s.[RUTID], s.[SUCURSALID], s.[ACTIVO], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadAliasAutos AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;SELECT @N AS RowsInsert;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL10ReevaluateQc"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{30933BEB-96CC-4D8F-BC89-74FC457C0F3F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL10ReevaluateQc"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL10ReevaluateQc_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL10ReevaluateQc&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Camino SIN CAMBIOS del archivo: re-evalúa la Qc pendiente ID_NO_EXISTE_EN_SALESFORCE (único motivo que depende de otra fuente) contra SFOBaseAccount. Si la cuenta ya existe, no es persona, su dealer y su sala (si tiene) están en Base y no tiene otro motivo pendiente, pasa a Base y queda Resuelta. Devuelve RowsReevaluadas.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;IF OBJECT_ID(N'tempdb..#Pasa') IS NOT NULL DROP TABLE #Pasa;&#xA;&#xA;SELECT q.QcID, q.[SALESFORCEID], q.[TIPO_CUENTA], q.[NOMBRE_CUENTA_SF], q.[NOMBRE_DEALER_SF], q.[RUTID], q.[SUCURSALID], q.[OBSERVACION], q.[ACTIVO]&#xA;INTO   #Pasa&#xA;FROM   HMDCBISA.dbo.V4WQcCuentaSalesforceAutos AS q&#xA;WHERE  q.EstadoQc = N'Pendiente' AND q.MotivoFalla = N'ID_NO_EXISTE_EN_SALESFORCE'&#xA;  AND  EXISTS (SELECT 1 FROM HMDCBIDW.dbo.SFOBaseAccount a&#xA;               WHERE a.Id = q.SALESFORCEID AND ISNULL(a.IsDeleted, 0) = 0 AND ISNULL(a.IsPersonAccount, 0) = 0)&#xA;  AND  EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseDealerAutos d WHERE d.RUTID = q.RUTID)&#xA;  AND  (q.SUCURSALID IS NULL OR EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseSalaAutos x WHERE x.SUCURSALID = q.SUCURSALID AND x.RUTID = q.RUTID))&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcCuentaSalesforceAutos o&#xA;                   WHERE o.SALESFORCEID = q.SALESFORCEID AND o.EstadoQc = N'Pendiente' AND o.QcID &lt;&gt; q.QcID);&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;MERGE HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS tgt&#xA;USING (SELECT p.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(500), p.[SALESFORCEID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[TIPO_CUENTA]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[NOMBRE_CUENTA_SF]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[NOMBRE_DEALER_SF]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[OBSERVACION]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(500), p.[ACTIVO]), N''))), 1, 8)) AS HashNuevo FROM #Pasa AS p) AS src&#xA;   ON tgt.SALESFORCEID = src.SALESFORCEID&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[TIPO_CUENTA] = src.[TIPO_CUENTA], tgt.[NOMBRE_CUENTA_SF] = src.[NOMBRE_CUENTA_SF], tgt.[NOMBRE_DEALER_SF] = src.[NOMBRE_DEALER_SF], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[OBSERVACION] = src.[OBSERVACION], tgt.[ACTIVO] = src.[ACTIVO],&#xA;                tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([SALESFORCEID], [TIPO_CUENTA], [NOMBRE_CUENTA_SF], [NOMBRE_DEALER_SF], [RUTID], [SUCURSALID], [OBSERVACION], [ACTIVO], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[SALESFORCEID], src.[TIPO_CUENTA], src.[NOMBRE_CUENTA_SF], src.[NOMBRE_DEALER_SF], src.[RUTID], src.[SUCURSALID], src.[OBSERVACION], src.[ACTIVO], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcCuentaSalesforceAutos AS q&#xA;JOIN   #Pasa AS p ON p.QcID = q.QcID;&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(*) AS RowsReevaluadas FROM #Pasa;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsReevaluadas"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL11RegisterFile"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E3E7AAB4-8296-4A41-B4BE-EB76D3112467}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL11RegisterFile"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* DealerAutos__ETL11RegisterFile_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: ETL11RegisterFile&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Registra el archivo en V4WBaseArchivoCargado. Estado = 'Cargado' (camino de carga) o 'SinCambios' (camino sin cambios). En 'SinCambios' las filas van en 0. Igual que ModeloGrupo.&#xA;   Parámetros (OLE DB, en orden): 1) $Package::CtlProcessID · 2) $Package::EtlFilePath · 3) User::EtlFileModifiedDate · 4) User::EtlTamanoBytes · 5) User::EtlHashArchivo · 6) User::CtlExecutionID · 7) User::EtlEstadoArchivo · 8) User::CtlRowsInserted · 9) User::CtlRowsUpdated · 10) User::CtlRowsFailed · 11) User::EtlFilasFormatoInvalido&#xA;*/&#xA;DECLARE @ProcessID int = ?, @Ruta nvarchar(400) = ?, @FechaMod datetime2(0) = ?, @Tamano bigint = ?,&#xA;        @HashHex varchar(64) = ?, @ExecutionID bigint = ?, @Estado nvarchar(20) = ?,&#xA;        @Ins int = ?, @Upd int = ?, @Qc int = ?, @Invalidas int = ?;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseArchivoCargado&#xA;       (ProcessID, Archivo, Ruta, FechaCorte, FechaModificacion, TamanoBytes, HashArchivo,&#xA;        ExecutionID, Estado, FilasCargadas, FilasQc, Aviso)&#xA;VALUES (@ProcessID,&#xA;        RIGHT(@Ruta, CHARINDEX(N'\', REVERSE(@Ruta)) - 1),&#xA;        @Ruta, NULL, @FechaMod, @Tamano, CONVERT(binary(32), @HashHex, 2),&#xA;        @ExecutionID, @Estado,&#xA;        CASE WHEN @Estado = N'Cargado' THEN @Ins + @Upd ELSE 0 END,&#xA;        CASE WHEN @Estado = N'Cargado' THEN @Qc ELSE 0 END,&#xA;        CASE WHEN @Invalidas &gt; 0 THEN CONVERT(nvarchar(20), @Invalidas) + N' filas con formato inválido (ver correo L3 de ETL02ValidateFile)' END);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
