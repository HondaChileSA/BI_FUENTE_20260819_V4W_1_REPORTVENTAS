      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* DealerAutos__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo (las fuentes de archivo usan hash). Fecha = último cambio en las 4 Base; LastID = mayor ALIASID. Full result set.&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;SELECT (SELECT ISNULL(MAX(x.Fecha), '1900-01-01') FROM (&#xA;    SELECT MAX(ISNULL(LastModifiedDate, CreateDate)) AS Fecha FROM HMDCBIDW.dbo.V4WBaseDealerAutos&#xA;    UNION ALL&#xA;    SELECT MAX(ISNULL(LastModifiedDate, CreateDate)) AS Fecha FROM HMDCBIDW.dbo.V4WBaseSalaAutos&#xA;    UNION ALL&#xA;    SELECT MAX(ISNULL(LastModifiedDate, CreateDate)) AS Fecha FROM HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos&#xA;    UNION ALL&#xA;    SELECT MAX(ISNULL(LastModifiedDate, CreateDate)) AS Fecha FROM HMDCBIDW.dbo.V4WBaseAliasAutos&#xA;        ) AS x) AS NewLoadDate,&#xA;       ISNULL((SELECT CONVERT(nvarchar(50), MAX(ALIASID)) FROM HMDCBIDW.dbo.V4WBaseAliasAutos), N'') AS NewLastID;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
