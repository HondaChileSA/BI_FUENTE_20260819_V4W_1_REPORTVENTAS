    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3BA5467C-FA59-41EA-AC8D-C74B61651E5C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* DealerAutos__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : DealerAutos (EtlVentasAutos, ProcessID 47) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-24 · plan ARQ7 v1 · SOL-024, D-ARQ-74, D-91 a D-100&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_dealerautos.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote de auditoría. FailedRows = pendientes de Qc de las 4 entidades vistos en esta ejecución. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @FailedRows int =&#xA;      (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcDealerAutos WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente')&#xA;    + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcSalaAutos WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente')&#xA;    + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcCuentaSalesforceAutos WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente')&#xA;    + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcAliasAutos WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = @FailedRows&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;&#xA;SELECT @FailedRows AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
