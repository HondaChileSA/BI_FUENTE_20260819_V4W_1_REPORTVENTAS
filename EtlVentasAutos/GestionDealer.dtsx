ja], s.[FilaOrigen], s.[Canal], s.[Orden], s.[ModeloArea], s.[NivelArea], s.[EsDetalle], s.[AvanceReal], s.[Meta2QFC], s.[MetaNiguri], s.[PlanMTD2QFC], s.[PlanMTDNiguri], s.[PlanDealers], s.[FCDLR], s.[MesAnterior], s.[StockHonda], s.[SpecialSales], s.[FactorArea], s.[DiaArea], s.[LeadsMTD], s.[LeadsWebMTD], s.[LeadsMesAnteriorMTD], s.[LeadTargetWeb], s.[WebSales], s.[Modelo], s.[Familia], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadAvanceDiario AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseStockDealer ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [VIN], [ConcesionarioArea], [ModeloArea], [Color], [Retail], [Fuente], [CondicionVenta], [Renovacion], [Credito], [RUTID], [SUCURSALID], [CodigoArticulo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[Archivo], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[VIN], s.[ConcesionarioArea], s.[ModeloArea], s.[Color], s.[Retail], s.[Fuente], s.[CondicionVenta], s.[Renovacion], s.[Credito], s.[RUTID], s.[SUCURSALID], s.[CodigoArticulo], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadStockDealer AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND s.TypeLoad = N'I';&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsInsert;&#xA;"
