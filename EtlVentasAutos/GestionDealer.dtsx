    <DTS:Executable
      DTS:refId="Package\ETL11ReevaluateQc"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{282B5C40-96A4-45CE-B378-88D5947276CE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL11ReevaluateQc"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* GestionDealer__ETL11ReevaluateQc_v1.1.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: ETL11ReevaluateQc&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_gestiondealer_v2.py (no editar a mano: regenerar)&#xA;   v1.1    : 2026-11-24 · Franco Véliz (Agente V4W) · ARQ7 E2 (plan_E2 v2): alias y sala única del maestro de Autos (V4WBaseAliasAutos, V4WBaseSalaAutos, D-95); sin DIC ni sociedad (D-ARQ-76)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Corre en las dos ramas: re-evalúa TODA la Qc pendiente de las 3 entidades contra los maestros actuales (por ejemplo, un alias creado hoy). Lo que ya no falla pasa a Base y queda Resuelto, sin recargar el archivo.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;&#xA;-- ── Maestros (maestro de Autos V4WBase*Autos; modelos V4W) ──────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#AliasAutos') IS NOT NULL DROP TABLE #AliasAutos;&#xA;IF OBJECT_ID(N'tempdb..#SalaUnica')  IS NOT NULL DROP TABLE #SalaUnica;&#xA;IF OBJECT_ID(N'tempdb..#ModAlias')   IS NOT NULL DROP TABLE #ModAlias;&#xA;IF OBJECT_ID(N'tempdb..#Vin')        IS NOT NULL DROP TABLE #Vin;&#xA;&#xA;-- Alias del área: texto → dealer y sala (NULL = alias de dealer) del maestro de Autos (SOL-024, D-ARQ-74); sin sociedad&#xA;SELECT x.Alias, x.RUTID, x.SUCURSALID&#xA;INTO   #AliasAutos&#xA;FROM (&#xA;    SELECT UPPER(LTRIM(RTRIM(al.ALIAS))) AS Alias, al.RUTID, al.SUCURSALID,&#xA;           ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(al.ALIAS))) ORDER BY al.ALIASID) AS Rn&#xA;    FROM   HMDCBIDW.dbo.V4WBaseAliasAutos  AS al&#xA;    JOIN   HMDCBIDW.dbo.V4WBaseDealerAutos AS d ON d.RUTID = al.RUTID AND d.ACTIVO = 1&#xA;    WHERE  al.ORIGEN = N'Autos' AND al.ACTIVO = 1&#xA;) AS x WHERE x.Rn = 1;&#xA;&#xA;-- Dealers con una sola sala activa en el maestro de Autos (D-95, reemplaza a D-46)&#xA;SELECT s.RUTID, MIN(s.SUCURSALID) AS SUCURSALID&#xA;INTO   #SalaUnica&#xA;FROM   HMDCBIDW.dbo.V4WBaseSalaAutos AS s&#xA;WHERE  s.ACTIVO = 1&#xA;GROUP BY s.RUTID&#xA;HAVING COUNT(*) = 1;&#xA;&#xA;-- Texto de modelo del área → grupo (Modelo o Familia) existente en V4WBaseModeloGrupo&#xA;SELECT UPPER(LTRIM(RTRIM(ma.AliasArea))) AS Alias, ma.NivelGrupo, ma.Grupo,&#xA;       CASE WHEN ma.NivelGrupo = N'Modelo' THEN ma.Grupo END AS Modelo,&#xA;       CASE WHEN ma.NivelGrupo = N'Familia' THEN ma.Grupo&#xA;            ELSE (SELECT TOP (1) g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1 AND g.Modelo = ma.Grupo) END AS Familia,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1&#xA;                         AND ((ma.NivelGrupo = N'Modelo' AND g.Modelo = ma.Grupo) OR (ma.NivelGrupo = N'Familia' AND g.Familia = ma.Grupo)))&#xA;            THEN 1 ELSE 0 END AS EnMaestro&#xA;INTO   #ModAlias&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias AS ma&#xA;WHERE  ma.Activo = 1;&#xA;&#xA;-- VIN de Autos en el maestro de Salesforce&#xA;SELECT x.VIN, x.Codigo&#xA;INTO   #Vin&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;             UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;             ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;      FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;      WHERE v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles') AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Vin ON #Vin (VIN);&#xA;&#xA;-- GestionDealer: filas con algún pendiente, una vez por llave (la última vista)&#xA;IF OBJECT_ID(N'tempdb..#SrcGestionDealer') IS NOT NULL DROP TABLE #SrcGestionDealer;&#xA;SELECT x.* INTO #SrcGestionDealer&#xA;FROM (SELECT q.[Archivo], q.[FechaCorte], q.[Hoja], q.[FilaOrigen], q.[DealerArea], q.[SalaArea], q.[EsTTL], q.[EsFuenteDealer], q.[ModeloArea], q.[NivelArea], q.[EsDetalle], q.[Retail], q.[PlanDealer], q.[FCRetail], q.[WS], q.[FCWhole], q.[Stock], q.[Test], q.RowNumber, ROW_NUMBER() OVER (PARTITION BY q.[Archivo], q.[Hoja], q.[FilaOrigen] ORDER BY q.FechaUltimaVez DESC, q.QcID DESC) AS Rn&#xA;      FROM HMDCBISA.dbo.V4WQcGestionDealer q WHERE q.EstadoQc = N'Pendiente') AS x&#xA;WHERE x.Rn = 1;&#xA;-- ── Resolución GestionDealer sobre #SrcGestionDealer (mismas columnas que la Stg) → #ResGestionDealer y #FallaGestionDealer ──&#xA;IF OBJECT_ID(N'tempdb..#ResGestionDealer')   IS NOT NULL DROP TABLE #ResGestionDealer;&#xA;IF OBJECT_ID(N'tempdb..#PreGestionDealer')   IS NOT NULL DROP TABLE #PreGestionDealer;&#xA;IF OBJECT_ID(N'tempdb..#FallaGestionDealer') IS NOT NULL DROP TABLE #FallaGestionDealer;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber,&#xA;       a.RUTID AS RUTIDAlias, a.SUCURSALID AS SalaAlias, su.SUCURSALID AS SalaUnica,&#xA;       m.Modelo, m.Familia, m.EnMaestro, CASE WHEN m.Alias IS NULL THEN 0 ELSE 1 END AS TieneAliasModelo,&#xA;       CASE WHEN a.Alias IS NULL THEN 0 ELSE 1 END AS TieneAliasSala,&#xA;       s.EsTTL, s.SalaArea, s.DealerArea, s.ModeloArea&#xA;INTO   #PreGestionDealer&#xA;FROM   #SrcGestionDealer AS s&#xA;LEFT JOIN #AliasAutos AS a ON a.Alias = UPPER(LTRIM(RTRIM(s.SalaArea)))&#xA;LEFT JOIN #SalaUnica  AS su ON su.RUTID = a.RUTID&#xA;LEFT JOIN #ModAlias   AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)));&#xA;&#xA;-- TTL (D-29): el dealer se toma de los bloques de sala resueltos de la misma hoja; sin sala y sin Qc&#xA;SELECT p.Archivo, p.Hoja, p.FilaOrigen, p.RowNumber,&#xA;       CASE WHEN p.EsTTL = 1 THEN (SELECT TOP (1) q.RUTIDAlias FROM #PreGestionDealer q&#xA;                                   WHERE q.Archivo = p.Archivo AND q.Hoja = p.Hoja AND q.EsTTL = 0 AND q.RUTIDAlias IS NOT NULL&#xA;                                   GROUP BY q.RUTIDAlias ORDER BY COUNT(*) DESC)&#xA;            ELSE p.RUTIDAlias END AS RUTID,&#xA;       CASE WHEN p.EsTTL = 1 THEN NULL ELSE COALESCE(p.SalaAlias, p.SalaUnica) END AS SUCURSALID,&#xA;       p.Modelo, p.Familia&#xA;INTO   #ResGestionDealer&#xA;FROM   #PreGestionDealer AS p;&#xA;&#xA;SELECT p.Archivo, p.Hoja, p.FilaOrigen, p.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaGestionDealer&#xA;FROM   #PreGestionDealer AS p&#xA;CROSS APPLY (&#xA;    SELECT CASE WHEN p.SalaArea = p.DealerArea THEN N'DEALER_SIN_ALIAS' ELSE N'SALA_SIN_ALIAS' END,&#xA;           N'&quot;' + p.SalaArea + N'&quot; no tiene alias ORIGEN Autos en el maestro de Autos'&#xA;    WHERE p.EsTTL = 0 AND p.TieneAliasSala = 0&#xA;    UNION ALL&#xA;    SELECT N'SALA_SIN_ALIAS', N'&quot;' + p.SalaArea + N'&quot; tiene alias de dealer, no de sala, y el dealer tiene varias salas'&#xA;    WHERE p.EsTTL = 0 AND p.TieneAliasSala = 1 AND p.SalaAlias IS NULL AND p.SalaUnica IS NULL&#xA;    UNION ALL&#xA;    SELECT N'GRUPO_FUERA_MAESTRO',&#xA;           CASE WHEN p.TieneAliasModelo = 0 THEN N'Modelo &quot;' + p.ModeloArea + N'&quot; sin alias en V4WBaseModeloAlias'&#xA;                ELSE N'Modelo &quot;' + p.ModeloArea + N'&quot; apunta a un grupo que no existe en V4WBaseModeloGrupo' END&#xA;    WHERE p.EsTTL = 0 AND (p.TieneAliasModelo = 0 OR p.EnMaestro = 0)&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;BEGIN TRANSACTION;&#xA;-- Pasan las llaves que ya no tienen ninguna falla&#xA;MERGE HMDCBIDW.dbo.V4WBaseGestionDealer AS tgt&#xA;USING (SELECT x2.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), x2.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[DealerArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[SalaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[EsTTL]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[EsFuenteDealer]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[NivelArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[EsDetalle]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Retail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[PlanDealer]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FCRetail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[WS]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FCWhole]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Stock]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Test]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Familia]), N''))), 1, 8)) AS HashNuevo&#xA;       FROM #SrcGestionDealer x JOIN #ResGestionDealer r ON r.[Archivo] = x.[Archivo] AND r.[Hoja] = x.[Hoja] AND r.[FilaOrigen] = x.[FilaOrigen]&#xA;       CROSS APPLY (SELECT x.[Archivo], x.[FechaCorte], x.[Hoja], x.[FilaOrigen], x.[DealerArea], x.[SalaArea], x.[EsTTL], x.[EsFuenteDealer], x.[ModeloArea], x.[NivelArea], x.[EsDetalle], x.[Retail], x.[PlanDealer], x.[FCRetail], x.[WS], x.[FCWhole], x.[Stock], x.[Test], r.[RUTID], r.[SUCURSALID], r.[Modelo], r.[Familia]) AS x2 ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [SalaArea], [EsTTL], [EsFuenteDealer], [ModeloArea], [NivelArea], [EsDetalle], [Retail], [PlanDealer], [FCRetail], [WS], [FCWhole], [Stock], [Test], [RUTID], [SUCURSALID], [Modelo], [Familia])&#xA;       WHERE NOT EXISTS (SELECT 1 FROM #FallaGestionDealer f WHERE f.[Archivo] = x.[Archivo] AND f.[Hoja] = x.[Hoja] AND f.[FilaOrigen] = x.[FilaOrigen])) AS src&#xA;   ON tgt.[Archivo] = src.[Archivo] AND tgt.[Hoja] = src.[Hoja] AND tgt.[FilaOrigen] = src.[FilaOrigen]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[FechaCorte] = src.[FechaCorte], tgt.[DealerArea] = src.[DealerArea], tgt.[SalaArea] = src.[SalaArea], tgt.[EsTTL] = src.[EsTTL], tgt.[EsFuenteDealer] = src.[EsFuenteDealer], tgt.[ModeloArea] = src.[ModeloArea], tgt.[NivelArea] = src.[NivelArea], tgt.[EsDetalle] = src.[EsDetalle], tgt.[Retail] = src.[Retail], tgt.[PlanDealer] = src.[PlanDealer], tgt.[FCRetail] = src.[FCRetail], tgt.[WS] = src.[WS], tgt.[FCWhole] = src.[FCWhole], tgt.[Stock] = src.[Stock], tgt.[Test] = src.[Test], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia], tgt.Hash64 = src.HashNuevo,&#xA;                tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [SalaArea], [EsTTL], [EsFuenteDealer], [ModeloArea], [NivelArea], [EsDetalle], [Retail], [PlanDealer], [FCRetail], [WS], [FCWhole], [Stock], [Test], [RUTID], [SUCURSALID], [Modelo], [Familia], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[DealerArea], src.[SalaArea], src.[EsTTL], src.[EsFuenteDealer], src.[ModeloArea], src.[NivelArea], src.[EsDetalle], src.[Retail], src.[PlanDealer], src.[FCRetail], src.[WS], src.[FCWhole], src.[Stock], src.[Test], src.[RUTID], src.[SUCURSALID], src.[Modelo], src.[Familia], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q SET q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcGestionDealer AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FallaGestionDealer f WHERE f.[Archivo] = q.[Archivo] AND f.[Hoja] = q.[Hoja] AND f.[FilaOrigen] = q.[FilaOrigen] AND f.MotivoFalla = q.MotivoFalla);&#xA;COMMIT TRANSACTION;&#xA;&#xA;-- AvanceDiario: filas con algún pendiente, una vez por llave (la última vista)&#xA;IF OBJECT_ID(N'tempdb..#SrcAvanceDiario') IS NOT NULL DROP TABLE #SrcAvanceDiario;&#xA;SELECT x.* INTO #SrcAvanceDiario&#xA;FROM (SELECT q.[Archivo], q.[FechaCorte], q.[Hoja], q.[FilaOrigen], q.[Canal], q.[Orden], q.[ModeloArea], q.[NivelArea], q.[EsDetalle], q.[AvanceReal], q.[Meta2QFC], q.[MetaNiguri], q.[PlanMTD2QFC], q.[PlanMTDNiguri], q.[PlanDealers], q.[FCDLR], q.[MesAnterior], q.[StockHonda], q.[SpecialSales], q.[FactorArea], q.[DiaArea], q.[LeadsMTD], q.[LeadsWebMTD], q.[LeadsMesAnteriorMTD], q.[LeadTargetWeb], q.[WebSales], q.RowNumber, ROW_NUMBER() OVER (PARTITION BY q.[Archivo], q.[Hoja], q.[FilaOrigen] ORDER BY q.FechaUltimaVez DESC, q.QcID DESC) AS Rn&#xA;      FROM HMDCBISA.dbo.V4WQcAvanceDiario q WHERE q.EstadoQc = N'Pendiente') AS x&#xA;WHERE x.Rn = 1;&#xA;-- ── Resolución AvanceDiario sobre #SrcAvanceDiario (mismas columnas que la Stg) → #ResAvanceDiario y #FallaAvanceDiario ──&#xA;IF OBJECT_ID(N'tempdb..#ResAvanceDiario')   IS NOT NULL DROP TABLE #ResAvanceDiario;&#xA;IF OBJECT_ID(N'tempdb..#PreAvanceDiario')   IS NOT NULL DROP TABLE #PreAvanceDiario;&#xA;IF OBJECT_ID(N'tempdb..#FallaAvanceDiario') IS NOT NULL DROP TABLE #FallaAvanceDiario;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber, m.Modelo, m.Familia&#xA;INTO   #ResAvanceDiario&#xA;FROM   #SrcAvanceDiario AS s&#xA;LEFT JOIN #ModAlias AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)));&#xA;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber, N'GRUPO_FUERA_MAESTRO' AS MotivoFalla,&#xA;       CASE WHEN m.Alias IS NULL THEN N'Modelo &quot;' + s.ModeloArea + N'&quot; sin alias en V4WBaseModeloAlias'&#xA;            ELSE N'Modelo &quot;' + s.ModeloArea + N'&quot; apunta a un grupo que no existe en V4WBaseModeloGrupo' END AS DetalleError&#xA;INTO   #FallaAvanceDiario&#xA;FROM   #SrcAvanceDiario AS s&#xA;LEFT JOIN #ModAlias AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)))&#xA;WHERE  m.Alias IS NULL OR m.EnMaestro = 0;&#xA;&#xA;BEGIN TRANSACTION;&#xA;-- Pasan las llaves que ya no tienen ninguna falla&#xA;MERGE HMDCBIDW.dbo.V4WBaseAvanceDiario AS tgt&#xA;USING (SELECT x2.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), x2.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Canal]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Orden]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[NivelArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[EsDetalle]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[AvanceReal]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Meta2QFC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[MetaNiguri]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[PlanMTD2QFC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[PlanMTDNiguri]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[PlanDealers]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FCDLR]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[MesAnterior]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[StockHonda]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[SpecialSales]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FactorArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[DiaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[LeadsMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[LeadsWebMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[LeadsMesAnteriorMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[LeadTargetWeb]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[WebSales]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Familia]), N''))), 1, 8)) AS HashNuevo&#xA;       FROM #SrcAvanceDiario x JOIN #ResAvanceDiario r ON r.[Archivo] = x.[Archivo] AND r.[Hoja] = x.[Hoja] AND r.[FilaOrigen] = x.[FilaOrigen]&#xA;       CROSS APPLY (SELECT x.[Archivo], x.[FechaCorte], x.[Hoja], x.[FilaOrigen], x.[Canal], x.[Orden], x.[ModeloArea], x.[NivelArea], x.[EsDetalle], x.[AvanceReal], x.[Meta2QFC], x.[MetaNiguri], x.[PlanMTD2QFC], x.[PlanMTDNiguri], x.[PlanDealers], x.[FCDLR], x.[MesAnterior], x.[StockHonda], x.[SpecialSales], x.[FactorArea], x.[DiaArea], x.[LeadsMTD], x.[LeadsWebMTD], x.[LeadsMesAnteriorMTD], x.[LeadTargetWeb], x.[WebSales], r.[Modelo], r.[Familia]) AS x2 ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [Canal], [Orden], [ModeloArea], [NivelArea], [EsDetalle], [AvanceReal], [Meta2QFC], [MetaNiguri], [PlanMTD2QFC], [PlanMTDNiguri], [PlanDealers], [FCDLR], [MesAnterior], [StockHonda], [SpecialSales], [FactorArea], [DiaArea], [LeadsMTD], [LeadsWebMTD], [LeadsMesAnteriorMTD], [LeadTargetWeb], [WebSales], [Modelo], [Familia])&#xA;       WHERE NOT EXISTS (SELECT 1 FROM #FallaAvanceDiario f WHERE f.[Archivo] = x.[Archivo] AND f.[Hoja] = x.[Hoja] AND f.[FilaOrigen] = x.[FilaOrigen])) AS src&#xA;   ON tgt.[Archivo] = src.[Archivo] AND tgt.[Hoja] = src.[Hoja] AND tgt.[FilaOrigen] = src.[FilaOrigen]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[FechaCorte] = src.[FechaCorte], tgt.[Canal] = src.[Canal], tgt.[Orden] = src.[Orden], tgt.[ModeloArea] = src.[ModeloArea], tgt.[NivelArea] = src.[NivelArea], tgt.[EsDetalle] = src.[EsDetalle], tgt.[AvanceReal] = src.[AvanceReal], tgt.[Meta2QFC] = src.[Meta2QFC], tgt.[MetaNiguri] = src.[MetaNiguri], tgt.[PlanMTD2QFC] = src.[PlanMTD2QFC], tgt.[PlanMTDNiguri] = src.[PlanMTDNiguri], tgt.[PlanDealers] = src.[PlanDealers], tgt.[FCDLR] = src.[FCDLR], tgt.[MesAnterior] = src.[MesAnterior], tgt.[StockHonda] = src.[StockHonda], tgt.[SpecialSales] = src.[SpecialSales], tgt.[FactorArea] = src.[FactorArea], tgt.[DiaArea] = src.[DiaArea], tgt.[LeadsMTD] = src.[LeadsMTD], tgt.[LeadsWebMTD] = src.[LeadsWebMTD], tgt.[LeadsMesAnteriorMTD] = src.[LeadsMesAnteriorMTD], tgt.[LeadTargetWeb] = src.[LeadTargetWeb], tgt.[WebSales] = src.[WebSales], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia], tgt.Hash64 = src.HashNuevo,&#xA;                tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [Canal], [Orden], [ModeloArea], [NivelArea], [EsDetalle], [AvanceReal], [Meta2QFC], [MetaNiguri], [PlanMTD2QFC], [PlanMTDNiguri], [PlanDealers], [FCDLR], [MesAnterior], [StockHonda], [SpecialSales], [FactorArea], [DiaArea], [LeadsMTD], [LeadsWebMTD], [LeadsMesAnteriorMTD], [LeadTargetWeb], [WebSales], [Modelo], [Familia], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[Canal], src.[Orden], src.[ModeloArea], src.[NivelArea], src.[EsDetalle], src.[AvanceReal], src.[Meta2QFC], src.[MetaNiguri], src.[PlanMTD2QFC], src.[PlanMTDNiguri], src.[PlanDealers], src.[FCDLR], src.[MesAnterior], src.[StockHonda], src.[SpecialSales], src.[FactorArea], src.[DiaArea], src.[LeadsMTD], src.[LeadsWebMTD], src.[LeadsMesAnteriorMTD], src.[LeadTargetWeb], src.[WebSales], src.[Modelo], src.[Familia], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q SET q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcAvanceDiario AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FallaAvanceDiario f WHERE f.[Archivo] = q.[Archivo] AND f.[Hoja] = q.[Hoja] AND f.[FilaOrigen] = q.[FilaOrigen] AND f.MotivoFalla = q.MotivoFalla);&#xA;COMMIT TRANSACTION;&#xA;&#xA;-- StockDealer: filas con algún pendiente, una vez por llave (la última vista)&#xA;IF OBJECT_ID(N'tempdb..#SrcStockDealer') IS NOT NULL DROP TABLE #SrcStockDealer;&#xA;SELECT x.* INTO #SrcStockDealer&#xA;FROM (SELECT q.[Archivo], q.[FechaCorte], q.[Hoja], q.[FilaOrigen], q.[VIN], q.[ConcesionarioArea], q.[ModeloArea], q.[Color], q.[Retail], q.[Fuente], q.[CondicionVenta], q.[Renovacion], q.[Credito], q.RowNumber, ROW_NUMBER() OVER (PARTITION BY q.[Archivo], q.[FilaOrigen] ORDER BY q.FechaUltimaVez DESC, q.QcID DESC) AS Rn&#xA;      FROM HMDCBISA.dbo.V4WQcStockDealer q WHERE q.EstadoQc = N'Pendiente') AS x&#xA;WHERE x.Rn = 1;&#xA;-- ── Resolución StockDealer sobre #SrcStockDealer (mismas columnas que la Stg) → #ResStockDealer y #FallaStockDealer ──&#xA;IF OBJECT_ID(N'tempdb..#ResStockDealer')   IS NOT NULL DROP TABLE #ResStockDealer;&#xA;IF OBJECT_ID(N'tempdb..#PreStockDealer')   IS NOT NULL DROP TABLE #PreStockDealer;&#xA;IF OBJECT_ID(N'tempdb..#FallaStockDealer') IS NOT NULL DROP TABLE #FallaStockDealer;&#xA;SELECT s.[Archivo], s.[FilaOrigen], s.RowNumber, a.RUTID, CONVERT(int, NULL) AS SUCURSALID, v.Codigo AS CodigoArticulo,&#xA;       CASE WHEN a.Alias IS NULL THEN 0 ELSE 1 END AS TieneAlias, CASE WHEN v.VIN IS NULL THEN 0 ELSE 1 END AS EnMaestro,&#xA;       s.ConcesionarioArea, s.VIN&#xA;INTO   #PreStockDealer&#xA;FROM   #SrcStockDealer AS s&#xA;LEFT JOIN #AliasAutos AS a ON a.Alias = UPPER(LTRIM(RTRIM(s.ConcesionarioArea)))&#xA;LEFT JOIN #Vin        AS v ON v.VIN = UPPER(LTRIM(RTRIM(s.VIN)));&#xA;&#xA;-- La sala del VIN del Stock Dealer no la informa el área: la completa la imputación (42). D-44&#xA;SELECT p.[Archivo], p.[FilaOrigen], p.RowNumber, p.RUTID, p.SUCURSALID, p.CodigoArticulo&#xA;INTO   #ResStockDealer&#xA;FROM   #PreStockDealer AS p;&#xA;&#xA;SELECT p.[Archivo], p.[FilaOrigen], p.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaStockDealer&#xA;FROM   #PreStockDealer AS p&#xA;CROSS APPLY (&#xA;    SELECT N'DEALER_SIN_ALIAS', N'Concesionario &quot;' + ISNULL(p.ConcesionarioArea, N'(vacío)') + N'&quot; sin alias ORIGEN Autos en el maestro de Autos'&#xA;    WHERE p.TieneAlias = 0&#xA;    UNION ALL&#xA;    SELECT N'VIN_FUERA_MAESTRO', N'VIN ' + p.VIN + N' no existe en SFOBaseVin_Modelos__c (Automoviles)'&#xA;    WHERE p.EnMaestro = 0&#xA;    UNION ALL&#xA;    SELECT N'DUPLICADO', N'VIN ' + p.VIN + N' repetido en la hoja Stock Dealer del archivo'&#xA;    WHERE (SELECT COUNT(*) FROM #PreStockDealer x WHERE x.Archivo = p.Archivo AND x.VIN = p.VIN) &gt; 1&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;BEGIN TRANSACTION;&#xA;-- Pasan las llaves que ya no tienen ninguna falla&#xA;MERGE HMDCBIDW.dbo.V4WBaseStockDealer AS tgt&#xA;USING (SELECT x2.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), x2.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[VIN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[ConcesionarioArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Color]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Retail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Fuente]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[CondicionVenta]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Renovacion]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[Credito]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), x2.[CodigoArticulo]), N''))), 1, 8)) AS HashNuevo&#xA;       FROM #SrcStockDealer x JOIN #ResStockDealer r ON r.[Archivo] = x.[Archivo] AND r.[FilaOrigen] = x.[FilaOrigen]&#xA;       CROSS APPLY (SELECT x.[Archivo], x.[FechaCorte], x.[Hoja], x.[FilaOrigen], x.[VIN], x.[ConcesionarioArea], x.[ModeloArea], x.[Color], x.[Retail], x.[Fuente], x.[CondicionVenta], x.[Renovacion], x.[Credito], r.[RUTID], r.[SUCURSALID], r.[CodigoArticulo]) AS x2 ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [VIN], [ConcesionarioArea], [ModeloArea], [Color], [Retail], [Fuente], [CondicionVenta], [Renovacion], [Credito], [RUTID], [SUCURSALID], [CodigoArticulo])&#xA;       WHERE NOT EXISTS (SELECT 1 FROM #FallaStockDealer f WHERE f.[Archivo] = x.[Archivo] AND f.[FilaOrigen] = x.[FilaOrigen])) AS src&#xA;   ON tgt.[Archivo] = src.[Archivo] AND tgt.[FilaOrigen] = src.[FilaOrigen]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[FechaCorte] = src.[FechaCorte], tgt.[Hoja] = src.[Hoja], tgt.[VIN] = src.[VIN], tgt.[ConcesionarioArea] = src.[ConcesionarioArea], tgt.[ModeloArea] = src.[ModeloArea], tgt.[Color] = src.[Color], tgt.[Retail] = src.[Retail], tgt.[Fuente] = src.[Fuente], tgt.[CondicionVenta] = src.[CondicionVenta], tgt.[Renovacion] = src.[Renovacion], tgt.[Credito] = src.[Credito], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[CodigoArticulo] = src.[CodigoArticulo], tgt.Hash64 = src.HashNuevo,&#xA;                tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [VIN], [ConcesionarioArea], [ModeloArea], [Color], [Retail], [Fuente], [CondicionVenta], [Renovacion], [Credito], [RUTID], [SUCURSALID], [CodigoArticulo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[VIN], src.[ConcesionarioArea], src.[ModeloArea], src.[Color], src.[Retail], src.[Fuente], src.[CondicionVenta], src.[Renovacion], src.[Credito], src.[RUTID], src.[SUCURSALID], src.[CodigoArticulo], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q SET q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcStockDealer AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #FallaStockDealer f WHERE f.[Archivo] = q.[Archivo] AND f.[FilaOrigen] = q.[FilaOrigen] AND f.MotivoFalla = q.MotivoFalla);&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT 0 AS RowsReevaluadas;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
