      <DTS:Variables />
      <DTS:ObjectData>
        <ScriptProject
          Name="ST_ff694be232ea4a2a8a51957507785fb0"
          VSTAMajorVersion="15"
          VSTAMinorVersion="0"
          Language="CSharp"
          ReadOnlyVariables="User::CtlComputerName,User::CtlExecutionID,User::CtlPackageName,User::CtlUserName,User::EtlArchivosLista,User::EtlFileModifiedDate,User::EtlFileName,User::EtlOperatorUser,$Package::CtlProcessID,$Package::EtlFilePath,$Package::EtlFileSheet,$Package::vMailCC,$Package::vMailFrom,$Package::vMailTO,$Project::vSMTPHost,$Project::vSQLConnStr,$Project::vSMTPPort,$Project::vLogoMain,$Project::vLogoWhite">
          <ProjectItem
