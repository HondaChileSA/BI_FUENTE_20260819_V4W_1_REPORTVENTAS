          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL_07_Report_Final — Reporte final post-aplicación (INSERT / UPDATE)
 *
 * Después del merge al modelo final (DICBaseDealerParent), este Script Task
 * envía un correo con el detalle de los cambios aplicados:
 *   · Registros insertados (TOP N preview)
 *   · Registros actualizados (TOP N preview, con delta de Hash)
 *
 * Es un reporte informativo — NUNCA detiene la ejecución (TaskResult siempre
 * = Success).
 *
 * Diseño config-driven:
 *   - Config.SUMMARY_ROWS → filas del bloque "Execution Summary".
 *   - Config.SECCIONES    → cada sección define su tabla origen y sus columnas.
 *                           El SQL SELECT, los encabezados y las celdas se
 *                           arman solos a partir de este array. Soporta
 *                           expresiones SQL personalizadas (ej. delta de Hash)
 *                           y un filtro opcional por sección (útil cuando se
 *                           migre a una sola tabla DICLoadDealerAlias con
 *                           columna Operation = 'I' | 'U').
 *
 * Para clonar este Script a otro input, sólo se toca el bloque Config.
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;              // WebClient + HttpWebRequest
using System.Net.Mail;
using System.Net.Mime;
using System.Text;
using System.Text.RegularExpressions;
#endregion

namespace ST_3b5335120ee1469aaa904846d3479804
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
