          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL02LoadDWHSA — V4W · GestionDealer (ProcessID 36) · Script Task · v1.0
 *
 * Lee los archivos "Gestion Dealer 4W <Mes> DD-MM.xlsx" que dejó ETL00aCheckFile en
 * User::EtlArchivosLista (nuevos o modificados, KI 103) y carga tres Stg en HMDCBISA:
 *   - V4WStgGestionDealer : hojas "Gestion <Dealer>". Cada celda "Retail" abre un bloque; la sala es la
 *                           celda de arriba (vacía = el dealer). Modelo = columna a la izquierda; el
 *                           bloque termina en "Total". Columnas por encabezado (Retail, Plan, FC Retail,
 *                           W/S, FC Whole, Stock*, Test*). Bloques " TTL" con EsTTL = 1.
 *                           FilaOrigen = fila Excel * 1000 + columna Excel del bloque (en una fila puede
 *                           haber varios bloques, uno por sala, lado a lado).
 *   - V4WStgAvanceDiario  : "Avance Diario RETAIL" y "Avance Diario Whole" (tabla de colores).
 *   - V4WStgStockDealer   : hoja "Stock Dealer" (VIN por dealer).
 * Lógica portada de la maqueta (fnLeerGestionDealer / fnLeerMetaGestion / fnLeerStockDealer), validada
 * contra la base del área. Familia / Versión con la lista de familias de V4WBaseModeloAlias (nivel
 * Familia) y V4WBaseModeloGrupo.
 * D-34: filas con todas sus cifras en cero o vacías se omiten (Gestion y Avance).
 * Un archivo que falla no detiene a los demás: queda "Rechazado" con su aviso (lo registra ETL06).
 * Excel por OLE DB ACE 12.0 (HDR=NO, IMEX=1), leyendo rangos acotados (la hoja RETAIL trae un rango
 * usado A1:XDA57).
 *
 * Al terminar reescribe User::EtlArchivosLista agregando a cada línea:
 *   Estado (Cargado / Rechazado), FilasGestion, FilasAvance, FilasStock, Aviso.
 *
 * ReadOnlyVariables : User::CtlExecutionID, $Project::vSQLConnStr, $Project::vSQLConnDw
 * ReadWriteVariables: User::EtlArchivosLista
 *
 * Desarrollador: Franco Véliz (Agente V4W) · 2026-11-08 · C# 7.3 / .NET Framework (SSIS 2019)
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Globalization;
using System.Linq;
#endregion

namespace ST_ece9a6b9ab81467a994c3c863fb40de6
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private static class Config
        {
            public const string ComponentName = "ETL02LoadDWHSA";
            public const string RangoGestion = "A1:HZ300";   // 234 columnas: bloques de sala lado a lado
            public const string RangoAvance = "A1:CB150";    // tabla de colores (~48 columnas, ~57 filas)
            public const string RangoStock = "A1:T6000";
            public const int TimeoutSeg = 600;
        }

        private long _execId;
        private HashSet<string> _familias;
        private int _rowGestion, _rowAvance, _rowStock;
        private string _avisoStock;

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                _execId = Convert.ToInt64(Dts.Variables["User::CtlExecutionID"].Value);
                string connStg = Convert.ToString(Dts.Variables["$Project::vSQLConnStr"].Value);
                string connDw = Convert.ToString(Dts.Variables["$Project::vSQLConnDw"].Value);
                string lista = Convert.ToString(Dts.Variables["User::EtlArchivosLista"].Value);
                _familias = LeerFamilias(connDw);

                var salida = new List<string>();
                foreach (string linea in lista.Split(new[] { '\n' }, StringSplitOptions.RemoveEmptyEntries))
                {
                    string[] f = linea.Split('\t');
                    string ruta = f[0], archivo = f[1];
                    DateTime corte = DateTime.ParseExact(f[2], "yyyy-MM-dd", CultureInfo.InvariantCulture);
                    string estado = "Cargado", aviso = "";
                    int nG = 0, nA = 0, nS = 0;
                    try
                    {
                        DataTable tG = NuevaGestion(), tA = NuevaAvance(), tS = NuevaStock();
                        var avisos = new List<string>();
                        using (var cn = new OleDbConnection(
                            "Provider=Microsoft.ACE.OLEDB.12.0;Data Source=" + ruta +
                            ";Extended Properties='Excel 12.0 Xml;HDR=NO;IMEX=1';"))
                        {
                            cn.Open();
                            List<string> hojas = Hojas(cn);

                            var gestion = hojas.Where(h => h.StartsWith("gestion ", StringComparison.OrdinalIgnoreCase)).ToList();
                            if (gestion.Count == 0) throw new Exception("HOJA_FALTANTE: no hay hojas 'Gestion <Dealer>'");
                            LeerGestion(cn, gestion, archivo, corte, tG);

                            foreach (var par in new[] { new[] { "Avance Diario RETAIL", "Retail" }, new[] { "Avance Diario Whole", "Whole" } })
                            {
                                string h = hojas.FirstOrDefault(x => string.Equals(x, par[0], StringComparison.OrdinalIgnoreCase));
                                if (h == null) { avisos.Add("falta hoja " + par[0]); continue; }
                                string av = LeerAvance(cn, h, par[1], archivo, corte, tA);
                                if (av != null) avisos.Add(av);
                            }

                            string hs = hojas.FirstOrDefault(x => string.Equals(x, "Stock Dealer", StringComparison.OrdinalIgnoreCase));
                            if (hs == null) avisos.Add("falta hoja Stock Dealer");
                            else if (!LeerStock(cn, hs, archivo, corte, tS)) avisos.Add("Stock Dealer sin encabezado VIN");
                            else if (_avisoStock != null) avisos.Add(_avisoStock);
                        }
                        Bulk(connStg, "dbo.V4WStgGestionDealer", tG);
                        Bulk(connStg, "dbo.V4WStgAvanceDiario", tA);
                        Bulk(connStg, "dbo.V4WStgStockDealer", tS);
                        nG = tG.Rows.Count; nA = tA.Rows.Count; nS = tS.Rows.Count;
                        aviso = string.Join("; ", avisos);
                    }
                    catch (Exception exA)
                    {
                        estado = "Rechazado";
                        aviso = exA.Message;
                        Dts.Events.FireWarning(0, Config.ComponentName, archivo + ": " + exA.Message, "", 0);
                    }
                    aviso = (aviso ?? "").Replace('\t', ' ').Replace('\n', ' ').Replace('\r', ' ');
                    if (aviso.Length > 900) aviso = aviso.Substring(0, 900);
                    salida.Add(string.Join("\t", f.Take(6).Concat(new[] { estado, nG.ToString(), nA.ToString(), nS.ToString(), aviso })));
                    Dts.Events.FireInformation(0, Config.ComponentName,
                        string.Format("{0} · {1:yyyy-MM-dd} · {2} · Gestion {3} · Avance {4} · Stock {5}{6}",
                            archivo, corte, estado, nG, nA, nS, aviso == "" ? "" : " · " + aviso), "", 0, ref fireAgain);
                }

                Dts.Variables["User::EtlArchivosLista"].Value = string.Join("\n", salida);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ComponentName, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ═════════════════════════════ LECTORES ═════════════════════════════

        private void LeerGestion(OleDbConnection cn, List<string> hojas, string archivo, DateTime corte, DataTable t)
        {
            var filas = new List<object[]>();          // acumulado del archivo, para EsFuenteDealer
            var dealersTtl = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (string hoja in hojas)
            {
                string dealer = hoja.Substring(8).Trim();
                var X = new Celdas(Leer(cn, hoja, Config.RangoGestion));
                for (int r0 = 0; r0 < X.N; r0++)
                    for (int c0 = 1; c0 < X.NC; c0++)
                    {
                        if (!string.Equals(X.Txt(r0, c0), "retail", StringComparison.OrdinalIgnoreCase)) continue;
                        string salaTxt = X.Txt(r0 - 1, c0);
                        string sala = salaTxt == "" ? dealer : salaTxt;
                        bool esTtl = sala.ToUpperInvariant().EndsWith(" TTL");
                        if (esTtl) dealersTtl.Add(dealer);

                        var enc = new Dictionary<string, int>(StringComparer.Ordinal);
                        var cStock = new List<int>(); var cTest = new List<int>();
                        for (int c = c0; c < X.NC && X.Txt(r0, c) != ""; c++)
                        {
                            string n = X.Txt(r0, c).ToLowerInvariant();
                            if (!enc.ContainsKey(n)) enc[n] = c;
                            if (n.StartsWith("stock")) cStock.Add(c);
                            if (n.StartsWith("test")) cTest.Add(c);
                        }
                        int? cR = Col(enc, "retail"), cP = Col(enc, "plan"), cF = Col(enc, "fc retail"),
                             cW = Col(enc, "w/s"), cFW = Col(enc, "fc whole");

                        var bloque = new List<Fila>();
                        for (int r = r0 + 1; r < X.N && r <= r0 + 200; r++)
                        {
                            string m = X.Txt(r, c0 - 1);
                            if (string.Equals(m, "total", StringComparison.OrdinalIgnoreCase)) break;
                            if (m == "") continue;
                            bloque.Add(new Fila
                            {
                                R = r,
                                Modelo = m,
                                EsFamilia = _familias.Contains(m.ToUpperInvariant()),
                                V = new[] { X.Num(r, cR), X.Num(r, cP), X.Num(r, cF), X.Num(r, cW), X.Num(r, cFW),
                                            cStock.Sum(c => X.Num(r, c)), cTest.Sum(c => X.Num(r, c)) }
                            });
                        }
                        MarcarNiveles(bloque);
                        foreach (var x in bloque)
                        {
                            if (x.V.All(v => v == 0)) continue;   // D-34
                            filas.Add(new object[] { (x.R + 1) * 1000 + (c0 + 1), hoja, dealer, sala, esTtl, x.Modelo, x.Nivel, x.EsDetalle, x.V });
                        }
                    }
            }

            foreach (var o in filas)
            {
                string dealer = (string)o[2]; bool esTtl = (bool)o[4]; double[] v = (double[])o[8];
                bool fuente = esTtl || !dealersTtl.Contains(dealer);
                t.Rows.Add(_execId, ++_rowGestion, Cut(archivo, 260), corte, Cut((string)o[1], 100), (int)o[0],
                    Cut(dealer, 100), Cut((string)o[3], 150), esTtl, fuente, Cut((string)o[5], 100), (string)o[6], (bool)o[7],
                    D(v[0]), D(v[1]), D(v[2]), D(v[3]), D(v[4]), D(v[5]), D(v[6]));
            }
        }

        // Devuelve un aviso si faltan columnas o el factor; null si está completo.
        private string LeerAvance(OleDbConnection cn, string hoja, string canal, string archivo, DateTime corte, DataTable t)
        {
            var X = new Celdas(Leer(cn, hoja, Config.RangoAvance));
            int hr = -1, ca = -1;
            for (int r = 0; r < X.N && hr < 0; r++)
                for (int c = 0; c < X.NC; c++)
                    if (string.Equals(X.Txt(r, c), "avance real", StringComparison.OrdinalIgnoreCase)) { hr = r; ca = c; break; }
            if (hr < 0) return canal + ": no se encontró 'Avance Real'";
            int cm = ca - 1;

            var enc = new List<KeyValuePair<string, int>>();
            for (int c = 0; c < X.NC; c++) { string n = X.Txt(hr, c).ToLowerInvariant(); if (n != "") enc.Add(new KeyValuePair<string, int>(n, c)); }
            Func<Func<string, bool>, int?> col = p => { foreach (var e in enc) if (p(e.Key)) return e.Value; return null; };

            int? cQ = col(n => n.EndsWith("qfc")) ?? col(n => n == "prb");
            int? cN = col(n => n == "niguri plan"), cS = col(n => n == "stock honda"), cE = col(n => n == "real special sales");
            int? cPM2 = col(n => n.StartsWith("plan mtd") && (n.EndsWith("qfc") || n.EndsWith("prb")));
            int? cPMN = col(n => n.StartsWith("plan mtd") && n.Contains("niguri"));
            int? cPD = col(n => n == "plan dealers"), cMA = col(n => n.Contains("mes anterior"));
            int limite = cMA ?? 100000;
            int? cFC = enc.Where(e => e.Key.StartsWith("fc") && e.Key.EndsWith("dlr") && e.Value < limite)
                          .Select(e => (int?)e.Value).DefaultIfEmpty(null).Max();
            double factor = X.Num(hr - 1, ca + 1), dia = X.Num(hr - 1, ca);

            var faltan = new List<string>();
            if (cQ == null) faltan.Add("2QFC"); if (cN == null) faltan.Add("Niguri Plan");
            if (cFC == null) faltan.Add("FC DLR"); if (cMA == null) faltan.Add("mes anterior");
            if (canal == "Retail") { if (cPM2 == null) faltan.Add("Plan MTD 2QFC"); if (cPMN == null) faltan.Add("Plan MTD Niguri"); }
            if (!(factor > 0)) faltan.Add("factor (E2/G2)");

            var bloque = new List<Fila>();
            for (int r = hr + 1; r < X.N && r <= hr + 80; r++)
            {
                if (X.Txt(r, cm - 1).ToUpperInvariant().StartsWith("TOTAL")) break;
                string m = X.Txt(r, cm);
                if (m == "" || !m.Any(char.IsLetter)) continue;
                bloque.Add(new Fila
                {
                    R = r,
                    Modelo = m,
                    EsFamilia = _familias.Contains(m.ToUpperInvariant()),
                    V = new[] { X.Num(r, ca), X.Num(r, cQ), X.Num(r, cN), X.Num(r, cPM2), X.Num(r, cPMN), X.Num(r, cPD),
                                X.Num(r, cFC), X.Num(r, cMA), X.Num(r, cS), X.Num(r, cE) }
                });
            }
            MarcarNiveles(bloque);
            foreach (var x in bloque)
            {
                if (x.V.All(v => v == 0)) continue;   // D-34
                t.Rows.Add(_execId, ++_rowAvance, Cut(archivo, 260), corte, Cut(hoja, 100), x.R + 1, canal, x.R,
                    Cut(x.Modelo, 100), x.Nivel, x.EsDetalle,
                    D(x.V[0]), D(x.V[1]), D(x.V[2]), D(x.V[3]), D(x.V[4]), D(x.V[5]), D(x.V[6]), D(x.V[7]), D(x.V[8]), D(x.V[9]),
                    Math.Round((decimal)factor, 6), (int)dia, DBNull.Value, DBNull.Value, DBNull.Value, DBNull.Value, DBNull.Value);
            }
            return faltan.Count == 0 ? null : canal + ": falta " + string.Join(", ", faltan);
        }

        private bool LeerStock(OleDbConnection cn, string hoja, string archivo, DateTime corte, DataTable t)
        {
            var X = new Celdas(Leer(cn, hoja, Config.RangoStock));
            int hr = -1;
            for (int r = 0; r < X.N && hr < 0; r++)
                for (int c = 0; c < X.NC; c++)
                    if (string.Equals(X.Txt(r, c), "VIN", StringComparison.OrdinalIgnoreCase)) { hr = r; break; }
            if (hr < 0) return false;
            var enc = new Dictionary<string, int>(StringComparer.Ordinal);
            for (int c = 0; c < X.NC; c++) { string n = X.Txt(hr, c).ToLowerInvariant(); if (n != "" && !enc.ContainsKey(n)) enc[n] = c; }
            int cV = enc["vin"];
            Func<int, string, int, object> T = (r, n, len) =>
            { int? c = Col(enc, n); if (c == null) return DBNull.Value; string v = X.Txt(r, c.Value); return v == "" ? (object)DBNull.Value : Cut(v, len); };
            int noVin = 0;
            for (int r = hr + 1; r < X.N; r++)
            {
                string vin = X.Txt(r, cV);
                if (vin == "") continue;
                // v1.2: solo filas con forma de VIN (17 letras/dígitos). Debajo de la lista el área suele
                // tener resúmenes (conteos, totales) que no son VIN.
                if (vin.Length != 17 || !vin.All(char.IsLetterOrDigit)) { noVin++; continue; }
                t.Rows.Add(_execId, ++_rowStock, Cut(archivo, 260), corte, Cut(hoja, 100), r + 1, Cut(vin.ToUpperInvariant(), 25),
                    T(r, "concesionario", 255), T(r, "modelo", 100), T(r, "color", 50), T(r, "retail", 50), T(r, "fuente", 50),
                    T(r, "condicion venta", 100), T(r, "renovacion", 50), T(r, "credito", 50));
            }
            _avisoStock = noVin > 0 ? "Stock Dealer: " + noVin + " fila(s) sin forma de VIN omitidas" : null;
            return true;
        }

        // ═════════════════════════════ APOYO ═════════════════════════════

        private class Fila { public int R; public string Modelo; public bool EsFamilia; public double[] V; public string Nivel; public bool EsDetalle; }

        // Familia / Versión (igual que la maqueta): una fila familia abre el grupo; EsDetalle = versión,
        // o familia sin versiones debajo.
        private static void MarcarNiveles(List<Fila> filas)
        {
            string fam = null;
            var conHijos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var x in filas)
            {
                if (x.EsFamilia) { fam = x.Modelo; x.Nivel = "Familia"; }
                else { x.Nivel = "Version"; if (fam != null) conHijos.Add(fam); }
            }
            foreach (var x in filas) x.EsDetalle = x.Nivel == "Version" || !conHijos.Contains(x.Modelo);
        }

        private class Celdas
        {
            private readonly DataTable _t;
            public int N { get { return _t.Rows.Count; } }
            public int NC { get { return _t.Columns.Count; } }
            public Celdas(DataTable t) { _t = t; }
            public object Celda(int r, int c) { return (r < 0 || c < 0 || r >= N || c >= NC || _t.Rows[r].IsNull(c)) ? null : _t.Rows[r][c]; }
            public string Txt(int r, int c) { var v = Celda(r, c); return v == null ? "" : Convert.ToString(v, CultureInfo.InvariantCulture).Trim(); }
            public double Num(int r, int? c)
            {
                if (c == null) return 0;
                var v = Celda(r, c.Value);
                if (v == null) return 0;
                if (v is double) return (double)v;
                if (v is decimal) return (double)(decimal)v;
                // v1.1: IMEX=1 puede traer el número como texto ("0,95", "95%", "1.234,5"): se prueban
                // la cultura invariante y la chilena, y el porcentaje se pasa a fracción.
                double d;
                string s = Convert.ToString(v, CultureInfo.InvariantCulture).Trim();
                bool pct = s.EndsWith("%");
                if (pct) s = s.TrimEnd('%').Trim();
                if (!double.TryParse(s, NumberStyles.Any, CultureInfo.InvariantCulture, out d) &&
                    !double.TryParse(s, NumberStyles.Any, CultureInfo.GetCultureInfo("es-CL"), out d)) return 0;
                return pct ? d / 100.0 : d;
            }
        }

        private static DataTable Leer(OleDbConnection cn, string hoja, string rango)
        {
            var dt = new DataTable();
            using (var da = new OleDbDataAdapter("SELECT * FROM [" + hoja + "$" + rango + "]", cn)) da.Fill(dt);
            return dt;
        }

        private static List<string> Hojas(OleDbConnection cn)
        {
            var res = new List<string>();
            DataTable s = cn.GetOleDbSchemaTable(OleDbSchemaGuid.Tables, null);
            foreach (DataRow r in s.Rows)
            {
                string n = Convert.ToString(r["TABLE_NAME"]).Trim('\'');
                if (!n.EndsWith("$")) continue;            // descarta rangos con nombre y filtros
                res.Add(n.Substring(0, n.Length - 1));
            }
            return res;
        }

        private static HashSet<string> LeerFamilias(string connDw)
        {
            var h = new HashSet<string>(StringComparer.Ordinal);
            const string sql = @"
SELECT UPPER(LTRIM(RTRIM(AliasArea))) FROM dbo.V4WBaseModeloAlias WHERE Activo = 1 AND NivelGrupo = N'Familia'
UNION
SELECT UPPER(LTRIM(RTRIM(Familia)))   FROM dbo.V4WBaseModeloGrupo WHERE Activo = 1;";
            using (var cn = new SqlConnection(connDw))
            using (var cmd = new SqlCommand(sql, cn))
            {
                cn.Open();
                using (var rd = cmd.ExecuteReader()) while (rd.Read()) h.Add(rd.GetString(0));
            }
            return h;
        }

        private static int? Col(Dictionary<string, int> enc, string n) { int c; return enc.TryGetValue(n, out c) ? (int?)c : null; }
        private static object D(double v) { return Math.Round((decimal)v, 4); }
        private static string Cut(string s, int n) { return s == null ? null : (s.Length <= n ? s : s.Substring(0, n)); }

        private static void Bulk(string connStr, string tabla, DataTable t)
        {
            if (t.Rows.Count == 0) return;
            using (var cn = new SqlConnection(connStr))
            {
                cn.Open();
                using (var b = new SqlBulkCopy(cn, SqlBulkCopyOptions.CheckConstraints, null))
                {
                    b.DestinationTableName = tabla;
                    b.BulkCopyTimeout = Config.TimeoutSeg;
                    foreach (DataColumn c in t.Columns) b.ColumnMappings.Add(c.ColumnName, c.ColumnName);
                    b.WriteToServer(t);
                }
            }
        }

        private static DataTable Tabla(params object[] def)
        {
            var t = new DataTable();
            for (int i = 0; i < def.Length; i += 2) t.Columns.Add((string)def[i], (Type)def[i + 1]);
            return t;
        }
        private static DataTable NuevaGestion()
        {
            return Tabla("ExecutionID", typeof(long), "RowNumber", typeof(int), "Archivo", typeof(string), "FechaCorte", typeof(DateTime),
                "Hoja", typeof(string), "FilaOrigen", typeof(int), "DealerArea", typeof(string), "SalaArea", typeof(string),
                "EsTTL", typeof(bool), "EsFuenteDealer", typeof(bool), "ModeloArea", typeof(string), "NivelArea", typeof(string),
                "EsDetalle", typeof(bool), "Retail", typeof(decimal), "PlanDealer", typeof(decimal), "FCRetail", typeof(decimal),
                "WS", typeof(decimal), "FCWhole", typeof(decimal), "Stock", typeof(decimal), "Test", typeof(decimal));
        }
        private static DataTable NuevaAvance()
        {
            return Tabla("ExecutionID", typeof(long), "RowNumber", typeof(int), "Archivo", typeof(string), "FechaCorte", typeof(DateTime),
                "Hoja", typeof(string), "FilaOrigen", typeof(int), "Canal", typeof(string), "Orden", typeof(int),
                "ModeloArea", typeof(string), "NivelArea", typeof(string), "EsDetalle", typeof(bool),
                "AvanceReal", typeof(decimal), "Meta2QFC", typeof(decimal), "MetaNiguri", typeof(decimal), "PlanMTD2QFC", typeof(decimal),
                "PlanMTDNiguri", typeof(decimal), "PlanDealers", typeof(decimal), "FCDLR", typeof(decimal), "MesAnterior", typeof(decimal),
                "StockHonda", typeof(decimal), "SpecialSales", typeof(decimal), "FactorArea", typeof(decimal), "DiaArea", typeof(int),
                "LeadsMTD", typeof(decimal), "LeadsWebMTD", typeof(decimal), "LeadsMesAnteriorMTD", typeof(decimal),
                "LeadTargetWeb", typeof(decimal), "WebSales", typeof(decimal));
        }
        private static DataTable NuevaStock()
        {
            return Tabla("ExecutionID", typeof(long), "RowNumber", typeof(int), "Archivo", typeof(string), "FechaCorte", typeof(DateTime),
                "Hoja", typeof(string), "FilaOrigen", typeof(int), "VIN", typeof(string), "ConcesionarioArea", typeof(string),
                "ModeloArea", typeof(string), "Color", typeof(string), "Retail", typeof(string), "Fuente", typeof(string),
                "CondicionVenta", typeof(string), "Renovacion", typeof(string), "Credito", typeof(string));
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
