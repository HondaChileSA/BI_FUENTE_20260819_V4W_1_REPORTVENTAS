    <DTS:Executable
      DTS:refId="Package\ETL06LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F5744ED1-03E4-4C49-8FC9-025656658115}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL06LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* GestionDealer__ETL06LoadDWHDW_v1.1.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: ETL06LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_gestiondealer_v2.py (no editar a mano: regenerar)&#xA;   v1.1    : 2026-11-24 · Franco Véliz (Agente V4W) · ARQ7 E2 (plan_E2 v2): alias y sala única del maestro de Autos (V4WBaseAliasAutos, V4WBaseSalaAutos, D-95); sin DIC ni sociedad (D-ARQ-76)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma las 3 Load: I / U por hash y D (fotografía reemplazada: filas en Base de un archivo recargado que ya no vienen o pasaron a Qc). Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;-- ── Maestros (maestro de Autos V4WBase*Autos; modelos V4W) ──────────────────────────&#xA;IF OBJECT_ID(N'tempdb..#AliasAutos') IS NOT NULL DROP TABLE #AliasAutos;&#xA;IF OBJECT_ID(N'tempdb..#SalaUnica')  IS NOT NULL DROP TABLE #SalaUnica;&#xA;IF OBJECT_ID(N'tempdb..#ModAlias')   IS NOT NULL DROP TABLE #ModAlias;&#xA;IF OBJECT_ID(N'tempdb..#Vin')        IS NOT NULL DROP TABLE #Vin;&#xA;&#xA;-- Alias del área: texto → dealer y sala (NULL = alias de dealer) del maestro de Autos (SOL-024, D-ARQ-74); sin sociedad&#xA;SELECT x.Alias, x.RUTID, x.SUCURSALID&#xA;INTO   #AliasAutos&#xA;FROM (&#xA;    SELECT UPPER(LTRIM(RTRIM(al.ALIAS))) AS Alias, al.RUTID, al.SUCURSALID,&#xA;           ROW_NUMBER() OVER (PARTITION BY UPPER(LTRIM(RTRIM(al.ALIAS))) ORDER BY al.ALIASID) AS Rn&#xA;    FROM   HMDCBIDW.dbo.V4WBaseAliasAutos  AS al&#xA;    JOIN   HMDCBIDW.dbo.V4WBaseDealerAutos AS d ON d.RUTID = al.RUTID AND d.ACTIVO = 1&#xA;    WHERE  al.ORIGEN = N'Autos' AND al.ACTIVO = 1&#xA;) AS x WHERE x.Rn = 1;&#xA;&#xA;-- Dealers con una sola sala activa en el maestro de Autos (D-95, reemplaza a D-46)&#xA;SELECT s.RUTID, MIN(s.SUCURSALID) AS SUCURSALID&#xA;INTO   #SalaUnica&#xA;FROM   HMDCBIDW.dbo.V4WBaseSalaAutos AS s&#xA;WHERE  s.ACTIVO = 1&#xA;GROUP BY s.RUTID&#xA;HAVING COUNT(*) = 1;&#xA;&#xA;-- Texto de modelo del área → grupo (Modelo o Familia) existente en V4WBaseModeloGrupo&#xA;SELECT UPPER(LTRIM(RTRIM(ma.AliasArea))) AS Alias, ma.NivelGrupo, ma.Grupo,&#xA;       CASE WHEN ma.NivelGrupo = N'Modelo' THEN ma.Grupo END AS Modelo,&#xA;       CASE WHEN ma.NivelGrupo = N'Familia' THEN ma.Grupo&#xA;            ELSE (SELECT TOP (1) g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1 AND g.Modelo = ma.Grupo) END AS Familia,&#xA;       CASE WHEN EXISTS (SELECT 1 FROM HMDCBIDW.dbo.V4WBaseModeloGrupo g WHERE g.Activo = 1&#xA;                         AND ((ma.NivelGrupo = N'Modelo' AND g.Modelo = ma.Grupo) OR (ma.NivelGrupo = N'Familia' AND g.Familia = ma.Grupo)))&#xA;            THEN 1 ELSE 0 END AS EnMaestro&#xA;INTO   #ModAlias&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias AS ma&#xA;WHERE  ma.Activo = 1;&#xA;&#xA;-- VIN de Autos en el maestro de Salesforce&#xA;SELECT x.VIN, x.Codigo&#xA;INTO   #Vin&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;             UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;             ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;      FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;      WHERE v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles') AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Vin ON #Vin (VIN);&#xA;&#xA;-- Archivos recargados en esta corrida (incluye los que quedaron enteros en Qc)&#xA;IF OBJECT_ID(N'tempdb..#Archivos') IS NOT NULL DROP TABLE #Archivos;&#xA;SELECT Archivo INTO #Archivos FROM HMDCBISA.dbo.V4WStgGestionDealer WHERE ExecutionID = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WStgAvanceDiario WHERE ExecutionID = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WStgStockDealer  WHERE ExecutionID = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WQcGestionDealer WHERE ExecutionIDUltima = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WQcAvanceDiario  WHERE ExecutionIDUltima = @ExecutionID&#xA;UNION SELECT Archivo FROM HMDCBISA.dbo.V4WQcStockDealer   WHERE ExecutionIDUltima = @ExecutionID;&#xA;&#xA;IF OBJECT_ID(N'tempdb..#SrcGestionDealer') IS NOT NULL DROP TABLE #SrcGestionDealer;&#xA;SELECT * INTO #SrcGestionDealer FROM HMDCBISA.dbo.V4WStgGestionDealer WHERE ExecutionID = @ExecutionID;&#xA;-- ── Resolución GestionDealer sobre #SrcGestionDealer (mismas columnas que la Stg) → #ResGestionDealer y #FallaGestionDealer ──&#xA;IF OBJECT_ID(N'tempdb..#ResGestionDealer')   IS NOT NULL DROP TABLE #ResGestionDealer;&#xA;IF OBJECT_ID(N'tempdb..#PreGestionDealer')   IS NOT NULL DROP TABLE #PreGestionDealer;&#xA;IF OBJECT_ID(N'tempdb..#FallaGestionDealer') IS NOT NULL DROP TABLE #FallaGestionDealer;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber,&#xA;       a.RUTID AS RUTIDAlias, a.SUCURSALID AS SalaAlias, su.SUCURSALID AS SalaUnica,&#xA;       m.Modelo, m.Familia, m.EnMaestro, CASE WHEN m.Alias IS NULL THEN 0 ELSE 1 END AS TieneAliasModelo,&#xA;       CASE WHEN a.Alias IS NULL THEN 0 ELSE 1 END AS TieneAliasSala,&#xA;       s.EsTTL, s.SalaArea, s.DealerArea, s.ModeloArea&#xA;INTO   #PreGestionDealer&#xA;FROM   #SrcGestionDealer AS s&#xA;LEFT JOIN #AliasAutos AS a ON a.Alias = UPPER(LTRIM(RTRIM(s.SalaArea)))&#xA;LEFT JOIN #SalaUnica  AS su ON su.RUTID = a.RUTID&#xA;LEFT JOIN #ModAlias   AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)));&#xA;&#xA;-- TTL (D-29): el dealer se toma de los bloques de sala resueltos de la misma hoja; sin sala y sin Qc&#xA;SELECT p.Archivo, p.Hoja, p.FilaOrigen, p.RowNumber,&#xA;       CASE WHEN p.EsTTL = 1 THEN (SELECT TOP (1) q.RUTIDAlias FROM #PreGestionDealer q&#xA;                                   WHERE q.Archivo = p.Archivo AND q.Hoja = p.Hoja AND q.EsTTL = 0 AND q.RUTIDAlias IS NOT NULL&#xA;                                   GROUP BY q.RUTIDAlias ORDER BY COUNT(*) DESC)&#xA;            ELSE p.RUTIDAlias END AS RUTID,&#xA;       CASE WHEN p.EsTTL = 1 THEN NULL ELSE COALESCE(p.SalaAlias, p.SalaUnica) END AS SUCURSALID,&#xA;       p.Modelo, p.Familia&#xA;INTO   #ResGestionDealer&#xA;FROM   #PreGestionDealer AS p;&#xA;&#xA;SELECT p.Archivo, p.Hoja, p.FilaOrigen, p.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaGestionDealer&#xA;FROM   #PreGestionDealer AS p&#xA;CROSS APPLY (&#xA;    SELECT CASE WHEN p.SalaArea = p.DealerArea THEN N'DEALER_SIN_ALIAS' ELSE N'SALA_SIN_ALIAS' END,&#xA;           N'&quot;' + p.SalaArea + N'&quot; no tiene alias ORIGEN Autos en el maestro de Autos'&#xA;    WHERE p.EsTTL = 0 AND p.TieneAliasSala = 0&#xA;    UNION ALL&#xA;    SELECT N'SALA_SIN_ALIAS', N'&quot;' + p.SalaArea + N'&quot; tiene alias de dealer, no de sala, y el dealer tiene varias salas'&#xA;    WHERE p.EsTTL = 0 AND p.TieneAliasSala = 1 AND p.SalaAlias IS NULL AND p.SalaUnica IS NULL&#xA;    UNION ALL&#xA;    SELECT N'GRUPO_FUERA_MAESTRO',&#xA;           CASE WHEN p.TieneAliasModelo = 0 THEN N'Modelo &quot;' + p.ModeloArea + N'&quot; sin alias en V4WBaseModeloAlias'&#xA;                ELSE N'Modelo &quot;' + p.ModeloArea + N'&quot; apunta a un grupo que no existe en V4WBaseModeloGrupo' END&#xA;    WHERE p.EsTTL = 0 AND (p.TieneAliasModelo = 0 OR p.EnMaestro = 0)&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;-- GestionDealer: I / U por hash (fila + resolución); D = filas en Base de un archivo recargado que ya no vienen&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadGestionDealer&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [SalaArea], [EsTTL], [EsFuenteDealer], [ModeloArea], [NivelArea], [EsDetalle], [Retail], [PlanDealer], [FCRetail], [WS], [FCWhole], [Stock], [Test], [RUTID], [SUCURSALID], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Archivo], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[DealerArea], s.[SalaArea], s.[EsTTL], s.[EsFuenteDealer], s.[ModeloArea], s.[NivelArea], s.[EsDetalle], s.[Retail], s.[PlanDealer], s.[FCRetail], s.[WS], s.[FCWhole], s.[Stock], s.[Test], s.[RUTID], s.[SUCURSALID], s.[Modelo], s.[Familia], h.HashNuevo, ISNULL(bs.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN bs.Archivo IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN bs.Archivo IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[RUTID], r.[SUCURSALID], r.[Modelo], r.[Familia] FROM #SrcGestionDealer x JOIN #ResGestionDealer r ON r.[Archivo] = x.[Archivo] AND r.[Hoja] = x.[Hoja] AND r.[FilaOrigen] = x.[FilaOrigen]) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[DealerArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SalaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[EsTTL]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[EsFuenteDealer]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[NivelArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[EsDetalle]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Retail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[PlanDealer]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FCRetail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[WS]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FCWhole]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Stock]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Test]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Familia]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseGestionDealer AS bs ON bs.[Archivo] = s.[Archivo] AND bs.[Hoja] = s.[Hoja] AND bs.[FilaOrigen] = s.[FilaOrigen]&#xA;WHERE  bs.Archivo IS NULL OR bs.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadGestionDealer&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [DealerArea], [SalaArea], [EsTTL], [EsFuenteDealer], [ModeloArea], [NivelArea], [EsDetalle], [Retail], [PlanDealer], [FCRetail], [WS], [FCWhole], [Stock], [Test], [RUTID], [SUCURSALID], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT bs.[Archivo], bs.[FechaCorte], bs.[Hoja], bs.[FilaOrigen], bs.[DealerArea], bs.[SalaArea], bs.[EsTTL], bs.[EsFuenteDealer], bs.[ModeloArea], bs.[NivelArea], bs.[EsDetalle], bs.[Retail], bs.[PlanDealer], bs.[FCRetail], bs.[WS], bs.[FCWhole], bs.[Stock], bs.[Test], bs.[RUTID], bs.[SUCURSALID], bs.[Modelo], bs.[Familia], bs.Hash64, bs.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseGestionDealer AS bs&#xA;WHERE  bs.Archivo IN (SELECT Archivo FROM #Archivos)&#xA;  AND  NOT EXISTS (SELECT 1 FROM #SrcGestionDealer s WHERE s.[Archivo] = bs.[Archivo] AND s.[Hoja] = bs.[Hoja] AND s.[FilaOrigen] = bs.[FilaOrigen]);&#xA;&#xA;IF OBJECT_ID(N'tempdb..#SrcAvanceDiario') IS NOT NULL DROP TABLE #SrcAvanceDiario;&#xA;SELECT * INTO #SrcAvanceDiario FROM HMDCBISA.dbo.V4WStgAvanceDiario WHERE ExecutionID = @ExecutionID;&#xA;-- ── Resolución AvanceDiario sobre #SrcAvanceDiario (mismas columnas que la Stg) → #ResAvanceDiario y #FallaAvanceDiario ──&#xA;IF OBJECT_ID(N'tempdb..#ResAvanceDiario')   IS NOT NULL DROP TABLE #ResAvanceDiario;&#xA;IF OBJECT_ID(N'tempdb..#PreAvanceDiario')   IS NOT NULL DROP TABLE #PreAvanceDiario;&#xA;IF OBJECT_ID(N'tempdb..#FallaAvanceDiario') IS NOT NULL DROP TABLE #FallaAvanceDiario;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber, m.Modelo, m.Familia&#xA;INTO   #ResAvanceDiario&#xA;FROM   #SrcAvanceDiario AS s&#xA;LEFT JOIN #ModAlias AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)));&#xA;&#xA;SELECT s.[Archivo], s.[Hoja], s.[FilaOrigen], s.RowNumber, N'GRUPO_FUERA_MAESTRO' AS MotivoFalla,&#xA;       CASE WHEN m.Alias IS NULL THEN N'Modelo &quot;' + s.ModeloArea + N'&quot; sin alias en V4WBaseModeloAlias'&#xA;            ELSE N'Modelo &quot;' + s.ModeloArea + N'&quot; apunta a un grupo que no existe en V4WBaseModeloGrupo' END AS DetalleError&#xA;INTO   #FallaAvanceDiario&#xA;FROM   #SrcAvanceDiario AS s&#xA;LEFT JOIN #ModAlias AS m ON m.Alias = UPPER(LTRIM(RTRIM(s.ModeloArea)))&#xA;WHERE  m.Alias IS NULL OR m.EnMaestro = 0;&#xA;&#xA;-- AvanceDiario: I / U por hash (fila + resolución); D = filas en Base de un archivo recargado que ya no vienen&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadAvanceDiario&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [Canal], [Orden], [ModeloArea], [NivelArea], [EsDetalle], [AvanceReal], [Meta2QFC], [MetaNiguri], [PlanMTD2QFC], [PlanMTDNiguri], [PlanDealers], [FCDLR], [MesAnterior], [StockHonda], [SpecialSales], [FactorArea], [DiaArea], [LeadsMTD], [LeadsWebMTD], [LeadsMesAnteriorMTD], [LeadTargetWeb], [WebSales], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Archivo], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[Canal], s.[Orden], s.[ModeloArea], s.[NivelArea], s.[EsDetalle], s.[AvanceReal], s.[Meta2QFC], s.[MetaNiguri], s.[PlanMTD2QFC], s.[PlanMTDNiguri], s.[PlanDealers], s.[FCDLR], s.[MesAnterior], s.[StockHonda], s.[SpecialSales], s.[FactorArea], s.[DiaArea], s.[LeadsMTD], s.[LeadsWebMTD], s.[LeadsMesAnteriorMTD], s.[LeadTargetWeb], s.[WebSales], s.[Modelo], s.[Familia], h.HashNuevo, ISNULL(bs.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN bs.Archivo IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN bs.Archivo IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[Modelo], r.[Familia] FROM #SrcAvanceDiario x JOIN #ResAvanceDiario r ON r.[Archivo] = x.[Archivo] AND r.[Hoja] = x.[Hoja] AND r.[FilaOrigen] = x.[FilaOrigen]) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Canal]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Orden]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[NivelArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[EsDetalle]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[AvanceReal]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Meta2QFC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[MetaNiguri]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[PlanMTD2QFC]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[PlanMTDNiguri]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[PlanDealers]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FCDLR]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[MesAnterior]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[StockHonda]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SpecialSales]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FactorArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[DiaArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[LeadsMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[LeadsWebMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[LeadsMesAnteriorMTD]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[LeadTargetWeb]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[WebSales]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Familia]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseAvanceDiario AS bs ON bs.[Archivo] = s.[Archivo] AND bs.[Hoja] = s.[Hoja] AND bs.[FilaOrigen] = s.[FilaOrigen]&#xA;WHERE  bs.Archivo IS NULL OR bs.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadAvanceDiario&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [Canal], [Orden], [ModeloArea], [NivelArea], [EsDetalle], [AvanceReal], [Meta2QFC], [MetaNiguri], [PlanMTD2QFC], [PlanMTDNiguri], [PlanDealers], [FCDLR], [MesAnterior], [StockHonda], [SpecialSales], [FactorArea], [DiaArea], [LeadsMTD], [LeadsWebMTD], [LeadsMesAnteriorMTD], [LeadTargetWeb], [WebSales], [Modelo], [Familia], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT bs.[Archivo], bs.[FechaCorte], bs.[Hoja], bs.[FilaOrigen], bs.[Canal], bs.[Orden], bs.[ModeloArea], bs.[NivelArea], bs.[EsDetalle], bs.[AvanceReal], bs.[Meta2QFC], bs.[MetaNiguri], bs.[PlanMTD2QFC], bs.[PlanMTDNiguri], bs.[PlanDealers], bs.[FCDLR], bs.[MesAnterior], bs.[StockHonda], bs.[SpecialSales], bs.[FactorArea], bs.[DiaArea], bs.[LeadsMTD], bs.[LeadsWebMTD], bs.[LeadsMesAnteriorMTD], bs.[LeadTargetWeb], bs.[WebSales], bs.[Modelo], bs.[Familia], bs.Hash64, bs.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseAvanceDiario AS bs&#xA;WHERE  bs.Archivo IN (SELECT Archivo FROM #Archivos)&#xA;  AND  NOT EXISTS (SELECT 1 FROM #SrcAvanceDiario s WHERE s.[Archivo] = bs.[Archivo] AND s.[Hoja] = bs.[Hoja] AND s.[FilaOrigen] = bs.[FilaOrigen]);&#xA;&#xA;IF OBJECT_ID(N'tempdb..#SrcStockDealer') IS NOT NULL DROP TABLE #SrcStockDealer;&#xA;SELECT * INTO #SrcStockDealer FROM HMDCBISA.dbo.V4WStgStockDealer WHERE ExecutionID = @ExecutionID;&#xA;-- ── Resolución StockDealer sobre #SrcStockDealer (mismas columnas que la Stg) → #ResStockDealer y #FallaStockDealer ──&#xA;IF OBJECT_ID(N'tempdb..#ResStockDealer')   IS NOT NULL DROP TABLE #ResStockDealer;&#xA;IF OBJECT_ID(N'tempdb..#PreStockDealer')   IS NOT NULL DROP TABLE #PreStockDealer;&#xA;IF OBJECT_ID(N'tempdb..#FallaStockDealer') IS NOT NULL DROP TABLE #FallaStockDealer;&#xA;SELECT s.[Archivo], s.[FilaOrigen], s.RowNumber, a.RUTID, CONVERT(int, NULL) AS SUCURSALID, v.Codigo AS CodigoArticulo,&#xA;       CASE WHEN a.Alias IS NULL THEN 0 ELSE 1 END AS TieneAlias, CASE WHEN v.VIN IS NULL THEN 0 ELSE 1 END AS EnMaestro,&#xA;       s.ConcesionarioArea, s.VIN&#xA;INTO   #PreStockDealer&#xA;FROM   #SrcStockDealer AS s&#xA;LEFT JOIN #AliasAutos AS a ON a.Alias = UPPER(LTRIM(RTRIM(s.ConcesionarioArea)))&#xA;LEFT JOIN #Vin        AS v ON v.VIN = UPPER(LTRIM(RTRIM(s.VIN)));&#xA;&#xA;-- La sala del VIN del Stock Dealer no la informa el área: la completa la imputación (42). D-44&#xA;SELECT p.[Archivo], p.[FilaOrigen], p.RowNumber, p.RUTID, p.SUCURSALID, p.CodigoArticulo&#xA;INTO   #ResStockDealer&#xA;FROM   #PreStockDealer AS p;&#xA;&#xA;SELECT p.[Archivo], p.[FilaOrigen], p.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #FallaStockDealer&#xA;FROM   #PreStockDealer AS p&#xA;CROSS APPLY (&#xA;    SELECT N'DEALER_SIN_ALIAS', N'Concesionario &quot;' + ISNULL(p.ConcesionarioArea, N'(vacío)') + N'&quot; sin alias ORIGEN Autos en el maestro de Autos'&#xA;    WHERE p.TieneAlias = 0&#xA;    UNION ALL&#xA;    SELECT N'VIN_FUERA_MAESTRO', N'VIN ' + p.VIN + N' no existe en SFOBaseVin_Modelos__c (Automoviles)'&#xA;    WHERE p.EnMaestro = 0&#xA;    UNION ALL&#xA;    SELECT N'DUPLICADO', N'VIN ' + p.VIN + N' repetido en la hoja Stock Dealer del archivo'&#xA;    WHERE (SELECT COUNT(*) FROM #PreStockDealer x WHERE x.Archivo = p.Archivo AND x.VIN = p.VIN) &gt; 1&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;-- StockDealer: I / U por hash (fila + resolución); D = filas en Base de un archivo recargado que ya no vienen&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadStockDealer&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [VIN], [ConcesionarioArea], [ModeloArea], [Color], [Retail], [Fuente], [CondicionVenta], [Renovacion], [Credito], [RUTID], [SUCURSALID], [CodigoArticulo], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Archivo], s.[FechaCorte], s.[Hoja], s.[FilaOrigen], s.[VIN], s.[ConcesionarioArea], s.[ModeloArea], s.[Color], s.[Retail], s.[Fuente], s.[CondicionVenta], s.[Renovacion], s.[Credito], s.[RUTID], s.[SUCURSALID], s.[CodigoArticulo], h.HashNuevo, ISNULL(bs.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN bs.Archivo IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN bs.Archivo IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[RUTID], r.[SUCURSALID], r.[CodigoArticulo] FROM #SrcStockDealer x JOIN #ResStockDealer r ON r.[Archivo] = x.[Archivo] AND r.[FilaOrigen] = x.[FilaOrigen]) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[Archivo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FechaCorte]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Hoja]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FilaOrigen]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[VIN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ConcesionarioArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ModeloArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Color]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Retail]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Fuente]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[CondicionVenta]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Renovacion]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Credito]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[CodigoArticulo]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseStockDealer AS bs ON bs.[Archivo] = s.[Archivo] AND bs.[FilaOrigen] = s.[FilaOrigen]&#xA;WHERE  bs.Archivo IS NULL OR bs.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadStockDealer&#xA;       ([Archivo], [FechaCorte], [Hoja], [FilaOrigen], [VIN], [ConcesionarioArea], [ModeloArea], [Color], [Retail], [Fuente], [CondicionVenta], [Renovacion], [Credito], [RUTID], [SUCURSALID], [CodigoArticulo], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT bs.[Archivo], bs.[FechaCorte], bs.[Hoja], bs.[FilaOrigen], bs.[VIN], bs.[ConcesionarioArea], bs.[ModeloArea], bs.[Color], bs.[Retail], bs.[Fuente], bs.[CondicionVenta], bs.[Renovacion], bs.[Credito], bs.[RUTID], bs.[SUCURSALID], bs.[CodigoArticulo], bs.Hash64, bs.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseStockDealer AS bs&#xA;WHERE  bs.Archivo IN (SELECT Archivo FROM #Archivos)&#xA;  AND  NOT EXISTS (SELECT 1 FROM #SrcStockDealer s WHERE s.[Archivo] = bs.[Archivo] AND s.[FilaOrigen] = bs.[FilaOrigen]);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM #SrcGestionDealer) + (SELECT COUNT(*) FROM #SrcAvanceDiario) + (SELECT COUNT(*) FROM #SrcStockDealer) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
