tgt.[MetaNiguri] = src.[MetaNiguri], tgt.[PlanMTD2QFC] = src.[PlanMTD2QFC], tgt.[PlanMTDNiguri] = src.[PlanMTDNiguri], tgt.[PlanDealers] = src.[PlanDealers], tgt.[FCDLR] = src.[FCDLR], tgt.[MesAnterior] = src.[MesAnterior], tgt.[StockHonda] = src.[StockHonda], tgt.[SpecialSales] = src.[SpecialSales], tgt.[FactorArea] = src.[FactorArea], tgt.[DiaArea] = src.[DiaArea], tgt.[LeadsMTD] = src.[LeadsMTD], tgt.[LeadsWebMTD] = src.[LeadsWebMTD], tgt.[LeadsMesAnteriorMTD] = src.[LeadsMesAnteriorMTD], tgt.[LeadTargetWeb] = src.[LeadTargetWeb], tgt.[WebSales] = src.[WebSales], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseAvanceDiario AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadAvanceDiario AS src ON src.[Archivo] = tgt.[Archivo] AND src.[Hoja] = tgt.[Hoja] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;&#xA;UPDATE tgt SET tgt.[FechaCorte] = src.[FechaCorte], tgt.[Hoja] = src.[Hoja], tgt.[VIN] = src.[VIN], tgt.[ConcesionarioArea] = src.[ConcesionarioArea], tgt.[ModeloArea] = src.[ModeloArea], tgt.[Color] = src.[Color], tgt.[Retail] = src.[Retail], tgt.[Fuente] = src.[Fuente], tgt.[CondicionVenta] = src.[CondicionVenta], tgt.[Renovacion] = src.[Renovacion], tgt.[Credito] = src.[Credito], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[CodigoArticulo] = src.[CodigoArticulo],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseStockDealer AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadStockDealer AS src ON src.[Archivo] = tgt.[Archivo] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N += @@ROWCOUNT;&#xA;SELECT @N AS RowsUpdated;&#xA;"
