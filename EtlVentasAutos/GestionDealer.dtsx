/* ETL00aCheckFile — V4W · paquetes de archivo (ModeloGrupo 38, ModeloAlias 39; luego 36 y 37)
 *
 * Corre todos los días (D-31, SOL-008 O-5). Decide si el archivo del file server cambió:
 *   1. Verifica que el archivo exista en $Package::EtlFilePath (ruta \\10.144.5.248\…, D-ARQ-41).
 *   2. Calcula el SHA-256 del archivo (lo abre con FileShare.ReadWrite: el área puede tenerlo abierto).
 *   3. Lo compara con el último registro en HMDCBIDW.dbo.V4WBaseArchivoCargado del mismo
 *      ProcessID y archivo, ignorando los registros 'SinCambios'.
 *   4. Escribe:
 *        User::EtlArchivoCambiado  (Boolean) → true = cargar; false = solo re-evaluar Qc y cerrar OK
 *        User::EtlHashArchivo      (String)  → SHA-256 en hexadecimal (64 caracteres)
 *        User::EtlTamanoBytes      (Int64)
 *        User::EtlFileModifiedDate (DateTime) → fecha de modificación del archivo
 *        User::EtlOperatorUser     (String)  → cuenta que ejecuta (no hay operador manual)
 *        User::EtlEstadoArchivo    (String)  → "Cargado" o "SinCambios" (lo usa ETL06RegisterFile)
 *
 * ReadOnlyVariables : $Package::EtlFilePath, $Package::CtlProcessID, $Project::vSQLConnDw
 * ReadWriteVariables: User::EtlArchivoCambiado, User::EtlHashArchivo, User::EtlTamanoBytes,
 *                     User::EtlFileModifiedDate, User::EtlOperatorUser, User::EtlEstadoArchivo
 *
 * Restricciones de plataforma: C# 7.3 / .NET Framework (SSIS 2019). Sin credenciales: vSQLConnDw es WT.
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.SqlClient;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Text.RegularExpressions;
#endregion

namespace ST_1eea5bfed806408f9ed3b445df6d54b9
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private static class Config
        {
            public const string ComponentName = "ETL00aCheckFile";
            public const string Patron = "Gestion Dealer 4W*.xlsx";
            public const string CarpetaExcluida = "ModeloAlias";
            public const string TablaArchivo = "dbo.V4WBaseArchivoCargado";
        }

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                string carpeta = Convert.ToString(Dts.Variables["$Package::EtlFilePath"].Value);
                int processId = Convert.ToInt32(Dts.Variables["$Package::CtlProcessID"].Value);
                string connDw = Convert.ToString(Dts.Variables["$Project::vSQLConnDw"].Value);
                DateTime desde = Convert.ToDateTime(Dts.Variables["User::WmCurrentLoadDate"].Value).Date;

                if (!Directory.Exists(carpeta))
                    throw new DirectoryNotFoundException("No existe la carpeta del file server: " + carpeta);

                Dictionary<string, string> ultimos = LeerUltimosHash(connDw, processId);

                var lineas = new List<string>();
                int vistos = 0, fueraKi = 0, sinFecha = 0, iguales = 0;
                var nombresSinFecha = new List<string>();
                foreach (string ruta in Directory.EnumerateFiles(carpeta, Config.Patron, SearchOption.AllDirectories))
                {
                    var fi = new FileInfo(ruta);
                    if (fi.Name.StartsWith("~$")) continue;
                    if (fi.DirectoryName != null &&
                        fi.DirectoryName.Split(Path.DirectorySeparatorChar).Any(p => string.Equals(p, Config.CarpetaExcluida, StringComparison.OrdinalIgnoreCase)))
                        continue;
                    vistos++;

                    DateTime? corte = FechaCorte(fi);
                    if (corte == null) { sinFecha++; nombresSinFecha.Add(fi.Name); continue; }
                    if (corte.Value < desde) { fueraKi++; continue; }

                    string hash = Sha256(ruta);
                    string previo;
                    if (ultimos.TryGetValue(ruta.ToUpperInvariant(), out previo) &&
                        string.Equals(previo, hash, StringComparison.OrdinalIgnoreCase)) { iguales++; continue; }

                    lineas.Add(string.Join("\t", new[]
                    {
                        ruta, fi.Name, corte.Value.ToString("yyyy-MM-dd"),
                        fi.LastWriteTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture),
                        fi.Length.ToString(CultureInfo.InvariantCulture), hash
                    }));
                }

                Dts.Variables["User::EtlArchivosLista"].Value = string.Join("\n", lineas);
                Dts.Variables["User::EtlArchivoCambiado"].Value = lineas.Count > 0;
                Dts.Variables["User::EtlEstadoArchivo"].Value = lineas.Count > 0 ? "Cargado" : "SinCambios";
                Dts.Variables["User::EtlOperatorUser"].Value = Environment.UserDomainName + "\\" + Environment.UserName;

                Dts.Events.FireInformation(0, Config.ComponentName,
                    string.Format("Archivos Gestion vistos: {0} · fuera del KI: {1} · sin fecha en el nombre: {2} · sin cambios: {3} · A CARGAR: {4}",
                        vistos, fueraKi, sinFecha, iguales, lineas.Count), "", 0, ref fireAgain);
                if (sinFecha > 0)
                    Dts.Events.FireWarning(0, Config.ComponentName,
                        sinFecha + " archivo(s) 'Gestion Dealer 4W' sin fecha DD-MM en el nombre: no se cargan: " +
                        string.Join(" | ", nombresSinFecha.Take(40)), "", 0);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ComponentName, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // DD-MM o DD_MM del nombre ("… Octubre 31-10.xlsx", "… 31-10 Cierre.xlsx", "… Abril 08_04.xlsx"); año desde la carpeta \AAAA\.
        private static DateTime? FechaCorte(FileInfo fi)
        {
            var m = Regex.Matches(Path.GetFileNameWithoutExtension(fi.Name), @"(?<!\d)(\d{1,2})[-_](\d{1,2})(?!\d)");
            if (m.Count == 0) return null;
            int d = int.Parse(m[m.Count - 1].Groups[1].Value), mes = int.Parse(m[m.Count - 1].Groups[2].Value);

            int? anio = null;
            foreach (string p in (fi.DirectoryName ?? "").Split(Path.DirectorySeparatorChar))
                if (p.Length == 4 && p.All(char.IsDigit)) anio = int.Parse(p);
            if (anio == null) anio = fi.LastWriteTime.Year - (mes > fi.LastWriteTime.Month ? 1 : 0);

            // v1.3 (D-49): un "Cierre" cuyo mes nombrado no coincide con el de la fecha (ej. "Marzo 06_04 Cierre")
            // es el cierre del mes nombrado: fecha de corte = último día de ese mes.
            string nombre = fi.Name.ToLowerInvariant();
            int mesNombre = MesEnNombre(nombre);
            if (nombre.Contains("cierre") && mesNombre > 0 && mesNombre != mes)
            {
                int anioCierre = anio.Value - (mesNombre > mes ? 1 : 0);   // "Diciembre 05_01 Cierre" → diciembre del año anterior
                return new DateTime(anioCierre, mesNombre, DateTime.DaysInMonth(anioCierre, mesNombre));
            }

            try { return new DateTime(anio.Value, mes, d); } catch { return null; }
        }

        private static readonly string[] Meses = { "enero", "febrero", "marzo", "abril", "mayo", "junio", "julio",
                                                   "agosto", "septiembre", "octubre", "noviembre", "diciembre" };
        private static int MesEnNombre(string nombre)
        {
            for (int i = 0; i < Meses.Length; i++)
                if (Regex.IsMatch(nombre, @"\b" + Meses[i] + @"\b")) return i + 1;
            if (Regex.IsMatch(nombre, @"\bsetiembre\b")) return 9;
            return 0;
        }

        private static string Sha256(string path)
        {
            using (var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            using (var sha = SHA256.Create())
            {
                var sb = new StringBuilder(64);
                foreach (byte b in sha.ComputeHash(fs)) sb.Append(b.ToString("X2"));
                return sb.ToString();
            }
        }

        // Último hash por ruta (en mayúsculas), ignorando los registros 'SinCambios'.
        private static Dictionary<string, string> LeerUltimosHash(string connStr, int processId)
        {
            var d = new Dictionary<string, string>(StringComparer.Ordinal);
            const string sql = @"
SELECT x.Ruta, CONVERT(varchar(64), x.HashArchivo, 2) AS HashHex
FROM (SELECT Ruta, HashArchivo, ROW_NUMBER() OVER (PARTITION BY Ruta ORDER BY ArchivoCargadoID DESC) AS Rn
      FROM " + Config.TablaArchivo + @"
      WHERE ProcessID = @ProcessID AND Estado <> N'SinCambios') AS x
WHERE x.Rn = 1;";
            using (var cn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, cn))
            {
                cmd.Parameters.Add("@ProcessID", SqlDbType.Int).Value = processId;
                cn.Open();
                using (var rd = cmd.ExecuteReader())
                    while (rd.Read()) d[rd.GetString(0).ToUpperInvariant()] = rd.GetString(1);
            }
            return d;
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
