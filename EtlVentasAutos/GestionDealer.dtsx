                new ReporteSeccion(
                    titulo:       "Gestion · filas nuevas",
                    tabla:        "HMDCBISA.dbo.V4WLoadGestionDealer",
                    filter:       "TypeLoad = 'I'",
                    ordenColumna: "RowNumber",
                    metricKey:    "InsertedRows",
                    columnas: new ReporteCol[]
                    {
                        new ReporteCol("FechaCorte", "Corte", 80),
