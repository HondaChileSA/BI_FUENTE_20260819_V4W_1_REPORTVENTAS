                    filter:       "TypeLoad = 'U'",
                    ordenColumna: "RowNumber",
                    metricKey:    "UpdatedRows",
                    columnas: new ReporteCol[]
                    {
                        new ReporteCol("FechaCorte", "Corte", 80),
                        new ReporteCol("Hoja", "Hoja", 110),
                        new ReporteCol("SalaArea", "Sala", 150),
