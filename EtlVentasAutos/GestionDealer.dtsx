    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5521B21B-2801-4A4C-8DE7-09B5D0539F9C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* GestionDealer__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_gestiondealer.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U (antes y después) y D (antes) de las 3 entidades, en un solo CTLAuditBatch; el JSON lleva la entidad.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT N'GestionDealer' AS Entidad, tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT N'GestionDealer' AS Entidad, src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseGestionDealer AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadGestionDealer AS src ON src.[Archivo] = tgt.[Archivo] AND src.[Hoja] = tgt.[Hoja] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT N'AvanceDiario' AS Entidad, tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT N'AvanceDiario' AS Entidad, src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseAvanceDiario AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadAvanceDiario AS src ON src.[Archivo] = tgt.[Archivo] AND src.[Hoja] = tgt.[Hoja] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT N'StockDealer' AS Entidad, tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT N'StockDealer' AS Entidad, src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseStockDealer AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadStockDealer AS src ON src.[Archivo] = tgt.[Archivo] AND src.[FilaOrigen] = tgt.[FilaOrigen]&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{969A699D-3BD1-4D30-94D5-BB29F20926D1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* GestionDealer__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_gestiondealer.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría I de las 3 entidades (el JSON lleva la entidad).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'I', NULL,&#xA;       (SELECT N'GestionDealer' AS Entidad, src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[DealerArea], src.[SalaArea], src.[EsTTL], src.[EsFuenteDealer], src.[ModeloArea], src.[NivelArea], src.[EsDetalle], src.[Retail], src.[PlanDealer], src.[FCRetail], src.[WS], src.[FCWhole], src.[Stock], src.[Test], src.[RUTID], src.[SUCURSALID], src.[Modelo], src.[Familia], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadGestionDealer AS src&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'I';&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'I', NULL,&#xA;       (SELECT N'AvanceDiario' AS Entidad, src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[Canal], src.[Orden], src.[ModeloArea], src.[NivelArea], src.[EsDetalle], src.[AvanceReal], src.[Meta2QFC], src.[MetaNiguri], src.[PlanMTD2QFC], src.[PlanMTDNiguri], src.[PlanDealers], src.[FCDLR], src.[MesAnterior], src.[StockHonda], src.[SpecialSales], src.[FactorArea], src.[DiaArea], src.[LeadsMTD], src.[LeadsWebMTD], src.[LeadsMesAnteriorMTD], src.[LeadTargetWeb], src.[WebSales], src.[Modelo], src.[Familia], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadAvanceDiario AS src&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'I';&#xA;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, 'I', NULL,&#xA;       (SELECT N'StockDealer' AS Entidad, src.[Archivo], src.[FechaCorte], src.[Hoja], src.[FilaOrigen], src.[VIN], src.[ConcesionarioArea], src.[ModeloArea], src.[Color], src.[Retail], src.[Fuente], src.[CondicionVenta], src.[Renovacion], src.[Credito], src.[RUTID], src.[SUCURSALID], src.[CodigoArticulo], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadStockDealer AS src&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{933B8B2D-7EE7-4892-84F5-28B8FE403865}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* GestionDealer__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_gestiondealer.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote. FailedRows = pendientes vistos en esta corrida en las 3 Qc; borradas en Notes. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::EtlRowsDeleted · 5) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @FailedRows int =&#xA;      (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcGestionDealer WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente')&#xA;    + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcAvanceDiario  WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente')&#xA;    + (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcStockDealer   WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente');&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = @FailedRows,&#xA;       Notes = CASE WHEN @Del &gt; 0 THEN N'Filas borradas de Base (TypeLoad D, fotografía reemplazada): ' + CONVERT(nvarchar(20), @Del) END&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT @FailedRows AS RowsFailed;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="4" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{AFD65115-2C3A-4AF4-AB6E-FECA78358663}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* GestionDealer__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : GestionDealer (EtlVentasAutos, ProcessID 36) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-08 · plan V1 v6 · D-16, D-22, D-29, D-34, D-37, D-44, D-46, D-ARQ-40&#xA;   Generado: etapas/V1/herramientas/generar_sql_gestiondealer.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo (archivos por hash): conserva el corte del KI 103 (CTL10 resta un día) y deja la última fotografía cargada.&#xA;   Parámetros (OLE DB, en orden): 1) User::WmCurrentLoadDate&#xA;*/&#xA;DECLARE @Actual date = ?;&#xA;SELECT DATEADD(DAY, 1, @Actual) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(FechaCorte) FROM HMDCBIDW.dbo.V4WBaseGestionDealer), 23), N'') AS NewLastID;&#xA;"
