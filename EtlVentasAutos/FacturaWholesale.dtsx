    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL01TruncateStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{C818470A-7CE6-4FC0-B408-00FACE7707A0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL01TruncateStaging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL01TruncateStaging_v1.0.sql&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL01TruncateStaging&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008, D-22, D-32, D-35, D-36&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Vacía Stg y Load. La Qc NO se trunca (persistente, D-ARQ-40).&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WStgFacturaWholesale;&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WLoadFacturaWholesale;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL02bValidateMaestro"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{30B107DF-77F8-4786-992F-B314CFF38AC1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL02bValidateMaestro"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL02bValidateMaestro_v1.2.sql   (v1.2 06-11: plan V1 v6, SOL-011 / D-ARQ-50 · reemplaza v1.1 en _reemplazados/)&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL02bValidateMaestro&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-05 · D-22, D-32, D-35, D-36, D-37, D-ARQ-44, D-ARQ-45&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: 1) Resuelve dealer y sala (bloque Resolución). 2) Borra en Stg la razón social de personas (ES_PERSONA o RUT &lt; 50.000.000; D-36, D-ARQ-45). 3) Valida: RUT_FUERA_DIC, CODIGO_FUERA_MAESTRO, VIN_VACIO, VIN_FUERA_MAESTRO, DUPLICADO. Sin VIN_SIN_SALA: la sala es opcional (D-ARQ-50); la completan Vin_Modelos__c, Stock Dealer o la imputación (42). 4) Actualiza la Qc persistente; lo que ya no falla queda Resuelto (recarga completa). 5) Saca de Stg lo que no cruza. Devuelve RowsQc.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;&#xA;-- ── Resolución (idéntica en ETL02bValidateMaestro y ETL04LoadDWHDW) ──────────────────&#xA;-- Dealer: RUT de la factura = RUTID de DICBaseDealerParent, o RUT_SOCIEDAD de DICBaseDealerParentSociety → su RUTID.&#xA;-- Sala por VIN (D-ARQ-44): (1) Vin_Modelos__c.Sala_de_venta__c → SFOBaseAccount.Name → alias 'Sales force' → SUCURSALID;&#xA;--                          (2) sala del VIN en la última fotografía de V4WBaseStockDealer.&#xA;--   Solo vale una sala del mismo dealer facturado (traspasos: el wholesale queda en el dealer facturado).&#xA;IF OBJECT_ID(N'tempdb..#Parent')    IS NOT NULL DROP TABLE #Parent;&#xA;IF OBJECT_ID(N'tempdb..#Sociedad')  IS NOT NULL DROP TABLE #Sociedad;&#xA;IF OBJECT_ID(N'tempdb..#VinSala')   IS NOT NULL DROP TABLE #VinSala;&#xA;IF OBJECT_ID(N'tempdb..#StockSala') IS NOT NULL DROP TABLE #StockSala;&#xA;IF OBJECT_ID(N'tempdb..#Res')       IS NOT NULL DROP TABLE #Res;&#xA;&#xA;SELECT DISTINCT LTRIM(RTRIM(p.RUTID)) AS RUTID INTO #Parent FROM HMDCBIDW.dbo.DICBaseDealerParent AS p;&#xA;&#xA;SELECT LTRIM(RTRIM(so.RUT_SOCIEDAD)) AS RutSociedad, LTRIM(RTRIM(so.RUTID)) AS RUTID,&#xA;       so.SUCURSALID AS SalaSociedad, so.ES_PERSONA AS EsPersona&#xA;INTO   #Sociedad&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerParentSociety AS so&#xA;WHERE  so.ACTIVO = 1;&#xA;&#xA;SELECT x.VIN, x.SUCURSALID, x.RUTID, x.SalaNombre&#xA;INTO   #VinSala&#xA;FROM (&#xA;    SELECT LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name))) AS VIN, al.SUCURSALID, LTRIM(RTRIM(b.RUTID)) AS RUTID,&#xA;           CONVERT(nvarchar(255), acc.Name) AS SalaNombre,&#xA;           ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY al.SUCURSALID) AS Rn&#xA;    FROM   HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;    JOIN   HMDCBIDW.dbo.SFOBaseAccount        AS acc ON acc.Id = v.Sala_de_venta__c&#xA;    JOIN   HMDCBIDW.dbo.DICBaseDealerAlias    AS al  ON al.ALIAS1 = acc.Name AND al.ORIGEN = N'Sales force' AND al.ACTIVO = 1&#xA;    JOIN   HMDCBIDW.dbo.DICBaseDealerBranch   AS b   ON b.SUCURSALID = al.SUCURSALID&#xA;    WHERE  v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles'&#xA;) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;SELECT x.VIN, x.SUCURSALID, x.RUTID&#xA;INTO   #StockSala&#xA;FROM (&#xA;    SELECT sd.VIN, sd.SUCURSALID, LTRIM(RTRIM(sd.RUTID)) AS RUTID,&#xA;           ROW_NUMBER() OVER (PARTITION BY sd.VIN ORDER BY sd.FechaCorte DESC) AS Rn&#xA;    FROM   HMDCBIDW.dbo.V4WBaseStockDealer AS sd&#xA;    WHERE  sd.VIN IS NOT NULL AND sd.SUCURSALID IS NOT NULL&#xA;) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;SELECT s.RowNumber,&#xA;       d.RUTID,&#xA;       CASE WHEN vs.RUTID = d.RUTID THEN vs.SUCURSALID&#xA;            WHEN ss.RUTID = d.RUTID THEN ss.SUCURSALID END                     AS SUCURSALID,&#xA;       so.SalaSociedad, ISNULL(so.EsPersona, 0)                                AS EsPersona,&#xA;       CASE WHEN vs.RUTID IS NOT NULL AND vs.RUTID &lt;&gt; d.RUTID THEN vs.SalaNombre END AS SalaOtroDealer&#xA;INTO   #Res&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;LEFT JOIN #Sociedad  AS so ON so.RutSociedad = s.RUT&#xA;OUTER APPLY (SELECT COALESCE((SELECT TOP (1) p.RUTID FROM #Parent p WHERE p.RUTID = s.RUT), so.RUTID) AS RUTID) AS d&#xA;LEFT JOIN #VinSala   AS vs ON vs.VIN = s.VIN&#xA;LEFT JOIN #StockSala AS ss ON ss.VIN = s.VIN&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Res ON #Res (RowNumber);&#xA;-- ── fin resolución ───────────────────────────────────────────────────────────────────&#xA;&#xA;-- Sin datos personales (D-36, D-ARQ-45)&#xA;UPDATE s SET s.RazonSocial = NULL&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;JOIN   #Res AS r ON r.RowNumber = s.RowNumber&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (r.EsPersona = 1 OR TRY_CONVERT(int, LEFT(s.RUT, CHARINDEX(N'-', s.RUT + N'-') - 1)) &lt; 50000000);&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Codigo') IS NOT NULL DROP TABLE #Codigo;&#xA;IF OBJECT_ID(N'tempdb..#Vin')    IS NOT NULL DROP TABLE #Vin;&#xA;IF OBJECT_ID(N'tempdb..#Falla')  IS NOT NULL DROP TABLE #Falla;&#xA;&#xA;SELECT DISTINCT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo&#xA;INTO   #Codigo&#xA;FROM   HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;WHERE  v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles' AND v.Codigoarticulo__c IS NOT NULL;&#xA;&#xA;SELECT DISTINCT LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name))) AS VIN&#xA;INTO   #Vin&#xA;FROM   HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;WHERE  v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles';&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Vin ON #Vin (VIN);&#xA;&#xA;SELECT s.RowNumber, s.[NumeroInterno], s.[TipoDocumento], s.[NumeroDocumento], s.[GlosaDocumento], s.[Estado], s.[Fecha], s.[VIN], s.[Motor], s.[Color], s.[RUT], s.[RazonSocial], s.[Articulo], s.[DescripcionArticulo], s.[Cantidad], s.[ValorTotalSinDesc], s.[ValorTotalConDesc], s.[CostoVenta], s.[Descuento], s.[DvcNumDocto], f.MotivoFalla, f.DetalleError, CONVERT(int, 1) AS Rn&#xA;INTO   #Falla&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;JOIN   #Res AS r ON r.RowNumber = s.RowNumber&#xA;CROSS APPLY (&#xA;    SELECT N'RUT_FUERA_DIC', N'RUT ' + ISNULL(s.RUT, N'(vacío)') + N' no está en DICBaseDealerParent ni en DICBaseDealerParentSociety'&#xA;    WHERE r.RUTID IS NULL&#xA;    UNION ALL&#xA;    SELECT N'CODIGO_FUERA_MAESTRO', N'Articulo ' + ISNULL(s.Articulo, N'(vacío)') + N' no existe en SFOBaseVin_Modelos__c (Automoviles)'&#xA;    WHERE NOT EXISTS (SELECT 1 FROM #Codigo c WHERE c.Codigo = s.Articulo)&#xA;    UNION ALL&#xA;    SELECT N'VIN_VACIO', N'Factura sin VIN'&#xA;    WHERE s.VIN IS NULL&#xA;    UNION ALL&#xA;    SELECT N'VIN_FUERA_MAESTRO', N'VIN ' + s.VIN + N' no existe en SFOBaseVin_Modelos__c (Automoviles)'&#xA;    WHERE s.VIN IS NOT NULL AND NOT EXISTS (SELECT 1 FROM #Vin v WHERE v.VIN = s.VIN)&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;&#xA;INSERT INTO #Falla&#xA;SELECT s.RowNumber, s.[NumeroInterno], s.[TipoDocumento], s.[NumeroDocumento], s.[GlosaDocumento], s.[Estado], s.[Fecha], s.[VIN], s.[Motor], s.[Color], s.[RUT], s.[RazonSocial], s.[Articulo], s.[DescripcionArticulo], s.[Cantidad], s.[ValorTotalSinDesc], s.[ValorTotalConDesc], s.[CostoVenta], s.[Descuento], s.[DvcNumDocto], N'DUPLICADO', N'Documento repetido en la vista del .185', 1&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgFacturaWholesale x WHERE x.ExecutionID = @ExecutionID AND x.[NumeroInterno] = s.[NumeroInterno] AND x.[TipoDocumento] = s.[TipoDocumento] AND x.[NumeroDocumento] = s.[NumeroDocumento]) &gt; 1;&#xA;&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [NumeroInterno], [TipoDocumento], [NumeroDocumento], MotivoFalla ORDER BY RowNumber) AS r FROM #Falla)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora,&#xA;       q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[GlosaDocumento] = f.[GlosaDocumento], q.[Estado] = f.[Estado], q.[Fecha] = f.[Fecha], q.[VIN] = f.[VIN], q.[Motor] = f.[Motor], q.[Color] = f.[Color], q.[RUT] = f.[RUT], q.[RazonSocial] = f.[RazonSocial], q.[Articulo] = f.[Articulo], q.[DescripcionArticulo] = f.[DescripcionArticulo], q.[Cantidad] = f.[Cantidad], q.[ValorTotalSinDesc] = f.[ValorTotalSinDesc], q.[ValorTotalConDesc] = f.[ValorTotalConDesc], q.[CostoVenta] = f.[CostoVenta], q.[Descuento] = f.[Descuento], q.[DvcNumDocto] = f.[DvcNumDocto]&#xA;FROM   HMDCBISA.dbo.V4WQcFacturaWholesale AS q&#xA;JOIN   #Falla AS f ON f.[NumeroInterno] = q.[NumeroInterno] AND f.[TipoDocumento] = q.[TipoDocumento] AND f.[NumeroDocumento] = q.[NumeroDocumento] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcFacturaWholesale&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [NumeroInterno], [TipoDocumento], [NumeroDocumento], [GlosaDocumento], [Estado], [Fecha], [VIN], [Motor], [Color], [RUT], [RazonSocial], [Articulo], [DescripcionArticulo], [Cantidad], [ValorTotalSinDesc], [ValorTotalConDesc], [CostoVenta], [Descuento], [DvcNumDocto])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente', @Ahora, @Ahora, f.[NumeroInterno], f.[TipoDocumento], f.[NumeroDocumento], f.[GlosaDocumento], f.[Estado], f.[Fecha], f.[VIN], f.[Motor], f.[Color], f.[RUT], f.[RazonSocial], f.[Articulo], f.[DescripcionArticulo], f.[Cantidad], f.[ValorTotalSinDesc], f.[ValorTotalConDesc], f.[CostoVenta], f.[Descuento], f.[DvcNumDocto]&#xA;FROM   #Falla AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcFacturaWholesale q&#xA;                   WHERE q.[NumeroInterno] = f.[NumeroInterno] AND q.[TipoDocumento] = f.[TipoDocumento] AND q.[NumeroDocumento] = f.[NumeroDocumento] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcFacturaWholesale AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Falla f WHERE f.[NumeroInterno] = q.[NumeroInterno] AND f.[TipoDocumento] = q.[TipoDocumento] AND f.[NumeroDocumento] = q.[NumeroDocumento] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  EXISTS (SELECT 1 FROM #Falla f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(DISTINCT RowNumber) AS RowsQc FROM #Falla;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsQc"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
