    <DTS:Executable
      DTS:refId="Package\ETL04LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F7734D30-E97B-4B0A-A617-52403A7843E2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL04LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL04LoadDWHDW_v1.2.sql   (v1.2 06-11: plan V1 v6, SOL-011 / D-ARQ-50 · reemplaza v1.1 en _reemplazados/)&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL04LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-05 · D-22, D-32, D-35, D-36, D-37, D-ARQ-44, D-ARQ-45&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma V4WLoad: I / U (hash sobre factura + RUTID + SUCURSALID + PendienteEnvio + FechaDespacho: si cambia la sala en el maestro, la fila se actualiza) y D (en Base dentro de la ventana y ya no viene, o pasó a Qc). Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::WmCurrentLoadDate&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Desde date = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;-- ── Resolución (idéntica en ETL02bValidateMaestro y ETL04LoadDWHDW) ──────────────────&#xA;-- Dealer: RUT de la factura = RUTID de DICBaseDealerParent, o RUT_SOCIEDAD de DICBaseDealerParentSociety → su RUTID.&#xA;-- Sala por VIN (D-ARQ-44): (1) Vin_Modelos__c.Sala_de_venta__c → SFOBaseAccount.Name → alias 'Sales force' → SUCURSALID;&#xA;--                          (2) sala del VIN en la última fotografía de V4WBaseStockDealer.&#xA;--   Solo vale una sala del mismo dealer facturado (traspasos: el wholesale queda en el dealer facturado).&#xA;IF OBJECT_ID(N'tempdb..#Parent')    IS NOT NULL DROP TABLE #Parent;&#xA;IF OBJECT_ID(N'tempdb..#Sociedad')  IS NOT NULL DROP TABLE #Sociedad;&#xA;IF OBJECT_ID(N'tempdb..#VinSala')   IS NOT NULL DROP TABLE #VinSala;&#xA;IF OBJECT_ID(N'tempdb..#StockSala') IS NOT NULL DROP TABLE #StockSala;&#xA;IF OBJECT_ID(N'tempdb..#Res')       IS NOT NULL DROP TABLE #Res;&#xA;&#xA;SELECT DISTINCT LTRIM(RTRIM(p.RUTID)) AS RUTID INTO #Parent FROM HMDCBIDW.dbo.DICBaseDealerParent AS p;&#xA;&#xA;SELECT LTRIM(RTRIM(so.RUT_SOCIEDAD)) AS RutSociedad, LTRIM(RTRIM(so.RUTID)) AS RUTID,&#xA;       so.SUCURSALID AS SalaSociedad, so.ES_PERSONA AS EsPersona&#xA;INTO   #Sociedad&#xA;FROM   HMDCBIDW.dbo.DICBaseDealerParentSociety AS so&#xA;WHERE  so.ACTIVO = 1;&#xA;&#xA;SELECT x.VIN, x.SUCURSALID, x.RUTID, x.SalaNombre&#xA;INTO   #VinSala&#xA;FROM (&#xA;    SELECT LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name))) AS VIN, al.SUCURSALID, LTRIM(RTRIM(b.RUTID)) AS RUTID,&#xA;           CONVERT(nvarchar(255), acc.Name) AS SalaNombre,&#xA;           ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY al.SUCURSALID) AS Rn&#xA;    FROM   HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;    JOIN   HMDCBIDW.dbo.SFOBaseAccount        AS acc ON acc.Id = v.Sala_de_venta__c&#xA;    JOIN   HMDCBIDW.dbo.DICBaseDealerAlias    AS al  ON al.ALIAS1 = acc.Name AND al.ORIGEN = N'Sales force' AND al.ACTIVO = 1&#xA;    JOIN   HMDCBIDW.dbo.DICBaseDealerBranch   AS b   ON b.SUCURSALID = al.SUCURSALID&#xA;    WHERE  v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles'&#xA;) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;SELECT x.VIN, x.SUCURSALID, x.RUTID&#xA;INTO   #StockSala&#xA;FROM (&#xA;    SELECT sd.VIN, sd.SUCURSALID, LTRIM(RTRIM(sd.RUTID)) AS RUTID,&#xA;           ROW_NUMBER() OVER (PARTITION BY sd.VIN ORDER BY sd.FechaCorte DESC) AS Rn&#xA;    FROM   HMDCBIDW.dbo.V4WBaseStockDealer AS sd&#xA;    WHERE  sd.VIN IS NOT NULL AND sd.SUCURSALID IS NOT NULL&#xA;) AS x&#xA;WHERE x.Rn = 1;&#xA;&#xA;SELECT s.RowNumber,&#xA;       d.RUTID,&#xA;       CASE WHEN vs.RUTID = d.RUTID THEN vs.SUCURSALID&#xA;            WHEN ss.RUTID = d.RUTID THEN ss.SUCURSALID END                     AS SUCURSALID,&#xA;       so.SalaSociedad, ISNULL(so.EsPersona, 0)                                AS EsPersona,&#xA;       CASE WHEN vs.RUTID IS NOT NULL AND vs.RUTID &lt;&gt; d.RUTID THEN vs.SalaNombre END AS SalaOtroDealer&#xA;INTO   #Res&#xA;FROM   HMDCBISA.dbo.V4WStgFacturaWholesale AS s&#xA;LEFT JOIN #Sociedad  AS so ON so.RutSociedad = s.RUT&#xA;OUTER APPLY (SELECT COALESCE((SELECT TOP (1) p.RUTID FROM #Parent p WHERE p.RUTID = s.RUT), so.RUTID) AS RUTID) AS d&#xA;LEFT JOIN #VinSala   AS vs ON vs.VIN = s.VIN&#xA;LEFT JOIN #StockSala AS ss ON ss.VIN = s.VIN&#xA;WHERE  s.ExecutionID = @ExecutionID;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Res ON #Res (RowNumber);&#xA;-- ── fin resolución ───────────────────────────────────────────────────────────────────&#xA;&#xA;-- Las filas que quedaron en Stg ya pasaron la validación: RUTID existe (la sala es opcional, D-ARQ-50)&#xA;IF EXISTS (SELECT 1 FROM #Res WHERE RUTID IS NULL)&#xA;    THROW 50011, N'Hay filas en Stg sin dealer: ETL02bValidateMaestro debe correr antes que ETL04LoadDWHDW.', 1;&#xA;&#xA;-- Bodega HMDC (D-47): historia de la vista de pendientes de envío (ProcessID 43). Pendiente = sin FechaDespacho.&#xA;IF OBJECT_ID(N'tempdb..#Envio') IS NOT NULL DROP TABLE #Envio;&#xA;SELECT pe.NumeroInterno, pe.TipoDocumento, pe.NumeroDocumento, pe.VIN, pe.FechaDespacho,&#xA;       CONVERT(bit, CASE WHEN pe.FechaDespacho IS NULL THEN 1 ELSE 0 END) AS PendienteEnvio&#xA;INTO   #Envio&#xA;FROM   HMDCBIDW.dbo.V4WBasePendienteEnvio AS pe;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadFacturaWholesale&#xA;       ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [GlosaDocumento], [Estado], [Fecha], [VIN], [Motor], [Color], [RUT], [RazonSocial], [Articulo], [DescripcionArticulo], [Cantidad], [ValorTotalSinDesc], [ValorTotalConDesc], [CostoVenta], [Descuento], [DvcNumDocto], RUTID, CodigoArticulo, SUCURSALID, PendienteEnvio, FechaDespacho, HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[NumeroInterno], s.[TipoDocumento], s.[NumeroDocumento], s.[GlosaDocumento], s.[Estado], s.[Fecha], s.[VIN], s.[Motor], s.[Color], s.[RUT], s.[RazonSocial], s.[Articulo], s.[DescripcionArticulo], s.[Cantidad], s.[ValorTotalSinDesc], s.[ValorTotalConDesc], s.[CostoVenta], s.[Descuento], s.[DvcNumDocto], s.RUTID, s.Articulo, s.SUCURSALID, s.PendienteEnvio, s.FechaDespacho, h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.NumeroInterno IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.NumeroInterno IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   (SELECT x.*, r.RUTID, r.SUCURSALID,&#xA;               ISNULL(e.PendienteEnvio, CONVERT(bit, 0)) AS PendienteEnvio, e.FechaDespacho&#xA;        FROM HMDCBISA.dbo.V4WStgFacturaWholesale AS x&#xA;        JOIN #Res AS r ON r.RowNumber = x.RowNumber&#xA;        LEFT JOIN #Envio AS e ON e.NumeroInterno = x.NumeroInterno AND e.TipoDocumento = x.TipoDocumento&#xA;                             AND e.NumeroDocumento = x.NumeroDocumento AND e.VIN = x.VIN&#xA;        WHERE x.ExecutionID = @ExecutionID) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[NumeroInterno]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[TipoDocumento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[NumeroDocumento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[GlosaDocumento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Estado]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Fecha]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[VIN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Motor]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Color]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RUT]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RazonSocial]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Articulo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[DescripcionArticulo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Cantidad]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ValorTotalSinDesc]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[ValorTotalConDesc]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[CostoVenta]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Descuento]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[DvcNumDocto]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[PendienteEnvio]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[FechaDespacho]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseFacturaWholesale AS b ON b.[NumeroInterno] = s.[NumeroInterno] AND b.[TipoDocumento] = s.[TipoDocumento] AND b.[NumeroDocumento] = s.[NumeroDocumento]&#xA;WHERE  b.NumeroInterno IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadFacturaWholesale&#xA;       ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [GlosaDocumento], [Estado], [Fecha], [VIN], [Motor], [Color], [RUT], [RazonSocial], [Articulo], [DescripcionArticulo], [Cantidad], [ValorTotalSinDesc], [ValorTotalConDesc], [CostoVenta], [Descuento], [DvcNumDocto], RUTID, CodigoArticulo, SUCURSALID, PendienteEnvio, FechaDespacho, HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT b.[NumeroInterno], b.[TipoDocumento], b.[NumeroDocumento], b.[GlosaDocumento], b.[Estado], b.[Fecha], b.[VIN], b.[Motor], b.[Color], b.[RUT], b.[RazonSocial], b.[Articulo], b.[DescripcionArticulo], b.[Cantidad], b.[ValorTotalSinDesc], b.[ValorTotalConDesc], b.[CostoVenta], b.[Descuento], b.[DvcNumDocto], b.RUTID, b.CodigoArticulo, b.SUCURSALID, b.PendienteEnvio, b.FechaDespacho, b.Hash64, b.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseFacturaWholesale AS b&#xA;WHERE  b.Fecha &gt;= @Desde&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WStgFacturaWholesale s WHERE s.ExecutionID = @ExecutionID AND s.[NumeroInterno] = b.[NumeroInterno] AND s.[TipoDocumento] = b.[TipoDocumento] AND s.[NumeroDocumento] = b.[NumeroDocumento]);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgFacturaWholesale WHERE ExecutionID = @ExecutionID) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
