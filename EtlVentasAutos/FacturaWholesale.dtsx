      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL05InsertDWHDW_v1.2.sql   (v1.2 06-11: plan V1 v6, SOL-011 / D-ARQ-50 · reemplaza v1.1 en _reemplazados/)&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-05 · D-22, D-32, D-35, D-36, D-37, D-ARQ-44, D-ARQ-45&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsInsert int;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseFacturaWholesale ([NumeroInterno], [TipoDocumento], [NumeroDocumento], [GlosaDocumento], [Estado], [Fecha], [VIN], [Motor], [Color], [RUT], [RazonSocial], [Articulo], [DescripcionArticulo], [Cantidad], [ValorTotalSinDesc], [ValorTotalConDesc], [CostoVenta], [Descuento], [DvcNumDocto], RUTID, CodigoArticulo, SUCURSALID, PendienteEnvio, FechaDespacho, ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[NumeroInterno], s.[TipoDocumento], s.[NumeroDocumento], s.[GlosaDocumento], s.[Estado], s.[Fecha], s.[VIN], s.[Motor], s.[Color], s.[RUT], s.[RazonSocial], s.[Articulo], s.[DescripcionArticulo], s.[Cantidad], s.[ValorTotalSinDesc], s.[ValorTotalConDesc], s.[CostoVenta], s.[Descuento], s.[DvcNumDocto], s.RUTID, s.CodigoArticulo, s.SUCURSALID, s.PendienteEnvio, s.FechaDespacho, s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadFacturaWholesale AS s&#xA;WHERE  s.ExecutionID = ? AND s.TypeLoad = N'I';&#xA;SET @RowsInsert = @@ROWCOUNT;&#xA;SELECT @RowsInsert AS RowsInsert;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
