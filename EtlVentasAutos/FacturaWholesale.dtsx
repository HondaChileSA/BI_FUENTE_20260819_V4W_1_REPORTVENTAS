      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL05UpdateDWHDW_v1.2.sql   (v1.2 06-11: plan V1 v6, SOL-011 / D-ARQ-50 · reemplaza v1.1 en _reemplazados/)&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-05 · D-22, D-32, D-35, D-36, D-37, D-ARQ-44, D-ARQ-45&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U (incluye cambio de sala). Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsUpdated int;&#xA;UPDATE tgt&#xA;SET    tgt.[GlosaDocumento] = src.[GlosaDocumento], tgt.[Estado] = src.[Estado], tgt.[Fecha] = src.[Fecha], tgt.[VIN] = src.[VIN], tgt.[Motor] = src.[Motor], tgt.[Color] = src.[Color], tgt.[RUT] = src.[RUT], tgt.[RazonSocial] = src.[RazonSocial], tgt.[Articulo] = src.[Articulo], tgt.[DescripcionArticulo] = src.[DescripcionArticulo], tgt.[Cantidad] = src.[Cantidad], tgt.[ValorTotalSinDesc] = src.[ValorTotalSinDesc], tgt.[ValorTotalConDesc] = src.[ValorTotalConDesc], tgt.[CostoVenta] = src.[CostoVenta], tgt.[Descuento] = src.[Descuento], tgt.[DvcNumDocto] = src.[DvcNumDocto], tgt.[RUTID] = src.[RUTID], tgt.[CodigoArticulo] = src.[CodigoArticulo], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[PendienteEnvio] = src.[PendienteEnvio], tgt.[FechaDespacho] = src.[FechaDespacho],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseFacturaWholesale AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadFacturaWholesale AS src ON src.[NumeroInterno] = tgt.[NumeroInterno] AND src.[TipoDocumento] = tgt.[TipoDocumento] AND src.[NumeroDocumento] = tgt.[NumeroDocumento]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @RowsUpdated = @@ROWCOUNT;&#xA;SELECT @RowsUpdated AS RowsUpdated;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
