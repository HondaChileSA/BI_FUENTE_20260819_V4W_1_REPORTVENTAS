      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* FacturaWholesale__ETL05DeleteDWHDW_v1.0.sql&#xA;   Paquete : FacturaWholesale (EtlVentasAutos, ProcessID 34) · Tarea: ETL05DeleteDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008, D-22, D-32, D-35, D-36&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Borra de Base las filas D (ya no vienen en la fuente o pasaron a Qc). Devuelve RowsDeleted. 📝 Tarea nueva en SOL-009.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsDeleted int;&#xA;DELETE tgt&#xA;FROM   HMDCBIDW.dbo.V4WBaseFacturaWholesale AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadFacturaWholesale AS src ON src.[NumeroInterno] = tgt.[NumeroInterno] AND src.[TipoDocumento] = tgt.[TipoDocumento] AND src.[NumeroDocumento] = tgt.[NumeroDocumento]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'D';&#xA;SET @RowsDeleted = @@ROWCOUNT;&#xA;SELECT @RowsDeleted AS RowsDeleted;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsDeleted"
            SQLTask:DtsVariableName="User::EtlRowsDeleted" />
