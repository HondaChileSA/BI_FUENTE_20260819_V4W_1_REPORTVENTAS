      DTS:LocaleID="-1"
      DTS:ObjectName="ETL05InsertDWHDW"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* ModeloGrupo__ETL05InsertDWHDW_v1.0.sql&#xA;   Paquete : ModeloGrupo (EtlVentasAutos) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas TypeLoad I. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsInsert int;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseModeloGrupo ([ModeloGrupoID], [CodigoArticulo], [Modelo], [Familia], [Activo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[ModeloGrupoID], s.[CodigoArticulo], s.[Modelo], s.[Familia], s.[Activo], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadModeloGrupo AS s&#xA;WHERE  s.ExecutionID = ? AND s.TypeLoad = N'I';&#xA;SET @RowsInsert = @@ROWCOUNT;&#xA;SELECT @RowsInsert AS RowsInsert;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL05UpdateDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5ef75b6f-0258-48b0-b804-4d3f65ad22d5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL05UpdateDWHDW"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* ModeloGrupo__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : ModeloGrupo (EtlVentasAutos) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas TypeLoad U con hash distinto. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @RowsUpdated int;&#xA;UPDATE tgt&#xA;SET    tgt.[CodigoArticulo] = src.[CodigoArticulo], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia], tgt.[Activo] = src.[Activo],&#xA;       tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloGrupo AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadModeloGrupo AS src ON src.[ModeloGrupoID] = tgt.[ModeloGrupoID]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @RowsUpdated = @@ROWCOUNT;&#xA;SELECT @RowsUpdated AS RowsUpdated;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL06RegisterFile"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{27DB6A28-4762-4DBD-926B-0D23B3887058}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL06RegisterFile"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* ModeloGrupo__ETL06RegisterFile_v1.0.sql&#xA;   Paquete : ModeloGrupo (EtlVentasAutos) · Tarea: ETL06RegisterFile&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Registra el archivo en V4WBaseArchivoCargado. Estado = 'Cargado' (camino de carga) o 'SinCambios' (camino sin cambios). En 'SinCambios' las filas van en 0 y RowsFailed = 0.&#xA;   Parámetros (OLE DB, en orden): 1) $Package::CtlProcessID · 2) $Package::EtlFilePath · 3) User::EtlFileModifiedDate · 4) User::EtlTamanoBytes · 5) User::EtlHashArchivo · 6) User::CtlExecutionID · 7) User::EtlEstadoArchivo · 8) User::CtlRowsInserted · 9) User::CtlRowsUpdated · 10) User::CtlRowsFailed · 11) User::EtlFilasFormatoInvalido&#xA;*/&#xA;DECLARE @ProcessID int = ?, @Ruta nvarchar(400) = ?, @FechaMod datetime2(0) = ?, @Tamano bigint = ?,&#xA;        @HashHex varchar(64) = ?, @ExecutionID bigint = ?, @Estado nvarchar(20) = ?,&#xA;        @Ins int = ?, @Upd int = ?, @Qc int = ?, @Invalidas int = ?;&#xA;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseArchivoCargado&#xA;       (ProcessID, Archivo, Ruta, FechaCorte, FechaModificacion, TamanoBytes, HashArchivo,&#xA;        ExecutionID, Estado, FilasCargadas, FilasQc, Aviso)&#xA;VALUES (@ProcessID,&#xA;        RIGHT(@Ruta, CHARINDEX(N'\', REVERSE(@Ruta)) - 1),&#xA;        @Ruta, NULL, @FechaMod, @Tamano, CONVERT(binary(32), @HashHex, 2),&#xA;        @ExecutionID, @Estado,&#xA;        CASE WHEN @Estado = N'Cargado' THEN @Ins + @Upd ELSE 0 END,&#xA;        CASE WHEN @Estado = N'Cargado' THEN @Qc ELSE 0 END,&#xA;        CASE WHEN @Invalidas &gt; 0 THEN CONVERT(nvarchar(20), @Invalidas) + N' filas con formato inválido (ver correo L3 de ETL00ValidateFile)' END);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::EtlFilePath"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
