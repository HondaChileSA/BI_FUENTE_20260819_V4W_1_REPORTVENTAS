    <DTS:Executable
      DTS:refId="Package\ETL04LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{08DADAEE-86C9-435D-A75A-611BF1D6DC53}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL04LoadDWHDW"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* ModeloGrupo__ETL04LoadDWHDW_v1.0.sql&#xA;   Paquete : ModeloGrupo (EtlVentasAutos) · Tarea: ETL04LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma V4WLoad con TypeLoad I/U por hash (SHA-256 → bigint, en SQL). Reemplaza el data flow de DIC (desviación documentada en la pauta). Solo filas nuevas o con hash distinto. Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID  (el BatchId se toma de CTLAuditBatch, abierto por CTL04OpenBatchId)&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadModeloGrupo&#xA;       ([ModeloGrupoID], [CodigoArticulo], [Modelo], [Familia], [Activo], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[ModeloGrupoID], s.[CodigoArticulo], s.[Modelo], s.[Familia], s.[Activo], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.[ModeloGrupoID] IS NULL THEN NULL ELSE SYSDATETIME() END,&#xA;       CASE WHEN b.[ModeloGrupoID] IS NULL THEN N'I' ELSE N'U' END&#xA;FROM   HMDCBISA.dbo.V4WStgModeloGrupo AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), s.[ModeloGrupoID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[CodigoArticulo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Familia]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), s.[Activo]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseModeloGrupo AS b ON b.[ModeloGrupoID] = s.[ModeloGrupoID]&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  (b.[ModeloGrupoID] IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgModeloGrupo WHERE ExecutionID = @ExecutionID) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL05InsertDWHDW"
