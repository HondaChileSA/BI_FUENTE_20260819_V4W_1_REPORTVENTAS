          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL00aCheckFile — V4W · paquetes de archivo (ModeloGrupo 38, ModeloAlias 39; luego 36 y 37)
 *
 * Corre todos los días (D-31, SOL-008 O-5). Decide si el archivo del file server cambió:
 *   1. Verifica que el archivo exista en $Package::EtlFilePath (ruta \\10.144.5.248\…, D-ARQ-41).
 *   2. Calcula el SHA-256 del archivo (lo abre con FileShare.ReadWrite: el área puede tenerlo abierto).
 *   3. Lo compara con el último registro en HMDCBIDW.dbo.V4WBaseArchivoCargado del mismo
 *      ProcessID y archivo, ignorando los registros 'SinCambios'.
 *   4. Escribe:
 *        User::EtlArchivoCambiado  (Boolean) → true = cargar; false = solo re-evaluar Qc y cerrar OK
 *        User::EtlHashArchivo      (String)  → SHA-256 en hexadecimal (64 caracteres)
 *        User::EtlTamanoBytes      (Int64)
 *        User::EtlFileModifiedDate (DateTime) → fecha de modificación del archivo
 *        User::EtlOperatorUser     (String)  → cuenta que ejecuta (no hay operador manual)
 *        User::EtlEstadoArchivo    (String)  → "Cargado" o "SinCambios" (lo usa ETL06RegisterFile)
 *
 * ReadOnlyVariables : $Package::EtlFilePath, $Package::CtlProcessID, $Project::vSQLConnDw
 * ReadWriteVariables: User::EtlArchivoCambiado, User::EtlHashArchivo, User::EtlTamanoBytes,
 *                     User::EtlFileModifiedDate, User::EtlOperatorUser, User::EtlEstadoArchivo
 *
 * Restricciones de plataforma: C# 7.3 / .NET Framework (SSIS 2019). Sin credenciales: vSQLConnDw es WT.
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Data;
using System.Data.SqlClient;
using System.IO;
using System.Security.Cryptography;
using System.Text;
#endregion

namespace ST_1eea5bfed806408f9ed3b445df6d54b9
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
        private static class Config
        {
            public const string ComponentName = "ETL00aCheckFile";
            public const string VarFilePath = "$Package::EtlFilePath";
            public const string VarProcessId = "$Package::CtlProcessID";
            public const string VarSqlConnDw = "$Project::vSQLConnDw";
            public const string VarCambiado = "User::EtlArchivoCambiado";
            public const string VarHash = "User::EtlHashArchivo";
            public const string VarTamano = "User::EtlTamanoBytes";
            public const string VarFileModified = "User::EtlFileModifiedDate";
            public const string VarOperator = "User::EtlOperatorUser";
            public const string VarEstado = "User::EtlEstadoArchivo";
            public const string TablaArchivo = "dbo.V4WBaseArchivoCargado";
        }

        public void Main()
        {
            bool fireAgain = false;
            try
            {
                string filePath = Convert.ToString(Dts.Variables[Config.VarFilePath].Value);
                int processId = Convert.ToInt32(Dts.Variables[Config.VarProcessId].Value);
                string connDw = Convert.ToString(Dts.Variables[Config.VarSqlConnDw].Value);

                if (string.IsNullOrWhiteSpace(filePath) || !File.Exists(filePath))
                    throw new FileNotFoundException("No existe el archivo en el file server: " + filePath);

                var info = new FileInfo(filePath);
                string hashHex = ComputeSha256(filePath);
                string archivo = info.Name;

                string ultimoHash = ReadLastHash(connDw, processId, archivo);
                bool cambiado = !string.Equals(ultimoHash, hashHex, StringComparison.OrdinalIgnoreCase);

                Dts.Variables[Config.VarCambiado].Value = cambiado;
                Dts.Variables[Config.VarHash].Value = hashHex;
                Dts.Variables[Config.VarTamano].Value = info.Length;
                Dts.Variables[Config.VarFileModified].Value = info.LastWriteTime;
                Dts.Variables[Config.VarOperator].Value = Environment.UserDomainName + "\\" + Environment.UserName;
                Dts.Variables[Config.VarEstado].Value = cambiado ? "Cargado" : "SinCambios";

                Dts.Events.FireInformation(0, Config.ComponentName,
                    string.Format("Archivo {0} · {1} bytes · modificado {2:yyyy-MM-dd HH:mm} · {3}",
                        archivo, info.Length, info.LastWriteTime,
                        cambiado ? "NUEVO O MODIFICADO: se carga" : "SIN CAMBIOS: solo re-evaluación de Qc"),
                    "", 0, ref fireAgain);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ComponentName, ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        private static string ComputeSha256(string path)
        {
            using (var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.ReadWrite))
            using (var sha = SHA256.Create())
            {
                byte[] h = sha.ComputeHash(fs);
                var sb = new StringBuilder(64);
                foreach (byte b in h) sb.Append(b.ToString("X2"));
                return sb.ToString();
            }
        }

        private static string ReadLastHash(string connStr, int processId, string archivo)
        {
            const string sql = @"
SELECT TOP (1) CONVERT(varchar(64), HashArchivo, 2)
FROM " + Config.TablaArchivo + @"
WHERE ProcessID = @ProcessID AND Archivo = @Archivo AND Estado <> N'SinCambios'
ORDER BY ArchivoCargadoID DESC;";
            using (var conn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, conn))
            {
                cmd.Parameters.Add("@ProcessID", SqlDbType.Int).Value = processId;
                cmd.Parameters.Add("@Archivo", SqlDbType.NVarChar, 260).Value = archivo;
                conn.Open();
                object r = cmd.ExecuteScalar();
                return (r == null || r == DBNull.Value) ? "" : r.ToString();
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
