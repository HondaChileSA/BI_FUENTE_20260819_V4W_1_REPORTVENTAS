          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
// Ver: Observaciones Importantes #001 — TextFieldParser de Microsoft.VisualBasic
//      Microsoft.VisualBasic.dll viene en el GAC con cualquier .NET Framework 4.x.
//      No requiere instalación adicional en el servidor SSIS.
using Microsoft.VisualBasic.FileIO;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;              // WebClient + HttpWebRequest
using System.Net.Mail;
using System.Net.Mime;
using System.Text;
#endregion


namespace ST_ba366888471244399bd5102ff4e29239
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        // ╔══════════════════════════════════════════════════════════════════════╗
        // ║  CONFIG — Único punto de modificación entre procesos                 ║
        // ║                                                                      ║
        // ║  Para clonar este package a otro input (HIJA / HOMOLOGACION / etc.)  ║
        // ║  sólo se edita ESTE bloque. El resto del script no se toca.          ║
        // ║                                                                      ║
        // ║  Aquí se controlan:                                                  ║
        // ║    · Identidad del proceso                                           ║
        // ║    · Variables SSIS de proyecto / paquete                            ║
        // ║    · Columnas esperadas (COLUMN_DEFS)                                ║
        // ║    · Filas del Execution Summary del correo (SUMMARY_ROWS)           ║
        // ║    · Secciones de validación que aparecen en el correo (SECCIONES)   ║
        // ║    · Branding (colores, asunto, callouts, banda, logos)              ║
        // ╚══════════════════════════════════════════════════════════════════════╝
        private static class Config
        {
            // ── Identidad del proceso ──────────────────────────────────────────
            public const string ProcessName = "ModeloGrupo";
            public const string ProcessLabel = "Ventas Autos · Agrupación de modelos";

            // ── Variables SSIS — SMTP / correo ─────────────────────────────────
            public const string VarSmtpHost = "$Project::vSMTPHost";
            public const string VarMailFrom = "$Package::vMailFrom";
            public const string VarMailTo = "$Package::vMailTO";

            // ── Variables SSIS — archivo y contexto ────────────────────────────
            public const string VarFilePath = "$Package::EtlFilePath";
            public const string VarFileSheet = "$Package::EtlFileSheet";
            public const string VarFileModifiedDate = "User::EtlFileModifiedDate";
            public const string VarOperatorUser = "User::EtlOperatorUser";
            public const string VarExecutionId = "User::CtlExecutionID";
            public const string VarPackageName = "User::CtlPackageName";

            // ── Recursos visuales (rutas UNC) ──────────────────────────────────
            public const string LogoMainPath = "$Project::vLogoMain";
            public const string LogoWhitePath = "$Project::vLogoWhite";

            // ── Banda de contexto bajo el header rojo ──────────────────────────
            public const string BandaTexto =
                "ETL Validation &nbsp;&#183;&nbsp; Honda Motor de Chile S.A. &nbsp;&#183;&nbsp; Customer Experience";

            // ── Branding — colores ─────────────────────────────────────────────
            public const string ColorPrimary = "#CC0000";   // rojo Honda
            public const string ColorPrimaryDark = "#A30000";   // borde lateral header
            public const string ColorCritical = "#CC0000";
            public const string ColorCriticalBg = "#FFEBEE";
            public const string ColorCriticalEdge = "#FFCDD2";
            public const string ColorWarning = "#F9A825";
            public const string ColorWarningBg = "#FFF8E1";
            public const string ColorWarningEdge = "#FFE082";
            public const string ColorOk = "#2E7D32";

            // ── Asunto y header — plantillas con {Process} ─────────────────────
            public const string SubjectCritical = "[ETL VALIDACIÓN] {Process} — Carga cancelada";
            public const string SubjectWarning = "[ETL VALIDACIÓN] {Process} — Advertencias";

            public const string HeaderCritical = "Validación fallida — Carga cancelada";
            public const string HeaderWarning = "Validación con advertencias — Carga continúa";

            // ── Callouts de acción ─────────────────────────────────────────────
            public const string ActionTextCritical =
                "La carga <b>NO fue ejecutada</b>. Corrija el origen y vuelva a ejecutar el paquete.";
            public const string ActionTextWarning =
                "La carga <b>continuará</b>. Revise las advertencias para mejorar la calidad del archivo.";

            // ── Columnas esperadas ─────────────────────────────────────────────
            // Tipos válidos : "string" | "number" | "date" | "boolean"
            // MaxLen        : sólo aplica para "string" (0 = sin límite)
            // Aliases       : nombres alternativos aceptados (se aplica Normalize)
            public static readonly ColumnDef[] COLUMN_DEFS = new ColumnDef[]
            {
                new ColumnDef("ModeloGrupoID",  "number",  0,
                    new[] { "ID", "IDMODELOGRUPO", "MODELO GRUPO ID" }),
                new ColumnDef("CodigoArticulo", "string",  25,
                    new[] { "CODIGO", "CODIGO ARTICULO", "ARTICULO" }),
                new ColumnDef("Modelo",         "string",  50,
                    new[] { "MODELO" }),
                new ColumnDef("Familia",        "string",  50,
                    new[] { "FAMILIA" }),
                new ColumnDef("Activo",         "boolean", 0,
                    new[] { "ACTIVE", "VIGENTE" }),
            };

            // ── Filas del "Execution Summary" del correo (declarativas) ────────
            //   Var → variable SSIS  ·  Ctx → clave del contexto  ·  Lit → literal
            public static readonly SummaryRowDef[] SUMMARY_ROWS = new SummaryRowDef[]
            {
                SummaryRowDef.Var("Paquete",             "User::CtlPackageName"),
                SummaryRowDef.Var("Usuario",             "User::EtlOperatorUser"),
                SummaryRowDef.Ctx("Última Modificación", "FileModifiedDate"),
                SummaryRowDef.Ctx("Hoja",                "FileSheet"),
                SummaryRowDef.Ctx("Filas leídas",        "TotalRowsFmt"),
                SummaryRowDef.Ctx("Ruta",                "FilePath"),
                SummaryRowDef.Ctx("ExecutionID",         "ExecutionId"),
            };

            // ── Secciones de validación en el correo ───────────────────────────
            //   Editá / reordená / quitá niveles modificando este array.
            public static readonly SeccionDef[] SECCIONES = new SeccionDef[]
            {
                new SeccionDef("Nivel 1 — Cantidad de columnas", SeccionTipo.L1_CantidadColumnas),
                new SeccionDef("Nivel 2 — Nombres de columnas",  SeccionTipo.L2_NombresColumnas),
                new SeccionDef("Nivel 3 — Formato de datos",     SeccionTipo.L3_FormatoDatos),
            };

            // ── Límites operativos ─────────────────────────────────────────────
            public const int MAX_ERRORS_PER_LEVEL = 10;
        }


        // ═════════════════════════════════════════════════════════════════════════
        // MAIN
        // ═════════════════════════════════════════════════════════════════════════
        public void Main()
        {
            bool fireAgain = false;
            var sw = Stopwatch.StartNew();

            // Forzar TLS 1.2/1.3 (algunos endpoints rechazan SSL3/TLS1.0 default).
            ServicePointManager.SecurityProtocol =
                  (SecurityProtocolType)3072     // Tls12
                | (SecurityProtocolType)12288;   // Tls13

            try
            {
                // ── Variables de contexto ─────────────────────────────────────
                string filePath = GetVar(Config.VarFilePath);
                string fileSheet = GetVar(Config.VarFileSheet);
                long execId = Convert.ToInt64(Dts.Variables[Config.VarExecutionId].Value);
                string packageName = GetVar(Config.VarPackageName);
                string operatorUser = GetVar(Config.VarOperatorUser);
                DateTime fileModified = (DateTime)Dts.Variables[Config.VarFileModifiedDate].Value;

                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Iniciando validación de archivo", "", 0, ref fireAgain);

                // ── Cargar archivo Excel ──────────────────────────────────────
                DataTable dt = LoadExcelFromOleDb(filePath, fileSheet);
                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Carga Excel ms=" + sw.ElapsedMilliseconds +
                    " | filas=" + dt.Rows.Count +
                    " | cols=" + dt.Columns.Count, "", 0, ref fireAgain);
                sw.Restart();

                // ── Clonar definiciones (evita estado sucio entre corridas) ──
                ColumnDef[] colDefs = CloneColumnDefs(Config.COLUMN_DEFS);

                // ── Ejecutar niveles ──────────────────────────────────────────
                LevelResult l1 = ValidateL1(dt);
                L2Result l2 = ValidateL2(dt, colDefs);
                LevelResult l3 = ValidateL3(dt, colDefs);
                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Validaciones ms=" + sw.ElapsedMilliseconds, "", 0, ref fireAgain);

                // ── Consolidar resultado ──────────────────────────────────────
                //   L1 críticos (faltan columnas) y L2 críticos detienen el flujo.
                //   L1 warnings (sobran columnas) y L3 sólo se reportan por correo;
                //   la carga continúa, columnas extras se ignoran y filas malas
                //   quedan fuera.
                bool l1Critical = l1.HasCritical;
                bool l1HasWarning = l1.Warnings.Count > 0;
                bool l2Critical = l2.HasCritical;
                bool l3HasErrors = l3.HasCritical;

                bool stopFlow = l1Critical || l2Critical;
                bool sendEmail = stopFlow || l3HasErrors || l1HasWarning;

                if (sendEmail)
                {
                    try
                    {
                        var ctx = new ValidationEmailContext
                        {
                            PackageName = packageName,
                            FileModifiedDate = fileModified.ToString("dd/MM/yyyy HH:mm"),
                            OperatorUser = operatorUser,
                            FilePath = filePath,
                            FileSheet = fileSheet,
                            TotalRows = dt.Rows.Count,
                            ExecutionId = execId,
                            Period = BuildPeriodString(),
                            Timestamp = DateTime.Now.ToString("dd/MM/yyyy HH:mm"),
                            HasCritical = stopFlow,                                  // L1 (faltan) o L2 → badge CRITICAL
                            HasWarning = !stopFlow && (l1HasWarning || l3HasErrors) // L1 (sobran) o L3 → badge WARNING
                        };
                        SendValidationEmail(l1, l2, l3, ctx);
                    }
                    catch (Exception exMail)
                    {
                        Dts.Events.FireInformation(0, Config.ProcessName,
                            "Aviso: correo no enviado — " + exMail.Message,
                            "", 0, ref fireAgain);
                    }
                }

                // ── Resultado final del Script Task ───────────────────────────
                if (stopFlow)
                {
                    var parts = new List<string>();
                    if (l1Critical) parts.Add(string.Format(
                        "L1 (faltan columnas: encontradas {0} vs esperadas {1})",
                        dt.Columns.Count, Config.COLUMN_DEFS.Length));
                    if (l2Critical) parts.Add(string.Format(
                        "L2 ({0} columna(s) no encontrada(s))",
                        l2.Criticals.Count));

                    Dts.Events.FireError(0, Config.ProcessName,
                        "Validación fallida — " + string.Join(" · ", parts) + ". Carga cancelada.",
                        "", 0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                }
                else
                {
                    // L1 sobran columnas: warning visible en SSIS pero no detiene
                    if (l1HasWarning)
                    {
                        Dts.Events.FireWarning(0, Config.ProcessName, string.Format(
                            "L1: el archivo trae {0} columna(s) más que las esperadas. La carga continúa — las extras se ignoran.",
                            dt.Columns.Count - Config.COLUMN_DEFS.Length), "", 0);
                    }
                    // L3 con errores: warning visible en SSIS pero no detiene
                    if (l3HasErrors)
                    {
                        int listed = l3.Criticals.Count(e => e.RowNumber > 0);
                        Dts.Events.FireWarning(0, Config.ProcessName, string.Format(
                            "L3 reportó {0} error(es) de formato. La carga continúa — esas filas quedan fuera.",
                            listed), "", 0);
                    }

                    string finalMsg;
                    if (l3HasErrors) finalMsg = "Validación con errores de formato (L3) — la carga continúa, las filas malas quedan fuera.";
                    else if (l1HasWarning) finalMsg = "Validación con advertencias en cantidad de columnas (L1) — la carga continúa, columnas extras se ignoran.";
                    else finalMsg = "Validación OK — archivo apto para carga.";

                    Dts.Events.FireInformation(0, Config.ProcessName, finalMsg, "", 0, ref fireAgain);
                    Dts.TaskResult = (int)ScriptResults.Success;
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ProcessName,
                    "Error inesperado en validación: " + ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // VALIDATION — L1, L2, L3
        // ═════════════════════════════════════════════════════════════════════════

        // ── L1 · Cantidad de columnas ────────────────────────────────────────────
        //    Menos columnas que las esperadas → CRÍTICO (faltan datos obligatorios,
        //    no podemos garantizar el mapeo completo, detiene el flujo).
        //    Más columnas que las esperadas   → WARNING (las extra se ignoran al
        //    mapear, la carga continúa con las columnas declaradas).
        //    Coincide exacto                  → OK.
        private LevelResult ValidateL1(DataTable dt)
        {
            var r = new LevelResult();
            int found = dt.Columns.Count;
            int expected = Config.COLUMN_DEFS.Length;

            if (found < expected)
            {
                r.Criticals.Add(new ValidationError(0, string.Format(
                    "Columnas encontradas: {0} | Columnas esperadas: {1} (faltan {2})",
                    found, expected, expected - found)));
            }
            else if (found > expected)
            {
                r.Warnings.Add(string.Format(
                    "Columnas encontradas: {0} | Columnas esperadas: {1} (sobran {2} — se ignorarán)",
                    found, expected, found - expected));
            }
            // found == expected → r vacío, todo OK
            return r;
        }

        // ── L2 · Nombres de columnas ─────────────────────────────────────────────
        //    Matching: exacto → normalizado → alias exacto → alias normalizado
        private L2Result ValidateL2(DataTable dt, ColumnDef[] colDefs)
        {
            var r = new L2Result();
            foreach (var def in colDefs)
            {
                string foundName = null;
                string matchType = null; // EXACT | NORMALIZED | ALIAS | ALIAS_NORMALIZED

                foreach (DataColumn col in dt.Columns)
                {
                    string colName = col.ColumnName.Trim();
                    string colNorm = Normalize(colName);
                    string defNorm = Normalize(def.Name);

                    // 1. Exacto con nombre principal
                    if (colName == def.Name)
                    { foundName = colName; matchType = "EXACT"; break; }

                    // 2. Normalizado con nombre principal
                    if (matchType == null && colNorm == defNorm)
                    { foundName = colName; matchType = "NORMALIZED"; }

                    // 3. Alias exacto / normalizado
                    foreach (var alias in def.Aliases)
                    {
                        if (matchType == null && colName == alias)
                        { foundName = colName; matchType = "ALIAS"; break; }
                        if (matchType == null && colNorm == Normalize(alias))
                        { foundName = colName; matchType = "ALIAS_NORMALIZED"; }
                    }
                }

                var row = new L2Row { ExpectedName = def.Name };
                if (matchType != null)
                {
                    row.FoundName = foundName;
                    row.Status = matchType;
                    int idx = dt.Columns.IndexOf(foundName);
                    row.ResolvedIndex = idx;
                    def.ResolvedIndex = idx;
                }
                else
                {
                    row.FoundName = null;
                    row.Status = "NOT_FOUND";
                    def.ResolvedIndex = -1;
                    r.Criticals.Add(new ValidationError(0, string.Format(
                        "Columna '{0}' no encontrada (ni por nombre principal ni por aliases definidos)",
                        def.Name)));
                }
                r.Rows.Add(row);
            }
            return r;
        }

        // ── L3 · Formato / tipo de dato ──────────────────────────────────────────
        //    Solo aplica a columnas que pasaron L2 (ResolvedIndex >= 0)
        private LevelResult ValidateL3(DataTable dt, ColumnDef[] colDefs)
        {
            var r = new LevelResult();
            int errorCount = 0;

            for (int i = 0; i < dt.Rows.Count; i++)
            {
                if (errorCount >= Config.MAX_ERRORS_PER_LEVEL) break;
                DataRow row = dt.Rows[i];
                int rowNum = i + 2; // +2: fila 1 = cabecera, índice base 1

                // Saltar filas completamente vacías
                bool allEmpty = true;
                foreach (object v in row.ItemArray)
                    if (v != null && v != DBNull.Value && v.ToString().Trim() != "")
                    { allEmpty = false; break; }
                if (allEmpty) continue;

                foreach (var def in colDefs)
                {
                    if (errorCount >= Config.MAX_ERRORS_PER_LEVEL) break;
                    if (def.ResolvedIndex < 0) continue; // No pasó L2 — se salta

                    string rawVal = row.IsNull(def.ResolvedIndex)
                        ? "" : row[def.ResolvedIndex].ToString().Trim();
                    if (rawVal == "") continue; // Vacío — L4 futuro

                    string error = ValidateType(rawVal, def);
                    if (error != null)
                    {
                        r.Criticals.Add(new ValidationError(rowNum,
                            string.Format("Col '{0}': {1}", def.Name, error)));
                        errorCount++;
                    }
                }
            }

            if (errorCount >= Config.MAX_ERRORS_PER_LEVEL)
                r.Criticals.Add(new ValidationError(0, string.Format(
                    "Límite de {0} errores alcanzado. El archivo puede tener más anomalías.",
                    Config.MAX_ERRORS_PER_LEVEL)));

            return r;
        }

        // ── Validación de tipo por valor ─────────────────────────────────────────
        private string ValidateType(string value, ColumnDef def)
        {
            switch (def.DataType.ToLower())
            {
                case "number":
                    decimal d;
                    if (!decimal.TryParse(value,
                        NumberStyles.Any,
                        CultureInfo.InvariantCulture, out d))
                        return string.Format("'{0}' no es un número válido", value);
                    break;

                case "date":
                    DateTime dt;
                    if (!TryParseFlexibleDate(value, out dt))
                        return string.Format("'{0}' no es una fecha válida", value);
                    break;

                case "string":
                    if (def.MaxLen > 0 && value.Length > def.MaxLen)
                        return string.Format(
                            "{0} caracteres — máximo permitido: {1}", value.Length, def.MaxLen);
                    break;

                case "boolean":
                    var validBool = new[] { "true", "false", "1", "0", "si", "no", "yes" };
                    bool found = false;
                    foreach (var v in validBool)
                        if (value.ToLower() == v) { found = true; break; }
                    if (!found)
                        return string.Format(
                            "'{0}' no es booleano válido (true/false/1/0/si/no)", value);
                    break;
            }
            return null;
        }

        // ── Normalización (cache estático: 1 vez por proceso) ────────────────────
        private static readonly Dictionary<string, string> _normCache =
            new Dictionary<string, string>(StringComparer.Ordinal);

        private string Normalize(string s)
        {
            if (s == null) return "";
            string cached;
            if (_normCache.TryGetValue(s, out cached)) return cached;
            string n = s.ToLowerInvariant().Trim();
            n = n.Replace(" ", "").Replace("_", "").Replace("-", "");
            _normCache[s] = n;
            return n;
        }

        // ── Parser de fechas flexible (varios formatos comunes) ──────────────────
        private bool TryParseFlexibleDate(string input, out DateTime result)
        {
            result = DateTime.MinValue;
            if (string.IsNullOrWhiteSpace(input)) return false;

            string v = input.Trim().Replace("-", "/").Replace(".", "/");
            string[] formats = new[]
            {
                "d/M/yyyy",  "dd/MM/yyyy",
                "M/d/yyyy",  "MM/dd/yyyy",
                "yyyy/MM/dd","yyyy/M/d"
            };
            if (DateTime.TryParseExact(v, formats,
                CultureInfo.InvariantCulture,
                DateTimeStyles.None, out result))
                return true;

            return DateTime.TryParse(v, out result);
        }


        // ═════════════════════════════════════════════════════════════════════════
        // EMAIL — context, entry point, builder principal (config-driven)
        // ═════════════════════════════════════════════════════════════════════════

        // ── Contexto del correo (datos resueltos en Main) ────────────────────────
        private class ValidationEmailContext
        {
            public string PackageName { get; set; }
            public string FilePath { get; set; }
            public string FileSheet { get; set; }
            public int TotalRows { get; set; }
            public long ExecutionId { get; set; }
            public string OperatorUser { get; set; }
            public string FileModifiedDate { get; set; }
            public string Period { get; set; }
            public string Timestamp { get; set; }
            public bool HasCritical { get; set; }
            public bool HasWarning { get; set; }
        }

        // ── Entry point — único método público que se llama desde Main() ─────────
        private void SendValidationEmail(LevelResult l1, L2Result l2, LevelResult l3,
                                         ValidationEmailContext ctx)
        {
            string smtpHost = GetVar(Config.VarSmtpHost);
            string from = GetVar(Config.VarMailFrom);
            string to = GetVar(Config.VarMailTo);

            if (string.IsNullOrEmpty(from) || string.IsNullOrEmpty(to) || string.IsNullOrEmpty(smtpHost))
            {
                bool fa = false;
                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Email no enviado: variables SMTP no configuradas en el proyecto.",
                    "", 0, ref fa);
                return;
            }

            string html = BuildValidationHtml(l1, l2, l3, ctx);
            SendEmail(html, ctx, smtpHost, from, to);
        }

        // ── Builder principal del HTML (itera Config.SUMMARY_ROWS y SECCIONES) ──
        private string BuildValidationHtml(LevelResult l1, L2Result l2, LevelResult l3,
                                           ValidationEmailContext ctx)
        {
            // Resolución de colores y textos según severidad
            string badgeColor = ctx.HasCritical ? Config.ColorCritical : Config.ColorWarning;
            string badgeText = ctx.HasCritical ? "CRITICAL" : "WARNING";
            string headerTitle = ctx.HasCritical ? Config.HeaderCritical : Config.HeaderWarning;
            string actionBg = ctx.HasCritical ? Config.ColorCriticalBg : Config.ColorWarningBg;
            string actionBorder = ctx.HasCritical ? Config.ColorCriticalEdge : Config.ColorWarningEdge;
            string actionAccent = ctx.HasCritical ? Config.ColorCritical : Config.ColorWarning;
            string actionText = ctx.HasCritical ? Config.ActionTextCritical : Config.ActionTextWarning;

            // Diccionario para resolver SUMMARY_ROWS de tipo Ctx
            var ctxValues = BuildCtxDictionary(ctx);

            var sb = new StringBuilder();

            // ── Documento + container externo ────────────────────────────────
            sb.Append("<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'></head>");
            sb.Append("<body style='margin:0;padding:0;background-color:#DADADA;font-family:\"Segoe UI\",Arial,sans-serif;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#DADADA;padding:28px 10px;'>");
            sb.Append("<tr><td align='center'>");

            // ── Caja blanca centrada (660px) ─────────────────────────────────
            sb.Append("<table width='660' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='width:660px;max-width:660px;background-color:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #C8C8C8;'>");

            // ── HEADER ROJO con corner redondeado ────────────────────────────
            sb.Append("<tr><td style='background-color:").Append(Config.ColorPrimary).Append(";padding:0;border-radius:14px 14px 0 0;overflow:hidden;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td width='8' style='background-color:").Append(Config.ColorPrimaryDark).Append(";width:8px;'>&nbsp;</td>");
            sb.Append("<td style='padding:20px 26px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td valign='middle' width='230'>");
            sb.Append("<img src='cid:logohonda_white' width='210' alt='Honda Motor de Chile' style='display:block;border:0;'/>");
            sb.Append("</td>");
            sb.Append("<td align='right' valign='middle'>");
            sb.Append("<div style='color:#fff;font-size:20px;font-weight:bold;font-family:\"Segoe UI\",Arial;text-align:right;'>")
              .Append(He(headerTitle)).Append("</div>");
            sb.Append("<div style='color:#ffdddd;font-size:14px;text-align:right;margin-top:6px;font-family:\"Segoe UI\",Arial;'>")
              .Append("Per&#237;odo: ").Append(He(ctx.Period ?? "")).Append("</div>");
            sb.Append("<div style='color:#ffaaaa;font-size:12px;text-align:right;margin-top:3px;font-family:\"Segoe UI\",Arial;'>")
              .Append(He(ctx.Timestamp ?? "")).Append("</div>");
            sb.Append("</td></tr></table></td></tr></table></td></tr>");

            // ── BANDA NEGRA de contexto ──────────────────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:8px 30px;'>");
            sb.Append("<span style='color:#AAA;font-size:10px;font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1.5px;'>");
            sb.Append(Config.BandaTexto);
            sb.Append("</span></td></tr>");

            // ── CUERPO ───────────────────────────────────────────────────────
            sb.Append("<tr><td style='padding:22px 26px 18px 26px;background-color:#F2F2F2;'>");

            // Badge CRITICAL / WARNING
            sb.Append("<table cellpadding='0' cellspacing='0' border='0' style='margin-bottom:14px;'><tr>");
            sb.Append("<td style='background-color:").Append(badgeColor).Append(";color:#fff;");
            sb.Append("padding:5px 14px;border-radius:14px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;letter-spacing:1px;'>");
            sb.Append(badgeText);
            sb.Append("</td></tr></table>");

            // Execution Summary — iterando Config.SUMMARY_ROWS
            sb.Append(SectionTitle("Execution Summary"));
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");
            foreach (var rowDef in Config.SUMMARY_ROWS)
                sb.Append(SummaryRowHtml(rowDef.Label, ResolveSummary(rowDef, ctxValues)));
            sb.Append("</table>");

            // Secciones de validación — iterando Config.SECCIONES
            foreach (var secDef in Config.SECCIONES)
            {
                sb.Append(SectionTitle(secDef.Titulo));
                switch (secDef.Tipo)
                {
                    case SeccionTipo.L1_CantidadColumnas: sb.Append(BuildL1Section(l1)); break;
                    case SeccionTipo.L2_NombresColumnas: sb.Append(BuildL2Section(l2)); break;
                    case SeccionTipo.L3_FormatoDatos: sb.Append(BuildL3Section(l3)); break;
                }
            }

            // Callout de acción
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'><tr>");
            sb.Append("<td style='background-color:").Append(actionBg).Append(";");
            sb.Append("border:1px solid ").Append(actionBorder).Append(";");
            sb.Append("border-left:4px solid ").Append(actionAccent).Append(";");
            sb.Append("border-radius:6px;padding:11px 15px;font-size:11px;color:#333;");
            sb.Append("font-family:\"Segoe UI\",Arial;line-height:1.5;'>");
            sb.Append(actionText);
            sb.Append("</td></tr></table>");

            sb.Append("</td></tr>");  // fin cuerpo

            // ── FIRMA con banner Honda ───────────────────────────────────────
            sb.Append("<tr><td style='background-color:#fff;padding:22px 26px 14px 26px;border-top:1px solid #E0E0E0;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td align='center'>");
            sb.Append("<img src='cid:logohonda' width='420' alt='Honda Motor de Chile' style='display:block;margin:0 auto;border:0;'/>");
            sb.Append("</td></tr></table></td></tr>");

            // ── FOOTER negro con timestamp + autor ───────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:9px 26px;border-radius:0 0 14px 14px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td style='font-size:9px;color:#666;font-family:\"Segoe UI\",Arial;'>")
              .Append("Generado autom&#225;ticamente &nbsp;&#183;&nbsp; ")
              .Append(He(ctx.Timestamp ?? ""))
              .Append(" &nbsp;&#183;&nbsp; Customer Experience</td>");
            sb.Append("<td align='right' style='font-size:9px;color:").Append(Config.ColorPrimary).Append(";font-family:\"Segoe UI\",Arial;'>")
              .Append("ETL &amp; DWH &#183; Franco V&#233;liz</td>");
            sb.Append("</tr></table></td></tr>");

            // ── Barra roja final de 5px ──────────────────────────────────────
            sb.Append("<tr><td height='5' style='background-color:").Append(Config.ColorPrimary).Append(";height:5px;font-size:0;line-height:0;'>&nbsp;</td></tr>");

            sb.Append("</table>");                  // fin caja blanca
            sb.Append("</td></tr></table>");        // fin container
            sb.Append("</body></html>");
            return sb.ToString();
        }

        // ── Diccionario que mapea claves "Ctx:xxx" a valores del contexto ───────
        private Dictionary<string, string> BuildCtxDictionary(ValidationEmailContext ctx)
        {
            var es = new CultureInfo("es-CL");
            return new Dictionary<string, string>(StringComparer.Ordinal)
            {
                { "PackageName",      ctx.PackageName      ?? "" },
                { "OperatorUser",     ctx.OperatorUser     ?? "" },
                { "FileModifiedDate", ctx.FileModifiedDate ?? "" },
                { "FileSheet",        ctx.FileSheet        ?? "" },
                { "TotalRows",        ctx.TotalRows.ToString() },
                { "TotalRowsFmt",     ctx.TotalRows.ToString("N0", es) },
                { "FilePath",         ctx.FilePath         ?? "" },
                { "ExecutionId",      ctx.ExecutionId.ToString() },
                { "Period",           ctx.Period           ?? "" },
                { "Timestamp",        ctx.Timestamp        ?? "" },
            };
        }

        // ── Resolver el valor de una fila del Execution Summary ─────────────────
        private string ResolveSummary(SummaryRowDef row, Dictionary<string, string> ctx)
        {
            switch (row.Origen)
            {
                case SummaryRowOrigen.Variable:
                    return GetVar(row.Fuente);
                case SummaryRowOrigen.Ctx:
                    string v;
                    return ctx.TryGetValue(row.Fuente, out v) ? v : "";
                case SummaryRowOrigen.Literal:
                    return row.Fuente;
            }
            return "";
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HTML BUILDERS — Secciones L1 / L2 / L3
        // ═════════════════════════════════════════════════════════════════════════

        // ── L1 · Cantidad de columnas ────────────────────────────────────────────
        //    3 estados: critical (faltan) · warning (sobran) · ok (exacto).
        private string BuildL1Section(LevelResult l1)
        {
            bool hasCritical = l1.HasCritical;
            bool hasWarning = l1.Warnings.Count > 0;

            string statusBg;
            string statusText;
            if (hasCritical)
            {
                statusBg = Config.ColorCritical;
                statusText = "&#10007; " + l1.Criticals.Count + " error(es) de cantidad de columnas";
            }
            else if (hasWarning)
            {
                statusBg = Config.ColorWarning;
                statusText = "&#9888; " + l1.Warnings.Count + " advertencia(s) de cantidad de columnas";
            }
            else
            {
                statusBg = Config.ColorOk;
                statusText = "&#10003; Sin anomal&#237;as";
            }

            var sb = new StringBuilder();
            sb.Append(OpenSectionTable());

            // Cabecera de estado
            sb.Append("<tr><td style='background-color:").Append(statusBg).Append(";color:#fff;");
            sb.Append("padding:6px 12px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1px;'>");
            sb.Append(statusText).Append("</td></tr>");

            // Contenido
            if (hasCritical)
            {
                foreach (var c in l1.Criticals)
                {
                    sb.Append("<tr><td style='padding:8px 12px;font-size:11px;color:")
                      .Append(Config.ColorCritical).Append(";font-family:\"Segoe UI\",Arial;'>");
                    sb.Append(He(c.Detail));
                    sb.Append("</td></tr>");
                }
            }
            if (hasWarning)
            {
                foreach (var w in l1.Warnings)
                {
                    sb.Append("<tr><td style='padding:8px 12px;font-size:11px;color:#333;font-family:\"Segoe UI\",Arial;'>");
                    sb.Append(He(w));
                    sb.Append("</td></tr>");
                }
            }
            if (!hasCritical && !hasWarning)
            {
                sb.Append("<tr><td style='padding:8px 12px;font-size:11px;color:#666;font-family:\"Segoe UI\",Arial;'>");
                sb.Append("Cantidad de columnas correcta (")
                  .Append(Config.COLUMN_DEFS.Length).Append("/").Append(Config.COLUMN_DEFS.Length).Append(").");
                sb.Append("</td></tr>");
            }

            sb.Append("</table>");
            return sb.ToString();
        }

        // ── L2 · Nombres de columnas ─────────────────────────────────────────────
        private string BuildL2Section(L2Result l2)
        {
            string statusBg = l2.HasCritical ? Config.ColorCritical : Config.ColorOk;
            string statusText = l2.HasCritical
                ? "&#10007; " + l2.Criticals.Count + " columna(s) no encontrada(s)"
                : "&#10003; Sin anomal&#237;as";

            var sb = new StringBuilder();
            sb.Append(OpenSectionTable());

            // Cabecera de estado
            sb.Append("<tr><td colspan='3' style='background-color:").Append(statusBg).Append(";color:#fff;");
            sb.Append("padding:6px 12px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1px;'>");
            sb.Append(statusText).Append("</td></tr>");

            // Encabezados
            sb.Append("<tr style='background-color:#F2F2F2;'>");
            sb.Append(ColHeader("Esperada", "width:33%;"));
            sb.Append(ColHeader("Encontrada", "width:33%;"));
            sb.Append(ColHeader("Estado", ""));
            sb.Append("</tr>");

            // Filas
            foreach (var row in l2.Rows)
            {
                string statusHtml;
                switch (row.Status)
                {
                    case "EXACT":
                        statusHtml = "<span style='color:" + Config.ColorOk + ";font-weight:bold;'>&#10003; OK</span>";
                        break;
                    case "NORMALIZED":
                        statusHtml = "<span style='color:" + Config.ColorWarning + ";font-weight:bold;'>&#10003; OK <i style='font-weight:normal;'>(normalizado)</i></span>";
                        break;
                    case "ALIAS":
                        statusHtml = "<span style='color:" + Config.ColorWarning + ";font-weight:bold;'>&#10003; OK <i style='font-weight:normal;'>(alias exacto)</i></span>";
                        break;
                    case "ALIAS_NORMALIZED":
                        statusHtml = "<span style='color:" + Config.ColorWarning + ";font-weight:bold;'>&#10003; OK <i style='font-weight:normal;'>(alias normalizado)</i></span>";
                        break;
                    default:
                        statusHtml = "<span style='color:" + Config.ColorCritical + ";font-weight:bold;'>&#10007; No encontrada</span>";
                        break;
                }

                sb.Append("<tr>");
                sb.Append(ColCell(He(row.ExpectedName)));
                sb.Append(ColCell(string.IsNullOrEmpty(row.FoundName) ? "&mdash;" : He(row.FoundName)));
                sb.Append(ColCell(statusHtml));
                sb.Append("</tr>");
            }

            sb.Append("</table>");
            return sb.ToString();
        }

        // ── L3 · Formato de datos ────────────────────────────────────────────────
        private string BuildL3Section(LevelResult l3)
        {
            string statusBg = l3.HasCritical ? Config.ColorCritical : Config.ColorOk;
            int listedErrors = l3.Criticals.Count(e => e.RowNumber > 0);
            string statusText = l3.HasCritical
                ? "&#10007; " + listedErrors + " error(es) de formato"
                : "&#10003; Sin anomal&#237;as";

            var sb = new StringBuilder();
            sb.Append(OpenSectionTable());

            // Cabecera de estado
            sb.Append("<tr><td colspan='3' style='background-color:").Append(statusBg).Append(";color:#fff;");
            sb.Append("padding:6px 12px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1px;'>");
            sb.Append(statusText).Append("</td></tr>");

            if (l3.HasCritical)
            {
                // Encabezados
                sb.Append("<tr style='background-color:#F2F2F2;'>");
                sb.Append(ColHeader("#Fila", "width:60px;"));
                sb.Append(ColHeader("Columna", "width:140px;"));
                sb.Append(ColHeader("Detalle", ""));
                sb.Append("</tr>");

                // Filas
                foreach (var c in l3.Criticals
                    .OrderByDescending(x => x.RowNumber > 0 ? x.RowNumber : int.MinValue))
                {
                    string[] parts = (c.Detail ?? "").Split(new char[] { ':' }, 2);
                    string colPart = parts.Length > 0
                        ? parts[0].Replace("Col", "").Replace("'", "").Trim()
                        : "—";
                    string detPart = parts.Length > 1 ? parts[1].Trim() : (c.Detail ?? "");

                    sb.Append("<tr>");
                    sb.Append(ColCell(c.RowNumber > 0 ? c.RowNumber.ToString() : "&mdash;"));
                    sb.Append("<td style='padding:6px 10px;font-size:11px;color:#333;font-weight:bold;font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;'>")
                      .Append(He(colPart)).Append("</td>");
                    sb.Append("<td style='padding:6px 10px;font-size:11px;color:").Append(Config.ColorCritical).Append(";font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;'>")
                      .Append(He(detPart)).Append("</td>");
                    sb.Append("</tr>");
                }
            }
            else
            {
                sb.Append("<tr><td style='padding:8px 12px;font-size:11px;color:#666;font-family:\"Segoe UI\",Arial;'>");
                sb.Append("Todos los formatos son correctos.");
                sb.Append("</td></tr>");
            }

            sb.Append("</table>");
            return sb.ToString();
        }


        // ═════════════════════════════════════════════════════════════════════════
        // SMTP — solo envío, no construye HTML
        // ═════════════════════════════════════════════════════════════════════════
        private void SendEmail(string htmlBody, ValidationEmailContext ctx,
                               string smtpHost, string from, string to)
        {
            string template = ctx.HasCritical ? Config.SubjectCritical : Config.SubjectWarning;
            string subject = template.Replace("{Process}", Config.ProcessName);

            using (var msg = new MailMessage())
            {
                msg.From = new MailAddress(from, "CRM · Honda Motor de Chile");
                msg.Subject = subject;

                foreach (var addr in to.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
                    msg.To.Add(addr.Trim());

                var view = AlternateView.CreateAlternateViewFromString(
                    htmlBody, Encoding.UTF8, "text/html");

                // Logos CID — rutas leídas desde parámetros de proyecto (nombres en Config)
                AddLogo(view, GetVar(Config.LogoWhitePath), "logohonda_white");
                AddLogo(view, GetVar(Config.LogoMainPath), "logohonda");

                msg.AlternateViews.Add(view);
                msg.IsBodyHtml = true;

                using (var smtp = new SmtpClient(smtpHost, 25))
                {
                    smtp.EnableSsl = false;
                    smtp.UseDefaultCredentials = true;
                    smtp.DeliveryMethod = SmtpDeliveryMethod.Network;
                    smtp.Timeout = 60000;

                    try { smtp.Send(msg); }
                    catch (SmtpFailedRecipientsException) { /* destinatarios inválidos — entrega a los válidos */ }
                }
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HELPERS — encoders y constructores HTML reutilizables
        // ═════════════════════════════════════════════════════════════════════════

        // HtmlEncode nativo (sin System.Web)
        private static string He(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;")
                    .Replace("'", "&#39;");
        }

        // HtmlAttributeEncode
        private static string Ha(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;");
        }

        // Título de sección con border-left rojo
        private static string SectionTitle(string text)
        {
            return "<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-bottom:6px;'>" +
                   "<tr><td style='border-left:4px solid " + Config.ColorPrimary + ";padding-left:10px;'>" +
                   "<span style='font-size:15px;font-weight:bold;color:" + Config.ColorPrimary +
                   ";font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.8px;'>" +
                   He(text) + "</span></td></tr></table>";
        }

        // Fila del Execution Summary (label gris | valor)
        private static string SummaryRowHtml(string label, string value)
        {
            return "<tr>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#666;font-weight:bold;background-color:#F8F8F8;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;width:200px;'>" +
                   He(label) + "</td>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;word-break:break-all;'>" +
                   He(value ?? "") + "</td>" +
                   "</tr>";
        }

        // Apertura común de tabla de sección (las 3 secciones la comparten)
        private static string OpenSectionTable()
        {
            return "<table width='100%' cellpadding='0' cellspacing='0' border='0' " +
                   "style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>";
        }

        // Encabezado de columna estilizado (gris claro, mayúsculas)
        private static string ColHeader(string text, string extraStyle)
        {
            return "<td style='padding:6px 10px;font-size:10px;font-weight:bold;color:#666;" +
                   "font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.5px;" +
                   extraStyle + "border-bottom:1px solid #DDD;'>" + text + "</td>";
        }

        // Celda de tabla simple (texto plano, ya escapado por quien llama)
        private static string ColCell(string innerHtml)
        {
            return "<td style='padding:6px 10px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;'>" +
                   innerHtml + "</td>";
        }

        // Carga imagen desde ruta UNC. Devuelve null si falla (el correo se envía sin imagen).
        private static MemoryStream LoadImage(string path)
        {
            try
            {
                if (string.IsNullOrEmpty(path)) return null;
                byte[] bytes = File.ReadAllBytes(path);
                return new MemoryStream(bytes);
            }
            catch { return null; }
        }

        // Agrega un logo como LinkedResource al AlternateView
        private static void AddLogo(AlternateView view, string path, string cid)
        {
            var ms = LoadImage(path);
            if (ms == null) return;
            var lr = new LinkedResource(ms, "image/png")
            {
                ContentId = cid,
                TransferEncoding = TransferEncoding.Base64
            };
            view.LinkedResources.Add(lr);
        }

        // String del período en español ("Mayo 2026")
        private static string BuildPeriodString()
        {
            var es = new CultureInfo("es-CL");
            string month = DateTime.Now.ToString("MMMM", es);
            return char.ToUpper(month[0]) + month.Substring(1) + " " + DateTime.Now.Year;
        }

        // Lectura segura de variable SSIS (no lanza si no existe)
        private string GetVar(string name)
        {
            try { return Dts.Variables[name].Value == null ? "" : Dts.Variables[name].Value.ToString(); }
            catch { return ""; }
        }

        // Clon defensivo de COLUMN_DEFS para no contaminar el static entre corridas
        private ColumnDef[] CloneColumnDefs(ColumnDef[] source)
        {
            var clone = new ColumnDef[source.Length];
            for (int i = 0; i < source.Length; i++)
                clone[i] = new ColumnDef(
                    source[i].Name,
                    source[i].DataType,
                    source[i].MaxLen,
                    source[i].Aliases);
            return clone;
        }


        // ═════════════════════════════════════════════════════════════════════════
        // IO — Lectura del archivo Excel
        // ═════════════════════════════════════════════════════════════════════════
        //   - Devuelve TODO como string (IMEX=1) para evitar problemas de tipo
        //     (ej. OleAut date) en celdas mixtas.
        private DataTable LoadExcelFromOleDb(string filePath, string fileSheet)
        {
            if (!File.Exists(filePath))
                throw new Exception("Archivo Excel no existe: " + filePath);

            string connStr =
                "Provider=Microsoft.ACE.OLEDB.12.0;" +
                "Data Source=" + filePath + ";" +
                "Extended Properties=\"Excel 12.0 Xml;HDR=YES;IMEX=1\";";

            var raw = new DataTable();
            using (var conn = new OleDbConnection(connStr))
            {
                conn.Open();
                string sql = "SELECT * FROM [" + fileSheet + "$]";
                using (var da = new OleDbDataAdapter(sql, conn))
                {
                    da.Fill(raw);
                }
            }

            // Clonamos a DataTable string-only
            var dt = new DataTable();
            foreach (DataColumn c in raw.Columns)
                dt.Columns.Add(c.ColumnName, typeof(string));
            foreach (DataRow r in raw.Rows)
            {
                var nr = dt.NewRow();
                for (int i = 0; i < dt.Columns.Count; i++)
                {
                    nr[i] = r[i] == null || r[i] == DBNull.Value
                        ? (object)DBNull.Value
                        : r[i].ToString();
                }
                dt.Rows.Add(nr);
            }
            return dt;
        }


        // ═════════════════════════════════════════════════════════════════════════
        // DATA CLASSES
        // ═════════════════════════════════════════════════════════════════════════

        // ── Definición de columna esperada ──────────────────────────────────────
        private class ColumnDef
        {
            public string Name { get; set; }
            public string DataType { get; set; }
            public int MaxLen { get; set; }
            public string[] Aliases { get; set; }
            public int ResolvedIndex { get; set; }

            public ColumnDef(string name, string dataType, int maxLen = 0,
                             string[] aliases = null)
            {
                Name = name;
                DataType = dataType;
                MaxLen = maxLen;
                Aliases = aliases ?? new string[0];
                ResolvedIndex = -1;
            }
        }

        // ── Error de validación (con número de fila o 0 para errores globales) ──
        private class ValidationError
        {
            public int RowNumber { get; set; }
            public string Detail { get; set; }

            public ValidationError(int row, string detail)
            { RowNumber = row; Detail = detail; }
        }

        // ── Resultado genérico de un nivel ──────────────────────────────────────
        private class LevelResult
        {
            public List<string> Warnings { get; set; }
            public List<ValidationError> Criticals { get; set; }
            public bool HasCritical { get { return Criticals.Count > 0; } }

            public LevelResult()
            {
                Warnings = new List<string>();
                Criticals = new List<ValidationError>();
            }
        }

        // ── Resultado específico de L2 (filas con estado por columna esperada) ──
        private class L2Result
        {
            public List<L2Row> Rows { get; set; }
            public List<ValidationError> Criticals { get; set; }
            public bool HasCritical { get { return Criticals.Count > 0; } }

            public L2Result()
            {
                Rows = new List<L2Row>();
                Criticals = new List<ValidationError>();
            }
        }

        private class L2Row
        {
            public string ExpectedName { get; set; }
            public string FoundName { get; set; }
            public string Status { get; set; }  // EXACT|NORMALIZED|ALIAS|ALIAS_NORMALIZED|NOT_FOUND
            public int ResolvedIndex { get; set; }

            public L2Row() { ResolvedIndex = -1; }
        }

        // ── Definición declarativa de una fila del Execution Summary ────────────
        private enum SummaryRowOrigen { Variable, Ctx, Literal }

        private class SummaryRowDef
        {
            public string Label { get; set; }
            public SummaryRowOrigen Origen { get; set; }
            public string Fuente { get; set; }   // nombre de variable | clave de ctx | literal

            private SummaryRowDef(string label, SummaryRowOrigen origen, string fuente)
            { Label = label; Origen = origen; Fuente = fuente; }

            public static SummaryRowDef Var(string label, string variable)
            { return new SummaryRowDef(label, SummaryRowOrigen.Variable, variable); }

            public static SummaryRowDef Ctx(string label, string clave)
            { return new SummaryRowDef(label, SummaryRowOrigen.Ctx, clave); }

            public static SummaryRowDef Lit(string label, string literal)
            { return new SummaryRowDef(label, SummaryRowOrigen.Literal, literal); }
        }

        // ── Definición declarativa de una sección del correo ────────────────────
        private enum SeccionTipo
        {
            L1_CantidadColumnas,
            L2_NombresColumnas,
            L3_FormatoDatos
        }

        private class SeccionDef
        {
            public string Titulo { get; set; }
            public SeccionTipo Tipo { get; set; }

            public SeccionDef(string titulo, SeccionTipo tipo)
            { Titulo = titulo; Tipo = tipo; }
        }


        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
