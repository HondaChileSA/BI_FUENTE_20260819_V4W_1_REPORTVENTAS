          SQLTask:SqlStatementSource="/* ModeloGrupo__ETL08ReevaluateQc_v1.0.sql&#xA;   Paquete : ModeloGrupo (EtlVentasAutos) · Tarea: ETL08ReevaluateQc&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Camino SIN CAMBIOS: re-evalúa la Qc pendiente CODIGO_FUERA_MAESTRO contra el maestro actual. Lo que ahora cruza (y no tiene otro motivo pendiente) pasa a Base y queda Resuelta. Devuelve RowsReevaluadas.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;IF OBJECT_ID(N'tempdb..#Maestro') IS NOT NULL DROP TABLE #Maestro;&#xA;IF OBJECT_ID(N'tempdb..#Pasa')    IS NOT NULL DROP TABLE #Pasa;&#xA;&#xA;SELECT DISTINCT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo&#xA;INTO #Maestro&#xA;FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c AS v&#xA;WHERE v.IsDeleted = 0&#xA;  AND v.Linea_de_Producto__c = N'Automoviles'&#xA;  AND v.Codigoarticulo__c IS NOT NULL;&#xA;&#xA;SELECT q.QcID, q.[ModeloGrupoID], q.[CodigoArticulo], q.[Modelo], q.[Familia], q.[Activo]&#xA;INTO   #Pasa&#xA;FROM   HMDCBISA.dbo.V4WQcModeloGrupo AS q&#xA;WHERE  q.EstadoQc = N'Pendiente' AND q.MotivoFalla = N'CODIGO_FUERA_MAESTRO'&#xA;  AND  NOT (NOT EXISTS (SELECT 1 FROM #Maestro m WHERE m.Codigo = q.CodigoArticulo))&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcModeloGrupo o&#xA;                   WHERE o.[ModeloGrupoID] = q.[ModeloGrupoID] AND o.EstadoQc = N'Pendiente' AND o.QcID &lt;&gt; q.QcID);&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;MERGE HMDCBIDW.dbo.V4WBaseModeloGrupo AS tgt&#xA;USING (SELECT p.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), p.[ModeloGrupoID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[CodigoArticulo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[Modelo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[Familia]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[Activo]), N''))), 1, 8)) AS HashNuevo FROM #Pasa AS p) AS src&#xA;   ON tgt.[ModeloGrupoID] = src.[ModeloGrupoID]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[CodigoArticulo] = src.[CodigoArticulo], tgt.[Modelo] = src.[Modelo], tgt.[Familia] = src.[Familia], tgt.[Activo] = src.[Activo],&#xA;                tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([ModeloGrupoID], [CodigoArticulo], [Modelo], [Familia], [Activo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[ModeloGrupoID], src.[CodigoArticulo], src.[Modelo], src.[Familia], src.[Activo], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcModeloGrupo AS q&#xA;JOIN   #Pasa AS p ON p.QcID = q.QcID;&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(*) AS RowsReevaluadas FROM #Pasa;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsReevaluadas"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
