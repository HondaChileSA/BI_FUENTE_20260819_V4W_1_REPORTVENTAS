              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* The Script Task allows you to perform virtually any operation that can be accomplished in
 * a .Net application within the context of an Integration Services control flow. 
 * 
 * Expand the other regions which have "Help" prefixes for examples of specific ways to use
 * Integration Services features within this script task. */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.IO;
using System.Net.Mail;
using System.Net.Mime;
using System.Security;
using System.Text;
#endregion

namespace ST_9d9cab44adfd425f94091267efa0f08c
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        // ╔══════════════════════════════════════════════════════════════════════╗
        // ║  CONFIG — Único punto de modificación                                ║
        // ║  Para agregar/quitar un dato del correo, editar CAMPOS.              ║
        // ╚══════════════════════════════════════════════════════════════════════╝
        private static class Config
        {
            // ── Recursos visuales ──────────────────────────────────────────────
            // OJO: verificar que logo_white.png exista en esa carpeta de red.
            // Si no existe, el header sale sin logo (no rompe el envío).
            public const string LogoMainPath = "$Project::vLogoMain";
            public const string LogoWhitePath = "$Project::vLogoWhite";

            // ── Variables SMTP (parámetros de proyecto) ────────────────────────
            public const string VarSmtpHost = "$Project::vSMTPHost";
            public const string VarMailFrom = "$Package::vMailFrom";
            public const string VarMailTo = "$Package::vMailTO";

            // ── Detalle del error: etiqueta visible + variable(s) SSIS ─────────
            // Si hay >1 variable, se unen con Separador.
            // EsHex formatea la 1ra variable como 0x........
            public static readonly CampoError[] CAMPOS = new CampoError[]
            {
                new CampoError("Paquete",                 new[]{ "System::PackageName" }),
                new CampoError("Tarea",                   new[]{ "System::SourceName" }),
                new CampoError("Tabla",                   new[]{ "User::Etl_DestObject" }),
                new CampoError("Código de error",         new[]{ "System::ErrorCode" }, esHex: true),
                new CampoError("Mensaje técnico",         new[]{ "User::CtlErrorMessage" }),
                new CampoError("ExecutionID",             new[]{ "User::CtlExecutionID" }),
                new CampoError("SSIS Execution ID",       new[]{ "User::CtlServerExecutionID" }),
                new CampoError("Rows Read / Ins / Upd",   new[]{ "User::CtlRowsRead",
                                                                 "User::CtlRowsInserted",
                                                                 "User::CtlRowsUpdated" }),
                new CampoError("Duración (ms)",           new[]{ "User::CtlDurationMs" }),
                new CampoError("Fecha inicio",            new[]{ "User::CtlStartTime" }),
                new CampoError("Servidor / IP / Usuario", new[]{ "System::MachineName",
                                                                 "User::CtlIpExecution",
                                                                 "System::UserName" }),
            };
        }

        // ─────────────────────────────────────────────────────────────────────────
        // MAIN
        // ─────────────────────────────────────────────────────────────────────────
        public void Main()
        {
            try
            {
                // ── Anti-spam: una sola alerta por ejecución ──────────────────
                bool alreadySent = false;
                try { alreadySent = (bool)Dts.Variables["User::CtlErrorNotified"].Value; }
                catch { }
                if (alreadySent)
                {
                    Dts.TaskResult = (int)ScriptResults.Success;
                    return;
                }

                // ── SMTP ──────────────────────────────────────────────────────
                string smtpHost = GetVar(Config.VarSmtpHost);
                string from = GetVar(Config.VarMailFrom);
                string to = GetVar(Config.VarMailTo);

                if (string.IsNullOrEmpty(smtpHost) || string.IsNullOrEmpty(from) || string.IsNullOrEmpty(to))
                {
                    bool fa = false;
                    Dts.Events.FireInformation(0, "SendError",
                        "Alerta no enviada: variables SMTP no configuradas.", "", 0, ref fa);
                    Dts.TaskResult = (int)ScriptResults.Success;
                    return;
                }

                // ── Detalle del error (config-driven) ─────────────────────────
                var detalle = BuildDetalle();

                string packageName = GetVar("System::PackageName");
                string sourceName = GetVar("System::SourceName");
                string timestamp = DateTime.Now.ToString("dd/MM/yyyy HH:mm");

                string subject = string.Format("[ALERTA ETL] {0} — Error en {1}", packageName, sourceName);
                string html = BuildErrorHtml(packageName, sourceName, timestamp, detalle);

                SendEmail(html, subject, smtpHost, from, to);

                // ── Marca anti-spam ───────────────────────────────────────────
                try { Dts.Variables["User::CtlErrorNotified"].Value = true; }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                bool fireAgain = false;
                Dts.Events.FireInformation(0, "SendError",
                    "Fallo envío de alerta: " + ex.ToString(), "", 0, ref fireAgain);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        // ═══════════════════════════════════════════════════════════════════════
        // DETALLE — itera Config.CAMPOS y arma la lista (etiqueta, valor)
        // ═══════════════════════════════════════════════════════════════════════
        private List<KeyValuePair<string, string>> BuildDetalle()
        {
            var detalle = new List<KeyValuePair<string, string>>();

            foreach (var campo in Config.CAMPOS)
            {
                string valor;

                if (campo.EsHex)
                {
                    string raw = GetVar(campo.Variables[0]);
                    valor = raw;
                    try { valor = "0x" + Convert.ToInt64(raw).ToString("X8"); }
                    catch { }
                }
                else
                {
                    var partes = new List<string>();
                    foreach (var v in campo.Variables)
                        partes.Add(GetVar(v));
                    valor = string.Join(campo.Separador, partes);
                }

                detalle.Add(new KeyValuePair<string, string>(campo.Label, valor));
            }

            return detalle;
        }

        // ═══════════════════════════════════════════════════════════════════════
        // HTML BUILDER — molde corporativo Honda
        // ═══════════════════════════════════════════════════════════════════════
        private string BuildErrorHtml(string packageName, string sourceName,
                                      string timestamp, List<KeyValuePair<string, string>> detalle)
        {
            var sb = new StringBuilder();

            // ── Documento + container ──
            sb.Append("<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'></head>");
            sb.Append("<body style='margin:0;padding:0;background-color:#DADADA;font-family:\"Segoe UI\",Arial,sans-serif;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#DADADA;padding:28px 10px;'>");
            sb.Append("<tr><td align='center'>");
            sb.Append("<table width='660' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='width:660px;max-width:660px;background-color:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #C8C8C8;'>");

            // ── HEADER ROJO ──
            sb.Append("<tr><td style='background-color:#CC0000;padding:0;border-radius:14px 14px 0 0;overflow:hidden;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td width='8' style='background-color:#A30000;width:8px;'>&nbsp;</td>");
            sb.Append("<td style='padding:20px 26px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td valign='middle' width='230'>");
            sb.Append("<img src='cid:logohonda_white' width='210' alt='Honda Motor de Chile' style='display:block;border:0;'/>");
            sb.Append("</td>");
            sb.Append("<td align='right' valign='middle'>");
            sb.Append("<div style='color:#fff;font-size:20px;font-weight:bold;font-family:\"Segoe UI\",Arial;text-align:right;'>")
              .Append("Error en la ejecución del paquete</div>");
            sb.Append("<div style='color:#ffdddd;font-size:14px;text-align:right;margin-top:6px;font-family:\"Segoe UI\",Arial;'>")
              .Append(He(packageName)).Append("</div>");
            sb.Append("<div style='color:#ffaaaa;font-size:12px;text-align:right;margin-top:3px;font-family:\"Segoe UI\",Arial;'>")
              .Append(He(timestamp)).Append("</div>");
            sb.Append("</td></tr></table></td></tr></table></td></tr>");

            // ── BANDA NEGRA ──
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:8px 30px;'>");
            sb.Append("<span style='color:#AAA;font-size:10px;font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1.5px;'>");
            sb.Append("ETL Alert &nbsp;&#183;&nbsp; Honda Motor de Chile S.A. &nbsp;&#183;&nbsp; Business Intelligence");
            sb.Append("</span></td></tr>");

            // ── CUERPO ──
            sb.Append("<tr><td style='padding:22px 26px 18px 26px;background-color:#F2F2F2;'>");

            // Badge CRITICAL
            sb.Append("<table cellpadding='0' cellspacing='0' border='0' style='margin-bottom:14px;'><tr>");
            sb.Append("<td style='background-color:#CC0000;color:#fff;padding:5px 14px;border-radius:14px;");
            sb.Append("font-size:10px;font-weight:bold;font-family:\"Segoe UI\",Arial;letter-spacing:1px;'>");
            sb.Append("CRITICAL");
            sb.Append("</td></tr></table>");

            // Sección — Detalle del error
            sb.Append(SectionTitle("Detalle del error"));
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");
            foreach (var kv in detalle)
                sb.Append(SummaryRow(kv.Key, kv.Value));
            sb.Append("</table>");

            // Callout — Acción requerida
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'><tr>");
            sb.Append("<td style='background-color:#FFEBEE;border:1px solid #FFCDD2;border-left:4px solid #CC0000;");
            sb.Append("border-radius:6px;padding:11px 15px;font-size:11px;color:#333;");
            sb.Append("font-family:\"Segoe UI\",Arial;line-height:1.5;'>");
            sb.Append("<b>Acción requerida:</b> revisar el log del paquete en el servidor indicado. ");
            sb.Append("La carga <b>no se completó</b> — corregir el origen del error y volver a ejecutar.");
            sb.Append("</td></tr></table>");

            sb.Append("</td></tr>"); // fin cuerpo

            // ── FIRMA banner Honda ──
            sb.Append("<tr><td style='background-color:#fff;padding:22px 26px 14px 26px;border-top:1px solid #E0E0E0;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td align='center'>");
            sb.Append("<img src='cid:logohonda' width='420' alt='Honda Motor de Chile' style='display:block;margin:0 auto;border:0;'/>");
            sb.Append("</td></tr></table></td></tr>");

            // ── FOOTER ──
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:9px 26px;border-radius:0 0 14px 14px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td style='font-size:9px;color:#666;font-family:\"Segoe UI\",Arial;'>")
              .Append("Generado autom&#225;ticamente &nbsp;&#183;&nbsp; ")
              .Append(He(timestamp))
              .Append(" &nbsp;&#183;&nbsp; Business Intelligence HMDC</td>");
            sb.Append("<td align='right' style='font-size:9px;color:#CC0000;font-family:\"Segoe UI\",Arial;'>")
              .Append("ETL &amp; DWH &#183; Franco V&#233;liz</td>");
            sb.Append("</tr></table></td></tr>");

            // ── Barra roja final ──
            sb.Append("<tr><td height='5' style='background-color:#CC0000;height:5px;font-size:0;line-height:0;'>&nbsp;</td></tr>");

            sb.Append("</table>");
            sb.Append("</td></tr></table>");
            sb.Append("</body></html>");

            return sb.ToString();
        }

        // ═══════════════════════════════════════════════════════════════════════
        // SMTP
        // ═══════════════════════════════════════════════════════════════════════
        private void SendEmail(string htmlBody, string subject, string smtpHost, string from, string to)
        {
            using (var msg = new MailMessage())
            {
                msg.From = new MailAddress(from, "CRM · Honda Motor de Chile");
                msg.Subject = subject;

                foreach (var addr in to.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
                    msg.To.Add(addr.Trim());

                var view = AlternateView.CreateAlternateViewFromString(
                    htmlBody, Encoding.UTF8, "text/html");

                // Logos CID — rutas leídas desde parámetros de proyecto (nombres en Config)
                AddLogo(view, GetVar(Config.LogoWhitePath), "logohonda_white");
                AddLogo(view, GetVar(Config.LogoMainPath), "logohonda");

                msg.AlternateViews.Add(view);
                msg.IsBodyHtml = true;

                using (var smtp = new SmtpClient(smtpHost, 25))
                {
                    smtp.EnableSsl = false;
                    smtp.UseDefaultCredentials = true;
                    smtp.DeliveryMethod = SmtpDeliveryMethod.Network;
                    smtp.Timeout = 60000;
                    try { smtp.Send(msg); }
                    catch (SmtpFailedRecipientsException) { /* CC inválido — entrega a los válidos */ }
                }
            }
        }

        // ═══════════════════════════════════════════════════════════════════════
        // HELPERS
        // ═══════════════════════════════════════════════════════════════════════
        private static string He(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;")
                    .Replace("\"", "&quot;").Replace("'", "&#39;");
        }

        private static string SectionTitle(string text)
        {
            return "<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-bottom:6px;'>" +
                   "<tr><td style='border-left:4px solid #CC0000;padding-left:10px;'>" +
                   "<span style='font-size:15px;font-weight:bold;color:#CC0000;font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.8px;'>" +
                   He(text) + "</span></td></tr></table>";
        }

        private static string SummaryRow(string label, string value)
        {
            return "<tr>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#666;font-weight:bold;background-color:#F8F8F8;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;width:200px;'>" +
                   He(label) + "</td>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;word-break:break-all;'>" +
                   He(value ?? "") + "</td>" +
                   "</tr>";
        }

        private static MemoryStream LoadImage(string path)
        {
            try
            {
                if (string.IsNullOrEmpty(path)) return null;
                byte[] bytes = File.ReadAllBytes(path);
                return new MemoryStream(bytes);
            }
            catch { return null; }
        }

        private static void AddLogo(AlternateView view, string path, string cid)
        {
            var ms = LoadImage(path);
            if (ms == null) return; // si el logo no existe, el correo se envía sin imagen
            var lr = new LinkedResource(ms, "image/png")
            {
                ContentId = cid,
                TransferEncoding = TransferEncoding.Base64
            };
            view.LinkedResources.Add(lr);
        }

        private string GetVar(string name)
        {
            try { return Dts.Variables[name].Value == null ? "" : Dts.Variables[name].Value.ToString(); }
            catch { return ""; }
        }

        // ═══════════════════════════════════════════════════════════════════════
        // DATA CLASSES
        // ═══════════════════════════════════════════════════════════════════════
        private class CampoError
        {
            public string Label { get; set; }
            public string[] Variables { get; set; }
            public string Separador { get; set; }
            public bool EsHex { get; set; }

            public CampoError(string label, string[] variables,
                              string separador = " / ", bool esHex = false)
            {
                Label = label;
                Variables = variables;
                Separador = separador;
                EsHex = esHex;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
