                    <arrayElement
                      dataType="System.String"><![CDATA[#region Help:  Introduction to the Script Component
/* ETL02LoadDWHSA · Script Source — V4W ModeloGrupo (ProcessID 38)
 *
 * Lee el Excel del file server (OLE DB ACE 12.0, igual que DIC) y emite SOLO las filas con
 * formato válido hacia V4WStgModeloGrupo. Diferencia con DIC (SOL-008 O-1, D-ARQ-40):
 *   - No clasifica contra maestros ni duplicados aquí: eso lo hace ETL02bValidateMaestro en SQL,
 *     porque la Qc de V4W es persistente (no se trunca) y necesita UPDATE/INSERT, no un destino directo.
 *   - Las filas con formato inválido (tipo, largo, vacías en obligatorias) no tienen llave usable:
 *     se omiten, se cuentan en User::EtlFilasFormatoInvalido y ya quedan informadas por el correo
 *     de ETL00ValidateFile (L3). ETL06RegisterFile deja el conteo en V4WBaseArchivoCargado.Aviso.
 *   - Filas completamente vacías se ignoran.
 *
 * Output 0 (columnas a crear en el editor, en este orden):
 *     ExecutionID · DT_I8
 *     RowNumber   · DT_I4
 *     ModeloGrupoID · DT_I4
 *     CodigoArticulo· DT_WSTR(25)
 *     Modelo        · DT_WSTR(50)
 *     Familia       · DT_WSTR(50)
 *     Activo        · DT_BOOL
 *
 * ReadOnlyVariables : $Package::EtlFilePath, $Package::EtlFileSheet, User::CtlExecutionID
 * ReadWriteVariables: User::EtlFilasFormatoInvalido
 */
#endregion


using Microsoft.SqlServer.Dts.Pipeline;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Globalization;
using System.Linq;
using System.Data.SqlClient;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  CONFIG — alineado con COLUMN_DEFS de ETL00ValidateFile              ║
    // ╚══════════════════════════════════════════════════════════════════════╝
    private static class Config
    {
        public const string ComponentName = "V4WModeloGrupoScriptSource";

        public static readonly ColumnRule[] COLUMN_RULES = new ColumnRule[]
        {
            new ColumnRule("ModeloGrupoID",  "number",  0,  true,  new[] { "ID", "IDMODELOGRUPO", "MODELO GRUPO ID" }),
            new ColumnRule("CodigoArticulo", "string",  25, true,  new[] { "CODIGO", "CODIGO ARTICULO", "ARTICULO", "CODIGOARTICULO" }),
            new ColumnRule("Modelo",         "string",  50, true,  new[] { "MODELO" }),
            new ColumnRule("Familia",        "string",  50, true,  new[] { "FAMILIA" }),
            new ColumnRule("Activo",         "boolean", 0,  true,  new[] { "ACTIVO", "ACTIVE", "VIGENTE" }),
        };
    }

    private DataTable _dt;
    private long _executionId;
    private Dictionary<string, int> _idx;
    private int _filasInvalidas;

    public override void PreExecute()
    {
        base.PreExecute();
        _executionId = Variables.CtlExecutionID;

        string connStr =
            "Provider=Microsoft.ACE.OLEDB.12.0;" +
            "Data Source=" + Variables.EtlFilePath + ";" +
            "Extended Properties='Excel 12.0 Xml;HDR=YES;IMEX=1';";

        using (var conn = new OleDbConnection(connStr))
        {
            conn.Open();
            var da = new OleDbDataAdapter(string.Format("SELECT * FROM [{0}$]", Variables.EtlFileSheet), conn);
            _dt = new DataTable();
            da.Fill(_dt);
        }

        _idx = new Dictionary<string, int>(StringComparer.Ordinal);
        var faltan = new List<string>();
        foreach (var rule in Config.COLUMN_RULES)
        {
            int i = FindCol(_dt, rule);
            _idx[rule.Name] = i;
            if (i < 0) faltan.Add(rule.Name);
        }
        if (faltan.Count > 0)
            throw new Exception("Columnas obligatorias no encontradas: " + string.Join(", ", faltan.ToArray()));
    }

    public override void CreateNewOutputRows()
    {
        int rowNumber = 1; // fila 1 = encabezado
        foreach (DataRow row in _dt.Rows)
        {
            rowNumber++;
            if (IsRowAllEmpty(row)) continue;

            bool ok = true;
            foreach (var rule in Config.COLUMN_RULES)
            {
                string v = GetCell(row, rule.Name);
                if (string.IsNullOrEmpty(v)) { if (rule.Required) { ok = false; break; } continue; }
                if (ValidateTypeAndLength(v, rule) != null) { ok = false; break; }
            }
            if (!ok) { _filasInvalidas++; continue; }

            Output0Buffer.AddRow();
            Output0Buffer.ExecutionID = _executionId;
            Output0Buffer.RowNumber = rowNumber;
            Output0Buffer.ModeloGrupoID = ToInt(GetCell(row, "ModeloGrupoID"));
            Output0Buffer.CodigoArticulo = GetCell(row, "CodigoArticulo").ToUpperInvariant();
            Output0Buffer.Modelo = GetCell(row, "Modelo");
            Output0Buffer.Familia = GetCell(row, "Familia");
            Output0Buffer.Activo = ParseBooleanLoose(GetCell(row, "Activo"));
        }
    }

    public override void PostExecute()
    {
        base.PostExecute();
        Variables.EtlFilasFormatoInvalido = _filasInvalidas;
        if (_dt != null) { _dt.Dispose(); _dt = null; }
    }

    // ── Helpers ────────────────────────────────────────────────────────────
    private string GetCell(DataRow row, string name)
    {
        int i;
        if (!_idx.TryGetValue(name, out i) || i < 0 || row.IsNull(i)) return "";
        return row[i].ToString().Trim();
    }

    private static int ToInt(string v)
    {
        return (int)decimal.Parse(v, NumberStyles.Any, CultureInfo.InvariantCulture);
    }

    private static string ValidateTypeAndLength(string value, ColumnRule rule)
    {
        switch (rule.DataType)
        {
            case "string":
                if (rule.MaxLen > 0 && value.Length > rule.MaxLen) return "largo " + value.Length + " > " + rule.MaxLen;
                if (rule.AllowedValues != null &&
                    !rule.AllowedValues.Any(a => string.Equals(a, value, StringComparison.OrdinalIgnoreCase)))
                    return "valor no permitido";
                break;
            case "number":
                decimal d;
                if (!decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out d) || d != decimal.Truncate(d))
                    return "no es entero";
                break;
            case "boolean":
                if (!IsValidBoolean(value)) return "no es booleano";
                break;
        }
        return null;
    }

    private static bool IsRowAllEmpty(DataRow row)
    {
        foreach (object v in row.ItemArray)
            if (v != null && v != DBNull.Value && v.ToString().Trim() != "") return false;
        return true;
    }

    private static bool IsValidBoolean(string v)
    {
        v = v.Trim().ToLowerInvariant();
        return v == "true" || v == "false" || v == "1" || v == "0" || v == "si" || v == "no" || v == "yes" || v == "verdadero" || v == "falso";
    }

    private static bool ParseBooleanLoose(string v)
    {
        v = (v ?? "").Trim().ToLowerInvariant();
        return v == "true" || v == "1" || v == "si" || v == "yes" || v == "verdadero";
    }

    // Nombre exacto del valor permitido (respeta mayúsculas del catálogo, ej. "Modelo").
    private static string Canon(string v, ColumnRule rule)
    {
        if (rule.AllowedValues == null) return v;
        foreach (var a in rule.AllowedValues)
            if (string.Equals(a, v, StringComparison.OrdinalIgnoreCase)) return a;
        return v;
    }

    private static string Norm(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        return s.Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "").Replace("-", "");
    }

    private static int FindCol(DataTable dt, ColumnRule rule)
    {
        var buscados = new List<string> { Norm(rule.Name) };
        if (rule.Aliases != null) buscados.AddRange(rule.Aliases.Select(Norm));
        for (int i = 0; i < dt.Columns.Count; i++)
            if (buscados.Contains(Norm(dt.Columns[i].ColumnName))) return i;
        return -1;
    }

    private class ColumnRule
    {
        public string Name; public string DataType; public int MaxLen; public bool Required;
        public string[] Aliases; public string[] AllowedValues;
        public ColumnRule(string name, string dataType, int maxLen, bool required, string[] aliases, string[] allowed = null)
        { Name = name; DataType = dataType; MaxLen = maxLen; Required = required; Aliases = aliases; AllowedValues = allowed; }
    }
}
]]></arrayElement>
