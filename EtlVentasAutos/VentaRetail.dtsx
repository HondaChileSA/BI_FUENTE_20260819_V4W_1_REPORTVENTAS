    <DTS:Executable
      DTS:refId="Package\ETL05LoadDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DE844B92-CFE9-4577-A936-E809BAAD4809}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL05LoadDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL05LoadDWHDW_v1.1.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL05LoadDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_ventaretail_v2.py (no editar a mano: regenerar)&#xA;   v1.1    : 2026-11-24 · Franco Véliz (Agente V4W) · ARQ7 E2 (plan_E2 v2): sala por la cuenta Sala__c en el maestro de Autos (D-82); Qc CUENTA_SIN_HOMOLOGAR y CUENTA_SIN_SALA (D-101); sin D1-10 (11.9) ni DIC&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Arma V4WLoad: I / U por hash (oportunidad + sala + VIN + código: si cambia la etapa, la sala o el código, se actualiza) y D (en Base dentro de la ventana y ya no viene, o pasó a Qc). Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::WmCurrentLoadDate&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Desde date = ?;&#xA;DECLARE @BatchId uniqueidentifier =&#xA;    (SELECT TOP (1) BatchId FROM HMDCBIPA.dbo.CTLAuditBatch WHERE ExecutionID = @ExecutionID ORDER BY AuditBatchID DESC);&#xA;IF @BatchId IS NULL THROW 50010, N'No hay CTLAuditBatch para esta ejecución (CTL04OpenBatchId debe correr antes).', 1;&#xA;IF OBJECT_ID(N'tempdb..#Src') IS NOT NULL DROP TABLE #Src;&#xA;SELECT * INTO #Src FROM HMDCBISA.dbo.V4WStgVentaRetail WHERE ExecutionID = @ExecutionID;&#xA;&#xA;-- ── Resolución (idéntica en ETL02bValidateMaestro y ETL04LoadDWHDW) ─────────────────────&#xA;-- Sala (D-82, SOL-024): Opportunity.Sala__c (SalaId) → V4WBaseCuentaSalesforceAutos (ACTIVO = 1): cuenta SALA → sala y su dealer.&#xA;--   Cuenta CONCESIONARIO → Qc CUENTA_SIN_SALA (D-101); cuenta fuera del maestro → Qc CUENTA_SIN_HOMOLOGAR (D-22).&#xA;--   Se retira D1-10 (tarea 11.9): manda la cuenta, sin reglas de texto.&#xA;-- Código: el del VIN en Vin_Modelos__c; si no hay VIN, Codigo_Vehiculo__c si existe en el maestro.&#xA;IF OBJECT_ID(N'tempdb..#Cta')    IS NOT NULL DROP TABLE #Cta;&#xA;IF OBJECT_ID(N'tempdb..#VinM')   IS NOT NULL DROP TABLE #VinM;&#xA;IF OBJECT_ID(N'tempdb..#Codigo') IS NOT NULL DROP TABLE #Codigo;&#xA;IF OBJECT_ID(N'tempdb..#Res')    IS NOT NULL DROP TABLE #Res;&#xA;&#xA;SELECT cs.SALESFORCEID, cs.TIPO_CUENTA, cs.RUTID, cs.SUCURSALID INTO #Cta&#xA;FROM   HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS cs&#xA;JOIN   HMDCBIDW.dbo.V4WBaseDealerAutos           AS d ON d.RUTID = cs.RUTID AND d.ACTIVO = 1&#xA;WHERE  cs.ACTIVO = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Cta ON #Cta (SALESFORCEID);&#xA;&#xA;SELECT x.VIN, x.Codigo INTO #VinM&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;             UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;             ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;      FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c v&#xA;      WHERE v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles') AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_VinM ON #VinM (VIN);&#xA;SELECT DISTINCT Codigo INTO #Codigo FROM #VinM WHERE Codigo IS NOT NULL;&#xA;&#xA;SELECT s.Id, s.RowNumber,&#xA;       CASE WHEN a.TIPO_CUENTA = N'SALA' THEN a.RUTID END AS RUTID,&#xA;       CASE WHEN a.TIPO_CUENTA = N'SALA' THEN a.SUCURSALID END AS SUCURSALID, v.VIN,&#xA;       COALESCE(vm.Codigo, c.Codigo) AS CodigoArticulo, v.SalaTexto, s.SalaId, a.TIPO_CUENTA AS TipoCuenta&#xA;INTO   #Res&#xA;FROM   #Src AS s&#xA;CROSS APPLY (SELECT NULLIF(UPPER(LTRIM(RTRIM(LEFT(s.VinTexto, 25)))), N'') AS VIN,&#xA;                    LEFT(s.Concesionario, 255) AS SalaTexto) AS v&#xA;LEFT JOIN #Cta    AS a  ON a.SALESFORCEID = s.SalaId&#xA;LEFT JOIN #VinM   AS vm ON vm.VIN = v.VIN&#xA;LEFT JOIN #Codigo AS c  ON c.Codigo = UPPER(LTRIM(RTRIM(LEFT(s.CodigoVehiculo, 255))));&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Res ON #Res (Id);&#xA;-- ── fin resolución ─────────────────────────────────────────────────────────────────────────&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadVentaRetail ([Id], [StageName], [CloseDate], [LineaProducto], [Concesionario], [SalaId], [SalaVentaOriginal], [VinTexto], [CodigoVehiculo], [Modelo2], [Version2], [RUTID], [SUCURSALID], [VIN], [CodigoArticulo], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT s.[Id], s.[StageName], s.[CloseDate], s.[LineaProducto], s.[Concesionario], s.[SalaId], s.[SalaVentaOriginal], s.[VinTexto], s.[CodigoVehiculo], s.[Modelo2], s.[Version2], s.[RUTID], s.[SUCURSALID], s.[VIN], s.[CodigoArticulo], h.HashNuevo, ISNULL(b.Hash64, 0), @ExecutionID, @BatchId, s.RowNumber,&#xA;       CASE WHEN b.Id IS NULL THEN NULL ELSE SYSDATETIME() END, CASE WHEN b.Id IS NULL THEN N'I' ELSE N'U' END&#xA;FROM  (SELECT x.*, r.[RUTID], r.[SUCURSALID], r.[VIN], r.[CodigoArticulo] FROM #Src x JOIN #Res r ON r.Id = x.Id) AS s&#xA;CROSS APPLY (SELECT CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(400), s.[Id]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[StageName]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[CloseDate]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[LineaProducto]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Concesionario]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SalaId]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SalaVentaOriginal]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[VinTexto]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[CodigoVehiculo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Modelo2]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[Version2]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[RUTID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[SUCURSALID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[VIN]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(400), s.[CodigoArticulo]), N''))), 1, 8)) AS HashNuevo) AS h&#xA;LEFT JOIN HMDCBIDW.dbo.V4WBaseVentaRetail AS b ON b.Id = s.Id&#xA;WHERE  b.Id IS NULL OR b.Hash64 &lt;&gt; h.HashNuevo;&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WLoadVentaRetail ([Id], [StageName], [CloseDate], [LineaProducto], [Concesionario], [SalaId], [SalaVentaOriginal], [VinTexto], [CodigoVehiculo], [Modelo2], [Version2], [RUTID], [SUCURSALID], [VIN], [CodigoArticulo], HashNuevo, HashActual, ExecutionID, BatchId, RowNumber, LastModifiedDate, TypeLoad)&#xA;SELECT b.[Id], b.[StageName], b.[CloseDate], b.[LineaProducto], b.[Concesionario], b.[SalaId], b.[SalaVentaOriginal], b.[VinTexto], b.[CodigoVehiculo], b.[Modelo2], b.[Version2], b.[RUTID], b.[SUCURSALID], b.[VIN], b.[CodigoArticulo], b.Hash64, b.Hash64, @ExecutionID, @BatchId, NULL, SYSDATETIME(), N'D'&#xA;FROM   HMDCBIDW.dbo.V4WBaseVentaRetail AS b&#xA;WHERE  b.CloseDate &gt;= @Desde AND NOT EXISTS (SELECT 1 FROM #Src s WHERE s.Id = b.Id);&#xA;&#xA;SELECT (SELECT COUNT(*) FROM #Src) AS RowsRead;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL06UpdateDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0456720E-A798-41D8-AC4B-ABFFEFC17585}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL06UpdateDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL05UpdateDWHDW_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL05UpdateDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Actualiza en Base las filas U. Devuelve RowsUpdated.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @N int;&#xA;UPDATE tgt SET tgt.[StageName] = src.[StageName], tgt.[CloseDate] = src.[CloseDate], tgt.[LineaProducto] = src.[LineaProducto], tgt.[Concesionario] = src.[Concesionario], tgt.[SalaId] = src.[SalaId], tgt.[SalaVentaOriginal] = src.[SalaVentaOriginal], tgt.[VinTexto] = src.[VinTexto], tgt.[CodigoVehiculo] = src.[CodigoVehiculo], tgt.[Modelo2] = src.[Modelo2], tgt.[Version2] = src.[Version2], tgt.[RUTID] = src.[RUTID], tgt.[SUCURSALID] = src.[SUCURSALID], tgt.[VIN] = src.[VIN], tgt.[CodigoArticulo] = src.[CodigoArticulo], tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = src.ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;FROM   HMDCBIDW.dbo.V4WBaseVentaRetail AS tgt JOIN HMDCBISA.dbo.V4WLoadVentaRetail AS src ON src.Id = tgt.Id&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U' AND tgt.Hash64 &lt;&gt; src.HashNuevo;&#xA;SET @N = @@ROWCOUNT; SELECT @N AS RowsUpdated;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsUpdated"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL07InsertDWHDW"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A79855B1-3638-4228-AA24-1F07776AA7B8}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL07InsertDWHDW"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL05InsertDWHDW_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL05InsertDWHDW&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Inserta en Base las filas I. Devuelve RowsInsert.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;DECLARE @N int;&#xA;INSERT INTO HMDCBIDW.dbo.V4WBaseVentaRetail ([Id], [StageName], [CloseDate], [LineaProducto], [Concesionario], [SalaId], [SalaVentaOriginal], [VinTexto], [CodigoVehiculo], [Modelo2], [Version2], [RUTID], [SUCURSALID], [VIN], [CodigoArticulo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;SELECT s.[Id], s.[StageName], s.[CloseDate], s.[LineaProducto], s.[Concesionario], s.[SalaId], s.[SalaVentaOriginal], s.[VinTexto], s.[CodigoVehiculo], s.[Modelo2], s.[Version2], s.[RUTID], s.[SUCURSALID], s.[VIN], s.[CodigoArticulo], s.ExecutionID, s.HashNuevo, SYSDATETIME(), NULL&#xA;FROM   HMDCBISA.dbo.V4WLoadVentaRetail AS s WHERE s.ExecutionID = ? AND s.TypeLoad = N'I';&#xA;SET @N = @@ROWCOUNT; SELECT @N AS RowsInsert;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsInsert"
            SQLTask:DtsVariableName="User::CtlRowsInserted" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
