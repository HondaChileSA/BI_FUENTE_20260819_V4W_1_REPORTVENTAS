    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8E225D1F-0809-4615-88AE-DB9473BEA8A9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* VentaRetail__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría U (antes y después) y D (antes).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;DECLARE @AuditBatchID bigint = ?, @ProcessID int = ?, @ExecutionID bigint = ?;&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT @AuditBatchID, @ProcessID, src.TypeLoad,&#xA;       (SELECT tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       CASE WHEN src.TypeLoad = N'U' THEN (SELECT src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER) END&#xA;FROM   HMDCBIDW.dbo.V4WBaseVentaRetail AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadVentaRetail AS src ON src.Id = tgt.Id&#xA;WHERE  src.ExecutionID = @ExecutionID AND src.TypeLoad IN (N'U', N'D');&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5D3F71C9-D434-4A93-8DCD-D1E4A344DDA1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* VentaRetail__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría I.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'I', NULL, (SELECT src.[Id], src.[StageName], src.[CloseDate], src.[LineaProducto], src.[Concesionario], src.[SalaId], src.[SalaVentaOriginal], src.[VinTexto], src.[CodigoVehiculo], src.[Modelo2], src.[Version2], src.[RUTID], src.[SUCURSALID], src.[VIN], src.[CodigoArticulo], src.HashNuevo AS Hash64 FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadVentaRetail AS src&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F06EA928-9614-4F68-B723-F65E759861A4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* VentaRetail__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote. FailedRows = pendientes vistos en esta ejecución; borradas en Notes. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::EtlRowsDeleted · 5) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @ExecutionID bigint = ?, @Upd int = ?, @Ins int = ?, @Del int = ?, @AuditBatchID bigint = ?;&#xA;DECLARE @FailedRows int = (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WQcVentaRetail WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente');&#xA;UPDATE dbo.CTLAuditBatch SET UpdatedRows = @Upd, InsertedRows = @Ins, FailedRows = @FailedRows,&#xA;       Notes = CASE WHEN @Del &gt; 0 THEN N'Filas borradas de Base (TypeLoad D): ' + CONVERT(nvarchar(20), @Del) END&#xA;WHERE  AuditBatchID = @AuditBatchID;&#xA;SELECT @FailedRows AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::EtlRowsDeleted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="4" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{72A999E4-A286-4489-A5CE-0AE12E24E6B3}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* VentaRetail__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Corte fijo del KI 103: devuelve el mismo LastLoadDate + 1 día (CTL10 resta uno). NewLastID = última fecha de cierre cargada.&#xA;   Parámetros (OLE DB, en orden): 1) User::WmCurrentLoadDate&#xA;*/&#xA;DECLARE @Actual date = ?;&#xA;SELECT DATEADD(DAY, 1, @Actual) AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), (SELECT MAX(CloseDate) FROM HMDCBIDW.dbo.V4WBaseVentaRetail), 23), N'') AS NewLastID;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
