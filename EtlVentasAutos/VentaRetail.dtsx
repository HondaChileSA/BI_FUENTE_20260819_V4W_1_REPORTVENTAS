    <DTS:Executable
      DTS:refId="Package\CTL10UpdateWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{B2CA5DCF-10F8-4AB7-8B05-344CE041E684}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL10UpdateWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="-- ResultSet: None&#xA;UPDATE [dbo].[CTLWaterMark]&#xA;SET    [LastLoadDate]    = DATEADD(DAY, -1, ?),&#xA;       [LastID]          = ?,&#xA;       [LastExecutionID] = ?,&#xA;       [DateUpdated]     = SYSDATETIME()&#xA;WHERE  [ProcessID] = ?;&#xA;-- Params (Input): WmNewLoadDate, WmNewLastID, CtlExecutionID, CtlProcessID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::WmNewLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmNewLastID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL11CloseExecutionOK"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{92DF6852-1E3A-4B74-ABC5-69AF2F377BD0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL11CloseExecutionOK"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="-- ResultSet: None&#xA;UPDATE [dbo].[CTLExecution]&#xA;SET    [EndTime]      = SYSDATETIME(),&#xA;       [Status]       = 'Success',&#xA;       [DurationMs]   = ?,&#xA;       [RowsRead]     = ?,&#xA;       [RowsInserted] = ?,&#xA;       [RowsUpdated]  = ?,&#xA;       [ErrorMessage] = NULL&#xA;WHERE  [ExecutionID] = ?;&#xA;-- Params (Input): CtlDurationMs, CtlRowsRead, CtlRowsInserted, CtlRowsUpdated, CtlExecutionID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlDurationMs"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsRead"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL01TruncateStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{67CB4C0A-6C9E-4794-8709-CAB78D26D472}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL01TruncateStaging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL01TruncateStaging_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL01TruncateStaging&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Vacía Stg y Load. La Qc NO se trunca (persistente).&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WStgVentaRetail;&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WLoadVentaRetail;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL02LoadDWHSA"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D86ABAF1-3C38-4FFA-9602-4565D0A7D9DA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL02LoadDWHSA"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL02LoadDWHSA_v1.0.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL02LoadDWHSA&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39, D1-10 (DIC)&#xA;   Generado: etapas/V1/herramientas/generar_sql_ventaretail.py (no editar a mano: regenerar)&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Copia a Stg las oportunidades de Autos en 'Venta Cerrada' o 'Emisión Nota de Venta' (D-53) con cierre desde el corte del KI 103. Mismo servidor (.223): Execute SQL, sin data flow. Sin datos del cliente (D-ARQ-39): solo Id, etapa, fecha, sala, VIN y modelo. Devuelve RowsRead.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::WmCurrentLoadDate&#xA;*/&#xA;SET NOCOUNT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Desde date = ?;&#xA;INSERT INTO HMDCBISA.dbo.V4WStgVentaRetail (ExecutionID, RowNumber, [Id], [StageName], [CloseDate], [LineaProducto], [Concesionario], [SalaId], [SalaVentaOriginal], [VinTexto], [CodigoVehiculo], [Modelo2], [Version2])&#xA;SELECT @ExecutionID, CONVERT(int, ROW_NUMBER() OVER (ORDER BY o.CloseDate, o.Id)),&#xA;       o.Id, o.StageName, CONVERT(date, o.CloseDate), LEFT(o.Linea_Producto__c, 3900), LEFT(o.Concesionario__c, 3900),&#xA;       o.Sala__c, LEFT(o.Sala_de_venta_original__c, 100), LEFT(o.Vin_texto__c, 3900),&#xA;       LEFT(o.Codigo_Vehiculo__c, 255), LEFT(o.Modelo2__c, 255), LEFT(o.Version2__c, 255)&#xA;FROM   HMDCBIDW.dbo.SFOBaseOpportunity AS o&#xA;WHERE  o.IsDeleted = 0&#xA;  AND  o.Linea_Producto__c = N'Automoviles'&#xA;  AND  (o.StageName = N'Venta Cerrada' OR o.StageName LIKE N'Emisi_n Nota de Venta')&#xA;  AND  o.CloseDate &gt;= @Desde;&#xA;SELECT @@ROWCOUNT AS RowsRead;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsRead"
            SQLTask:DtsVariableName="User::CtlRowsRead" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::WmCurrentLoadDate"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL03ValidateMaestro"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{903314BB-4071-4A55-B585-B791B9185FAA}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL03ValidateMaestro"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* VentaRetail__ETL03ValidateMaestro_v1.1.sql&#xA;   Paquete : VentaRetail (EtlVentasAutos, ProcessID 40) · Tarea: ETL03ValidateMaestro&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-09 · plan V1 v6 · D-22, D-26, D-53, D-ARQ-39&#xA;   Generado: etapas/ARQ7/herramientas/generar_sql_ventaretail_v2.py (no editar a mano: regenerar)&#xA;   v1.1    : 2026-11-24 · Franco Véliz (Agente V4W) · ARQ7 E2 (plan_E2 v2): sala por la cuenta Sala__c en el maestro de Autos (D-82); Qc CUENTA_SIN_HOMOLOGAR y CUENTA_SIN_SALA (D-101); sin D1-10 (11.9) ni DIC&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Valida sala (cuenta Sala__c en el maestro de Autos) y modelo (código por VIN o Codigo_Vehiculo__c); actualiza la Qc persistente (recarga completa: lo pendiente que ya no falla queda Resuelto) y saca de Stg lo que no cruza (D-22). Devuelve RowsQc.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;IF OBJECT_ID(N'tempdb..#Src') IS NOT NULL DROP TABLE #Src;&#xA;SELECT * INTO #Src FROM HMDCBISA.dbo.V4WStgVentaRetail WHERE ExecutionID = @ExecutionID;&#xA;&#xA;-- ── Resolución (idéntica en ETL02bValidateMaestro y ETL04LoadDWHDW) ─────────────────────&#xA;-- Sala (D-82, SOL-024): Opportunity.Sala__c (SalaId) → V4WBaseCuentaSalesforceAutos (ACTIVO = 1): cuenta SALA → sala y su dealer.&#xA;--   Cuenta CONCESIONARIO → Qc CUENTA_SIN_SALA (D-101); cuenta fuera del maestro → Qc CUENTA_SIN_HOMOLOGAR (D-22).&#xA;--   Se retira D1-10 (tarea 11.9): manda la cuenta, sin reglas de texto.&#xA;-- Código: el del VIN en Vin_Modelos__c; si no hay VIN, Codigo_Vehiculo__c si existe en el maestro.&#xA;IF OBJECT_ID(N'tempdb..#Cta')    IS NOT NULL DROP TABLE #Cta;&#xA;IF OBJECT_ID(N'tempdb..#VinM')   IS NOT NULL DROP TABLE #VinM;&#xA;IF OBJECT_ID(N'tempdb..#Codigo') IS NOT NULL DROP TABLE #Codigo;&#xA;IF OBJECT_ID(N'tempdb..#Res')    IS NOT NULL DROP TABLE #Res;&#xA;&#xA;SELECT cs.SALESFORCEID, cs.TIPO_CUENTA, cs.RUTID, cs.SUCURSALID INTO #Cta&#xA;FROM   HMDCBIDW.dbo.V4WBaseCuentaSalesforceAutos AS cs&#xA;JOIN   HMDCBIDW.dbo.V4WBaseDealerAutos           AS d ON d.RUTID = cs.RUTID AND d.ACTIVO = 1&#xA;WHERE  cs.ACTIVO = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Cta ON #Cta (SALESFORCEID);&#xA;&#xA;SELECT x.VIN, x.Codigo INTO #VinM&#xA;FROM (SELECT UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Name)))) AS VIN,&#xA;             UPPER(LTRIM(RTRIM(CONVERT(nvarchar(255), v.Codigoarticulo__c)))) AS Codigo,&#xA;             ROW_NUMBER() OVER (PARTITION BY v.Name ORDER BY v.Id) AS Rn&#xA;      FROM HMDCBIDW.dbo.SFOBaseVin_Modelos__c v&#xA;      WHERE v.IsDeleted = 0 AND v.Linea_de_Producto__c = N'Automoviles') AS x&#xA;WHERE x.Rn = 1;&#xA;CREATE UNIQUE CLUSTERED INDEX IX_VinM ON #VinM (VIN);&#xA;SELECT DISTINCT Codigo INTO #Codigo FROM #VinM WHERE Codigo IS NOT NULL;&#xA;&#xA;SELECT s.Id, s.RowNumber,&#xA;       CASE WHEN a.TIPO_CUENTA = N'SALA' THEN a.RUTID END AS RUTID,&#xA;       CASE WHEN a.TIPO_CUENTA = N'SALA' THEN a.SUCURSALID END AS SUCURSALID, v.VIN,&#xA;       COALESCE(vm.Codigo, c.Codigo) AS CodigoArticulo, v.SalaTexto, s.SalaId, a.TIPO_CUENTA AS TipoCuenta&#xA;INTO   #Res&#xA;FROM   #Src AS s&#xA;CROSS APPLY (SELECT NULLIF(UPPER(LTRIM(RTRIM(LEFT(s.VinTexto, 25)))), N'') AS VIN,&#xA;                    LEFT(s.Concesionario, 255) AS SalaTexto) AS v&#xA;LEFT JOIN #Cta    AS a  ON a.SALESFORCEID = s.SalaId&#xA;LEFT JOIN #VinM   AS vm ON vm.VIN = v.VIN&#xA;LEFT JOIN #Codigo AS c  ON c.Codigo = UPPER(LTRIM(RTRIM(LEFT(s.CodigoVehiculo, 255))));&#xA;CREATE UNIQUE CLUSTERED INDEX IX_Res ON #Res (Id);&#xA;-- ── fin resolución ─────────────────────────────────────────────────────────────────────────&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Falla') IS NOT NULL DROP TABLE #Falla;&#xA;SELECT r.Id, r.RowNumber, f.MotivoFalla, f.DetalleError&#xA;INTO   #Falla&#xA;FROM   #Res AS r&#xA;CROSS APPLY (&#xA;    SELECT N'CUENTA_SIN_HOMOLOGAR', N'Cuenta ' + ISNULL(r.SalaId, N'(vacía)') + N' (&quot;' + ISNULL(r.SalaTexto, N'sin nombre') + N'&quot;) no está en el maestro de Autos'&#xA;    WHERE r.TipoCuenta IS NULL&#xA;    UNION ALL&#xA;    SELECT N'CUENTA_SIN_SALA', N'Cuenta ' + r.SalaId + N' (&quot;' + ISNULL(r.SalaTexto, N'sin nombre') + N'&quot;) es de concesionario: la venta debe tener sala en Salesforce'&#xA;    WHERE r.TipoCuenta = N'CONCESIONARIO'&#xA;    UNION ALL&#xA;    SELECT N'CODIGO_FUERA_MAESTRO', N'Sin código de artículo: VIN ' + ISNULL(r.VIN, N'(vacío)') + N' fuera de Vin_Modelos__c y Codigo_Vehiculo__c fuera del maestro'&#xA;    WHERE r.CodigoArticulo IS NULL&#xA;) AS f (MotivoFalla, DetalleError);&#xA;&#xA;BEGIN TRANSACTION;&#xA;UPDATE q SET q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora, q.RowNumber = f.RowNumber, q.DetalleError = LEFT(f.DetalleError, 500),&#xA;       q.[StageName] = s.[StageName], q.[CloseDate] = s.[CloseDate], q.[LineaProducto] = s.[LineaProducto], q.[Concesionario] = s.[Concesionario], q.[SalaId] = s.[SalaId], q.[SalaVentaOriginal] = s.[SalaVentaOriginal], q.[VinTexto] = s.[VinTexto], q.[CodigoVehiculo] = s.[CodigoVehiculo], q.[Modelo2] = s.[Modelo2], q.[Version2] = s.[Version2]&#xA;FROM   HMDCBISA.dbo.V4WQcVentaRetail AS q&#xA;JOIN   #Falla AS f ON f.Id = q.Id AND f.MotivoFalla = q.MotivoFalla&#xA;JOIN   #Src   AS s ON s.Id = f.Id&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;INSERT INTO HMDCBISA.dbo.V4WQcVentaRetail&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc, FechaPrimeraVez, FechaUltimaVez, [Id], [StageName], [CloseDate], [LineaProducto], [Concesionario], [SalaId], [SalaVentaOriginal], [VinTexto], [CodigoVehiculo], [Modelo2], [Version2])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, LEFT(f.DetalleError, 500), N'Pendiente', @Ahora, @Ahora, s.[Id], s.[StageName], s.[CloseDate], s.[LineaProducto], s.[Concesionario], s.[SalaId], s.[SalaVentaOriginal], s.[VinTexto], s.[CodigoVehiculo], s.[Modelo2], s.[Version2]&#xA;FROM   #Falla AS f JOIN #Src AS s ON s.Id = f.Id&#xA;WHERE  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcVentaRetail q WHERE q.Id = f.Id AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;UPDATE q SET q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcVentaRetail AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Falla f WHERE f.Id = q.Id AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;DELETE s FROM HMDCBISA.dbo.V4WStgVentaRetail AS s&#xA;WHERE  s.ExecutionID = @ExecutionID AND EXISTS (SELECT 1 FROM #Falla f WHERE f.Id = s.Id);&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(DISTINCT Id) AS RowsQc FROM #Falla;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsQc"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
