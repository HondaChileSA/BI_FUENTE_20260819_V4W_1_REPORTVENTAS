          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL_07_Report_Final — Reporte final post-aplicación (INSERT / UPDATE)
 *
 * Después del merge al modelo final (DICBaseDealerParent), este Script Task
 * envía un correo con el detalle de los cambios aplicados:
 *   · Registros insertados (TOP N preview)
 *   · Registros actualizados (TOP N preview, con delta de Hash)
 *
 * Es un reporte informativo — NUNCA detiene la ejecución (TaskResult siempre
 * = Success).
 *
 * Diseño config-driven:
 *   - Config.SUMMARY_ROWS → filas del bloque "Execution Summary".
 *   - Config.SECCIONES    → cada sección define su tabla origen y sus columnas.
 *                           El SQL SELECT, los encabezados y las celdas se
 *                           arman solos a partir de este array. Soporta
 *                           expresiones SQL personalizadas (ej. delta de Hash)
 *                           y un filtro opcional por sección (útil cuando se
 *                           migre a una sola tabla DICLoadDealerAlias con
 *                           columna Operation = 'I' | 'U').
 *
 * Para clonar este Script a otro input, sólo se toca el bloque Config.
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;              // WebClient + HttpWebRequest
using System.Net.Mail;
using System.Net.Mime;
using System.Text;
using System.Text.RegularExpressions;
#endregion

namespace ST_3b5335120ee1469aaa904846d3479804
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        // ╔══════════════════════════════════════════════════════════════════════╗
        // ║  CONFIG — Único punto de modificación entre procesos                 ║
        // ║                                                                      ║
        // ║  Para clonar este Script a otro input (HIJA / HOMOLOGACION / etc.)   ║
        // ║  sólo se edita ESTE bloque. El resto no se toca.                     ║
        // ║                                                                      ║
        // ║  Aquí se controlan:                                                  ║
        // ║    · Identidad del proceso                                           ║
        // ║    · Variables SSIS de proyecto / paquete                            ║
        // ║    · Tablas Stg / Load / Qc                                          ║
        // ║    · Filas del Execution Summary (SUMMARY_ROWS)                      ║
        // ║    · Secciones del reporte (SECCIONES) — cada una con su tabla,      ║
        // ║      filtro opcional, orden y columnas                               ║
        // ║    · Branding (colores, asunto, callouts, banda, logos)              ║
        // ╚══════════════════════════════════════════════════════════════════════╝
        private static class Config

        {
            // ── Identidad del proceso ──────────────────────────────────────────
            public const string ProcessName = "ModeloAlias";
            public const string ProcessLabel = "Ventas Autos · Alias de modelos del área · Reporte Final";

            // ── Variables SSIS — SMTP / correo / SQL ───────────────────────────
            public const string VarSmtpHost = "$Project::vSMTPHost";
            public const string VarSqlConn = "$Project::vSQLConnStr";
            public const string VarMailFrom = "$Package::vMailFrom";
            public const string VarMailTo = "$Package::vMailTO";

            // ── Variables SSIS — contexto del archivo / ejecución ──────────────
            public const string VarFilePath = "$Package::EtlFilePath";
            public const string VarFileSheet = "$Package::EtlFileSheet";
            public const string VarFileModifiedDate = "User::EtlFileModifiedDate";
            public const string VarExecutionId = "User::CtlExecutionID";
            public const string VarAuditBatchId = "User::CtlAuditBatchID";
            public const string VarBatchId = "User::CtlBatchId";

            // ── Variables SSIS — métricas calculadas upstream (opcionales) ─────
            //    Si la variable existe y tiene valor > 0, se usa.
            //    Si no, el script cuenta desde la BD.
            public const string VarRowsRead = "User::CtlRowsRead";
            public const string VarRowsInserted = "User::CtlRowsInserted";
            public const string VarRowsUpdated = "User::CtlRowsUpdated";
            public const string VarRowsFailed = "User::CtlRowsFailed";

            // ── Tablas (Stg / Qc / Load operativas) ────────────────────────────
            public const string TableStg = "HMDCBISA.dbo.V4WStgModeloAlias";
            public const string TableQc = "HMDCBISA.dbo.V4WQcModeloAlias";

            // ── Recursos visuales (rutas UNC) ──────────────────────────────────
            public const string LogoMainPath = "$Project::vLogoMain";
            public const string LogoWhitePath = "$Project::vLogoWhite";

            // ── Banda de contexto bajo el header rojo ──────────────────────────
            public const string BandaTexto =
                "ETL Final Report &nbsp;&#183;&nbsp; Honda Motor de Chile S.A. &nbsp;&#183;&nbsp; Customer Experience";

            // ── Branding — colores ─────────────────────────────────────────────
            public const string ColorPrimary = "#CC0000";
            public const string ColorPrimaryDark = "#A30000";
            public const string ColorInfo = "#424242";
            public const string ColorInfoBg = "#F5F5F5";
            public const string ColorInfoEdge = "#E0E0E0";
            public const string ColorOk = "#2E7D32";
            public const string ColorOkBg = "#E8F5E9";
            public const string ColorOkEdge = "#C8E6C9";

            // ── Asunto y header — plantillas con {Process} / {ExecutionId} ─────
            public const string SubjectInfo = "[ETL REPORTE FINAL] {Process} | Exec {ExecutionId}";
            public const string SubjectOk = "[ETL REPORTE FINAL] {Process} | Sin cambios";

            public const string HeaderInfo = "Cambios aplicados";
            public const string HeaderOk = "Ejecución sin cambios";

            // ── Callouts de acción ─────────────────────────────────────────────
            public const string ActionTextInfo =
                "La ejecución finalizó correctamente. Los cambios indicados ya fueron aplicados en el sistema.";
            public const string ActionTextOk =
                "La ejecución finalizó correctamente. No se detectaron cambios para aplicar.";

            // ── Límite de filas listadas en el correo por sección ──────────────
            public const int MAX_ROWS_PREVIEW = 50;

            // ── Filas del Execution Summary (declarativas) ─────────────────────
            //   Var → variable SSIS  ·  Ctx → clave del contexto  ·  Lit → literal
            public static readonly SummaryRowDef[] SUMMARY_ROWS = new SummaryRowDef[]
            {
                SummaryRowDef.Var("Paquete",              "User::CtlPackageName"),
                SummaryRowDef.Var("Usuario",              "User::EtlOperatorUser"),
                SummaryRowDef.Ctx("Última Modificación",  "FileModifiedDate"),
                SummaryRowDef.Ctx("Hoja",                 "FileSheet"),
                SummaryRowDef.Ctx("Filas leídas",         "TotalRowsFmt"),
                SummaryRowDef.Ctx("Filas insertadas",     "InsertedRowsFmt"),
                SummaryRowDef.Ctx("Filas actualizadas",   "UpdatedRowsFmt"),
                SummaryRowDef.Ctx("Filas descartadas",    "FailedRowsFmt"),
                SummaryRowDef.Ctx("Ruta",                 "FilePath"),
                SummaryRowDef.Ctx("ExecutionID",          "ExecutionId"),
                SummaryRowDef.Ctx("BatchId",              "BatchId"),
            };

            // ── Secciones del reporte (declarativas) ───────────────────────────
            //   Cada sección tiene su propia tabla + columnas. Para migrar a una
            //   sola tabla DICLoadDealerAlias con columna Operation, basta con
            //   poner la misma Tabla en ambas y setear Filter = "Operation='I'"
            //   o "Operation='U'".
            //
            //   ReporteCol(dbColumn, label, width, format?, sqlExpr?)
            //     · format = "bool"  → renderiza 1/True como "Sí", resto como "No"
            //     · sqlExpr          → expresión SQL personalizada (override de la columna)
            public static readonly ReporteSeccion[] SECCIONES = new ReporteSeccion[]
            {
                new ReporteSeccion(
                    titulo:       "Registros insertados",
                    tabla:        "HMDCBISA.dbo.V4WLoadModeloAlias",
                    filter:       "TypeLoad = 'I'",
                    ordenColumna: "RowNumber",
                    metricKey:    "InsertedRows",
                    columnas: new ReporteCol[]
                    {
                        new ReporteCol("RowNumber", "#Fila", 60),
                        new ReporteCol("ModeloAliasID", "ID", 60),
                        new ReporteCol("AliasArea", "Alias", 120),
                        new ReporteCol("NivelGrupo", "Nivel", 70),
                        new ReporteCol("Grupo", "Grupo", 0),
                        new ReporteCol("Activo", "Activo", 70, format: "bool"),
                    }),

                new ReporteSeccion(
                    titulo:       "Registros actualizados",
                    tabla:        "HMDCBISA.dbo.V4WLoadModeloAlias",
                    filter:       "TypeLoad = 'U'",
                    ordenColumna: "RowNumber",
                    metricKey:    "UpdatedRows",
                    columnas: new ReporteCol[]
                    {
                        new ReporteCol("RowNumber", "#Fila", 60),
                        new ReporteCol("ModeloAliasID", "ID", 60),
                        new ReporteCol("AliasArea", "Alias", 120),
                        new ReporteCol("NivelGrupo", "Nivel", 70),
                        new ReporteCol("Grupo", "Grupo", 0),
                        new ReporteCol("Activo", "Activo", 70, format: "bool"),
                        new ReporteCol("HashDelta", "Hash (old → new)", 160,
                            sqlExpr: "CONCAT(CAST(HashActual AS varchar(20)), ' -> ', CAST(HashNuevo AS varchar(20)))"),
                    }),
            };
        }


        // ═════════════════════════════════════════════════════════════════════════
        // MAIN
        // ═════════════════════════════════════════════════════════════════════════
        public void Main()
        {
            bool fireAgain = false;
            var sw = Stopwatch.StartNew();

            ServicePointManager.SecurityProtocol =
                  (SecurityProtocolType)3072
                | (SecurityProtocolType)12288;

            Dts.Events.FireInformation(0, Config.ProcessName,
                "### RUNNING FINAL REPORT (INSERT / UPDATE) ###", "", 0, ref fireAgain);

            try
            {
                // ── Variables de contexto ─────────────────────────────────────
                string filePath = GetVar(Config.VarFilePath);
                string fileSheet = GetVar(Config.VarFileSheet);
                string connStr = GetVar(Config.VarSqlConn);
                long execId = TryGetLong(Config.VarExecutionId);
                long auditBatchId = TryGetLong(Config.VarAuditBatchId);
                string batchIdText = ReadBatchIdAsString(Config.VarBatchId);
                DateTime fileModified = (DateTime)Dts.Variables[Config.VarFileModifiedDate].Value;

                // ── Métricas (variables upstream; fallback a SQL si vienen en 0) ─
                int rowsRead = TryGetInt(Config.VarRowsRead);
                int rowsInserted = TryGetInt(Config.VarRowsInserted);
                int rowsUpdated = TryGetInt(Config.VarRowsUpdated);
                int rowsFailed = TryGetInt(Config.VarRowsFailed);

                if (rowsRead <= 0) rowsRead = ReadCount(connStr, Config.TableStg, execId, null);
                if (rowsFailed <= 0) rowsFailed = ReadCount(connStr, Config.TableQc, execId, null);

                Dts.Events.FireInformation(0, Config.ProcessName,
                    string.Format("Context OK | ExecutionID={0} | BatchId={1} | Read={2} | Inserted={3} | Updated={4} | Failed={5}",
                        execId, batchIdText, rowsRead, rowsInserted, rowsUpdated, rowsFailed),
                    "", 0, ref fireAgain);

                // ── Leer las secciones (cada una hace su propio query) ────────
                var sectionData = new List<SectionData>();
                foreach (var sec in Config.SECCIONES)
                {
                    int total = ReadCount(connStr, sec.Tabla, execId, sec.Filter);
                    List<Dictionary<string, string>> rows = total > 0
                        ? ReadSectionRows(connStr, sec, execId)
                        : new List<Dictionary<string, string>>();
                    sectionData.Add(new SectionData { Seccion = sec, Total = total, Rows = rows });
                }

                // ── Si las métricas de Insert/Update no venían en variables,
                //    fallback al total contado en la tabla de la sección
                if (rowsInserted <= 0) rowsInserted = SumByMetricKey(sectionData, "InsertedRows");
                if (rowsUpdated <= 0) rowsUpdated = SumByMetricKey(sectionData, "UpdatedRows");

                bool hasChanges = (rowsInserted + rowsUpdated + rowsFailed) > 0;

                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Consultas ms=" + sw.ElapsedMilliseconds, "", 0, ref fireAgain);

                // ── Construir contexto del correo ─────────────────────────────
                var ctx = new FinalReportEmailContext
                {
                    FilePath = filePath,
                    FileSheet = fileSheet,
                    FileModifiedDate = fileModified.ToString("dd/MM/yyyy HH:mm"),
                    ExecutionId = execId,
                    AuditBatchId = auditBatchId,
                    BatchId = batchIdText,
                    Period = BuildPeriodString(),
                    Timestamp = DateTime.Now.ToString("dd/MM/yyyy HH:mm"),
                    TotalRows = rowsRead,
                    InsertedRows = rowsInserted,
                    UpdatedRows = rowsUpdated,
                    FailedRows = rowsFailed,
                    HasChanges = hasChanges
                };

                // ── Enviar correo ─────────────────────────────────────────────
                string smtpHost = GetVar(Config.VarSmtpHost);
                string from = GetVar(Config.VarMailFrom);
                string to = GetVar(Config.VarMailTo);

                if (string.IsNullOrEmpty(smtpHost) || string.IsNullOrEmpty(from) || string.IsNullOrEmpty(to))
                {
                    Dts.Events.FireInformation(0, Config.ProcessName,
                        "Email no enviado: variables SMTP/TO no configuradas en el proyecto.",
                        "", 0, ref fireAgain);
                }
                else
                {
                    string html = BuildFinalReportHtml(ctx, sectionData);
                    SendEmail(html, ctx, smtpHost, from, to);
                }

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                // Este reporte NUNCA detiene la ejecución
                Dts.Events.FireError(0, Config.ProcessName,
                    "Reporte final falló (no bloqueante): " + ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // SQL — lecturas genéricas (sirven a cualquier sección declarada)
        // ═════════════════════════════════════════════════════════════════════════

        // Cuenta filas en una tabla para el ExecutionID dado (con filtro opcional).
        private int ReadCount(string connStr, string tabla, long execId, string filter)
        {
            string whereExtra = string.IsNullOrEmpty(filter) ? "" : " AND " + filter;
            string sql = string.Format(
                "SELECT COUNT(1) FROM {0} WHERE ExecutionID = @ExecutionID{1};",
                tabla, whereExtra);

            using (var conn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, conn))
            {
                conn.Open();
                cmd.Parameters.Add("@ExecutionID", SqlDbType.BigInt).Value = execId;
                object result = cmd.ExecuteScalar();
                return (result == null || result == DBNull.Value) ? 0 : Convert.ToInt32(result);
            }
        }

        // Lee TOP N filas de la sección armando el SELECT desde sus columnas
        // (soporta sqlExpr y filter).
        private List<Dictionary<string, string>> ReadSectionRows(string connStr, ReporteSeccion sec, long execId)
        {
            var rows = new List<Dictionary<string, string>>();

            string columnsSql = string.Join(",\n        ",
                sec.Columnas.Select(c =>
                    !string.IsNullOrEmpty(c.SqlExpr)
                        ? c.SqlExpr + " AS [" + c.DbColumn + "]"
                        : "[" + c.DbColumn + "]"
                ).ToArray());

            string whereExtra = string.IsNullOrEmpty(sec.Filter) ? "" : " AND " + sec.Filter;
            string orderBy = string.IsNullOrEmpty(sec.OrdenColumna) ? "RowNumber" : sec.OrdenColumna;

            string sql = string.Format(@"
SELECT TOP (@MaxRows)
        {0}
FROM {1}
WHERE ExecutionID = @ExecutionID{2}
ORDER BY {3};",
                columnsSql, sec.Tabla, whereExtra, orderBy);

            using (var conn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, conn))
            {
                conn.Open();
                cmd.Parameters.Add("@ExecutionID", SqlDbType.BigInt).Value = execId;
                cmd.Parameters.Add("@MaxRows", SqlDbType.Int).Value = Config.MAX_ROWS_PREVIEW;

                using (var rd = cmd.ExecuteReader())
                {
                    while (rd.Read())
                    {
                        var row = new Dictionary<string, string>(StringComparer.Ordinal);
                        foreach (var col in sec.Columnas)
                        {
                            object v = rd[col.DbColumn];
                            row[col.DbColumn] = (v == null || v == DBNull.Value) ? "" : v.ToString();
                        }
                        rows.Add(row);
                    }
                }
            }
            return rows;
        }

        // Suma totales de secciones por su metricKey (para fallback de contadores)
        private int SumByMetricKey(List<SectionData> data, string metricKey)
        {
            int s = 0;
            foreach (var d in data)
                if (d.Seccion.MetricKey == metricKey) s += d.Total;
            return s;
        }


        // ═════════════════════════════════════════════════════════════════════════
        // EMAIL — context, builder principal (config-driven)
        // ═════════════════════════════════════════════════════════════════════════

        private class FinalReportEmailContext
        {
            public string FilePath { get; set; }
            public string FileSheet { get; set; }
            public string FileModifiedDate { get; set; }
            public long ExecutionId { get; set; }
            public long AuditBatchId { get; set; }
            public string BatchId { get; set; }
            public string Period { get; set; }
            public string Timestamp { get; set; }
            public int TotalRows { get; set; }
            public int InsertedRows { get; set; }
            public int UpdatedRows { get; set; }
            public int FailedRows { get; set; }
            public bool HasChanges { get; set; }
        }

        // ── Builder principal — itera SUMMARY_ROWS y SECCIONES ──────────────────
        private string BuildFinalReportHtml(FinalReportEmailContext ctx, List<SectionData> sections)
        {
            string badgeColor = ctx.HasChanges ? Config.ColorInfo : Config.ColorOk;
            string badgeText = ctx.HasChanges ? "INFO" : "OK";
            string headerTitle = ctx.HasChanges ? Config.HeaderInfo : Config.HeaderOk;
            string actionBg = ctx.HasChanges ? Config.ColorInfoBg : Config.ColorOkBg;
            string actionBorder = ctx.HasChanges ? Config.ColorInfoEdge : Config.ColorOkEdge;
            string actionAccent = ctx.HasChanges ? Config.ColorInfo : Config.ColorOk;
            string actionText = ctx.HasChanges ? Config.ActionTextInfo : Config.ActionTextOk;

            var ctxValues = BuildCtxDictionary(ctx);

            var sb = new StringBuilder();

            // ── Documento + container ────────────────────────────────────────
            sb.Append("<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'></head>");
            sb.Append("<body style='margin:0;padding:0;background-color:#DADADA;font-family:\"Segoe UI\",Arial,sans-serif;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#DADADA;padding:28px 10px;'>");
            sb.Append("<tr><td align='center'>");

            sb.Append("<table width='660' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='width:660px;max-width:660px;background-color:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #C8C8C8;'>");

            // ── HEADER ROJO ──────────────────────────────────────────────────
            sb.Append("<tr><td style='background-color:").Append(Config.ColorPrimary).Append(";padding:0;border-radius:14px 14px 0 0;overflow:hidden;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td width='8' style='background-color:").Append(Config.ColorPrimaryDark).Append(";width:8px;'>&nbsp;</td>");
            sb.Append("<td style='padding:20px 26px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td valign='middle' width='230'>");
            sb.Append("<img src='cid:logohonda_white' width='210' alt='Honda Motor de Chile' style='display:block;border:0;'/>");
            sb.Append("</td>");
            sb.Append("<td align='right' valign='middle'>");
            sb.Append("<div style='color:#fff;font-size:20px;font-weight:bold;font-family:\"Segoe UI\",Arial;text-align:right;'>")
              .Append(He(headerTitle)).Append("</div>");
            sb.Append("<div style='color:#ffdddd;font-size:14px;text-align:right;margin-top:6px;font-family:\"Segoe UI\",Arial;'>")
              .Append("ExecutionID: ").Append(ctx.ExecutionId)
              .Append(" &nbsp;|&nbsp; BatchId: ").Append(He(ctx.BatchId ?? ""))
              .Append("</div>");
            sb.Append("<div style='color:#ffaaaa;font-size:12px;text-align:right;margin-top:3px;font-family:\"Segoe UI\",Arial;'>")
              .Append(He(ctx.Timestamp ?? "")).Append("</div>");
            sb.Append("</td></tr></table></td></tr></table></td></tr>");

            // ── BANDA NEGRA ──────────────────────────────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:8px 30px;'>");
            sb.Append("<span style='color:#AAA;font-size:10px;font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1.5px;'>");
            sb.Append(Config.BandaTexto);
            sb.Append("</span></td></tr>");

            // ── CUERPO ───────────────────────────────────────────────────────
            sb.Append("<tr><td style='padding:22px 26px 18px 26px;background-color:#F2F2F2;'>");

            // Badge
            sb.Append("<table cellpadding='0' cellspacing='0' border='0' style='margin-bottom:14px;'><tr>");
            sb.Append("<td style='background-color:").Append(badgeColor).Append(";color:#fff;");
            sb.Append("padding:5px 14px;border-radius:14px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;letter-spacing:1px;'>");
            sb.Append(badgeText);
            sb.Append("</td></tr></table>");

            // Execution Summary — iterando Config.SUMMARY_ROWS
            sb.Append(SectionTitle("Execution Summary"));
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");
            foreach (var rowDef in Config.SUMMARY_ROWS)
                sb.Append(SummaryRowHtml(rowDef.Label, ResolveSummary(rowDef, ctxValues)));
            sb.Append("</table>");

            // Secciones del reporte — iterando Config.SECCIONES
            foreach (var s in sections)
            {
                sb.Append(SectionTitle(s.Seccion.Titulo));
                sb.Append(BuildSectionTable(s));
            }

            // Callout de acción
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'><tr>");
            sb.Append("<td style='background-color:").Append(actionBg).Append(";");
            sb.Append("border:1px solid ").Append(actionBorder).Append(";");
            sb.Append("border-left:4px solid ").Append(actionAccent).Append(";");
            sb.Append("border-radius:6px;padding:11px 15px;font-size:11px;color:#333;");
            sb.Append("font-family:\"Segoe UI\",Arial;line-height:1.5;'>");
            sb.Append(He(actionText));
            sb.Append("</td></tr></table>");

            sb.Append("</td></tr>");  // fin cuerpo

            // ── FIRMA con banner Honda ───────────────────────────────────────
            sb.Append("<tr><td style='background-color:#fff;padding:22px 26px 14px 26px;border-top:1px solid #E0E0E0;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td align='center'>");
            sb.Append("<img src='cid:logohonda' width='420' alt='Honda Motor de Chile' style='display:block;margin:0 auto;border:0;'/>");
            sb.Append("</td></tr></table></td></tr>");

            // ── FOOTER ───────────────────────────────────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:9px 26px;border-radius:0 0 14px 14px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td style='font-size:9px;color:#666;font-family:\"Segoe UI\",Arial;'>")
              .Append("Generado autom&#225;ticamente &nbsp;&#183;&nbsp; ")
              .Append(He(ctx.Timestamp ?? ""))
              .Append(" &nbsp;&#183;&nbsp; Customer Experience</td>");
            sb.Append("<td align='right' style='font-size:9px;color:").Append(Config.ColorPrimary).Append(";font-family:\"Segoe UI\",Arial;'>")
              .Append("ETL &amp; DWH &#183; Franco V&#233;liz</td>");
            sb.Append("</tr></table></td></tr>");

            // ── Barra roja final ─────────────────────────────────────────────
            sb.Append("<tr><td height='5' style='background-color:").Append(Config.ColorPrimary).Append(";height:5px;font-size:0;line-height:0;'>&nbsp;</td></tr>");

            sb.Append("</table>");                  // fin caja blanca
            sb.Append("</td></tr></table>");        // fin container
            sb.Append("</body></html>");
            return sb.ToString();
        }

        // ── Diccionario que mapea claves "Ctx:xxx" a valores del contexto ──────
        private Dictionary<string, string> BuildCtxDictionary(FinalReportEmailContext ctx)
        {
            var es = new CultureInfo("es-CL");
            return new Dictionary<string, string>(StringComparer.Ordinal)
            {
                { "FileModifiedDate", ctx.FileModifiedDate ?? "" },
                { "FileSheet",        ctx.FileSheet        ?? "" },
                { "FilePath",         ctx.FilePath         ?? "" },
                { "TotalRows",        ctx.TotalRows.ToString() },
                { "TotalRowsFmt",     ctx.TotalRows.ToString("N0", es) },
                { "InsertedRowsFmt",  ctx.InsertedRows.ToString("N0", es) },
                { "UpdatedRowsFmt",   ctx.UpdatedRows.ToString("N0", es) },
                { "FailedRowsFmt",    ctx.FailedRows.ToString("N0", es) },
                { "ExecutionId",      ctx.ExecutionId.ToString() },
                { "BatchId",          ctx.BatchId          ?? "" },
                { "AuditBatchId",     ctx.AuditBatchId.ToString() },
                { "Period",           ctx.Period           ?? "" },
                { "Timestamp",        ctx.Timestamp        ?? "" },
            };
        }

        private string ResolveSummary(SummaryRowDef row, Dictionary<string, string> ctx)
        {
            switch (row.Origen)
            {
                case SummaryRowOrigen.Variable:
                    return GetVar(row.Fuente);
                case SummaryRowOrigen.Ctx:
                    string v;
                    return ctx.TryGetValue(row.Fuente, out v) ? v : "";
                case SummaryRowOrigen.Literal:
                    return row.Fuente;
            }
            return "";
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HTML BUILDERS — Tabla por sección
        // ═════════════════════════════════════════════════════════════════════════
        private string BuildSectionTable(SectionData s)
        {
            int colCount = s.Seccion.Columnas.Length;
            bool hasRows = s.Total > 0;
            string statusBg = hasRows ? Config.ColorInfo : Config.ColorOk;

            string statusText;
            if (hasRows)
            {
                statusText = "&#10003; " + s.Total + " " +
                             (s.Total == 1 ? "registro" : "registros");
                if (s.Rows.Count < s.Total)
                    statusText += " (mostrando primeros " + s.Rows.Count + ")";
            }
            else
            {
                statusText = "&#10003; Sin registros";
            }

            var sb = new StringBuilder();
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");

            // Cabecera de estado
            sb.Append("<tr><td colspan='").Append(colCount).Append("' ");
            sb.Append("style='background-color:").Append(statusBg).Append(";color:#fff;");
            sb.Append("padding:6px 12px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1px;'>");
            sb.Append(statusText).Append("</td></tr>");

            if (!hasRows)
            {
                sb.Append("<tr><td colspan='").Append(colCount).Append("' ");
                sb.Append("style='padding:8px 12px;font-size:11px;color:#666;font-family:\"Segoe UI\",Arial;'>");
                sb.Append("No se generaron registros para esta sección.");
                sb.Append("</td></tr>");
            }
            else
            {
                // Encabezados de columna
                sb.Append("<tr style='background-color:#F2F2F2;'>");
                foreach (var col in s.Seccion.Columnas)
                    sb.Append(ColHeader(col.Label, col.Width));
                sb.Append("</tr>");

                // Filas
                foreach (var row in s.Rows)
                {
                    sb.Append("<tr>");
                    foreach (var col in s.Seccion.Columnas)
                    {
                        string raw;
                        if (!row.TryGetValue(col.DbColumn, out raw)) raw = "";
                        string rendered = FormatCellValue(raw, col.Format);
                        sb.Append(ColCell(rendered, col.Width));
                    }
                    sb.Append("</tr>");
                }
            }

            sb.Append("</table>");
            return sb.ToString();
        }

        // Aplica el "format" declarado en la ReporteCol (extensible)
        private string FormatCellValue(string raw, string format)
        {
            if (string.IsNullOrEmpty(format)) return He(raw);

            switch (format.ToLower())
            {
                case "bool":
                    string v = (raw ?? "").Trim().ToLowerInvariant();
                    if (v == "1" || v == "true" || v == "sí" || v == "si") return "Sí";
                    return "No";
                default:
                    return He(raw);
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // SMTP — solo envío
        // ═════════════════════════════════════════════════════════════════════════
        private void SendEmail(string htmlBody, FinalReportEmailContext ctx,
                               string smtpHost, string from, string to)
        {
            string template = ctx.HasChanges ? Config.SubjectInfo : Config.SubjectOk;
            string subject = template
                .Replace("{Process}", Config.ProcessName)
                .Replace("{ExecutionId}", ctx.ExecutionId.ToString());

            using (var msg = new MailMessage())
            {
                msg.From = new MailAddress(from, "CRM · Honda Motor de Chile");
                msg.Subject = subject;

                foreach (var addr in to.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
                    msg.To.Add(addr.Trim());

                var view = AlternateView.CreateAlternateViewFromString(
                    htmlBody, Encoding.UTF8, "text/html");

                // Logos CID — rutas leídas desde parámetros de proyecto (nombres en Config)
                AddLogo(view, GetVar(Config.LogoWhitePath), "logohonda_white");
                AddLogo(view, GetVar(Config.LogoMainPath), "logohonda");

                msg.AlternateViews.Add(view);
                msg.IsBodyHtml = true;

                using (var smtp = new SmtpClient(smtpHost, 25))
                {
                    smtp.EnableSsl = false;
                    smtp.UseDefaultCredentials = true;
                    smtp.DeliveryMethod = SmtpDeliveryMethod.Network;
                    smtp.Timeout = 60000;

                    try { smtp.Send(msg); }
                    catch (SmtpFailedRecipientsException) { /* destinatarios inválidos — entrega a los válidos */ }
                }
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HELPERS
        // ═════════════════════════════════════════════════════════════════════════

        // HtmlEncode nativo
        private static string He(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;")
                    .Replace("'", "&#39;");
        }

        // HtmlAttributeEncode
        private static string Ha(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;");
        }

        // Título de sección con border-left rojo
        private static string SectionTitle(string text)
        {
            return "<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-bottom:6px;'>" +
                   "<tr><td style='border-left:4px solid " + Config.ColorPrimary + ";padding-left:10px;'>" +
                   "<span style='font-size:15px;font-weight:bold;color:" + Config.ColorPrimary +
                   ";font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.8px;'>" +
                   He(text) + "</span></td></tr></table>";
        }

        // Fila del Execution Summary
        private static string SummaryRowHtml(string label, string value)
        {
            return "<tr>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#666;font-weight:bold;background-color:#F8F8F8;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;width:200px;'>" +
                   He(label) + "</td>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;word-break:break-all;'>" +
                   He(value ?? "") + "</td>" +
                   "</tr>";
        }

        private static string ColHeader(string text, int width)
        {
            return "<td style='padding:6px 10px;font-size:10px;font-weight:bold;color:#666;" +
                   "font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.5px;" +
                   (width > 0 ? "width:" + width + "px;" : "") +
                   "border-bottom:1px solid #DDD;'>" + He(text) + "</td>";
        }

        private static string ColCell(string innerHtml, int width)
        {
            return "<td style='padding:6px 10px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;" +
                   (width > 0 ? "width:" + width + "px;" : "") + "'>" +
                   innerHtml + "</td>";
        }

        private static MemoryStream LoadImage(string path)
        {
            try
            {
                if (string.IsNullOrEmpty(path)) return null;
                byte[] bytes = File.ReadAllBytes(path);
                return new MemoryStream(bytes);
            }
            catch { return null; }
        }

        private static void AddLogo(AlternateView view, string path, string cid)
        {
            var ms = LoadImage(path);
            if (ms == null) return;
            var lr = new LinkedResource(ms, "image/png")
            {
                ContentId = cid,
                TransferEncoding = TransferEncoding.Base64
            };
            view.LinkedResources.Add(lr);
        }

        private static string BuildPeriodString()
        {
            var es = new CultureInfo("es-CL");
            string month = DateTime.Now.ToString("MMMM", es);
            return char.ToUpper(month[0]) + month.Substring(1) + " " + DateTime.Now.Year;
        }

        // Lectura segura de variables SSIS
        private string GetVar(string name)
        {
            try { return Dts.Variables[name].Value == null ? "" : Dts.Variables[name].Value.ToString(); }
            catch { return ""; }
        }

        private long TryGetLong(string name)
        {
            try { return Convert.ToInt64(Dts.Variables[name].Value); }
            catch { return 0L; }
        }

        private int TryGetInt(string name)
        {
            try { return Convert.ToInt32(Dts.Variables[name].Value); }
            catch { return 0; }
        }

        // El BatchId puede venir como Guid (Object) o String — normaliza a string
        private string ReadBatchIdAsString(string varName)
        {
            try
            {
                object batchObj = Dts.Variables[varName].Value;
                if (batchObj is Guid) return ((Guid)batchObj).ToString("D");
                return (batchObj == null ? "" : batchObj.ToString());
            }
            catch { return ""; }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // DATA CLASSES
        // ═════════════════════════════════════════════════════════════════════════

        // ── Definición declarativa de una fila del Execution Summary ────────────
        private enum SummaryRowOrigen { Variable, Ctx, Literal }

        private class SummaryRowDef
        {
            public string Label { get; set; }
            public SummaryRowOrigen Origen { get; set; }
            public string Fuente { get; set; }

            private SummaryRowDef(string label, SummaryRowOrigen origen, string fuente)
            { Label = label; Origen = origen; Fuente = fuente; }

            public static SummaryRowDef Var(string label, string variable)
            { return new SummaryRowDef(label, SummaryRowOrigen.Variable, variable); }

            public static SummaryRowDef Ctx(string label, string clave)
            { return new SummaryRowDef(label, SummaryRowOrigen.Ctx, clave); }

            public static SummaryRowDef Lit(string label, string literal)
            { return new SummaryRowDef(label, SummaryRowOrigen.Literal, literal); }
        }

        // ── Definición declarativa de una sección del reporte ───────────────────
        private class ReporteSeccion
        {
            public string Titulo { get; set; }
            public string Tabla { get; set; }
            public string Filter { get; set; }   // null = sin filtro extra
            public string OrdenColumna { get; set; }
            public string MetricKey { get; set; }   // identifica a qué contador del summary corresponde
            public ReporteCol[] Columnas { get; set; }

            public ReporteSeccion(string titulo, string tabla, string filter, string ordenColumna,
                                  string metricKey, ReporteCol[] columnas)
            {
                Titulo = titulo;
                Tabla = tabla;
                Filter = filter;
                OrdenColumna = ordenColumna;
                MetricKey = metricKey;
                Columnas = columnas ?? new ReporteCol[0];
            }
        }

        // ── Definición declarativa de una columna en una sección ────────────────
        private class ReporteCol
        {
            public string DbColumn { get; set; }   // nombre de columna o alias del sqlExpr
            public string Label { get; set; }
            public int Width { get; set; }
            public string Format { get; set; }   // "bool" | "" (texto plano)
            public string SqlExpr { get; set; }    // expresión SQL personalizada (override)

            public ReporteCol(string dbColumn, string label, int width,
                              string format = "", string sqlExpr = null)
            {
                DbColumn = dbColumn;
                Label = label;
                Width = width;
                Format = format ?? "";
                SqlExpr = sqlExpr;
            }
        }

        // ── Resultado en memoria de una sección leída (sec + total + filas) ─────
        private class SectionData
        {
            public ReporteSeccion Seccion { get; set; }
            public int Total { get; set; }
            public List<Dictionary<string, string>> Rows { get; set; }
        }


        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
