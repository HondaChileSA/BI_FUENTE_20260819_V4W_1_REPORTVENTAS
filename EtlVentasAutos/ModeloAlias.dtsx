          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Help:  Introduction to the script task
/* ETL_03_Report_QC — Reporte post-carga de pendientes en Qc
 *
 * Después del data flow (DICStgDealerParent / DICQcDealerParent), este Script
 * Task lee la tabla Qc del proceso y envía un correo con las filas que NO
 * pudieron cargarse (RUTID vacío, duplicados, formato inválido, etc.).
 *
 * Es un reporte informativo — NO detiene el flujo. La carga al modelo final
 * ya ocurrió desde el Stg; el Qc queda para revisión manual.
 *
 * Diseño config-driven:
 *   - Config.SUMMARY_ROWS  → filas del bloque "Execution Summary".
 *   - Config.QC_COLS       → columnas de la tabla de pendientes (orden,
 *                            etiqueta y mapeo a la columna de la BD).
 *                            El query SQL se arma solo a partir de este array.
 *   - Branding (colores, asunto, callouts) también en Config.
 *
 * Para clonar este Script a otro input (HIJA / HOMOLOGACION / etc.), sólo se
 * edita el bloque Config — ProcessName, TableStg, TableQc, SUMMARY_ROWS y
 * QC_COLS. El resto del script se adapta automáticamente.
 */
#endregion


#region Namespaces
using Microsoft.SqlServer.Dts.Runtime;
using System;
using System.Collections.Generic;
using System.Data;
using System.Data.OleDb;
using System.Data.SqlClient;
using System.Diagnostics;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Net;              // WebClient + HttpWebRequest
using System.Net.Mail;
using System.Net.Mime;
using System.Text;
#endregion

namespace ST_3b5335120ee1469aaa904846d3479804
{
    /// <summary>
    /// ScriptMain is the entry point class of the script.  Do not change the name, attributes,
    /// or parent of this class.
    /// </summary>
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        // ╔══════════════════════════════════════════════════════════════════════╗
        // ║  CONFIG — Único punto de modificación entre procesos                 ║
        // ║                                                                      ║
        // ║  Para clonar este Script a otro input (HIJA / HOMOLOGACION / etc.)   ║
        // ║  sólo se edita ESTE bloque. El resto no se toca.                     ║
        // ║                                                                      ║
        // ║  Aquí se controlan:                                                  ║
        // ║    · Identidad del proceso                                           ║
        // ║    · Variables SSIS de proyecto / paquete                            ║
        // ║    · Tablas Stg y Qc (origen de los conteos y del detalle)           ║
        // ║    · Filas del Execution Summary (SUMMARY_ROWS)                      ║
        // ║    · Columnas de la tabla de pendientes (QC_COLS)                    ║
        // ║    · Branding (colores, asunto, callouts, banda, logos)              ║
        // ╚══════════════════════════════════════════════════════════════════════╝
        private static class Config
        {
            // ── Identidad del proceso ──────────────────────────────────────────
            public const string ProcessName = "ModeloAlias";
            public const string ProcessLabel = "Ventas Autos · Alias de modelos del área · Pendientes";

            // ── Variables SSIS — SMTP / correo / SQL ───────────────────────────
            public const string VarSmtpHost = "$Project::vSMTPHost";
            public const string VarSqlConn = "$Project::vSQLConnStr";
            public const string VarMailFrom = "$Package::vMailFrom";
            public const string VarMailTo = "$Package::vMailTO";

            // ── Variables SSIS — contexto del archivo / ejecución ──────────────
            public const string VarFilePath = "$Package::EtlFilePath";
            public const string VarFileSheet = "$Package::EtlFileSheet";
            public const string VarFileModifiedDate = "User::EtlFileModifiedDate";
            public const string VarExecutionId = "User::CtlExecutionID";

            // ── Tablas Stg / Qc ────────────────────────────────────────────────
            public const string TableStg = "dbo.V4WStgModeloAlias";
            public const string TableQc = "dbo.V4WQcModeloAlias";

            // ── Recursos visuales (rutas UNC) ──────────────────────────────────
            public const string LogoMainPath = "$Project::vLogoMain";
            public const string LogoWhitePath = "$Project::vLogoWhite";

            // ── Banda de contexto bajo el header rojo ──────────────────────────
            public const string BandaTexto =
                "ETL Post-Carga &nbsp;&#183;&nbsp; Honda Motor de Chile S.A. &nbsp;&#183;&nbsp; Customer Experience";

            // ── Branding — colores ─────────────────────────────────────────────
            public const string ColorPrimary = "#CC0000";
            public const string ColorPrimaryDark = "#A30000";
            public const string ColorWarning = "#F9A825";
            public const string ColorWarningBg = "#FFF8E1";
            public const string ColorWarningEdge = "#FFE082";
            public const string ColorOk = "#2E7D32";
            public const string ColorOkBg = "#E8F5E9";
            public const string ColorOkEdge = "#C8E6C9";

            // ── Asunto y header — plantillas con {Process} ─────────────────────
            public const string SubjectWarning = "[ETL POST-CARGA] {Process} — Pendientes detectados";
            public const string SubjectOk = "[ETL POST-CARGA] {Process} — Carga sin pendientes";

            public const string HeaderWarning = "Pendientes detectados en Qc";
            public const string HeaderOk = "Validación OK · Sin pendientes";

            // ── Callouts de acción ─────────────────────────────────────────────
            public const string ActionTextWarning =
                "La carga <b>CONTINUÓ</b>. Los registros pendientes quedan en la tabla Qc para revisión manual.";
            public const string ActionTextOk =
                "Todos los registros del archivo se cargaron correctamente al Stg.";

            // ── Límite de filas listadas en el correo ──────────────────────────
            public const int MAX_ROWS_PREVIEW = 50;

            // ── Filas del Execution Summary (declarativas) ─────────────────────
            //   Var → variable SSIS  ·  Ctx → clave del contexto  ·  Lit → literal
            public static readonly SummaryRowDef[] SUMMARY_ROWS = new SummaryRowDef[]
            {
                SummaryRowDef.Var("Paquete",             "User::CtlPackageName"),
                SummaryRowDef.Var("Usuario",             "User::EtlOperatorUser"),
                SummaryRowDef.Ctx("Última Modificación", "FileModifiedDate"),
                SummaryRowDef.Ctx("Hoja",                "FileSheet"),
                SummaryRowDef.Ctx("Filas en Stg",        "TotalStgFmt"),
                SummaryRowDef.Ctx("Filas en Qc",         "TotalQcFmt"),
                SummaryRowDef.Ctx("Ruta",                "FilePath"),
                SummaryRowDef.Ctx("ExecutionID",         "ExecutionId"),
            };

            // ── Columnas de la tabla de pendientes en el correo ────────────────
            //   Label    → texto del encabezado
            //   DbColumn → columna de DICQcDealerParent a leer (el SQL se arma solo)
            //   Width    → ancho en px (0 = automático)
            //   Strong   → true = celda en negrita (para resaltar Motivo)
            public static readonly QcColDef[] QC_COLS = new QcColDef[]
            {
                new QcColDef("#Fila", "RowNumber", 50, strong: false),
                new QcColDef("Motivo", "MotivoFalla", 150, strong: true),
                new QcColDef("ID", "ModeloAliasID", 70, strong: false),
                new QcColDef("Alias", "AliasArea", 120, strong: false),
                new QcColDef("Grupo", "Grupo", 110, strong: false),
                new QcColDef("Pendiente desde", "FechaPrimeraVez", 110, strong: false),
                new QcColDef("Detalle", "DetalleError", 0, strong: false),
            };
        }


        // ═════════════════════════════════════════════════════════════════════════
        // MAIN
        // ═════════════════════════════════════════════════════════════════════════
        public void Main()
        {
            bool fireAgain = false;
            var sw = Stopwatch.StartNew();

            // Forzar TLS 1.2/1.3 para endpoints SMTP corporativos
            ServicePointManager.SecurityProtocol =
                  (SecurityProtocolType)3072     // Tls12
                | (SecurityProtocolType)12288;   // Tls13

            try
            {
                // ── Variables de contexto ─────────────────────────────────────
                string filePath = GetVar(Config.VarFilePath);
                string fileSheet = GetVar(Config.VarFileSheet);
                long execId = Convert.ToInt64(Dts.Variables[Config.VarExecutionId].Value);
                string connStr = GetVar(Config.VarSqlConn);
                DateTime fileModified = (DateTime)Dts.Variables[Config.VarFileModifiedDate].Value;

                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Iniciando reporte post-carga de Qc", "", 0, ref fireAgain);

                // ── Contar filas Stg / Qc en una sola pasada ──────────────────
                int totalStg, totalQc;
                ReadStgQcCounts(connStr, execId, out totalStg, out totalQc);

                // ── Leer detalle de Qc para el listado del correo ─────────────
                List<Dictionary<string, string>> qcRows = ReadQcRows(connStr, execId);

                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Conteos ms=" + sw.ElapsedMilliseconds +
                    " | stg=" + totalStg + " | qc=" + totalQc, "", 0, ref fireAgain);
                sw.Restart();

                // ── Enviar correo (siempre, OK o WARNING) ─────────────────────
                try
                {
                    var ctx = new ReportEmailContext
                    {
                        FileModifiedDate = fileModified.ToString("dd/MM/yyyy HH:mm"),
                        FilePath = filePath,
                        FileSheet = fileSheet,
                        TotalStg = totalStg,
                        TotalQc = totalQc,
                        ExecutionId = execId,
                        Period = BuildPeriodString(),
                        Timestamp = DateTime.Now.ToString("dd/MM/yyyy HH:mm"),
                        HasPendientes = totalQc > 0
                    };
                    SendReportEmail(qcRows, ctx);
                }
                catch (Exception exMail)
                {
                    Dts.Events.FireInformation(0, Config.ProcessName,
                        "Aviso: correo no enviado — " + exMail.Message,
                        "", 0, ref fireAgain);
                }

                // ── Resultado final — siempre Success (reporte no bloquea) ────
                Dts.Events.FireInformation(0, Config.ProcessName,
                    totalQc > 0
                        ? "Reporte post-carga: " + totalQc + " pendiente(s) en Qc — revisar correo."
                        : "Reporte post-carga: carga sin pendientes.",
                    "", 0, ref fireAgain);
                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, Config.ProcessName,
                    "Error inesperado en reporte post-carga: " + ex.Message, "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // SQL — lecturas de Stg y Qc
        // ═════════════════════════════════════════════════════════════════════════

        // Cuenta filas en Stg y Qc para el ExecutionID en un solo round-trip.
        private void ReadStgQcCounts(string connStr, long execId, out int totalStg, out int totalQc)
        {
            string sql = string.Format(@"
SELECT
    (SELECT COUNT(1) FROM {0} WHERE ExecutionID = @ExecutionID) AS StgCount,
    (SELECT COUNT(1) FROM {1} WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente') AS QcCount",
                Config.TableStg, Config.TableQc);

            using (var conn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, conn))
            {
                conn.Open();
                cmd.Parameters.Add("@ExecutionID", SqlDbType.BigInt).Value = execId;
                using (var rd = cmd.ExecuteReader())
                {
                    rd.Read();
                    totalStg = Convert.ToInt32(rd["StgCount"]);
                    totalQc = Convert.ToInt32(rd["QcCount"]);
                }
            }
        }

        // Lee el detalle de Qc (TOP N) usando las columnas declaradas en Config.QC_COLS.
        // El SQL se arma dinámicamente a partir de Config.QC_COLS.
        private List<Dictionary<string, string>> ReadQcRows(string connStr, long execId)
        {
            var rows = new List<Dictionary<string, string>>();

            string columns = string.Join(", ",
                Config.QC_COLS.Select(c => "[" + c.DbColumn + "]").ToArray());

            string sql = string.Format(@"
SELECT TOP (@MaxRows) {0}
FROM {1}
WHERE ExecutionIDUltima = @ExecutionID AND EstadoQc = N'Pendiente'
ORDER BY RowNumber", columns, Config.TableQc);

            using (var conn = new SqlConnection(connStr))
            using (var cmd = new SqlCommand(sql, conn))
            {
                conn.Open();
                cmd.Parameters.Add("@ExecutionID", SqlDbType.BigInt).Value = execId;
                cmd.Parameters.Add("@MaxRows", SqlDbType.Int).Value = Config.MAX_ROWS_PREVIEW;

                using (var rd = cmd.ExecuteReader())
                {
                    while (rd.Read())
                    {
                        var row = new Dictionary<string, string>(StringComparer.Ordinal);
                        foreach (var col in Config.QC_COLS)
                        {
                            object v = rd[col.DbColumn];
                            row[col.DbColumn] = (v == null || v == DBNull.Value) ? "" : v.ToString();
                        }
                        rows.Add(row);
                    }
                }
            }
            return rows;
        }


        // ═════════════════════════════════════════════════════════════════════════
        // EMAIL — context, entry point, builder principal (config-driven)
        // ═════════════════════════════════════════════════════════════════════════

        // ── Contexto del correo ──────────────────────────────────────────────────
        private class ReportEmailContext
        {
            public string FilePath { get; set; }
            public string FileSheet { get; set; }
            public int TotalStg { get; set; }
            public int TotalQc { get; set; }
            public long ExecutionId { get; set; }
            public string FileModifiedDate { get; set; }
            public string Period { get; set; }
            public string Timestamp { get; set; }
            public bool HasPendientes { get; set; }
        }

        // ── Entry point — único método público que se llama desde Main() ─────────
        private void SendReportEmail(List<Dictionary<string, string>> qcRows, ReportEmailContext ctx)
        {
            string smtpHost = GetVar(Config.VarSmtpHost);
            string from = GetVar(Config.VarMailFrom);
            string to = GetVar(Config.VarMailTo);

            if (string.IsNullOrEmpty(from) || string.IsNullOrEmpty(to) || string.IsNullOrEmpty(smtpHost))
            {
                bool fa = false;
                Dts.Events.FireInformation(0, Config.ProcessName,
                    "Email no enviado: variables SMTP no configuradas en el proyecto.",
                    "", 0, ref fa);
                return;
            }

            string html = BuildReportHtml(qcRows, ctx);
            SendEmail(html, ctx, smtpHost, from, to);
        }

        // ── Builder principal (itera Config.SUMMARY_ROWS y Config.QC_COLS) ──────
        private string BuildReportHtml(List<Dictionary<string, string>> qcRows, ReportEmailContext ctx)
        {
            // Severidad — sólo WARNING u OK (este reporte nunca es CRITICAL)
            string badgeColor = ctx.HasPendientes ? Config.ColorWarning : Config.ColorOk;
            string badgeText = ctx.HasPendientes ? "WARNING" : "OK";
            string headerTitle = ctx.HasPendientes ? Config.HeaderWarning : Config.HeaderOk;
            string actionBg = ctx.HasPendientes ? Config.ColorWarningBg : Config.ColorOkBg;
            string actionBorder = ctx.HasPendientes ? Config.ColorWarningEdge : Config.ColorOkEdge;
            string actionAccent = ctx.HasPendientes ? Config.ColorWarning : Config.ColorOk;
            string actionText = ctx.HasPendientes ? Config.ActionTextWarning : Config.ActionTextOk;

            // Diccionario para resolver SUMMARY_ROWS de tipo Ctx
            var ctxValues = BuildCtxDictionary(ctx);

            var sb = new StringBuilder();

            // ── Documento + container externo ────────────────────────────────
            sb.Append("<!DOCTYPE html><html lang='es'><head><meta charset='UTF-8'></head>");
            sb.Append("<body style='margin:0;padding:0;background-color:#DADADA;font-family:\"Segoe UI\",Arial,sans-serif;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#DADADA;padding:28px 10px;'>");
            sb.Append("<tr><td align='center'>");

            // ── Caja blanca centrada (660px) ─────────────────────────────────
            sb.Append("<table width='660' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='width:660px;max-width:660px;background-color:#ffffff;border-radius:14px;overflow:hidden;border:1px solid #C8C8C8;'>");

            // ── HEADER ROJO con corner redondeado ────────────────────────────
            sb.Append("<tr><td style='background-color:").Append(Config.ColorPrimary).Append(";padding:0;border-radius:14px 14px 0 0;overflow:hidden;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td width='8' style='background-color:").Append(Config.ColorPrimaryDark).Append(";width:8px;'>&nbsp;</td>");
            sb.Append("<td style='padding:20px 26px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td valign='middle' width='230'>");
            sb.Append("<img src='cid:logohonda_white' width='210' alt='Honda Motor de Chile' style='display:block;border:0;'/>");
            sb.Append("</td>");
            sb.Append("<td align='right' valign='middle'>");
            sb.Append("<div style='color:#fff;font-size:20px;font-weight:bold;font-family:\"Segoe UI\",Arial;text-align:right;'>")
              .Append(He(headerTitle)).Append("</div>");
            sb.Append("<div style='color:#ffdddd;font-size:14px;text-align:right;margin-top:6px;font-family:\"Segoe UI\",Arial;'>")
              .Append("Per&#237;odo: ").Append(He(ctx.Period ?? "")).Append("</div>");
            sb.Append("<div style='color:#ffaaaa;font-size:12px;text-align:right;margin-top:3px;font-family:\"Segoe UI\",Arial;'>")
              .Append(He(ctx.Timestamp ?? "")).Append("</div>");
            sb.Append("</td></tr></table></td></tr></table></td></tr>");

            // ── BANDA NEGRA de contexto ──────────────────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:8px 30px;'>");
            sb.Append("<span style='color:#AAA;font-size:10px;font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1.5px;'>");
            sb.Append(Config.BandaTexto);
            sb.Append("</span></td></tr>");

            // ── CUERPO ───────────────────────────────────────────────────────
            sb.Append("<tr><td style='padding:22px 26px 18px 26px;background-color:#F2F2F2;'>");

            // Badge WARNING / OK
            sb.Append("<table cellpadding='0' cellspacing='0' border='0' style='margin-bottom:14px;'><tr>");
            sb.Append("<td style='background-color:").Append(badgeColor).Append(";color:#fff;");
            sb.Append("padding:5px 14px;border-radius:14px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;letter-spacing:1px;'>");
            sb.Append(badgeText);
            sb.Append("</td></tr></table>");

            // Execution Summary — iterando Config.SUMMARY_ROWS
            sb.Append(SectionTitle("Execution Summary"));
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");
            foreach (var rowDef in Config.SUMMARY_ROWS)
                sb.Append(SummaryRowHtml(rowDef.Label, ResolveSummary(rowDef, ctxValues)));
            sb.Append("</table>");

            // Sección — Detalle de pendientes en Qc
            sb.Append(SectionTitle("Pendientes en Qc"));
            sb.Append(BuildQcSection(qcRows, ctx));

            // Callout de acción
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-top:18px;'><tr>");
            sb.Append("<td style='background-color:").Append(actionBg).Append(";");
            sb.Append("border:1px solid ").Append(actionBorder).Append(";");
            sb.Append("border-left:4px solid ").Append(actionAccent).Append(";");
            sb.Append("border-radius:6px;padding:11px 15px;font-size:11px;color:#333;");
            sb.Append("font-family:\"Segoe UI\",Arial;line-height:1.5;'>");
            sb.Append(actionText);
            sb.Append("</td></tr></table>");

            sb.Append("</td></tr>");  // fin cuerpo

            // ── FIRMA con banner Honda ───────────────────────────────────────
            sb.Append("<tr><td style='background-color:#fff;padding:22px 26px 14px 26px;border-top:1px solid #E0E0E0;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr><td align='center'>");
            sb.Append("<img src='cid:logohonda' width='420' alt='Honda Motor de Chile' style='display:block;margin:0 auto;border:0;'/>");
            sb.Append("</td></tr></table></td></tr>");

            // ── FOOTER negro con timestamp + autor ───────────────────────────
            sb.Append("<tr><td style='background-color:#1C1C1C;padding:9px 26px;border-radius:0 0 14px 14px;'>");
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0'><tr>");
            sb.Append("<td style='font-size:9px;color:#666;font-family:\"Segoe UI\",Arial;'>")
              .Append("Generado autom&#225;ticamente &nbsp;&#183;&nbsp; ")
              .Append(He(ctx.Timestamp ?? ""))
              .Append(" &nbsp;&#183;&nbsp; Customer Experience</td>");
            sb.Append("<td align='right' style='font-size:9px;color:").Append(Config.ColorPrimary).Append(";font-family:\"Segoe UI\",Arial;'>")
              .Append("ETL &amp; DWH &#183; Franco V&#233;liz</td>");
            sb.Append("</tr></table></td></tr>");

            // ── Barra roja final de 5px ──────────────────────────────────────
            sb.Append("<tr><td height='5' style='background-color:").Append(Config.ColorPrimary).Append(";height:5px;font-size:0;line-height:0;'>&nbsp;</td></tr>");

            sb.Append("</table>");                  // fin caja blanca
            sb.Append("</td></tr></table>");        // fin container
            sb.Append("</body></html>");
            return sb.ToString();
        }


        // ── Diccionario que mapea claves "Ctx:xxx" a valores del contexto ──────
        private Dictionary<string, string> BuildCtxDictionary(ReportEmailContext ctx)
        {
            var es = new CultureInfo("es-CL");
            return new Dictionary<string, string>(StringComparer.Ordinal)
            {
                { "FileModifiedDate", ctx.FileModifiedDate ?? "" },
                { "FileSheet",        ctx.FileSheet        ?? "" },
                { "FilePath",         ctx.FilePath         ?? "" },
                { "TotalStg",         ctx.TotalStg.ToString() },
                { "TotalStgFmt",      ctx.TotalStg.ToString("N0", es) },
                { "TotalQc",          ctx.TotalQc.ToString() },
                { "TotalQcFmt",       ctx.TotalQc.ToString("N0", es) },
                { "ExecutionId",      ctx.ExecutionId.ToString() },
                { "Period",           ctx.Period           ?? "" },
                { "Timestamp",        ctx.Timestamp        ?? "" },
            };
        }

        // ── Resolver el valor de una fila del Execution Summary ────────────────
        private string ResolveSummary(SummaryRowDef row, Dictionary<string, string> ctx)
        {
            switch (row.Origen)
            {
                case SummaryRowOrigen.Variable:
                    return GetVar(row.Fuente);
                case SummaryRowOrigen.Ctx:
                    string v;
                    return ctx.TryGetValue(row.Fuente, out v) ? v : "";
                case SummaryRowOrigen.Literal:
                    return row.Fuente;
            }
            return "";
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HTML BUILDERS — Sección de pendientes en Qc
        // ═════════════════════════════════════════════════════════════════════════
        private string BuildQcSection(List<Dictionary<string, string>> qcRows, ReportEmailContext ctx)
        {
            bool hasRows = qcRows.Count > 0;
            string statusBg = hasRows ? Config.ColorWarning : Config.ColorOk;
            string statusText = hasRows
                ? "&#9888; " + ctx.TotalQc + " pendiente(s) en Qc"
                  + (ctx.TotalQc > qcRows.Count
                        ? " (mostrando primeros " + qcRows.Count + ")"
                        : "")
                : "&#10003; Sin pendientes";

            var sb = new StringBuilder();
            sb.Append("<table width='100%' cellpadding='0' cellspacing='0' border='0' ");
            sb.Append("style='margin-bottom:18px;background-color:#fff;border:1px solid #DEDEDE;border-radius:8px;overflow:hidden;'>");

            // Cabecera de estado
            sb.Append("<tr><td colspan='").Append(Config.QC_COLS.Length).Append("' ");
            sb.Append("style='background-color:").Append(statusBg).Append(";color:#fff;");
            sb.Append("padding:6px 12px;font-size:10px;font-weight:bold;");
            sb.Append("font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:1px;'>");
            sb.Append(statusText).Append("</td></tr>");

            if (!hasRows)
            {
                sb.Append("<tr><td colspan='").Append(Config.QC_COLS.Length).Append("' ");
                sb.Append("style='padding:8px 12px;font-size:11px;color:#666;font-family:\"Segoe UI\",Arial;'>");
                sb.Append("No hay filas en Qc para este ExecutionID.");
                sb.Append("</td></tr>");
            }
            else
            {
                // Encabezados de columna — iterando Config.QC_COLS
                sb.Append("<tr style='background-color:#F2F2F2;'>");
                foreach (var col in Config.QC_COLS)
                    sb.Append(ColHeader(col.Label, col.Width));
                sb.Append("</tr>");

                // Filas
                foreach (var row in qcRows)
                {
                    sb.Append("<tr>");
                    foreach (var col in Config.QC_COLS)
                    {
                        string val;
                        if (!row.TryGetValue(col.DbColumn, out val)) val = "";
                        sb.Append(ColCell(He(val), col.Width, col.Strong));
                    }
                    sb.Append("</tr>");
                }
            }

            sb.Append("</table>");
            return sb.ToString();
        }


        // ═════════════════════════════════════════════════════════════════════════
        // SMTP — solo envío, no construye HTML
        // ═════════════════════════════════════════════════════════════════════════
        private void SendEmail(string htmlBody, ReportEmailContext ctx,
                               string smtpHost, string from, string to)
        {
            string template = ctx.HasPendientes ? Config.SubjectWarning : Config.SubjectOk;
            string subject = template.Replace("{Process}", Config.ProcessName);

            using (var msg = new MailMessage())
            {
                msg.From = new MailAddress(from, "CRM · Honda Motor de Chile");
                msg.Subject = subject;

                foreach (var addr in to.Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries))
                    msg.To.Add(addr.Trim());

                var view = AlternateView.CreateAlternateViewFromString(
                    htmlBody, Encoding.UTF8, "text/html");

                // Logos CID — rutas leídas desde parámetros de proyecto (nombres en Config)
                AddLogo(view, GetVar(Config.LogoWhitePath), "logohonda_white");
                AddLogo(view, GetVar(Config.LogoMainPath), "logohonda");

                msg.AlternateViews.Add(view);
                msg.IsBodyHtml = true;

                using (var smtp = new SmtpClient(smtpHost, 25))
                {
                    smtp.EnableSsl = false;
                    smtp.UseDefaultCredentials = true;
                    smtp.DeliveryMethod = SmtpDeliveryMethod.Network;
                    smtp.Timeout = 60000;

                    try { smtp.Send(msg); }
                    catch (SmtpFailedRecipientsException) { /* destinatarios inválidos — entrega a los válidos */ }
                }
            }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // HELPERS — encoders y constructores HTML reutilizables
        // ═════════════════════════════════════════════════════════════════════════

        // HtmlEncode nativo (sin System.Web)
        private static string He(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;")
                    .Replace("'", "&#39;");
        }

        // HtmlAttributeEncode
        private static string Ha(string s)
        {
            if (string.IsNullOrEmpty(s)) return "";
            return s.Replace("&", "&amp;")
                    .Replace("<", "&lt;")
                    .Replace(">", "&gt;")
                    .Replace("\"", "&quot;");
        }

        // Título de sección con border-left rojo
        private static string SectionTitle(string text)
        {
            return "<table width='100%' cellpadding='0' cellspacing='0' border='0' style='margin-bottom:6px;'>" +
                   "<tr><td style='border-left:4px solid " + Config.ColorPrimary + ";padding-left:10px;'>" +
                   "<span style='font-size:15px;font-weight:bold;color:" + Config.ColorPrimary +
                   ";font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.8px;'>" +
                   He(text) + "</span></td></tr></table>";
        }

        // Fila del Execution Summary (label gris | valor)
        private static string SummaryRowHtml(string label, string value)
        {
            return "<tr>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#666;font-weight:bold;background-color:#F8F8F8;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;width:200px;'>" +
                   He(label) + "</td>" +
                   "<td style='padding:7px 12px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;word-break:break-all;'>" +
                   He(value ?? "") + "</td>" +
                   "</tr>";
        }

        // Encabezado de columna estilizado (gris claro, mayúsculas)
        private static string ColHeader(string text, int width)
        {
            return "<td style='padding:6px 10px;font-size:10px;font-weight:bold;color:#666;" +
                   "font-family:\"Segoe UI\",Arial;text-transform:uppercase;letter-spacing:.5px;" +
                   (width > 0 ? "width:" + width + "px;" : "") +
                   "border-bottom:1px solid #DDD;'>" + He(text) + "</td>";
        }

        // Celda de tabla
        private static string ColCell(string innerHtml, int width, bool strong)
        {
            string weight = strong ? "font-weight:bold;" : "";
            return "<td style='padding:6px 10px;font-size:11px;color:#333;" +
                   "font-family:\"Segoe UI\",Arial;border-bottom:1px solid #EEE;" +
                   (width > 0 ? "width:" + width + "px;" : "") +
                   weight + "'>" + innerHtml + "</td>";
        }

        // Carga imagen desde ruta UNC. Devuelve null si falla (el correo se envía sin imagen).
        private static MemoryStream LoadImage(string path)
        {
            try
            {
                if (string.IsNullOrEmpty(path)) return null;
                byte[] bytes = File.ReadAllBytes(path);
                return new MemoryStream(bytes);
            }
            catch { return null; }
        }

        // Agrega un logo como LinkedResource al AlternateView
        private static void AddLogo(AlternateView view, string path, string cid)
        {
            var ms = LoadImage(path);
            if (ms == null) return;
            var lr = new LinkedResource(ms, "image/png")
            {
                ContentId = cid,
                TransferEncoding = TransferEncoding.Base64
            };
            view.LinkedResources.Add(lr);
        }

        // String del período en español ("Mayo 2026")
        private static string BuildPeriodString()
        {
            var es = new CultureInfo("es-CL");
            string month = DateTime.Now.ToString("MMMM", es);
            return char.ToUpper(month[0]) + month.Substring(1) + " " + DateTime.Now.Year;
        }

        // Lectura segura de variable SSIS (no lanza si no existe)
        private string GetVar(string name)
        {
            try { return Dts.Variables[name].Value == null ? "" : Dts.Variables[name].Value.ToString(); }
            catch { return ""; }
        }


        // ═════════════════════════════════════════════════════════════════════════
        // DATA CLASSES
        // ═════════════════════════════════════════════════════════════════════════

        // ── Definición declarativa de una fila del Execution Summary ────────────
        private enum SummaryRowOrigen { Variable, Ctx, Literal }

        private class SummaryRowDef
        {
            public string Label { get; set; }
            public SummaryRowOrigen Origen { get; set; }
            public string Fuente { get; set; }   // nombre de variable | clave de ctx | literal

            private SummaryRowDef(string label, SummaryRowOrigen origen, string fuente)
            { Label = label; Origen = origen; Fuente = fuente; }

            public static SummaryRowDef Var(string label, string variable)
            { return new SummaryRowDef(label, SummaryRowOrigen.Variable, variable); }

            public static SummaryRowDef Ctx(string label, string clave)
            { return new SummaryRowDef(label, SummaryRowOrigen.Ctx, clave); }

            public static SummaryRowDef Lit(string label, string literal)
            { return new SummaryRowDef(label, SummaryRowOrigen.Literal, literal); }
        }

        // ── Definición declarativa de una columna de la tabla de Qc ─────────────
        private class QcColDef
        {
            public string Label { get; set; }
            public string DbColumn { get; set; }
            public int Width { get; set; }   // 0 = ancho automático
            public bool Strong { get; set; }

            public QcColDef(string label, string dbColumn, int width, bool strong = false)
            {
                Label = label;
                DbColumn = dbColumn;
                Width = width;
                Strong = strong;
            }
        }


        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
