    <DTS:Executable
      DTS:refId="Package\ETL01TruncateStaging"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{694D1DE6-C668-4B8F-85D6-B72093971033}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL01TruncateStaging"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* ModeloAlias__ETL01TruncateStaging_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: ETL01TruncateStaging&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Vacía Stg y Load del proceso. La Qc NO se trunca (persistente, D-ARQ-40).&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WStgModeloAlias;&#xA;TRUNCATE TABLE HMDCBISA.dbo.V4WLoadModeloAlias;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\ETL02bValidateMaestro"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{01437FEF-A9CD-421B-960D-C850298C4E7B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL02bValidateMaestro"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* ModeloAlias__ETL02bValidateMaestro_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: ETL02bValidateMaestro&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Valida Stg contra el maestro y duplicados; actualiza la Qc persistente (Pendiente/Resuelta) y saca de Stg las filas que no cruzan (D-22). Devuelve RowsQc (fila única).&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;&#xA;IF OBJECT_ID(N'tempdb..#Maestro') IS NOT NULL DROP TABLE #Maestro;&#xA;IF OBJECT_ID(N'tempdb..#Falla')   IS NOT NULL DROP TABLE #Falla;&#xA;&#xA;SELECT N'Modelo' AS Nivel, g.Modelo AS Grupo&#xA;INTO #Maestro&#xA;FROM HMDCBIDW.dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1&#xA;UNION&#xA;SELECT N'Familia', g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1;&#xA;&#xA;-- 1. Filas que no cruzan (una fila puede tener más de un motivo)&#xA;SELECT s.RowNumber, s.[ModeloAliasID], s.[AliasArea], s.[NivelGrupo], s.[Grupo], s.[Activo], f.MotivoFalla, f.DetalleError,&#xA;       ROW_NUMBER() OVER (PARTITION BY s.[ModeloAliasID], f.MotivoFalla ORDER BY s.RowNumber) AS Rn&#xA;INTO #Falla&#xA;FROM HMDCBISA.dbo.V4WStgModeloAlias AS s&#xA;CROSS APPLY (&#xA;    -- AliasArea repetido en el archivo&#xA;    SELECT N'DUPLICADO', N'AliasArea ''' + s.AliasArea + N''' repetido en el archivo'&#xA;    WHERE (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgModeloAlias x WHERE x.ExecutionID = @ExecutionID AND x.AliasArea = s.AliasArea) &gt; 1&#xA;    UNION ALL&#xA;    -- El grupo no existe en V4WBaseModeloGrupo al nivel indicado (D-23, D-27)&#xA;    SELECT N'GRUPO_FUERA_MAESTRO', N'Grupo ''' + s.Grupo + N''' (' + s.NivelGrupo + N') no existe en V4WBaseModeloGrupo activo'&#xA;    WHERE NOT EXISTS (SELECT 1 FROM #Maestro m WHERE m.Nivel = s.NivelGrupo AND m.Grupo = s.Grupo)&#xA;) AS f (MotivoFalla, DetalleError)&#xA;WHERE s.ExecutionID = @ExecutionID;&#xA;&#xA;-- Llave repetida en el archivo: todas sus filas a Qc&#xA;INSERT INTO #Falla&#xA;SELECT s.RowNumber, s.[ModeloAliasID], s.[AliasArea], s.[NivelGrupo], s.[Grupo], s.[Activo], N'DUPLICADO', N'ModeloAliasID ' + CONVERT(nvarchar(20), s.[ModeloAliasID]) + N' repetido en el archivo',&#xA;       ROW_NUMBER() OVER (PARTITION BY s.[ModeloAliasID] ORDER BY s.RowNumber)&#xA;FROM HMDCBISA.dbo.V4WStgModeloAlias AS s&#xA;WHERE s.ExecutionID = @ExecutionID&#xA;  AND (SELECT COUNT(*) FROM HMDCBISA.dbo.V4WStgModeloAlias x WHERE x.ExecutionID = @ExecutionID AND x.[ModeloAliasID] = s.[ModeloAliasID]) &gt; 1&#xA;  AND NOT EXISTS (SELECT 1 FROM #Falla f WHERE f.RowNumber = s.RowNumber AND f.MotivoFalla = N'DUPLICADO');&#xA;&#xA;-- Una sola fila por llave y motivo hacia la Qc (índice único filtrado UX_V4WQcModeloAlias_Pendiente)&#xA;;WITH d AS (SELECT Rn, ROW_NUMBER() OVER (PARTITION BY [ModeloAliasID], MotivoFalla ORDER BY RowNumber) AS r FROM #Falla)&#xA;UPDATE d SET Rn = r;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;-- 2. Pendientes que siguen fallando: se refrescan&#xA;UPDATE q&#xA;SET    q.ExecutionIDUltima = @ExecutionID, q.FechaUltimaVez = @Ahora,&#xA;       q.RowNumber = f.RowNumber, q.DetalleError = f.DetalleError,&#xA;       q.[AliasArea] = f.[AliasArea], q.[NivelGrupo] = f.[NivelGrupo], q.[Grupo] = f.[Grupo], q.[Activo] = f.[Activo]&#xA;FROM   HMDCBISA.dbo.V4WQcModeloAlias AS q&#xA;JOIN   #Falla AS f ON f.[ModeloAliasID] = q.[ModeloAliasID] AND f.MotivoFalla = q.MotivoFalla AND f.Rn = 1&#xA;WHERE  q.EstadoQc = N'Pendiente';&#xA;&#xA;-- 3. Fallas nuevas&#xA;INSERT INTO HMDCBISA.dbo.V4WQcModeloAlias&#xA;       (ExecutionID, ExecutionIDUltima, RowNumber, MotivoFalla, DetalleError, EstadoQc,&#xA;        FechaPrimeraVez, FechaUltimaVez, [ModeloAliasID], [AliasArea], [NivelGrupo], [Grupo], [Activo])&#xA;SELECT @ExecutionID, @ExecutionID, f.RowNumber, f.MotivoFalla, f.DetalleError, N'Pendiente',&#xA;       @Ahora, @Ahora, f.[ModeloAliasID], f.[AliasArea], f.[NivelGrupo], f.[Grupo], f.[Activo]&#xA;FROM   #Falla AS f&#xA;WHERE  f.Rn = 1&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcModeloAlias q&#xA;                   WHERE q.[ModeloAliasID] = f.[ModeloAliasID] AND q.MotivoFalla = f.MotivoFalla AND q.EstadoQc = N'Pendiente');&#xA;&#xA;-- 4. Re-evaluación: el archivo se leyó completo, lo pendiente que ya no falla queda Resuelto&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcModeloAlias AS q&#xA;WHERE  q.EstadoQc = N'Pendiente'&#xA;  AND  NOT EXISTS (SELECT 1 FROM #Falla f WHERE f.[ModeloAliasID] = q.[ModeloAliasID] AND f.MotivoFalla = q.MotivoFalla);&#xA;&#xA;-- 5. Lo que no cruza no sigue a Load/Base&#xA;DELETE s&#xA;FROM   HMDCBISA.dbo.V4WStgModeloAlias AS s&#xA;WHERE  s.ExecutionID = @ExecutionID&#xA;  AND  EXISTS (SELECT 1 FROM #Falla f WHERE f.RowNumber = s.RowNumber);&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(DISTINCT RowNumber) AS RowsQc FROM #Falla;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsQc"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
