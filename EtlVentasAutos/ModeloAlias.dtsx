    <DTS:Executable
      DTS:refId="Package\ETL08ReevaluateQc"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E44E67ED-4DE9-4EE3-9DFD-AE13C88501AC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="ETL08ReevaluateQc"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0F0ACF89-D7FD-4BB3-B898-1223E842050F}"
          SQLTask:SqlStatementSource="/* ModeloAlias__ETL08ReevaluateQc_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: ETL08ReevaluateQc&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBISA&#xA;   Qué hace: Camino SIN CAMBIOS: re-evalúa la Qc pendiente GRUPO_FUERA_MAESTRO contra el maestro actual. Lo que ahora cruza (y no tiene otro motivo pendiente) pasa a Base y queda Resuelta. Devuelve RowsReevaluadas.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID&#xA;*/&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;DECLARE @ExecutionID bigint = ?;&#xA;DECLARE @Ahora datetime2(0) = SYSDATETIME();&#xA;IF OBJECT_ID(N'tempdb..#Maestro') IS NOT NULL DROP TABLE #Maestro;&#xA;IF OBJECT_ID(N'tempdb..#Pasa')    IS NOT NULL DROP TABLE #Pasa;&#xA;&#xA;SELECT N'Modelo' AS Nivel, g.Modelo AS Grupo&#xA;INTO #Maestro&#xA;FROM HMDCBIDW.dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1&#xA;UNION&#xA;SELECT N'Familia', g.Familia FROM HMDCBIDW.dbo.V4WBaseModeloGrupo AS g WHERE g.Activo = 1;&#xA;&#xA;SELECT q.QcID, q.[ModeloAliasID], q.[AliasArea], q.[NivelGrupo], q.[Grupo], q.[Activo]&#xA;INTO   #Pasa&#xA;FROM   HMDCBISA.dbo.V4WQcModeloAlias AS q&#xA;WHERE  q.EstadoQc = N'Pendiente' AND q.MotivoFalla = N'GRUPO_FUERA_MAESTRO'&#xA;  AND  NOT (NOT EXISTS (SELECT 1 FROM #Maestro m WHERE m.Nivel = q.NivelGrupo AND m.Grupo = q.Grupo))&#xA;  AND  NOT EXISTS (SELECT 1 FROM HMDCBISA.dbo.V4WQcModeloAlias o&#xA;                   WHERE o.[ModeloAliasID] = q.[ModeloAliasID] AND o.EstadoQc = N'Pendiente' AND o.QcID &lt;&gt; q.QcID);&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;MERGE HMDCBIDW.dbo.V4WBaseModeloAlias AS tgt&#xA;USING (SELECT p.*, CONVERT(bigint, SUBSTRING(HASHBYTES('SHA2_256', CONCAT(ISNULL(CONVERT(nvarchar(200), p.[ModeloAliasID]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[AliasArea]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[NivelGrupo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[Grupo]), N''), NCHAR(31), ISNULL(CONVERT(nvarchar(200), p.[Activo]), N''))), 1, 8)) AS HashNuevo FROM #Pasa AS p) AS src&#xA;   ON tgt.[ModeloAliasID] = src.[ModeloAliasID]&#xA;WHEN MATCHED AND tgt.Hash64 &lt;&gt; src.HashNuevo THEN&#xA;     UPDATE SET tgt.[AliasArea] = src.[AliasArea], tgt.[NivelGrupo] = src.[NivelGrupo], tgt.[Grupo] = src.[Grupo], tgt.[Activo] = src.[Activo],&#xA;                tgt.Hash64 = src.HashNuevo, tgt.ExecutionID = @ExecutionID, tgt.LastModifiedDate = SYSDATETIME()&#xA;WHEN NOT MATCHED THEN&#xA;     INSERT ([ModeloAliasID], [AliasArea], [NivelGrupo], [Grupo], [Activo], ExecutionID, Hash64, CreateDate, LastModifiedDate)&#xA;     VALUES (src.[ModeloAliasID], src.[AliasArea], src.[NivelGrupo], src.[Grupo], src.[Activo], @ExecutionID, src.HashNuevo, SYSDATETIME(), NULL);&#xA;&#xA;UPDATE q&#xA;SET    q.EstadoQc = N'Resuelta', q.FechaResuelta = @Ahora, q.ExecutionIDResuelta = @ExecutionID&#xA;FROM   HMDCBISA.dbo.V4WQcModeloAlias AS q&#xA;JOIN   #Pasa AS p ON p.QcID = q.QcID;&#xA;&#xA;COMMIT TRANSACTION;&#xA;&#xA;SELECT COUNT(*) AS RowsReevaluadas FROM #Pasa;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsReevaluadas"
            SQLTask:DtsVariableName="User::CtlRowsUpdated" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
