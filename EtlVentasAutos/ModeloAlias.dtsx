    <DTS:Executable
      DTS:refId="Package\CTL05UpdateAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5A6E9107-B5F7-40E3-94E9-8D49EA06781A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL05UpdateAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* ModeloAlias__CTL05UpdateAuditRow_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: CTL05UpdateAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría de filas que se actualizan (antes y después), antes de ETL05UpdateDWHDW.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'U',&#xA;       (SELECT tgt.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER),&#xA;       (SELECT src.* FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias AS tgt&#xA;JOIN   HMDCBISA.dbo.V4WLoadModeloAlias AS src ON src.[ModeloAliasID] = tgt.[ModeloAliasID]&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'U';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL06InsertAuditRow"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A8CF8994-DD50-46A5-B177-353DC6A65A9E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL06InsertAuditRow"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* ModeloAlias__CTL06InsertAuditRow_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: CTL06InsertAuditRow&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Auditoría de filas nuevas.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlAuditBatchID · 2) $Package::CtlProcessID · 3) User::CtlExecutionID&#xA;*/&#xA;INSERT INTO dbo.CTLAuditRow (AuditBatchID, ProcessID, ChangeType, BeforeJson, AfterJson)&#xA;SELECT ?, ?, 'I', NULL,&#xA;       (SELECT src.[ModeloAliasID], src.[AliasArea], src.[NivelGrupo], src.[Grupo], src.[Activo], src.ExecutionID, src.HashNuevo AS Hash64&#xA;        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER)&#xA;FROM   HMDCBISA.dbo.V4WLoadModeloAlias AS src&#xA;WHERE  src.ExecutionID = ? AND src.TypeLoad = N'I';&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL07CloseBatchId"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{787C5F59-9F57-41C5-8169-B2C7CF13C93C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL07CloseBatchId"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="/* ModeloAlias__CTL07CloseBatchId_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: CTL07CloseBatchId&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIPA&#xA;   Qué hace: Cierra el lote de auditoría. FailedRows = pendientes de Qc vistos en esta ejecución. Devuelve RowsFailed.&#xA;   Parámetros (OLE DB, en orden): 1) User::CtlExecutionID · 2) User::CtlRowsUpdated · 3) User::CtlRowsInserted · 4) User::CtlAuditBatchID&#xA;*/&#xA;DECLARE @FailedRows int;&#xA;SELECT @FailedRows = COUNT(*)&#xA;FROM   HMDCBISA.dbo.V4WQcModeloAlias&#xA;WHERE  ExecutionIDUltima = ? AND EstadoQc = N'Pendiente';&#xA;&#xA;UPDATE dbo.CTLAuditBatch&#xA;SET    UpdatedRows = ?, InsertedRows = ?, FailedRows = @FailedRows&#xA;WHERE  AuditBatchID = ?;&#xA;&#xA;SELECT @FailedRows AS RowsFailed;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="RowsFailed"
            SQLTask:DtsVariableName="User::CtlRowsFailed" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CtlExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="0" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlRowsUpdated"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlRowsInserted"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="2" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::CtlAuditBatchID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="3" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\CTL08GetNewWaterMark"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{D8E082A0-07F9-411F-BAA8-56ACF65FD11B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="CTL08GetNewWaterMark"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="2">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{0EDA87BA-ED8A-499E-BDBB-0D4439C1A343}"
          SQLTask:TimeOut="2"
          SQLTask:SqlStatementSource="/* ModeloAlias__CTL08GetNewWaterMark_v1.0.sql&#xA;   Paquete : ModeloAlias (EtlVentasAutos) · Tarea: CTL08GetNewWaterMark&#xA;   Autor   : Franco Véliz (Agente V4W) · 2026-11-04 · plan V1 v4, SOL-008&#xA;   Conexión: HMDCBIDW&#xA;   Qué hace: Watermark informativo (las fuentes de archivo usan hash, SOL-008 §2.10). Full result set.&#xA;   Parámetros (OLE DB, en orden): ninguno&#xA;*/&#xA;SELECT ISNULL(MAX(ISNULL(LastModifiedDate, CreateDate)), '1900-01-01') AS NewLoadDate,&#xA;       ISNULL(CONVERT(nvarchar(50), MAX([ModeloAliasID])), N'')              AS NewLastID&#xA;FROM   HMDCBIDW.dbo.V4WBaseModeloAlias;&#xA;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLoadDate"
            SQLTask:DtsVariableName="User::WmNewLoadDate" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="NewLastID"
            SQLTask:DtsVariableName="User::WmNewLastID" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
