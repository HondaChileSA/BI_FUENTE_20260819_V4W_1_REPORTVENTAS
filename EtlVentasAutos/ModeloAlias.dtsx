          SQLTask:Connection="{A08CFC16-0212-460D-B33B-893C4FC351E0}"
          SQLTask:SqlStatementSource="-- ResultSet: Single row&#xA;-- Output: User::CtlExecutionID&#xA;INSERT INTO [dbo].[CTLExecution]&#xA;    ([ProcessID], [ExecutionSSISID], [StartTime], [Status],&#xA;     [UserName], [IpExecution], [PackageName], [ComputerName],&#xA;     [LoadOrigin], [OperatorUser], [FileModifiedDate])&#xA;OUTPUT INSERTED.ExecutionID&#xA;VALUES&#xA;    (?, ?, ?, 'Running', ?, ?, ?, ?,&#xA;     'Automated', ?, ?);&#xA;&#xA;-- Params (Input): $Package::CtlProcessID, CtlServerExecutionID, CtlStartTime, CtlUserName, CtlIpExecution, CtlPackageName, CtlComputerName, EtlOperatorUser, EtlFileModifiedDate"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="ExecutionID"
            SQLTask:DtsVariableName="User::CtlExecutionID" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="$Package::CtlProcessID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="3"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CtlServerExecutionID"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::CtlStartTime"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="7"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::CtlUserName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="4"
            SQLTask:DtsVariableName="User::CtlIpExecution"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="5"
            SQLTask:DtsVariableName="User::CtlPackageName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="6"
            SQLTask:DtsVariableName="User::CtlComputerName"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="130"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
